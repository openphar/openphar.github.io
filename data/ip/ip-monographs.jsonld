monographs/2-7-1","@type":"IndexedMonograph","prefLabel":{"en":"PRP"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-7-10","@type":"IndexedMonograph","prefLabel":{"en":"General chapter 2.7.10"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-7-4","@type":"IndexedMonograph","prefLabel":{"en":"Mycoplasmas"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-7-7","@type":"IndexedMonograph","prefLabel":{"en":"Primary Cells"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-7-9","@type":"IndexedMonograph","prefLabel":{"en":"Mycoplasmas"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-8-1","@type":"IndexedMonograph","prefLabel":{"en":"General chapter 2.8.1"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-8-10","@type":"IndexedMonograph","prefLabel":{"en":"Heparin"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-8-12","@type":"IndexedMonograph","prefLabel":{"en":"Assay"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-8-4","@type":"IndexedMonograph","prefLabel":{"en":"Activated coagulation factors"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-8-8","@type":"IndexedMonograph","prefLabel":{"en":"Thrombin"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/2-8-9","@type":"IndexedMonograph","prefLabel":{"en":"Heparin"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/5-4","@type":"IndexedMonograph","prefLabel":{"en":"Butanol"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/5-7","@type":"IndexedMonograph","prefLabel":{"en":"Assay"},"edition":"IP 2022","category":"other"},{"@id":"https://www.openphar.org/data/ip/monographs/methotrexate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Methotrexate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methotrexate Injection\nMethotrexate Injection is a sterile solution of Methotrexate in \nWater for Injections containing Sodium Hydroxide.\nMethotrexate Injection contains not less than 95.0 per cent \nand not more than 110.0 per cent of the stated amount of \nmethotrexate, C20H22NgO5.\nUsual strengths. 2.5 mg per ml; 25 mg per ml.\nDescription. Aclear, yellowish solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/methotrexate","@type":"IndexedMonograph","prefLabel":{"en":"Methotrexate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Methotrexate\nMol. Wt. 454.4\n1662\nwww.webofpharma.com\nIP 2010\nMethotrexate is 4-amino-4-deoxy-1O-methylpteroyl-\nL-glutamic acid.\nMethotrexate contains not less than 97.0 per cent and not\nmore than 102.0 per cent of C2oH22NsOs, calculated on the\nanhydrous basis.\nCategory. Anticancer.\nDose. For adults, 2.5 to 10 mg; for children, 2.5 to 5 mg.\nDescription. A yellow to orange-brown, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/methoxamine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Methoxamine Hydrochloride"},"edition":"ip-2010","category":"monographs","definition":{"en":"Methoxamine Hydrochloride\nMethoxamine Hydrochloride is all-rac-2-amino-\n1-(2,5- dimethoxyphenyl)propan-1-o1 hydrochloride.\n1664\nwww.webofpharma.com\nIP 2010\nMethoxamine Hydrochloride contains not less than 98.5 per\ncent and not more than 101.0 per cent of C IlH 17N03,HCl,\ncalculated on the dried basis.\nCategory. Sympathomimetic.\nDose. By intramuscular injection, 10 to 15 mg; by slow\nintravenous injection, 5 to 10 mg.\nDescription. Colourless crystals or white, plate-like crystals\nor a white, crystalline powder; odourless or almost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/methoxamine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Methoxamine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methoxamine Injection\nMethoxamine Hydrochloride Injection\nMethoxamine Injection is a sterile solution containing 2 per \ncent w/v of Methoxamine Hydrochloride in Water for \nInjections.\nMethoxamine Injection contains not less than 1,90 per cent \nand not more than 2.10 per cent w/v of methoxamine \nhydrochloride, C11H17NO3, HC1."}},{"@id":"https://www.openphar.org/data/ip/monographs/methyl-hydroxybenzoate","@type":"IndexedMonograph","prefLabel":{"en":"Methyl Hydroxybenzoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methyl Hydroxybenzoate\nCOOCHS\n0\nOH\nCsH8O3 \nMol. Wt. 152.2\nMethylparaben is methyl 4-hydroxybenzoate.\nMethylparaben contains not less than 98.0 per cent and not \nmore than 102.0 per cent of C8H8O3.\nCategory. Pharmaceutical aid (antimicrobial preservative).\nDescription. A white or almost white, crystalline powder or \ncolourless crystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/methyl-salicylate-ointment","@type":"IndexedMonograph","prefLabel":{"en":"Methyl Salicylate Ointment"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methyl Salicylate Ointment\nStrong Methyl Salicylate Ointment\nMethyl Salicylate Ointment contains not less than 90.0 per \ncent and not more than 110.0 per cent of the stated amount of \nmethyl salicylate, C8H8O3 in a suitable ointment base.\nUsual strength. lOpercentw/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/methylatropine-nitrate","@type":"IndexedMonograph","prefLabel":{"en":"Methylatropine Nitrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylatropine Nitrate\nClsH26N,Of. \nMol. Wt 366.4\nAtropine Methonitrate is (.&S)-(lfl,3r,5iS,)-8-methyl-3- \ntropoyloxytropanium nitrate.\nAtropine Methonitrate contains not less than 99.0 per cent \nand not more than 101.0 per cent of C18H26N2O6, calculated on \nthe dried basis.\nCategory. Anticholinergic.\n1544\nwww.webofpharma.com\nDescription. Colourless crystals or a white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/methylcellulose","@type":"IndexedMonograph","prefLabel":{"en":"Methylcellulose"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylcellulose\nCellulose Methyl Ether\nMethylcellulose is a cellulose haying some of the hydroxyl \ngroups in the form of the methyl ether. Various grades are \navailable and are distinguished by a number indicative of the \napparent viscosity in millipascal seconds of a 2 per cent w/w \nsolution measured at 20°.\nMethylcellulose contains not less than 27.5 per cent and not \nmore than 31.5 per cent of methoxyl (-OCH3) groups, calculated \non the dried basis.\nCategory. Bulk laxative; pharmaceutical aid (tablet excipient; \nsuspending agent).\nDescription. A white or yellowish white or greyish white \npowder or granules; hygroscopic after drying."}},{"@id":"https://www.openphar.org/data/ip/monographs/methyldopa","@type":"IndexedMonograph","prefLabel":{"en":"Methyldopa"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methyldopa\noh\nC10H13NO4, PAH2O \nMol. Wt. 238.2\nMethyldopa is 3-(3,4-dihydroxyphenyl)-2-methyl-L-alanine \nsesquihydrate.\nMethyldopa contains not less than 98.5 per cent and not more \nthan 101.0 per cent of Ci0H13NO4, calculated on the anhydrous \nbasis.\nCategory. Antihypertensive.\nDescription. A white to yellowish white, fine powder, which \nmay contain friable lumps."}},{"@id":"https://www.openphar.org/data/ip/monographs/methylergometrine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Methylergometrine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylergometrine Injection\nMethylergometrine Maleate Injection; Methylergonovine \nMaleate Injection; Methylergonovine Injection\nMethyl ergometrine Injection is a sterile solution of \nMethylergometrine Maleate in.Water for Injections free from \ndissolved air.\nMethylergometrine Injection contains not less than 90.0 per \ncent and not more than 110.0 per cent of the stated amount of \nmethylergometrine maleate, C2oH25N302,C4H404.\nUsual strength. 200 pg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/methylergonovine-maleate","@type":"IndexedMonograph","prefLabel":{"en":"Methylergonovine Maleate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylergonovine Maleate\nC20H25N3O2,C4H4O4 \nMol. Wt. 455.5\n2894\nMETHYLDOPA AND HYDROCHLOROTHIAZIDE TABLETS\nIP 2022\nMethylergometrine Maleate is 9,10-didehydro-A;-[(Y)-l- \n(hydroxymethyl)propyl]-6-methylergoline-8|3-carboxamide \nhydrogen maleate.\nMethylergometrine Maleate contains not less than 95.0 per \ncent and not more than 105.0 per cent of C20H25N3O2,C4H4O4, \ncalculated on the dried basis.\nCategory. Uterine stimulant.\nDescription. A white or faintly yellow; crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/methylphenidate-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Methylphenidate Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylphenidate Hydrochloride\nC14Hi9NO2,HCl . \nMol.Wt.269.8\nMethylphenidate Hydrochloride is methyl a-phenyl-2- \npiperidineacetate hydrochloride.\n2898\nMETHYLPARABEN\nIP 2022\nMethylphenidate Hydrochloride contains not less than 98.0 \nper cent and not more than 102.0 per cent of ChH^NC^HCI, \ncalculated on the dried basis.\nCategory. CNS stimulant. ."}},{"@id":"https://www.openphar.org/data/ip/monographs/methylprednisolone-acetate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Methylprednisolone Acetate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylprednisolone Acetate Injection\nMethylprednisolone Acetate Injection is a sterile suspension \nof Methylprednisolone Acetate in Water for Injections. :;\nMethylprednisolone Acetate Injection contains not less than \n90.0 per cent and not more than 110.0 per cent of the stated \namount of methylprednisolone acetate, C24H32O6.\nUsual strength. 40 mg per ml.\nDescription. A white suspension which settles on standing \nbut readily disperses on shaking. On examination under a \nmicroscope, the particles are seen to b.e crystalline and rarely \nexceed 20 pm in diameter."}},{"@id":"https://www.openphar.org/data/ip/monographs/methylprednisolone-acetate","@type":"IndexedMonograph","prefLabel":{"en":"Methylprednisolone Acetate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylprednisolone Acetate\nC2J132()6 ' \n' Mol. Wl. 416.5\nMethylprednisolone Acetate is 11P, 17 a-dihydroxy-6a-methyl-.\n3.20-dioxopregna-l,4-dien-2I-ylacetate. \n..?-:\nMethylprednisolone Acetate contains not less than 96.0 per \ncent and not more than 104.0 per cent of C24H ;2O6, calculated \non the dried basis. ? .Jo. ]•.. \n,, /■\" A:. . r.j\nCategory. Adrenocortical steroid. \n: \n:\nDescription. A white ora] most white, crystalline powder. ; p\n2904\nMETHYLPREDNISOLONE. ACETATE\nIP 2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/methylprednisolone","@type":"IndexedMonograph","prefLabel":{"en":"Methylprednisolone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Methylprednisolone\nC22H30Os \nMol. Wt. 374.5\nMethylprednisolone is 1 l(3,17a,21-trihydroxy-6a- \nmethylpregna-1,4-diene-3,20-dione.\nMethylprednisolone contains not less than 96.0 per cent and \nnot more than 104.0 per cent of C22H30O5, calculated on the \ndried basis.\nCategory. Adrenocortical steroid.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/metoclopramide-hydrochloride-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Metoclopramide Hydrochloride Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Metoclopramide Hydrochloride Tablets\nC161-116C1N303S\nDetermine by liquid chromatography (2.4.14), as described in \nthe Assay with the following modifications.\nMol. Wt. 365.8\nMetoclopramide Tablets contain not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nanhydrous metoclopramide hydrochloride, C I4HrCIN30,,HC1.\nMetolazone is 7-chloro-1,2,3,4-tetrahydro-2-methy1-4-oxo-3- \no-toly1-6-quinazolinesulfonamide.\nTest solution. Disperse one tablet in 30 ml of water, with the \naid of ultrasound for 20 minutes and dilute to 100.0 ml with \nwater. Centrifuge and use the supernatant liquid. \nCalculate the content of C I4H22C1N 302, HC1 in the tablet.\nUsual strength. The equivalent of 10 mg of anhydrous \nmetoclopramide hydrochloride.\nMetolazone contains not less than 97.0 per cent and not more \nthan 102.0 per cent of C I6H 16C1N303S, calculated on the dried \nbasis."}},{"@id":"https://www.openphar.org/data/ip/monographs/metoclopramide-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Metoclopramide Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metoclopramide Hydrochloride\nC14H22C1N3O2,HC1,H,O \nMol. Wt.354.3\nMETOCLOPRAMIDE HYDROCHLORIDE\nIP 2022\nMetoclopramide Hydrochloride is 4-amino-5-chloro-A;-(2- \ndiethylaminoethyl)“2- methoxybenzamide hydrochloride \nmonohydrate.\nMetoclopramide Hydrochloride contains not less than \n99.0 per cent and not more than 101.0 per cent of \nC14H22C1N3O2,HC1, calculated on the anhydrous basis.\nCategory. Antiemetic.\nDescription. A white or almost white crystals or crystalline \npowder."}},{"@id":"https://www.openphar.org/data/ip/monographs/metoclopramide-injection","@type":"IndexedMonograph","prefLabel":{"en":"Metoclopramide Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metoclopramide Injection\nMetoclopramide Hydrochloride Injection\nMetoclopramide Injection is a sterile solution of \nMetoclopramide Hydrochloride; in Water for Injections free \nfrom dissolved air. It contains suitable buffering and stabilising \nagents. -\nMetoclopramide Injection contains not less than 90.0 per cent \nand not more than 110.0 per cent: of the stated amount of \nanhydrous metoclopramide hydrochloride, Ci^jHaCIN^O^HCl.\nUsual strength. The equivalent of 10 mg of anhydrous \nmetoclopramide hydrochloride jn 2 ml.\nDescription. A clear, colourless solution. \nw k\n2908\nMETOCLOPRAMIDE HYDROCHLORIDE \nIP 2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/metoclopramide-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Metoclopramide Syrup"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metoclopramide Syrup\nMetoclopramide Hydrochloride Syrup\nMetoclopramide Syrup contains Metoclopramide \nHydrochloride in a suitable flavoured vehicle.\nMetoclopramide Syrup contains not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nanhydrous metoclopramide hydrochloride, Ci4H22ClN3O2,HCl.\nUsual strength. The equivalent of 5 mg: of anhydrous \nmetoclopramide hydrochloride in 5 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/metolazone","@type":"IndexedMonograph","prefLabel":{"en":"Metolazone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metolazone\nC16H16C1N3O3S \nMol. Wt. 365.8\nMetolazone is 7-chloro-l ,2,3,4-tetrahydro-2-methyl-4-oxo-3- \no-tolyl-6-quinazolinesulfonamide.\nMetolazone contains not less than 97.0 per cent and notmore \nthan 102.0 percent of Ci6H16C1N3O3S, calculated on the dried \nbasis.\nCategory. Diuretic.\nDescription. A white or slightly, yellowish, crystalline powder.\nIt shows polymorphism (2.5.11)."}},{"@id":"https://www.openphar.org/data/ip/monographs/metoprolol-injection","@type":"IndexedMonograph","prefLabel":{"en":"Metoprolol Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metoprolol Injection\nMetoprolol Tartrate Inj ection\nMetoprolol Injection is a sterile solution of Metoprolol Tartrate\nin Water for Injections.\nMetoprolol Injection contains not less than 95.0 per cent and \nnot more than 105.0 per cent of the stated amount of metoprolol \ntartrate, (C15H2SNO3)2,C4H6O6.\nUsual strength. 1 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/metoprolol-succinate","@type":"IndexedMonograph","prefLabel":{"en":"Metoprolol Succinate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metoprolol Succinate\n(C15I1,5NO3)?,CJI6O4 \nMol. Wt. 652.8\nMetoprolol Succinate is (7?5)-l-(Isppropylamino)-3-[4-(2- \nmethoxyethyl)phenoxy]propan-2-ol succinate.\nMetoprolol Succinate contains not less than 98.0 per cent and \nnot more than 102.0 per cent of (C^HjsNOs^C^IgO^’ \ncalculated on the dried basis.\nCategory. Beta-adrenoceptor antagonist.\nDescription. A white, crystalline powder or colorless crystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/metoprolol-tartrate","@type":"IndexedMonograph","prefLabel":{"en":"Metoprolol Tartrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metoprolol Tartrate\n(C15H25NO3)2,C4H6O6\nMol. Wt. 684.8\nwww.webofpharma.com\nMetoprolol Tartrate contains not less than 99.0 per cent and \nnot more than 101.0 per cent of (CiSH25NO3)2,C4H6O6, \ncalculated on the dried basis;\nCategory. Beta-adrenoceptor antagonist.\nDescription. A white, crystalline powder or colourless \ncrystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/metronidazole-benzoate","@type":"IndexedMonograph","prefLabel":{"en":"Metronidazole Benzoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metronidazole Benzoate\nBenzoylmetronidazole\nC13H13N3O4 \nMol. Wt. 275.3\nMetronidazole Benzoate is2-(2-methyl-5-nitro-17/-imidazol-\nl-yl)ethyl benzoate.\nMetronidazole Benzoate contains not less than 98.0 per cent \nand not more than 101.0 per cent of Ci3H13N3O4, calculated on \nthe dried basis.\nCategory. Antiamoebic; antiprotozoal; antibacterial.\nDescription. A white or cream-coloured, crystalline powder or \nflakes.\n2923\nwww.webofpharma.com\nIndentification\nA, When examined in the range 230 nm to 360 nm (2.4.7), .a \n0.001 per cent w/v solution in ethanol shows an absorption \nmaximum only at about 309 nm; absorbance at about 309 nm, \nabout 0.3.\nB. It gives reaction (B) of benzoates (2.3.1).\nC. Melting range 98° to 102° (2.4.21)."}},{"@id":"https://www.openphar.org/data/ip/monographs/metronidazole-for-injection","@type":"IndexedMonograph","prefLabel":{"en":"Metronidazole for Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metronidazole for Injection\nMetronidazole for Injection is a sterile material consisting of \nMetronidazole with or without excipients. It is filled in a sealed \ncontainer.\nThe contents of the sealed container comply with the \nrequirements stated under Parenteral Preparations (Powders \nfor Injection) and with the following requirements.\nMetronidazole Injection contains not less than 95.0 per cent\nand not more than 105.0 per cent of the stated amount of \nmetronidazole, C6H9N3O3."}},{"@id":"https://www.openphar.org/data/ip/monographs/metronidazole-gel","@type":"IndexedMonograph","prefLabel":{"en":"Metronidazole Gel"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metronidazole Gel\nMetronidazole Gel contains Metronidazole in a suitable water- \nsoluble basis. It may contain suitable preservatives.\nMetronidazole Gel contains not less than 90,0 per cent and \nnot more than 110.0 per cent ofthe stated amount of \nmetronidazole, C6H9N3O3.\nUsual strengths. 0.5 per cent w/w; 0,75 per cent w/w; 0.8 per \ncent w/w; 1 per cent w/w; 2 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/metronidazole-injection","@type":"IndexedMonograph","prefLabel":{"en":"Metronidazole Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metronidazole Injection\nMetronidazole Intravenous Infusion ' \n. .\nMetronidazole Injection is a sterile, isotonic solution of \nMetronidazole in Water for Injections. It may contain suitable \nbuffering agents.\nMetronidazole Injection contains not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nmetronidazole, C6H9N3O3.\nUsual strength. 5 mg per ml.;\nDescription. An almost colourless to pale yellow solution.\nwww.webofpharma.com\nIP 2022\nMETRONIDAZOLE GEL"}},{"@id":"https://www.openphar.org/data/ip/monographs/metronidazole","@type":"IndexedMonograph","prefLabel":{"en":"Metronidazole"},"edition":"ip-2022","category":"monographs","definition":{"en":"Metronidazole\nC6H9NA \nMol. Wt. 171.2\nMetronidazole.is 2-(2-methyl-5-nitro-1 Z7-imidazol-1 -yl) ethanol.\nwww.webofpharma.com\nMetronidazole contains not less than 99.0 per cent and not \nmore than 101.0 per cent of C6H9N3O3, calculated on the dried \nbasis.\nCategory. Antiamoebic.\nDescription. A white or yellowish, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mexiletine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Mexiletine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mexiletine Hydrochloride\nch3 nh2 -\nA<°'-^CH3 ■ HCI\n< f!I \n' Mol.Wt.215.7\nMexiletine Hydrochloride is (RS)-1 -methyl-2-(2,6-xylyloxy) \nethylamine hydrochloride.\nMexiletine Hydrochloride contains not less than 99.0 per cent \nand not more than 101,0 per cent of C,, H i-NO.HCl, calculated \non the anhydrous basis. \n.. .. f: .\nCategory. Antiarrhythmic.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mexiletine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Mexiletine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mexiletine Injection\nMexiletine Hydrochloride Injection\nMexiletine Injection is a sterile solution of Mexiletine \nHydrochloride in Water for Injections.\nMexiletine Injection contains not less than 92.5 per cent and \nnot more than 107.5 per cent of the stated amount of Mexiletine \nHydrochloride Cj j Hi 7NO, HC1.\nUsual strength. 250 mg per 10 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/mianserin-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Mianserin Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mianserin Hydrochloride\nHCI\nCuH^HCl\nMol. Wt. 300.8\nMianserin Hydrochloride is (RS)-1,2,3,4,10,14b-hexahydro-2-\nmcthyldibenzo[c./] pyrazino[l,2-a]azepine hydrochloride;\n2931\nwww.webofpharma.com\nMianserin Hydrochloride contains not less than 98.5 per cent \nand not more than 101.0 per cent of C j hfoN? JIC1, calculated \non the dried basis.\nCategory. Antidepressant\nDescription. A white or almost white crystals or crystalline \npowder."}},{"@id":"https://www.openphar.org/data/ip/monographs/miconazole-cream","@type":"IndexedMonograph","prefLabel":{"en":"Miconazole Cream"},"edition":"ip-2022","category":"monographs","definition":{"en":"Miconazole Cream\nMiconazole Nitrate Cream\nMiconazole Cream contains Miconazole Nitrate in a suitable \ncream base.\nMiconazole Cream contains not less than 95.0 per cent and \nnot more than 105.0 per cent of the stated amount of \nmiconazole nitrate, Cl8Hi4Cl4N2O, I INO ..\nUsual strength. 2 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/miconazole-nitrate","@type":"IndexedMonograph","prefLabel":{"en":"Miconazole Nitrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Miconazole Nitrate\n’ HN°3\nC!SH14C14N2O,HNO3 \nMol. Wt. 479.2\nMiconazole Nitrate is (7?59-1 -[2-(2,4-dichloro- \nphenylmethoxy)-2-(2,4-dichlorophenyl)ethyl]-\n1/7-imidazole nitrate.\nMiconazole Nitrate contains not less than 98.5 per cent and \nnot more than 101.5 per cent of C18Hi4C14N2O,HNO3, calculated \non the dried basis.\nCategory. Antifungal.\nDescription. A white or almost white, crystalline or micro­\ncrystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/miconazole","@type":"IndexedMonograph","prefLabel":{"en":"Miconazole"},"edition":"ip-2022","category":"monographs","definition":{"en":"Miconazole\nci\nCl\nC18Hi4C14N2O \nMol. Wt 416.1\nMiconazole is l-[2-(2,4-dichlorophenyl)-2-[(2,4-dichloro- \nphenyl)methoxy]ethyl- 1//-imidazole.\nMiconazole contains not less than 99.0 per cent and not more \nthan 101.0 per cent of Cl8H14Cl4N2O, calculated on the dried \nbasis.\nCategory. Antifungal.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/microcrystalline-cellulose","@type":"IndexedMonograph","prefLabel":{"en":"Microcrystalline Cellulose"},"edition":"ip-2022","category":"monographs","definition":{"en":"Microcrystalline Cellulose\nMicrocrystalline Cellulose is purified, partially depolymerised \ncellulose prepared from alpha cellulose.\nMicrocrystalline Cellulose contains not less than 97.0 per cent \nand not more than 102.0 per cent of cellulose, calculated on \nthe dried basis.\nCategory. Pharmaceutical aid (suspending agent; tablet and \ncapsule adjuvant).\nDescription. A fine or granular, white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/microcrystalline-wax","@type":"IndexedMonograph","prefLabel":{"en":"Microcrystalline Wax"},"edition":"ip-2022","category":"monographs","definition":{"en":"Microcrystalline Wax\nPetroleum Wax (microcrystalline); Amorphous Wax\nMicrocrystalline Wax is a mixture of straight-chain, \nbranched-chain and cyclic hydrocarbons, obtained by \nsolvent fractionation of the still bottom fraction of \npetroleum by suitable dewaxing or de-oiling means.\nCategory. Pharmaceutical aid (stiffening and coating agent; \nointment base).\nDescription. A white or cream-coloured waxy solid."}},{"@id":"https://www.openphar.org/data/ip/monographs/midazolam-injection","@type":"IndexedMonograph","prefLabel":{"en":"Midazolam Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Midazolam Injection\nMidazolam Injection is a sterile solution of Midazolam in Water \nfor Injections containing hydrochloric acid.\nMidazolam Injection contains not less than 95.0 per cent and \nnot more than 105.0 per cent of the stated amount of \nmidazolam, Ci8H13C1FN3.\nUsual strengths. 1 mg per ml; 5 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/midazolam-oral-solution","@type":"IndexedMonograph","prefLabel":{"en":"Midazolam Oral Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Midazolam Oral Solution\nMidazolam Oral Solution is a solution of Midazolam in a \nsuitable flavoured vehicle.\nMidazolam Oral Solution contains not less than 95.0 per cent \nand not more than 105.0 per cent of the stated amount of \nmidazolam, Ci8Hi3C1FN3."}},{"@id":"https://www.openphar.org/data/ip/monographs/midazolam","@type":"IndexedMonograph","prefLabel":{"en":"Midazolam"},"edition":"ip-2022","category":"monographs","definition":{"en":"Midazolam\nCI8HI3C1FN3 \nMol. Wt. 325.8\nMidazolam is 8-chloro-6-(2-fluorophenyl)-1 -methyl- \n4/7-imidazo[l ,5-a] [ 1,4]benzodiazepine.\nMidazolam contains not less than 98.5 per cent and not more \nthan 101.5 per cent calculated on the dried basis.\nCategory. Sedative;Anxiolytic.\nDescription. Awhite or yellowish, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mifepristone","@type":"IndexedMonograph","prefLabel":{"en":"Mifepristone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mifepristone\nQ9H35NO2 \n■ - \nMol Wt. 429.6\nMifepristone is 17fJ-Hydroxy-l ip-(4-dimethylamino)phbnyL\n17-( 1 -propynyl)-4,9-estradien-3-one.\nMifepristone contains not less than 98.0 per cent and not \nmore than 102.0 per cent of C29H35NO2, calculated on the dried \nbasis. \n: •. \n- :\nwww.webofpharma.com\nCategory. Abortifacient.\nDescription. A slightly yellow crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/milk-thistle","@type":"IndexedMonograph","prefLabel":{"en":"Milk Thistle"},"edition":"ip-2022","category":"monographs","definition":{"en":"Milk Thistle"}},{"@id":"https://www.openphar.org/data/ip/monographs/ministry-of-chemicals-and-fertilizers","@type":"IndexedMonograph","prefLabel":{"en":"Ministry of Chemicals and Fertilizers"},"edition":"ip-2018","category":"monographs","definition":{"en":"Ministry of Chemicals and Fertilizers \nShastri Bhawan, New Delhi-110 011.\n(Shri Sudhanshu Pant)\nMember \t\nThe Deputy Secretary (Drugs) \n(ex -officio) \nMinistry of Health & Family Welfare \nNirman Bhawan \nNew Delhi-110011.\n(Shri D. N. Sahoo)\nMember \t\nThe Drugs Controller General (I) \n(ex -officio) \nDirectorate General of Health Services \nMinistry of Health & Family Welfare \nFDA Bhawan, Kotla Road \nNew Delhi-110 002.\n(Dr. G N. Singh)\nMember \t\nThe Director \n(ex -officio) \nNational Institute of Biologicals \nA-32, Sector-62, Institutional Area \nNoida-201 309.\n(Dr. Surinder Singh)\nMember \t\nProfessor (Dr.) Lal Ji Singh \nFormer Vice Chancellor \nBanaras Hindu University \nVaranasi-221 005.\nMember \t\nThe President, \nPharmacy Council of India \nCombined Councils' Building \nKotla Road, Aiwan-E-Ghalib Marg \nPost Box No. 7020, New Delhi-110 002.\n(Professor B. Suresh)\nMember \t\nDr. Kiran Mazumdar Shaw \nC&MD \nBiocon Ltd. 20th KM, Hosur \nElectronics City, Bangalore- 56\nIP 2018"}},{"@id":"https://www.openphar.org/data/ip/monographs/minoxidil-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Minoxidil Tablets"},"edition":"ip-2022","category":"monographs","definition":{"en":"Minoxidil Tablets\nMinoxidil Tablets contains not less than 90.0 per cent and not \nmore than 110.0 per cent of the stated amount of minoxidil, \nG>H15N5O.\nUsual strengths. 2.5 mg; 5 mg; 10 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/minoxidil","@type":"IndexedMonograph","prefLabel":{"en":"Minoxidil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Minoxidil\nQH^NsO \nMol. Wt. 209.3\nMinoxidil is 2,4-diamino-6-piperidinopyrimidine 3-oxide.\nMinoxidil contains nbt less than 98.5 per cent and not more \nthan 101.0 per cent of C9H|5N5O, calculated on the dried basis.\nCategory. Antihypertensive.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mirtazapine-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Mirtazapine Tablets"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mirtazapine Tablets\nMirtazapine Tablets contains not less than 95.0 per cent and \nnot more than 105.0 per cent of Ci7Hi9N3.\nUsual strengths. 15 mg; 30 mg; 45 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/mirtazapine","@type":"IndexedMonograph","prefLabel":{"en":"Mirtazapine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mirtazapine\nCI7H1?N3' \n' ' Mol. Wt. 265.4\nCategory. Antidepressant.\nMirtazapine is (14b7?S')-2-methyk 1,2,3,4,10,14b-hexahydro- \npyrazino[2,1 -a]pyrido[2,3-c] [2]benzazepine.\nMirtazapine contains not less than 99.0 per cent and not more \nthan 101.0 per cent of C^H^N^ calculated on the anhydrous \nbasis.\nDescription. A white or almost white powder, slightly \nhygroscopic to hygroscopic in nature. It shows polymorphism \n(2.5.11). \n' \n' ; \n■ \n■ A;"}},{"@id":"https://www.openphar.org/data/ip/monographs/misoprostol","@type":"IndexedMonograph","prefLabel":{"en":"Misoprostol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Misoprostol\n2948\nIP 2022\nMisoprostol is (/?A')-methyl (13/T)-11,16-dihydroxy-\n16-methyI-9-oxoprost-13-enoate.\nMisoprostol contains not less than 96.5 percent and not more \nthan 102.0 percent of C22H38OS, calculated bn the anhydrous \nbasis. ' \n. \n'\nCategory. Abortifacient; gastric cytoprotector.\nDescription. A clear, colourless or yellowish, oily liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/mitiglinide-calcium-dihydrate","@type":"IndexedMonograph","prefLabel":{"en":"Mitiglinide Calcium Dihydrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mitiglinide Calcium Dihydrate\nC38H48CaN2O6^H2O \nMol Wt. 704.9\nMitiglinide Calcium Dihydrate is calcium (5)-2-benzyl-4- \n((3 a7?,7aS)-hexahydro-1 H-isoindol-2 (3/7)-yl)-4-oxobutanoate \ndehydrate.\nMitiglinide Calcium Dihydrate contains not less than 98.0 per \ncent and not more than 102.0 per cent of C38H4SCaN2O6, \ncalculated on the anhydrous basis.\nCategory. Antidiabetic.\nDescription. A white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mitomycin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Mitomycin Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Mitomycin Injection\nB. When examined in the range 200 nm to 400 nm (2.4.7), a \n0.0005 per cent w/v solution in methanol shows an absorption\nMitomycin Injection contains not less than 90.0 per cent and \nnot more than 120.0 per cent of the stated amount of \nmitomycin, C I5FINN405.\nmaximum at 357 nm as that of solution of mitomycin RS prepared\nin the same manner.\nUsual strength. 5 mg per 10 ml vial.\nInject reference solution (b). The test is not valid unless the \nresolution between the peaks corresponding to mitomycin \nand 3-ethoxy-4-hydroxybenzaldehyde is not less than 1.8, the \ntailing factor for the principal peak is not more than 1.3 and \nthe relative standard deviation for replicate injections is not \nmore than 2.0..per cent."}},{"@id":"https://www.openphar.org/data/ip/monographs/mitomycin","@type":"IndexedMonograph","prefLabel":{"en":"Mitomycin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mitomycin\ncI5h18n4os\nMol. Wt. 334.3\nMitomycin is (l.S\\25,86\\8a/?)-[6-Amino-<Sa-methoxy-5-methyl- \n4,7-dioxo-l,la,2,4,7,8,8a,8b-octahydroazireno[2',3':3,4] \npyrrole [ 1,2-a] -8-indolyl] methylcarbamate.\nMitomycin has a potency of not less than 970 pg per. mg \ncalculated on the anhydrous basis.\nCategory. Anticancer."}},{"@id":"https://www.openphar.org/data/ip/monographs/mobile","@type":"IndexedMonograph","prefLabel":{"en":"Mobile"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mobile \nphase C \n(per cent v/v)\nMobile phase A\nCategory. Amino acid\nMobile phase B\nTim?\n.£j \nfe®^\n(per cent v/v)\n(per cent v/v)\nDescription. A white crystals.\n0\n95\n(in mm.)\n5\n0\n2\n100. ■\n0"}},{"@id":"https://www.openphar.org/data/ip/monographs/modafinil","@type":"IndexedMonograph","prefLabel":{"en":"Modafinil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Modafinil\nC15H15NO2S\nModafinil is acetamide, 2-[(diphenylmethyl)sulphenyl];\n2-[(Diphenylmethyl)sulfinyl]-acetamide.\nModafinil contains not less than 98.0 per cent and not more \nthan 101.5 per cent of Ci5H15NO2 S, calculated on the anhydrous \nbasis.\nCategory. Psychoanaleptic,\nDescription. A white to off-white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/moexipril-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Moexipril Hydrochloride"},"edition":"ip-2018","category":"monographs","definition":{"en":"Moexipril Hydrochloride\nOC H3\n• Ha\nOC H3\nMol Wt. 535.0\nc2. H34 N207,HC1\nMoexipril Hydrochloride is (3S)-2-[(2S)-2-1[(1S)-(1- \nEthoxycarbony1)-3-phenylipropyllaminolpropanoy 1 1 -\n 6,7-dimethoxy-1,2,3,4-tetrahydroisoquinoline-3-carboxylic acid \nhydrochloride.\nMoexipril Hydrochloride contains not less than 98.0 per cent \nand not more than 102.0 per cent of C 27H34 N207,HC1, calculated \non the anhydrous basis.\nCategory. Antihypertensive.\nDescription. A white to off white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mometasone-aqueous-nasal-spray","@type":"IndexedMonograph","prefLabel":{"en":"Mometasone Aqueous Nasal Spray"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mometasone Aqueous Nasal Spray\nMometasone Aqueous Nasal Spray is an aqueous suspension \nof Mometasone Furoate in a suitable pressurised container \nfitted with an appropriate nasal delivery system.\nThe nasal spray complies with the requirements stated under \nNasal Preparations and with the following requirements.\nMometasone Aqueous Nasal Spray contains not less than\n80.0 per cent and not more than 120.0 per cent ofthe stated \namount of mometasone furoate, C27H30Cl2O6.\nUsual strength. 0.05 per cent w/v."}},{"@id":"https://www.openphar.org/data/ip/monographs/mometasone-cream","@type":"IndexedMonograph","prefLabel":{"en":"Mometasone Cream"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mometasone Cream\nMometasone Furoate Cream\nMometasone Cream.-contains Mometasone Furoate in a\nsuitable cream base.\nMometasone Cream contains not less than 90.0 per cent and \nriot more than 110.0 per cent of the stated amount of \nmometasone furoate, C27H3oC1206.\nIP 2022\nMOMETASONE CREAM\nUsual strength. 0.1 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/mometasone-furoate","@type":"IndexedMonograph","prefLabel":{"en":"Mometasone Furoate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Mometasone Furoate\no\n~7H30Ch06\nMol. Wt. 521.4\nMometasone Furoate is 9<x,21-Dichloro-ll~-hydroxy-16<x­\nmethy~-3,20-dioxopregna-l,4-dien-17-yl furan-2-carboxylate.\nMometasone Furoate contains not less than 97.0 per cent and\nnot more than 102.0per cent ofC27H30Ch06, calculated on the\ndried basis.\nCategory. Glucocorticoid.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mometasone-ointment","@type":"IndexedMonograph","prefLabel":{"en":"Mometasone Ointment"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mometasone Ointment\nMometasone Furoate Ointment\nMometasone Ointment contains Mometasone Furoate in a \nsuitable base.\nMometasone Ointment contains not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nmometasone furoate, C27H30C12O6..\nUsual strength. 0.1 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/monoethanolamine","@type":"IndexedMonograph","prefLabel":{"en":"Monoethanolamine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Monoethanolamine\nCJL.NO \nMol. Wt. 61.1\nEthanolamine is 2-aminoethanol.\nEthanolamine contains not less than 98.0 per cent and not \nmorethan 100.5 percentofC2H7NO.\nCategory. Sclerosing agent.\nDescription. A clear, colourless or pale yellow liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/monosulfiram-solution","@type":"IndexedMonograph","prefLabel":{"en":"Monosulfiram Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Monosulfiram Solution\nMonosulfiram Solution is a-solution. of: Monosulfiram in\nEthanol (95 per cent} containing a suitable dispersing agent.\n‘NOTE. — Carry. ‘ut the test in subdued light. \n  \n    \nwww.webofpharma.com\nIn making Monosulfiram Solution the ethanol (95 per cent} \nmay be replaced by Industrial Methylated Spirit provided that\nthe statutory requirements governing the use of Industrial \nMethylated Spirit are observed. \n,\nMonosulfiram Solution contains not less than 94.0 per cent\nand not more than 106.0 per cent of. the stated amount of \nmonosulfiram, CipHagNoSs. \n' \nL\nUsual strength: 25 per cent wiw. |’\nDescription. Clear, bright, deep reddish-brown liquid; crystals \nfrom which may deposit slowly at low temperatures but \ndissolve on, warming. Vields a \na pale yellow dispersion \no on \ndilution with water."}},{"@id":"https://www.openphar.org/data/ip/monographs/montelukast-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Montelukast Sodium","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Montelukast Sodium\nC35H35ClNNaO3S \nMol. Wt. 608.2\nMontelukast sodium is monosodium salt of l-[[[(17?)-l-[3-[(lE)- \n2-(7-chloro-2-quinolinyl)ethenyl]phenyl]-3 -[2-( 1 -hydroxy-1 - \nmethylethyl)phenyl]propyl]thio] methyl] cyclopropaneacetic \nacid. ,\nMontelukast Sodium contains not less than 98.0 per cent and \nnot more than 102.0 per cent of C35H35ClNNaO3S, calculated \non the anhydrous basis.\nCategory. Antiasthmatic (add-on therapy, formild to moderate \nasthma).\nDescription. A white to pale yellow powder.\nIP. 2022\nMONTELUKAST SODIUM"}},{"@id":"https://www.openphar.org/data/ip/monographs/morphine-and-atropine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Morphine and Atropine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Morphine and Atropine Injection\nMorphine Sulphate and Afropine Sulphate Injection\nMorphine and Atropine Injection is a sterile isotonic solution \nin Water for Injections containing 1.0 per cent w/v of Morphine \nSulphate and 0.06 per cent w/v of Atropine Sulphate.\nwww.webofpharma.com\nMorphine and Atropine Injection, contains not less than \n0.90 per cent w/v and not more than 1.10 per cent w/v of \nmorphine sulphate, (Ci7H[9NO3)2,H2SO4,5H2O, and not less \nthan 0.054 per cent w/v and not more than 0.066 per cent w/v \nof atropine sulphate, (Ci7H23NO3)2,H2SO4,H2O.\nUsual Strengths. Morphine sulphate 1 per cent and atropine \nsulphate 0.06 per cent."}},{"@id":"https://www.openphar.org/data/ip/monographs/morphine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Morphine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Morphine Injection\nMorphine Sulphate Injection\nMorphine Injection is a sterile solution of Morphine \nSulphate in Water for Injections.\nMorphine Injection contains not less than 90.0 per cent and \nnot more than 110.0 per cent ofthe stated amount of morphine \nsulphate, (C17Hi9NO3)2,H2SO4,5H2O.\nUsual strength. 10 mg per ml; 15 mg per ml; 50 ml per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/morphine-sulphate","@type":"IndexedMonograph","prefLabel":{"en":"Morphine Sulphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Morphine Sulphate\nH2SO4) 5H2O\n(C17H19NO3)2,H2SO4,5H2O\nMol. Wt. 758.8\nMorphine Sulphate is 7,8-didehydro-4,5 a-epoxy-17-methyl- \nmorphinan-3,6a-diol sulphate pentahydrate.\nMorphine Sulphate contains not less than 98.0.per cent and \nnot more than 102.0 per cent of (C17Hi9NO3)2,H2SO4, calculated \non the dried basis.\nCategory. Narcotic analgesic.\nDescription. White, acicular crystals or cubical masses or a \nwhite, crystalline powder.\n2965\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/mosapride-citrate-dihydrate","@type":"IndexedMonograph","prefLabel":{"en":"Mosapride Citrate Dihydrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mosapride Citrate Dihydrate\nC21H25C1FN3O3 C6HsO7 2H2O \nMol. Wt. 650.0\nMosapride Citrate Dihydrate is (/?5f)-4-amino-5-chlor o- \n2-ethoxy-A'- {[4-(4-fluorobenzyl)-2-morpholinyl]methyl} \nbenzamide citrate dihydrate.\nMosapride Citrate Dihydrate contains not less than 98.0 per \ncent and not more than 102.0 per cent of C21H25C1FN3O3 C6H8O7t \ncalculated on the anhydrous basis.\nCategory. Gastroprokinetic agent.\nDescription. A white or yellowish white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/mosapride-citrate-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Mosapride Citrate Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Mosapride Citrate Tablets\nMoxifloxacin Hydrochloride contains 98.0 per cent to 102.0 \nper cent of C21H25C1FN304, calculated on the anhydrous basis. \nCategory. Antibacterial.\nReference solution. Weigh 26.5 mg of mosapride citrate \ndihydrate RS and dissolve in 100 ml of the mobile phase. \nDilute with the mobile phase to produce a solution containing \nof 0.02 mg of mosapride citrate per ml.\nMosapride Citrate Tablets contain not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nmosapride citrate, C 21 1-125CIFN30,.C6Hs07.\nDose. Orally, 400 mg or intravenous infusion every 24 hours.\nUsual strengths. 2.5 mg; 5 mg; 10 mg; 15 mg.\nOther tests. Comply with the tests stated under Tablets.\nDescription. A light yellow or yellow powder or crystals, \nslightly hygroscopic.\nAssay. Determine by liquid chromatography (2.4.14)."}},{"@id":"https://www.openphar.org/data/ip/monographs/moxifloxacin-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Moxifloxacin Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Moxifloxacin Hydrochloride\nC21H2SC1FN3O4 \nMol. Wt. 437.9.\nMoxifloxacin Hydrochloride is l-Cyclopropyl-6-fluoro-8- \nmethoxy-7-[(4as,7as)-octahydro-6#-pyrolo’3,4-b] pyridin-6- \nylj-4-oxo-1,4-dihydroquinoline-3-carboxylic acid \nhydrochloride.,\nMoxifloxacin Hydrochloride contains 98.0 per cent to 102.0 \nper cent of C2iH25C1FN3O4, calculated on the anhydrous basis.\nCategory. Antibacterial.\nDescription. A light yellow or yellow powder or crystals, \nslightly hygroscopic.\n2970\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/mupirocin-ointment","@type":"IndexedMonograph","prefLabel":{"en":"Mupirocin Ointment"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mupirocin Ointment\nMupirocin Ointment contains Mupirocin in a suitable base.\nMupirocin Ointment contains not less than 90.0 per cent and \nnot more than 115.0 per cent ofthe stated amount of C26H44O9.\nUsual strength. 2 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/mupirocin","@type":"IndexedMonograph","prefLabel":{"en":"Mupirocin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mupirocin\nMol. Wt. 500.6\nMupirocin is 9-[(E')-4-[(2iV,3R,4^,51S)-3,4-Dihydroxy-5- \n[[(25,3‘S)-3-[(2>S,35,)-3-hydroxy-2-butanyl]-2\"Oxiranyl]methyl]- \n2-oxanyl]-3-methyl-2-butenoyl]oxynonanoic acid.\nMupirocin is produced by the growth of certain strains of \nPseudomonas fluorescenscn obtained by any other means.\nMupirocin contains not less than 93.0 per cent and not more \nthan 102.0 per centof C26H44O9, calculated on the anhydrous \nbasis.\nCategory. Antibacterial.\nDescription,A white or almost white powder. It shows \npolymorphism (2.5.11)."}},{"@id":"https://www.openphar.org/data/ip/monographs/mustine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Mustine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mustine Hydrochloride\nNitrogen Mustard. .\nC5H! AN-HCI \nMol Wt. 192.4\nIP 2022\nMUSTINE INJECTION\nMustine Hydrochloride is bis(2-chloroethyl)methylamine \nhydrochloride.\nMustine Hydrochloride contains not less than 98.0 per cent \nand not more than 101.0 per cent of C5Hj iC12N, HCI.\nCategory. Anticancer.\nDescription. A white or almost white, crystalline powder or \nmass; hydroscopic; vesicant."}},{"@id":"https://www.openphar.org/data/ip/monographs/mustine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Mustine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mustine Injection\nMustine Hydrochloride Injection\nMustine Injection is a sterile material consisting of Mustine \nHydrochloride with or without buffering agents and other\nexcipients. It is filled in a sealed container.\nThe injection is constituted by dissolving the contents of the \nsealed container in the requisite amount of sterile Water for \nInjections or Sodium Chloride Intravenous Infusion, \nimmediately before use.\nThe constituted solution complies with the requirements for \nClarity of solution and Particulate matter stated under \nParenteral Preparations (Injections).\n2983\nwww.webofpharma.com\nStorage. The constituted.solution deteriorates rapidly on \nstorage and should be used immediately after preparation; .\nMustine Injection contains not less than 90.0 per cent and not \nmore than 110.0 per cent of the stated amount of the stated \namount of mustine hydrochloride, CsH] [CbHHCl.\nUsual strength. 10 mg.\nThe contents of the sealed container complies with the tests \nstated under Parenteral Preparations (Powders for \nInjection) and with the following requirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/mycophenolate-mofetil","@type":"IndexedMonograph","prefLabel":{"en":"Mycophenolate Mofetil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Mycophenolate Mofetil\nCyJkNO? . \nMol. Wt. 433.5\nMycophenolate Mofetil is.2-(morpholin-4-yl)ethyl \n(4£0-6-(4-hydroxy-6-methoxy-7-methyl-3-oxo- ■ ■\nl,3-dihydroisobenzofuran-5-yl)-4-methylhex-4-endate. . ..\nMycophenolate Mofetil contains not less than 98.0 per cent \nand not more than 102.0 per cent of C^HsjNCb, calculated on \nthe dried basis.\nMUSTINE INJECTION \nIP 2022\nCategory. Immunosupressant.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/myristic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Myristic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Myristic Acid\nCH.3(CH2)12COOH .\nCi4H28O2 \nMol. Wt. 228:4\nMyristic acid is tetradecanoic, acid.\nMyristic Acid is obtained from coconut oil and other fats.\nMyristic Acid contains not less than 97:0 per cent of Ci4H3SO2.\nCategory. Pharmaceutical aid."}},{"@id":"https://www.openphar.org/data/ip/monographs/nabumetone","@type":"IndexedMonograph","prefLabel":{"en":"Nabumetone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nabumetone\nC]5H16O2 \nMol.Wt.228.3\nNabumetone is 4-(6-methoxynaphthalen-2-yl)butan-2-one.\nNabumetone contains not less than 97.0 per-cent and not \nmore than 102.0 per cent of Ci5H16O2, calculated on the \nanhydrous basis. \n■\nCategory. Cyclo-oxygenase inhibitor; analgesic; anti­\ninflammatory.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nadifloxacin-cream","@type":"IndexedMonograph","prefLabel":{"en":"Nadifloxacin Cream"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nadifloxacin Cream\nNadifloxacin Cream contains Nadifloxacin in a suitable cream \nbase.\nNadifloxacin Cream contains not less than 90.0 per cent and \nnot more than II 0.0 per cent of the stated amount of \nnadifloxacin, C19H2iFN2O4.\nUsual strength. 1 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/nadifloxacin-gel","@type":"IndexedMonograph","prefLabel":{"en":"Nadifloxacin Gel"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nadifloxacin Gel\nNadifloxacin Gel contains not less than 90.0 per cent and not \nmore than 110.0 per cent of the stated amount of Nadifloxacin, \nC19H21FN2O4. \n.\nwww.webofpharma.com\nNALIDIXIC ACID\nIP 2022\nUsual strength. 1 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/nadifloxacin","@type":"IndexedMonograph","prefLabel":{"en":"Nadifloxacin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nadifloxacin\no o\n■\nHCT^\nC19H21FN2O4 \nMol.Wt.360.4\nNadifloxacin is 9-Fluoro-8-(4-hydroxy-piperidin-l -yl)-5-methyl-\n17Oxo-6,7“dihydrp-lF/j,5/f-pyrido [3,2,1-ij] quinoline-2 - \ncarboxylicacid.\nNadifloxacin contains not less than 98.0 per cent and hot \nmore than 102.0 per cent of C^IFiF-NSO.;, calculated on the \nanhydrous basis.\nCategory. Antibacterial.\nDescription. An off-white to pale yellow crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nagakesar","@type":"IndexedMonograph","prefLabel":{"en":"Nagakesar"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nagakesar"}},{"@id":"https://www.openphar.org/data/ip/monographs/nalidixic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Nalidixic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nalidixic Acid\nC12H12N2O3 \" \n. Mol. Wt. 232.2\nNalidixic Acid is 1 -ethyl-1,4-dihydro-7-methyl-4-oxo-l,8- \nnaphthyridine-3-carboxylic acid.\nNalidixic Acid contains not less than 99.0 per cent and not\nmore than 101.0 per cent of C^H^NjCh, calculated on the \ndried basis.\nCategory. Antibacterial.\nDescription. A white to slightly yellow, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nalorphine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Nalorphine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nalorphine Hydrochloride\nC19H21NO3,HC1 ■ \n. y Mol.Wt. 347.8\nNalorphine Hydrochloride is 17-ally 1-7,8-di dehydro-4,5 (x-\nepoxymorphinan-3,6a-diol hydrochloride.\nNalorphine Hydrochloride^contains not less than 97.0 per cent\nand notmore:thanl03.0per,cent of C;1)1 I>|NO3,HC1, calculated \non the dried basis. \n•\nCategory. Narcotic antagonist ' \n•• u\nDescription. A white or almost white, crystalline powder. It \nslowly darkens on exposure to air and light."}},{"@id":"https://www.openphar.org/data/ip/monographs/nalorphine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Nalorphine Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Nalorphine Injection\nRelated substances. Determine by thin-layer chromatography \n(2.4.17), coating the plate with silica gel HF254.\nDescription. A white or almost white, crystalline powder; \nodourless. It slowly darkens on exposure to air and light.\nNalorphine Hydrochloride Injection\nMobile phase. A mixture of 70 volumes of ethanol (95 per \ncent), 20 volumes of dichloromethane and 10 volumes of \n5 M ammonia.\nNalorphine Injection is a sterile solution of Nalorphine \nHydrochloride in Water for Injections containing suitable \nbuffering agents."}},{"@id":"https://www.openphar.org/data/ip/monographs/naloxone-hydrochloride-dihydrate","@type":"IndexedMonograph","prefLabel":{"en":"Naloxone Hydrochloride Dihydrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Naloxone Hydrochloride Dihydrate\nCVJH21NO4,HCL2H3O \nMol. Wt. 399.9\nNaloxone Hydrochloride isT7-allyl-4,5-a-epoxy-3,14- \ndihydroxymorphinan-3-one hydrochloride dihydrate.\nNaloxone Hydrochloride contains riot less than 98.0 per cent \nand not more than 102.0 per cent of C!91 fA'lNOa, calculated \non the anhydrous basis.\nCategory. Antidote for opioids poisoning. ;\nDescription. A white to almost white, hygroscopic, crystalline \npowder. '"}},{"@id":"https://www.openphar.org/data/ip/monographs/naloxone-injection","@type":"IndexedMonograph","prefLabel":{"en":"Naloxone Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Naloxone Injection\nNaloxone Injection is a sterile solution of Naloxone \nHydrochloride in Water for Injections.\nNaloxone Injection contains not less than 95.0 per cent and \nnot more than 105.0 per cent of the stated amount of naloxone \nhydrochloride, C^HziNO^HCl.\nUsual strength. 400 pg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/naltrexone-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Naltrexone Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Naltrexone Hydrochloride\nC20H24ClNO4 \" \nMol. Wt. 377.9\nNaltrexone Hydrochloride is 17-(cyclopropylmethyl)- \n4,5a-epoxy-3,14-dihydroxymorphinan-6-one hydrochloride.\nNaltrexone Hydrochloride contains not less than 98.0 per cent \nand not more than 102.0 per cent of C20H24CINO4, calculated \non the anhydrous and ethanol free basis.\nCategory. Antidote for opioids poisoning.\nDescription; A white or almost white powder, very \nhygroscopic. \n<• \n•;"}},{"@id":"https://www.openphar.org/data/ip/monographs/nandrolone-decanoate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Nandrolone Decanoate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nandrolone Decanoate Injection\nNandrolone Decanoate Injection is a sterile solution of \nNandrolone Decanoate in Ethyl Oleate or other suitable ester, \nin a suitable fixed oil or in any mixture of these.\nNandrolone Decanoate Injection contains not less than \n90.0 per cent and not more than 110.0,per cent of the stated \namount of nandrolone decanoate, C28H44O3.\nUsual strength. 25 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/nandrolone-decanoate","@type":"IndexedMonograph","prefLabel":{"en":"Nandrolone Decanoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nandrolone Decanoate\nC28H44O3 . \n. \n' \nMol. Wt. 428.7\nNandrolone Decanoate is 3-oxo-4-estren-17p-yl decanoate.\nNandrolone Decanoate, contains, not less than 97.0 per cent \nand not more than 103.0 per cent of C28H44O3, calculated on \nthe dried basis.\nCategory. Anabolic steroid.\nDescription. A white to creamy-off white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nandrolone-laurate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Nandrolone Laurate Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Nandrolone Laurate Injection\nNandrolone Laurate Injection is a sterile solution ofNandrolone\nLaurate in Ethyl Oleate or other suitable ester, in a suitable\nfixed oil, or in any mixture ofthese.\nNandrolone Laurate Injection contains not less than 92.5 per\ncent and not more than 107.5 per cent ofthe stated amount of\nnandrolone 1aurate, C30H4S03'\n!!sUl!I~~!!~!!gths:~?IJ1~ i!11!J11;~~~!J1~iIl~!!J1I~...."}},{"@id":"https://www.openphar.org/data/ip/monographs/nandrolone-laurate","@type":"IndexedMonograph","prefLabel":{"en":"Nandrolone Laurate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Nandrolone Laurate\na\nC30~S03\nMol. Wt. 456.7\nNandrolone Laurate is 3-oxoestr-4-en-17~-yl-dodecanoate.\nNandrolone Laurate contains not less than 97.0 per cent and\nnot more than 103.0 per cent ofC30H4s03, calculated on the\ndried basis.\nCategory. Anabolic steroid; androgen.\nDose. Allspecies. By subcutaneous or intramuscular injection,\n0.2 to 1 mg per kg ofbody weight once every two weeks.\nDescription. A white to creamy white, crystalline powder;\nodour, faint and characteristic."}},{"@id":"https://www.openphar.org/data/ip/monographs/nandrolone-phenpropionate","@type":"IndexedMonograph","prefLabel":{"en":"Nandrolone Phenpropionate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Nandrolone Phenpropionate\nC27H3403 \nMol. Wt. 406.6\nNandrolone Phenylpropionate is 3-oxo-4-estren-1713-y1 3-\nphenylpropionate.\n100.0 ml, dilute 5.0 ml to 50.0 ml with ethanol and measure the \nabsorbance of the resulting solution at the maximum at about \n240 nm (2,4.7). ,Calculate the content of C 2413403 taking 430 as \nthe 'specific absOrbance at 240 nm. \nCategory. Anabolic steroid. \nStoi-age. Store protected from light.\nNandrolone Phenylpropionate contains not less than 97.0 per \ncent and not more than 103.0 per cent of C 27113,05, ca_ lculated \non the dried basis."}},{"@id":"https://www.openphar.org/data/ip/monographs/nandrolone-phenylpropionate","@type":"IndexedMonograph","prefLabel":{"en":"Nandrolone Phenylpropionate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nandrolone Phenylpropionate\nNandrolone Phenpropionate\nNandrolone Phenylpropionate is 3-oxo-4-estren-17fJ-yl 3- \nphenylpropionate.\nNandrolone Phenylpropionate.contains not less than 97.0 per \ncent and not more than 103.0 per cent of C27H34O3, calculated \non the dried.basis.\nwww.webofpharma.com\nIP 2022\nCategory. Anabolic steroid.\nDescription. A white to creamy-white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/naphazoline-nitrate","@type":"IndexedMonograph","prefLabel":{"en":"Naphazoline Nitrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Naphazoline Nitrate\nC14HmN2J1NO3 \nMol. Wt. 273.3\nNaphazoline Nitrate is. 2-(lmapthyhnethyl)-2-imidazoline \nnitrate.\nNaphazoline Nitrate contains not less than 99.0 per cent and \nnot more than 101.0 per cent of.C4HHN2,HNO3 calculated on \nthe dried basis.\nCategory. Sympathomimetic.\nDescription. A white or almost white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/naproxcinod","@type":"IndexedMonograph","prefLabel":{"en":"Naproxcinod"},"edition":"ip-2022","category":"monographs","definition":{"en":"Naproxcinod\nNaproxcinod is 4-Nitrooxybutyl (2S)-2-(6-methoxy- \n.\n2-naphthyl)proparioate.\nNaproxcinod contains not less than 98.0 per cent.and not \nmore than 102.0 per cent of C^H^NO^ calculated on the \nanhydrous basis.\nCategory. Analgesic.\nDescription. A light yellow to yellow liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/naproxen-oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Naproxen Oral Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Naproxen Oral Suspension\nNaproxen Oral Suspension is an aqueous suspension of \nNaproxen in a suitable flavoured vehicle.\nNaproxen Oral Suspension contains not less than 90.0 per \ncent and not more than 110.0 per cent of the stated amount of \nnaproxen, Ci4Hi4O3.. >\nUsual strength. 25 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/naproxen","@type":"IndexedMonograph","prefLabel":{"en":"Naproxen"},"edition":"ip-2022","category":"monographs","definition":{"en":"Naproxen\n2.^ \nch3\nC14H14O3 \nMol. Wt. 230.3\nNaproxen is (2S)-2-(6-methoxynaphthalen-2-yl)propionic acid.\nNaproxen contains not less than 99.0 per cent and not more \nthan 101.0 per cent of Ci4H]4O3, calculated on the dried basis.\n3030\nNAPROXCINOD\nIP 2022\nCategory. Nonsteroidal antiinflammatory.\nDescription. A white or almost white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/narcotine","@type":"IndexedMonograph","prefLabel":{"en":"Narcotine"},"edition":"ip-2010","category":"monographs","definition":{"en":"Narcotine\nMol. Wt. 413.4\n1798\nwww.webofpharma.com\nIP 2010\nNoscapine is (38)-6,7-dimethoxy-3-[(5R)-5,6,7,8-tetrahydro-\n4-methoxy-6-methyl-1,3-dioxolo[4,5-g]isoquinolin-5-\nyl]phthalide, an alkaloid obtained from opium.\nNoscapine contains not less than 98.5 per cent and not more\nthan 100.5 per cent ofC22H23N07, calculated on the dried basis.\nCategory. Cough suppressant.\nDose. 15 to 30 mg three to four times daily.\nDescription. Colourless crystals or awhite crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/natamycin-ophthalmic-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Natamycin Ophthalmic Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Natamycin Ophthalmic Suspension\nNatamycin Ophthalmic Suspension is a sterile aqueous\nsolution of Natamycin in a suitable aqueous vehicle.\nNatamycin Ophthalmic Suspension contains not less than \n90.0 per cent and not more than 125.0 per cent of the labeled \namount of C33H47NO13. It contains one or more suitable \npreservatives.\nUsual strengths. 5.0 per cent w/v."}},{"@id":"https://www.openphar.org/data/ip/monographs/natamycin","@type":"IndexedMonograph","prefLabel":{"en":"Natamycin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Natamycin\nC33l I47NO13 . / \n, \n’\\ Mol. Wt. 665.7\nCategory. Antibacterial.\nNatamycin is stereoisomer of (VR^S^RflRfiEf 2R, 14£, 1 EE,\n18£,20/?,22^24S,25/?,26S)-22-f(3-Amino-3,6-dideoxy- \nD-mannopyfanosyi)oxy]-1,3,26-trihydroxy-12-methyl-\n10-oxo-6,IL28-trioxatricyclo[22.3. L05,7]octacosa8; 14,1'6,1 8,20- \npentaene-25-carboxylic acid. ■ \n. .\nNatamycin contains not less than 90,0 per cent and not more \nthan 102.0 per cent of C?3 [[47iNO , calculated on the anhydrous \nbasis. .. \n•_ \n......\n3034\nNATAMYCIN\nIP. 2022\nDescription: A white to yellow, crystalline powder... ,"}},{"@id":"https://www.openphar.org/data/ip/monographs/nebivolol-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Nebivolol Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nebivolol Hydrochloride\nC22H25F2NO4,HC1 \n. Mol. Wt, 441.9\nNebivolol Hydrochloride is (1/tf,1 'RS)- 1,1 ’-[(2^,2'67?)-bis (6-\nflurochroman-2-yl)]-2,2'-iminodiethanol hydrochloride. .\nNebivolol Hydrochloride contains not less than 98.0 per cent \nand not more than 102.0 per cent of C22H25F2NO4,HC1, \ncalculated on the anhydrous basis.\n3035\nwww.webofpharma.com\nCategory. Antihypertensive.: \n;\nDescription. A white to off-white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/negative","@type":"IndexedMonograph","prefLabel":{"en":"Negative"},"edition":"ip-2018","category":"monographs","definition":{"en":"Negative\nz to  Anti-D (IgM)\n(Monoclonal)\npotency value greater than or equal to that of suitable reference \nstandard.\nReactivity\nAnti-lluman Globulin Serum\nType of Reagent Test Red \t\nTitre \nBlood Cells Immediate At 37° for\nHaemolysis. It is defined as the release of hemoglobin from \nthe red cells as a result of osmotic effect or due to the breaking \nup of the red blood cells. No immune haemolysis should be \nobserved with the red blood cells used for specificity.\nAnti-Human Globulin Serum is a sterile. liquid preparation of \nserum produced by immunizing lower animals such as rabbits \nor goats with human serum or plasma, or with selected human \nplasma proteins. It is free from agglutinins and from hemolysins \nto nonsensitized human red cells of all blood groups. It \ncontains a suitable antimicrobial preservative.\nspin \t\n30 minutes\nAnti-D (IgM) \t\nO+ve \t\n1:>_64-128 1: 128-256 \n(Monoclonal) (R ir or R1R2)\nType  of Reagent \t\nTest Red Blood Cells Haemolysis\nAvidity. It is defined as the time taken for agglutination to \nappear first to the unaided eye when 1 volume of the Anti-1)\nAnti-D (IgM) \t\n0 +ve (kr or RIR2)"}},{"@id":"https://www.openphar.org/data/ip/monographs/nelfinavir-mesylate-oral-powder","@type":"IndexedMonograph","prefLabel":{"en":"Nelfinavir Mesylate Oral Powder"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nelfinavir Mesylate Oral Powder\nNelfinavir Mesylate Oral Powder contains not less than\n90.0 per cent and not more than 110.0 per cent of the stated \namount of nelfinavir, C32H45N3O4S.\nUsual strength. 50 mg per g."}},{"@id":"https://www.openphar.org/data/ip/monographs/neomycin-sulphate-eye-ointment","@type":"IndexedMonograph","prefLabel":{"en":"Neomycin Sulphate Eye Ointment"},"edition":"ip-2022","category":"monographs","definition":{"en":"Neomycin Sulphate Eye Ointment\nNeomycin Sulphate Eye Ointment is a sterile preparation \ncontaining Neomycin Sulphate in a suitable base.\nNeomycin Sulphate Eye Ointment contains not less than\n90.0 per cent and not more than 115.0 per cent of the stated \namount of neomycin sulphate.\nUsual strength. 0.35 per cent w/v of neomycin."}},{"@id":"https://www.openphar.org/data/ip/monographs/neomycin-sulphate","@type":"IndexedMonograph","prefLabel":{"en":"Neomycin Sulphate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Neomycin Sulphate\nNeomycin Sulphate is a mixture ofthe sulphates ofsubstances\nobtained by the growth of certain selected strains of\nStreptomyces fradiae.\nNeomycin Sulphate has a potency of not less than 600 Units\nper mg, calculated on the dried basis.\nCategory. Antibacterial (topical and systemic).\nDose. 1 g every 4 hours.\nDescription. A white or yellowish-white powder; odourless\nor almost odourless; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/neostigmine-bromide","@type":"IndexedMonograph","prefLabel":{"en":"Neostigmine Bromide"},"edition":"ip-2010","category":"monographs","definition":{"en":"Neostigmine Bromide\nMol. Wt. 303.2\nNeostigmine Bromide is 3-(dimethylcarbamoyloxy)\ntrimethylanilinium bromide.\nNeostigmine Bromide contains not less than 98:0 per cent and\nnot more than 101.0 per cent ofClzH19BrNzOz, calculated on\nthe dried basis.\nCategory. Anticholinesterase.\nDose. 15 to 30 mg, repeated at suitable intervals; total daily\ndose, 75 to 300 mg.\nDescription. Colourless crystals or a white, clystalline powder;\nodourless; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/neostigmine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Neostigmine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Neostigmine Injection\nNeostigmine Methylsulphate Injection\nNeostigmine Injection is a sterile solution of Neostigmine \nMethylsulphate in Water for Injections.\nNeostigmine Injection contains not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nneostigmine methylsulphate, Ci3H22N2O6S.\nUsual strengths. 0.5 mg per ml; 2.5 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/neostigmine-methylsnlphate","@type":"IndexedMonograph","prefLabel":{"en":"Neostigmine Methylsnlphate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Neostigmine Methylsnlphate\nMol. Wt. 334.4\nNeostigmine Methylsulphate is 3-(dimethylcarbamoyloxy)-\ntrimethylanilinium methyl sulphate.\nNeostigmine Methylsulphate contains not less than 98.5 per\ncent and not more than 101.0 per cent of CI3H22N206S,\ncalculated on the dried basis.\nCategory. Anticholinesterase.\nDose. By subcutaneous or intramuscular injection, 1 to 2.5\nmg, repeated at suitable intervals; total daily dose,S to 20 mg.\nDescription. Colourless crystals or a white, crystalline powder;\nhygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/neostigmine-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Neostigmine Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Neostigmine Tablets\nDescription. Colourless crystals or a white, crystalline powder; \nodourless; hygroscopic.\nNeostigmine Bromide Tablets\nIf necessary the tetrahydrofuran and water content of the \nmobile phase may be adjusted so that the chromatogram \nobtained with reference solution shows resolution similar to \nthat:in-the specimen chromatogram supplied withfi-amycetin \nsulphate RS. The mobile phase should be passed through the \ncolumn for several hours before the solutions are injected.\nNeostigmine Bromide Tablets contain not less than 92.5 per \ncent and not more than 107.5 per cent of the stated amount  of \nneostigmine bromide, C l2HRrN \n19-- - 2 - 2."}},{"@id":"https://www.openphar.org/data/ip/monographs/neotame","@type":"IndexedMonograph","prefLabel":{"en":"Neotame"},"edition":"ip-2022","category":"monographs","definition":{"en":"Neotame\nC,0H30N2Os ... \n.. \n. ' Mol.Wt.378.4\nNeotame is JV-(3,3-dimethylbutyl)-L-a-aspartyl-L? \nphenylalanine 2-methyl ester.\n'Neotame contains not less than 97.0 per cent arid not more \nthan 102.0 per cent of C20H30N2O3, calculated bn the anhydrous \nbasis. \n\" ;\nCategory. Non-nutritive sweetener.\nDescription. A white crystalline powder. \nf <"}},{"@id":"https://www.openphar.org/data/ip/monographs/netilmicin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Netilmicin Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Netilmicin Injection\nNetilmicin Sulphate Injection\nNetilmicin Injection is a sterile solution of Netilmicin Sulphate\nin Water for Inj ections.\nNetilmicin Injection contains not less than 90.0 per cent and \nnot more than 115.0 per cent of the stated amount of netilmicin, \nQJUNA. \n■■■■■■■\nUsual strengths. 10 mg per ml; 25 mg per ml; 5 0 pig per ml;\nlOOmgperml. \n?"}},{"@id":"https://www.openphar.org/data/ip/monographs/nevirapine-oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Nevirapine Oral Suspension"},"edition":"ip-2010","category":"monographs","definition":{"en":"Nevirapine Oral Suspension\nNevirapine Oral Suspension is a suspension ofNevirapine in\na suitable flavoured vehicle.\nNevirapine Oral Suspension contains not less than 90.0 per\ncent and not more than 110.0 per cent ofthe stated amount of\nnevirapine, ClsH14N40.\nUsual strength. 50 mg in 5 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/nevirapine","@type":"IndexedMonograph","prefLabel":{"en":"Nevirapine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nevirapine\nC15H14N4O ' \nMol.;Wt 266.3\n(anhydrous)\nCi5H14N4O. /2H2O \nMol. Wt. 275.3\n(hemihydrate)\nNevirapine is 1l-cyclopropyl-5,1 l-dihydro~4-methy-6//-\ndipyrido[3,2-£:2',3'-e][l,4]diazepin-6-one. \n. \n:\nNevirapine is anhydrous or contains one-half molecule of water \nof hydration. It contains not less than 9.8.0 per cent and not \nmore than 102,0 per cent of C!5Hi4N4O, calculated on the \nanhydrous basis.\nCategory. Antiretroviral. \n. \n. . „\nDescription. A white or almost white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/niacin","@type":"IndexedMonograph","prefLabel":{"en":"Niacin"},"edition":"ip-2018","category":"monographs","definition":{"en":"Niacin\nCOON\nC61-15NO2 \t\nMol. Wt. 123.1\nNicotinic Acid is pyridine-3-carboxylic acid.\nNicotinic Acid contains not less than 99.5 per cent and not \nmore than 100.5 per cent of C 6H5NO2, calculated on the dried \nbasis.\nCategory. B-group vitamin.\nDose. Prophylactic, 15 to 30 mg daily; therapeutic, 50 to \n250 mg daily.\nDescription. A white or creamy-white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/niacinamide","@type":"IndexedMonograph","prefLabel":{"en":"Niacinamide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Niacinamide\nCg«.\no\nWO \nMol. Wt 122.1\nNicotinamide is pyridine-3-carboxamide.\nNicotinamide contains not less than 99.0 per cent and not\nmore than 101.0 per cent of C()H6N2O, calculated on the dried \nbasis.\nCategory. B-group vitamin.\nDescription. Colourless crystals or a white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nicardipine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Nicardipine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nicardipine Hydrochloride\nC26H29N3O6,HCI \nMol.Wt.516.0.\nNicardipine Hydrochloride is 3,5-pyridinedicarboxylic acid, 1, \n4-dihydro-2,6-dimethyi-4-(3-nitrophenyl)-, methyl2- \n[methyl(phenylmethyl)amino]ethyl ester,monohydrochlpri de.\nNicardipine Hydrochloride contains not less than 98.0 per \ncent and not more than 101.0 per cent of C26H29N3O6,HC1 \ncalculated on the dried basis. \n.,\n3052\nNEVIRAPINE TABLETS\nIP 2022\nCategory. Antihypertensive. \n. A\nDescription. A greenish yellow crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nicorandil","@type":"IndexedMonograph","prefLabel":{"en":"Nicorandil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nicorandil\no . .. .\nn^\\xONO2\nH\nC8H9N3O4 ■ /. J :. . \n.. Mol. Wt. 211.2\nNicorandil is 2-(3 -Pyridinecarboxamido)ethyl nitrate.\nNicorandil contains not less than 98.0 per cent and not more \nthan; 102.0 per cent of C8H^N3O4, calculated on the anhydrous \nbasis/ ■ ■ \\ \n■ \"■-■ '■ \n; ■■\nCategory. Selective ATP dependent potassium channel opener.\nDescription. A white to off white powder. :"}},{"@id":"https://www.openphar.org/data/ip/monographs/nicotinamide","@type":"IndexedMonograph","prefLabel":{"en":"Nicotinamide"},"edition":"ip-2010","category":"monographs","definition":{"en":"Nicotinamide\nNOyNH2\no\nC6H6N20\nMol. Wt. 122.1\nNicotinamide ispyridine-3-carboxamide.\nNicotinamide contains not less than 99.0 per cent and not\nmore than 101.0 per cent ofC6H6N20, calculated on the dried\nbasis.\nCategory. B-group vitamin.\nDose. Orally, prophylactic, 15 to 30 mg daily; therapeutic, 50\nto 250 mg daily. By intravenous injection,.50 to 250 mg daily.\nDescriptioR Colourless crystals or a white, crystalline powder;\nodour, faint and characteristic.\n1775\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/nicotinic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Nicotinic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nicotinic Acid\nNiacin\n. cooh '\nC^NO, \n■ Mol.Wt.123.1\nNicotinic Acid is pyridine-3-carboxylic acid. \n?; \"!\nNicotinic Acid contains not less than 99.5 per cent and not \nmqre than 100.5 per cent of C6H$NO2, calculated on the dried \nbasis. ’ \n. . i ..\nCategory. B-group vitamin. \n■\nDescr iption. A white or creamy-white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nicoumalone","@type":"IndexedMonograph","prefLabel":{"en":"Nicoumalone"},"edition":"ip-2010","category":"monographs","definition":{"en":"Nicoumalone\nNOz\n1777\n°\nMol. Wt. 353.3\nNICOUMALONE\nNicoumalone is (RS)-4-hydroxy-3-[1-(4-nitrophenyl)-3-\noxobutyl]coumarin.\nNicoumalone contains not less than 98.5 per cent and not\nmore than 100.5 percent ofC19HlsN06, calculated on the dried\nbasis.\nCategory. Anticoagulant.\nDose. Initial dose, first day, 8 to 12 mg; second day, 4 to 8 mg;\nmaintenance dose, 1 to 8 mg daily.\nDescription. A white to brownish-white powder; odourless or\nalmost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/nifedipine","@type":"IndexedMonograph","prefLabel":{"en":"Nifedipine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nifedipine\nNifedipine is dimethyl l,4-dihydro-2,6-dimethyl- \n4-(2-nitrophenyl)pyridine-3,5-dicarboxylate.\n3060\nNICOUMALONE TABLETS\nIP 2022\nNifedipine contains riot less than 98.0 per cent and notmore \nthan 102.0 pen cent of C77Hi8NT)(i, calculated on the dried \nbasis. \n...NN\nCategory. Antianginal (calcium channel blocker). \n;\nDescription. A yellow, crystalline powder; readily affected by \nexposure to light.\nNOTE — Nifedipine, when exposed to daylight and certain \nwavelengths of artificial light, readily coriyerts to a \nnitrosophenyl derivative. Exposure to ultraviolet light leads \nto the formation of a nitrophenyl derivative. Perform the \ntests and assay in the dark or under long-wavelength light \n(greater than 420 nm).' Use low-actinic glassware."}},{"@id":"https://www.openphar.org/data/ip/monographs/nikethamide-injection","@type":"IndexedMonograph","prefLabel":{"en":"Nikethamide Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Nikethamide Injection"}},{"@id":"https://www.openphar.org/data/ip/monographs/nikethamide","@type":"IndexedMonograph","prefLabel":{"en":"Nikethamide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nikethamide\nN _/CH3\nO\nC10Hi4N2O \nMol. Wt. 178.2\nNikethamide is A;,A-diethylpyridine-3-carboxamide.\nNikethamide contains not less than 99.0 per cent and notmore \nthan 101.0 per cent of CioH14N20, calculated on the anhydrous \nbasis.\nCategory. CNS and Respiratory stimulant.\nDescription. A colourless or slightly yellowish, oily liquid or \ncrystalline mass."}},{"@id":"https://www.openphar.org/data/ip/monographs/nimbukatail","@type":"IndexedMonograph","prefLabel":{"en":"Nimbukatail"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nimbukatail\nLime Oil is obtained by centrifuging the emulsion of juice and \noil obtained by. crushing the whole fruits of Citrus aurantiifolia \n(Christman) Swingle,(Fam.Rutaceae).\nLime Oil contains not less than 45.0 per cent and not more \nthan 60.0 per cent of D-limohene; and not less than lO.Oper \ncent and not more than 20.0 per cent of y-terpinene.\nDescription. A clear, amber green to dark green liquid, free \nfrom sediment, suspended matter and characteristic odour."}},{"@id":"https://www.openphar.org/data/ip/monographs/nimodipine","@type":"IndexedMonograph","prefLabel":{"en":"Nimodipine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nimodipine\nMol.Wt.418.4\n3068\nNIKETHAMIDE INJECTION\nIP. 2022;\nNimodipine is; 2-methoxyethyl 1-methylethyl (47?(9)-2<6- \ndimethyl-4-(3-nitrophenyl)-l,4-dihydropyridine-3.,:5- \ndicarboxylate. \\ \n-A\nNimodipine contains not less than 98.5 per cent and not more\nthan 101.5 per cent of C2!H26N2O7, calculated on the dried \nbasis. \n, . , \n■\nCategory. Calcium channel blocker.\nDescription. A light yellow or yellow, crystalline powder. It \nshows polymorphism (2.5.11). Exposure to ultraviolet light \nleads to the formation of a nitrophenylpyridne derivative."}},{"@id":"https://www.openphar.org/data/ip/monographs/nirgundi","@type":"IndexedMonograph","prefLabel":{"en":"Nirgundi"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nirgundi\nSambhalu, Mewri, Nisirida, V'itex neguhdo\n4270\nNIRGUNDI\nIP 2022 3\nNirgundi contains not less than 0.3 per cent, w/w of \nnegundoside calculated on the dried basis. : ; \n- .\nCategory. Analgesic, anti-inflammatory and antirheumatic ;\nDescription. Green to brownish coloured leaves and having \ncharacteristic odour. : \n\" \n; . ;"}},{"@id":"https://www.openphar.org/data/ip/monographs/nirman-bhawan","@type":"IndexedMonograph","prefLabel":{"en":"Nirman Bhawan"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nirman Bhawan\nNewDelhi-110011.\n(ShriRajesh Bhushan)\n(ShriN.Yuvaraj) \n. ;\nCo-\nThe Chairperson, Scientific Body, IPC\nChairperson Former Director General, 1CMR\nC-191,9th Floc r, City View Apartment\nPlot No. 199. Sector-35\nNirmanBhawan \nNewDelhi-110011.\nNoida-201301.\nMember\n(ex-officio)\nNirmanBhawan \nNew Delhi-1 iOOll.\nThe Additional Secretary & Financial Advisor \nMinistry of Health & Family Welfare r.\nThe Director\n.NirmanBhawan ;\n(ex-officio)\nNational Institute of Biological? ..\nNewDelhi-110011.; ■\nA-32, Sector-62, InstitutionalArea \nNoida-201 309.\n(Shri Ashish Srivastava) ■ ■■ ■■ \n:\n(Dr. AnupAnvikar) .\n.. Member\nThe Additional Secretary (Drugs)\n. - (ex-officio)\nMinistry of Health\n*\n Family Welfare\nMember\nThe President :\nNirmanBhawan • \n. • \n.............. .\nPharmacy Council of India. \nNBCC Centre, 3rdFlcor ,,'.\nNewDelhi-110011. . \n.\n(SmtRoli Singh)\nMaa Anandamai Marg,\nMember\nThe Joint Secretary (Regulations) ,\nOkhla Phase H \n■\n(ex-officio)\nMinistry of Health & Family Welfare\nNew.Delhi-110 020.\nNirnran Bhawan 1 ' \n'\n(Dr. Mandeep Kumar Bhandari)\nC&MD\nMember\nThe Joint Secretary '\nZydus Cadila Healthcare Ltd,\n(ex-officio)\nDepartment of Pharmaceuticals \n■. :.\nZydus Tower, 6th Fl oof ■\nMinistry of Chemicals.and Fertilizers :\n(ShriN.Yuvaraj)\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/nitofiiral","@type":"IndexedMonograph","prefLabel":{"en":"Nitofiiral"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nitofiiral \n/ .. \n>\nCyWA \nMol. Wt. 198.1\nNitrofurazone is 5-nitro-2-fiiraldehyde semicarbazone.\nNitrofurazone.contains, not less than 97.0 per cent and not \nmore than 103.0 per cent of C6I I6N4Ck calculated on the dried \nbasis. \n. \n■ ' '\nCategory. Antibacterial.\nDescription. Ayellow to brownish-yellow, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nitofural","@type":"IndexedMonograph","prefLabel":{"en":"Nitofural"},"edition":"ip-2010","category":"monographs","definition":{"en":"Nitofural\nC6H6N40 4\nMol. Wt. 198.1\nNitrofurazone is 5-nitro-2-furaldehyde semicarbazone.\nNitrofurazone contains not less than 97.0 per cent and not\nmore than 103.0 per c.ent ofC6H6N40 4, calculated on the dried\nbasis.\nCategory. Antibacterial.\nDescription. Ayellow to brownish-yellow, crystalline powder;\nodourless or almost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/nitrazepam","@type":"IndexedMonograph","prefLabel":{"en":"Nitrazepam"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nitrazepam\nC.sHhNT); ■ . \nMol.Wt.281.3\nNitrazepam is 1,3-dihy dr o-7-nitro-5-phenyl-277-1,4-\nbenzodiazepin-2-one. ’! .• \n;\nNitrazepam contains not less than 99.0 per cent and not more \nthan 101.0 per cent C15H4 jN3O3, calculated on the dried basis\nCategory. Hypnotic; sedative.\nDescription. Ayellow, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nitrofurantoin","@type":"IndexedMonograph","prefLabel":{"en":"Nitrofurantoin"},"edition":"ip-2010","category":"monographs","definition":{"en":"Nitrofurantoin\nCgH6N40 S\nMol. Wt. 238.2 (anhydrous)\nCgH6N40S,HzO\nMol. Wt. 256.2 (hydrous)\nNitrofurantoin is 1-(5-nitrofurfurylideneamino)imidazolidine-\n2,4-dione. It is anhydrous or contains one molecule ofwater\nof hydration.\nIP 2010\nNitrofurantoin contains not less than 98.0 per cent-and not\nmorethan 102.0 per cent ofCgH6N40 s, calculated on the dried\nbasis.\nCategory. Antibacterial.\nDose. 50 to 100 mg four times daily.\nDescription. Lemon yellow crystals or a crystalline powder;\nodourless or almost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/nitroglycerin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Nitroglycerin Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nitroglycerin Injection\nDiluted Glyceryl Trinitrate Injection\nNitroglycerin Injection is a sterile solution, of Diluted \nNitroglycerin, which may contains alcohol and propylene \nglycol in Water for Injections.\nNitroglycerin Injection contains not less than 90.0 per cent\nand not more than 110.0 per cent of the stated amount of \nnitroglycerin, C3H5N3O9.\nDescription. A clear colourless solution.- ,\nUsual strengths. 5 mg per 5 ml; 5 mg per 10 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/nitrous-oxide","@type":"IndexedMonograph","prefLabel":{"en":"Nitrous Oxide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nitrous Oxide\nNT) ■ \n••...■ Mol. Wt. 44.0\nNitrous Oxide contains not less than 98.0 per cent v/v of N2O.\nNOTE — Carry out thefollowing tests on a full cylinderfrom \nwhich no gas has been withdrawn. The cylinder from which \nthe gas is' taken should'be kept at room temperature for not \nless than 6 hours before carrying out the tests. Keep the \ncylinder in the vertical position with the outlet valve \nuppermost and deliver the gas at a rate of 4. litres per hour, \nunless 'otherwise directed,. The. test for Carbon monoxide \nshould be carried out on the first portion of gas drawn from\nthe cylinder and that for Nitric oxide '■ arid' h itrbgen dioxide \nimmediately thereafter.\nCategory. General anaesthetic.\nDescription. A colourless gas."}},{"@id":"https://www.openphar.org/data/ip/monographs/nitroxynil-injection","@type":"IndexedMonograph","prefLabel":{"en":"Nitroxynil Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Nitroxynil Injection\n(Human) \nJapanese Encephalitis Vaccine\nHaemorrhagic Septicaemia Vaccine,\nDivalproex Sodium \nDocetaxel Anhydrous\nInactivated\nInactivated (Adsorbed, Human) \nKetorolac Tromethamine \nLabetalol Injection \nLactic Acid \nLatanoprost \nLevamisole Injection \nLevetiracetam \nLevocetirizine Tablets \nLevodropropizine \nLevofloxacin Infusion \nLevofloxacin Injection \nLevonorgestrel and Ethinyloestradiol\nHeparin Injection\nDoxofylline \nDoxorubicin Injection \nDuloxetine Gastro-resistant Tablets \nEgg Drop Syndrome'76 (Adenovirus)\nHeparin Sodium \nHepatitis A (Inactivated) and Hepatitis\nB (rDNA) Vaccine (Adsorbed)\nHuman Albumin\nVaccine, Inactivated\nHuman Normal Immunoglobulin\nOfloxacin\nEnrofloxacin \nEnterotoxaemia Vaccine, Inactivated \nErgotamine Injection \nEsmolol Hydrochloride \nEthacrynic Acid \nEthanolamine \nEtoposide \nFibrin Sealant Kit\nHuman Normal Immunoglobulin for\nOfloxacin Oral Suspension \nOfloxacin Tablets \nOlmesartan Medoxomil \nOndansetron Hydrochloride \nOndansetron Orally Desintegrating\nIntravenous use\nHuman Plasma Protein Fraction \nHydrochlorothiazide \nHydrochlorothiazide Tablets \nHydroxychloroquine Tablets \nHydroxypropylmethyl Cellulose \nHyoscine Butylbromide \nHyoscine Butylbromide Injection \nHyoscine Butylbromide Tablets \nHyoscine Hydrobromide \nHyoscyamine Sulphate \nIfosfamide Injection\nTablets \nOral Rehydration Salts \nOrphenadrine Citrate \nOrphenadrine Hydrochloride \nOxytetracycline Hydrochloride\nTablets \nLevosalbutamol Sulphate \nLiquid Maltitol \nMarek's Disease Vaccine, Live \nMeasles and Rubella Vaccine (Live) \nMeasles Vaccine (Live) \nMeasles, Mumps and Rubella Vaccine\nFilgrastin concentrated solution \nFenspiride Hydrochloride \nFinasteride\nInjection \nOxytetracyclineDihydrate Injection \nOxytocin \nOxytocin Injection \nParacetamol Infusion"}},{"@id":"https://www.openphar.org/data/ip/monographs/nitroxynil","@type":"IndexedMonograph","prefLabel":{"en":"Nitroxynil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nitroxynil\nNOs\n- CN\nC,H;IN20; \n. \n:Mol. Wt-290.0\nNitroxynil is 4-hydroxy-3- iodo-5 5-nitrobenzonitrile.\nNitroxynil contains not less than 98.0 per: cent and not more \nthan 101. 0 per cent of C,HsIN,O;, calculated on the dried basis,\nCategory. Anthelmintic.\nDescription. A yellow to yellowish brown powder,"}},{"@id":"https://www.openphar.org/data/ip/monographs/nlethod","@type":"IndexedMonograph","prefLabel":{"en":"Nlethod"},"edition":"ip-2018","category":"monographs","definition":{"en":"Nlethod\nAcid-insoluble ash (2.3.19). Not more than 1.0 per cent.\nDetermine by liquid chromatography (2.4.14.).\nHeavy metals (2.3.13). 1.0 g complies with the limit test for \nheavy metals, Method B (20 ppm).\ncolour. They have a slightly characteristic odour and the taitte \nDescription. The roots are cylindrical, yellowish brown%\nTest solution. Boil under reflux 1.0 g of the coarsely powdered \nsubstance under examination with 40 ml of 0.1 per cent v/v \nsolution of strong ammonia solution in methanol for \n30 minutes, cool and filter. Boil under reflux the residue with \nfurther 2 quantities, each of 30 ml, of 0.1 per cent v/v strong \nammonia solution in methanol, cool and filter. Combine all \nthe filtrates and dilute to 100 ml with 0.1 per cent v/v solution \nofstrong ammonia solution in methanol. Dilute 5.0 ml of this \nsolution to 50 ml with 0.1 per cent v/v strong ammonia solution \nin methanol.\nLoss on drying (2.4.19). Not more than 10.0 per cent determined \non 5.0 g by drying in an oven at 105°.\nis hitter."}},{"@id":"https://www.openphar.org/data/ip/monographs/noradrenaline-bitartrate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Noradrenaline Bitartrate Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Noradrenaline Bitartrate Injection\nNoradrenaline Acid Tartrate Injection; Noradrenaline\nInjection; Levarterenol Bitartrate Injection; \nNorepinephrine Bitartrate Injection\nNoradrenaline Bitartrate Injection is a sterile \n\tof \nNoradrenaline Bitartrate. It is prepared by;tlfluting Sterile\n•"}},{"@id":"https://www.openphar.org/data/ip/monographs/noradrenaline-bitartrate","@type":"IndexedMonograph","prefLabel":{"en":"Noradrenaline Bitartrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Noradrenaline Bitartrate\nNoradrenaline Acid Tartrate; Levarterenol Bitartrate;\nNorepinephrine Bitartrate\nC8HI1NO3,C4H6O6Ji2O. \nMol. Wt. 337.3\nNoradrenaline Bitaftrate is (R)-2-amino-l-(3,4-dihydroxy- \nphenyl) ethanol tartrate monohydrate.\nNoradrenaline Bitartrate contains not less than 98.5 per cent \nand not more than 101.0 per cent of Cdlr;NO3.CJ-l6O6. \ncalculated on the anhydrous basis.\nCategory. Sympathomimetic.\nDescription. A white or almost white, crystalline powder. It \ngradually darkens on exposure to air and light."}},{"@id":"https://www.openphar.org/data/ip/monographs/norethindrone","@type":"IndexedMonograph","prefLabel":{"en":"Norethindrone"},"edition":"ip-2010","category":"monographs","definition":{"en":"Norethindrone\nOH\n-C=CH\no\nMol. Wt. 298.4\nNorethisterone is 17~-hydroxy-19-nor-17 a-pregn-4-en-20-yn-\n3-one.\nwww.webofpharma.com\nNORETHISTERONE\nNorethisterone contains not less than 98.0 per cent and not\nmore than 102.0 per cent ofCZOHZ60Z, calculated on the dried\nbasis.\nCategory. Progestogen.\nDose. 5 to 20 mg daily, in single or divided doses.\nDescription. A white or yellowish-white, crystalline powder;\nodourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/norfloxacin-eye-drops","@type":"IndexedMonograph","prefLabel":{"en":"Norfloxacin Eye Drops"},"edition":"ip-2018","category":"monographs","definition":{"en":"Norfloxacin Eye Drops\n22 \n95 \n5\nThe relative retention time with reference to norfloxacin for \nnorfloxacin impurity E (7-chloro-l-ethy1-4-oxo-6-(piperazin-\nCategory. Antibacterial.\nNorfloxacin Eye Drops are a sterile solution of Norfloxacin in \nPurified water.\nDose. 400 mg to 800 g daily, in divided doses.\n1-y1)-1,4-dihydroquinoline-3-carboxylic acid )is about 0.97, for \nnorfloxacin impurity A (7-chloro- 1 -ethy1-6-fluoro-4-oxo-\nNorfloxacin Eye Drops contain not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of \nnorfloxacin, C I6H 18FN303.\nDescription. A white to pale yellow, crystalline powder.\n1,4-dihydroquinoline-3-carboxylic acid) is about 1.5 and for \nnorfloxacin impurity H (7-[4-(ethoxycarbonyl)piperazin-l-y1]-"}},{"@id":"https://www.openphar.org/data/ip/monographs/norfloxacin","@type":"IndexedMonograph","prefLabel":{"en":"Norfloxacin","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Norfloxacin\nC16H18FN3O3 \nMol. Wt. 319.3\nNorfloxacin is 1 -ethyl-6-fluoro-4-oxo-7-(piperazin-1 -y1)-1,4- \ndihydroquinoline-3-carboxylic acid.\nNorfloxacin contains not less than 99.0 per cent and not more \nthan 101.0 per cent of Ci6Hi8FN3O3, calculated on the dried \nbasis.\nCategory. Antibacterial.\nDescription. A white to pale yellow, crystalline powder.\nNORFLOXACIN"}},{"@id":"https://www.openphar.org/data/ip/monographs/norgestimate-and-ethinyl-estradiol-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Norgestimate and Ethinyl Estradiol Tablets"},"edition":"ip-2022","category":"monographs","definition":{"en":"Norgestimate and Ethinyl Estradiol Tablets\nNorgestimate and Ethinyl Oestradiol Tablets contain not less \nthan 90.0 per cent and not more than 110.0 per cent of the \nstated amounts of norgestimate, C23H31NO3, and ethinyl \nestradiol, C20H24O2.\nCategory. Oral contraceptive.\nUsual strengths. Norgestimate, 180 pg and Ethinyl Oestradiol, \n35 pg; Norgestimate, 215 pg and Ethinyl Oestradiol, 35 pg; \nNorgestimate, 250 pg and Ethinyl Oestradiol, 35 pg."}},{"@id":"https://www.openphar.org/data/ip/monographs/norgestrel","@type":"IndexedMonograph","prefLabel":{"en":"Norgestrel"},"edition":"ip-2022","category":"monographs","definition":{"en":"Norgestrel\nC21H28O2 \nMol. Wt. 312.5\nNorgestrel is rac-13-ethyl-l 7-hydroxy-l 8,19-dinor-17a-pregn- \n4-en-20-yn-3-onc.\nNorgestrel contains not less than 98.0 per cent and not more \nthan 102.0 per cent of C2iH28O2, calculated on the dried basis.\nCategory. Progestogen. ;\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/nortriptyline-hydrochloride-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Nortriptyline Hydrochloride Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Nortriptyline Hydrochloride Tablets\nDescription. A white to off-white powder; odour slight and \ncharacteristic.\nNortriptyline Tablets contain less than 90.0 per cent and not \nmore than 110.0 per cent of the stated amount of nortriptyline, \nC 19H2IN. The tablets are coated.\nNortriptyline impurity A' \t\n0.5\nNortriptyline impurity D2 \t\n0.8 \t\n1.7"}},{"@id":"https://www.openphar.org/data/ip/monographs/nortriptyline-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Nortriptyline Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nortriptyline Hydrochloride\nC19H21N,IIC1 ■ \n. - \nMol.Wt.299.8\nNortriptyline Hydrochloride is 3-( 10,11 -dihydro-5/7-dibenzo \n[a,^]cyclohept-5-ylidene)propyl(methyl)amine hydrochloride.\nNortriptyline Hydrochloride contains not less than 98.0 per\ncent and not more than 101.5. per eentofC19H2iN,H,Cl, calculated \non the dried basis.\nCategory. Antidepressant.\nDescription. A white to off-white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/noscapine-linctus","@type":"IndexedMonograph","prefLabel":{"en":"Noscapine Linctus"},"edition":"ip-2010","category":"monographs","definition":{"en":"Noscapine Linctus\nNarcotine Linctus\nNoscapine Linctus is a solution of Noscapine in a suitable\nflavoured vehicle. Itmay contain up to 1per cent w/v solution\nofCitricAcid.\nNoscapine Linctus contains not less than 90.0 per cent and\nnot more than 110.0 per cent of the stated amount of\nnoscapine, C22H23N07'\nUsual strength. 7 mg per 5ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/noscapine","@type":"IndexedMonograph","prefLabel":{"en":"Noscapine"},"edition":"ip-2010","category":"monographs","definition":{"en":"Noscapine\n(Crystallizing)\nNystatin\nSoritol Solution (70 per cent) (Non-\nOfloxacin\ncrystallizing)\nOlanzapine\nSpironolactone\nSpironolactone Tablets\nOmeprazole\nOndansetron Tablets\nSodium Fusidate\nSodium Fusidate Capsules\nOxytocin\nOxytocin Injection\nSodium Propylparaben\nSodium Methylparaben\nOxytocin Nasal Solution\nPhenobarbitone\nMethylparaben\nPropylparaben\nPhenobarbitone Sodium\nParacetarnol\nStearyl Alcohol\nParacetarnol Tablets\nSucrose\nSulphacetamide Sodium\nSulphacetamide Eye drops\nDiluted Pentaerythritol Tetranitrate\nPentamidine Isethionate\nPentamidine Injection\nTalc\nPethidine Hydrochloride\nTerbutaline Tablets\nTheophylline\nPethidine Injection\nPhenolphthalein\nTheophylline Tablets\nThiamine Hydrochloride\nPhenylbutazone\nPiracetarn\nThiamine Nitrate\nTenofovir and Emtricitabine Tablets\nTerbutaline Sulphate\nPiroxicarn\nPolysorbate 20\nPolysorbate 80\nPotassium Iodide\nThiotepa\nTopirarnate Tablets\nPovidone\nVerapamil Hydrochloride\nVerapamil Tablets\nPrednisolone\nPropranolol Hydrochloride\nVessopressin Injection\nVincristine Sulphate\nPropranolol Injection\nPropranolol Tablets\nVmcristine Injection\nXylometazoline Hydrochloride\nPseudoephedrine Hydrochloride\nPyrantel Parnoate\nWarfarin Sodium\nWarfarin Sodium Clatharate\nZidovudine Tablets\nQuetiapine Fumarate"}},{"@id":"https://www.openphar.org/data/ip/monographs/novobiocin-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Novobiocin Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Novobiocin Sodium\nCHo\n^0^0. OH\no\nC31H35N2NaOii\nNovobiocin Sodium is the monosodium salt of novobiocin, \nA-[7-{3-0-(ariiinocarbonyl)-6-deoxy-5-C-methyl-4-(?-methyl-\nj3-L-Zyxo-hexopyranosyl)-oxy-4-hydroxy^8-methyl-2’-dxo- \n2H-1 -benzopyran-3-y 1] -4-hydroxy-3-(3 -methyl-2- butenyf)- \nbenzamide, an antimicrobial substance produced by the growth \nof certain strains of Streptomyces niveus or related organisms \nor by other means.-' '\nNovobiocin Sodium contains the equivalent of not less than\n850 pg bf novobiocin per mg, calculated’on the dried basis.\nCategory. Antibacterial.\nDescription. A white or yellowish white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ns-nu","@type":"IndexedMonograph","prefLabel":{"en":"Ns Nu"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ns Nu\n(XXU)2 \n2 u\n(ZXS)2\n1 \n_ Nu \nZXu\n£XS2-^\nNs\ns.\nu\nNs + Nu - 2\nNs and Nu are the numbers of animals treated with standard\nand unknown and L and E represent the summation of\nresults obtained with the two preparations. Fiducial limits are\ncalculated as\nantilog (M’ ± tsM«) \n.... (9)\nThe degrees of freedom for t are equal to (Ns + Nu - 2). The \nestimate of potency (R) is equal to antilog (M) where\nM = M’+logAu \n....(10)\nwith fiducial limits\nantilog (M ± t*sM) \n....(11)\nIn this way sM is equal to sMX Limits calculated by Equation 11 \nmay be expressed as percentage of the stated potency or as \npercentages of the estimated potency.\nIn a valid assay, the variance of Xs should be the same as that \nfor Xu, apart from sampling errors. If necessary this condition\nmay be tested by calculating the variances and dividing the \nlarger by the smaller, to obtain a variance ratio.\nThe variance of Xs is calculated from Equation 12\n2\nzx;--—\n2 \n* \nn\ns 2 =---------------\n....(12)\nNs-1\nand similarly for SX;;\nThe variance ratio (F) distribution is given in Table 6 but it \nshould be noted that for this test the upper values given \ncorrespond to P = 0.05, and the lower values to P = 0.01.\nExample 3 - Direct assay with digitalis using guinea-pigs\nPreparation\nEstimate of \nindividual lethal\nX = log lethal\ndose\ndose (ml/kg)\nStandard\n■ 1.12\n0.0492\nPreparation\n1.44\n0.1584\n(S)\n1.06\n0.0253\n1.14\n0.0569\n1.26\n0.1004\n1.20\n0.0792\nTotal\n5\n0.4694\nMean Xs\n^(0.4694)\n= 0.0782\nTest preparation\n1.24\n0.0934\n(U)\n1.38\n0.1399\n1.08\n0.0334\n1.41\n0.1492\n1.20\n0.0792\n1.09\n0.0374\nTotal SXU \nu\n0.5325\n-^■(0.5325)\nMean xu\n= 0.0888\nThe variance S 2 is calculated as\nS2 =-L < (0.0492)2 +...+ (0.0792)-\n< (0.0934)2 + ... + (0.0374)2 - (°-g25L\n6\n= 002310\n1189\nwww.webofpharma.com\n■ fl 1 \nFrom Equation-?, S(r =0.002310 ! + g\n=0.000770\nSo that sM, = 0.0277\nAt P= 0.05 with 10 degrees of freedom, t2.23 (Table 1)\nM' = 0.0782-0.0888 =-0.0106 = T.9894\nIf the concentrations of the two solutions are equal, as in this \nexample, then the assumed potency ratio equals unity and \nM = M'. Potency ratio (TesvStandard) - 0.98.\nFiducial limits to potency ratio\n= antilog [- 0.0106 ± (2.23) (0.0277)]\n= antilog 1.9276 and antilog 0.0512 =0.85 to 1.13\nIf the test concentration (mg/ml) had been twice that of the \nstandard, then the assumed potency ratio A would be 0.5. M \nwould then be equal to M' + log 0.5.\n5.7.7. Assays depending upon Measured Effects.\n5.7.7.I. Validity and other conditions\nThese tests involve the measurement of the effects of fixed \nquantities of drugs on individual biological systems, e.g. a \nwhole animal, isolated animal tissue or a culture of bacteria.\nEach treatment which consists of a fixed dose of a standard \n(sb s2) or of an unknown (u,. u2) to be assayed, is administered \nto a certain number (n) of experimental units (animals, cultures, \ntubes, etc.) and n responses are recorded, one per unit. The \nresponses (y) may . be increases in the weights of animals,\norgan weights, the sizes of zones of inhibition of bacterial \ngrowth, measurements of the turbidity of cultures, etc.\nThe methods of calculation described below may be used to\nevaluate the results of such assays provided that the following \nconditions are fulfilled.\n4. The experimental units have been randomly assigned to \nthe different treatments (Sections 5.7.4 and 5.7.7.2) -\n2. \nThe responses to each treatment are normally distributed.\n3. \nThe standard deviation of the response is independent \nof the level of response, i.e. is constant for each treatment.\n4. \nThe relationship between the logarithm of the dose and \nthe response can be represented by a straight line, over \nthe range of doses used.\n5. \nFor any test preparation in the assay? the straight line \n(defined in 4) must be parallel to that for the standard.\nIf conditions 3 and 4 are not met, it may be possible to remedy \nthe situation by using a different response metameter, i.e by \ntransforming the response, e.g. by taking its square or \nlogarithm before proceeding with the "}},{"@id":"https://www.openphar.org/data/ip/monographs/number-of-sites","@type":"IndexedMonograph","prefLabel":{"en":"Number of Sites"},"edition":"ip-2018","category":"monographs","definition":{"en":"Number of Sites\nDose \n(Al per site)\n(per animal)\ng of elastomer or 0.2 g of plastic or other polymers\n5\n200\n5\n200\n2.2.24. TEST FOR BIOLOGICAL REACTIVITY, IN VIVO\nExamine injection sites for evidence of any tissue reaction \nsuch as erythema, edema, and necrosis. Swab the skin lightly, \nif necessary, with diluted ethanol to facilitate reading of \ninjection sites. Observe all animals at 24, 48 and 72 hours after \ninjection. Rate the observations on a numerical scale for the \nextract of the sample and for the blank, using Table 2. Reclip \nthe fur as necessary during the observation period. The \naverage erythema and edema scores for sample and blank \nsites are determined at every scoring interval (24, 48 and 72 \nhours) for each rabbit or guinea pig. After the 72 hour scoring, \nall erythema scores plus edema scores are totalled separately \nfor each sample and blank.\nDivide each of the totals by 12 (2 animals x 3 scoring periods \nx 2 scoring categories) to determine the overall mean score for \neach sample versus each corresponding blank. The \nrequirements of the test are met if the difference between the \nsample and the blank mean score is 1.0 or less. If at any \nobservation period the average reaction to the sample is \nquestionably greater than the average reaction to the blank, \nrepeat the test using three additional rabbits or guinea pigs. \nThe requirements of the test are met if the difference between \nthe sample and the blank mean score is 1.0 or less.\nImplantation Test. The implantation test is designed for the \nevaluation of plastic materials and other polymeric materials \nin direct contact with living tissue. Of importance are the proper \npreparation of the implant strips and their proper implantation \nunder aseptic conditions. The intramuscular implantation test \nrequires healthy adult albino rabbits. The test specimens are \nplaced into needles as the delivery system for implantation.\nAlthough most materials lend themselves readily to this \nmethod, there are a number of materials that are unsuitable for \nintramuscular implantation. For materials with physical \ncharacteristics unsuitable for routine intramuscular \nimplantation, the subcutaneous rat implantation model is a \nviable alternative.\nIntramuscular Implantation in Rabbits. Prepare for \nimplantation 8 strips of the sample and 4 strips of High-Density \nPolyethylene RS. Each strip should measure not less than 10 \nx 1 mm. The edges of the strips should be as smooth as possible \nto avoid additional mechanical trauma upon implantation. \nStrips of the specified minimum size are implanted by means \nof a hypodermic needle (15-19 gauge) with intravenous point \nand a sterile trocar. Use either presterilized needles into which \nthe sterile plastic strips are aseptically inserted, or insert each \nclean strip into a needle, the cannula and hub of which are \nprotected with an appropriate cover, and then subjected to \nthe appropriate sterilization procedure.\nNOTE— Allowfor proper degassing ifagents such as ethylene \noxide are used.\nTest Animals. Select healthy, adult rabbits weighing not leSs \nthan 2.5 kg, and with paravertebral muscles thatare sufficiently\nIP 2018\n2.2.25. MONOCYTE ACTIVATION TEST\nIP 2018\nthe sample and control mean scores for more than one of the \nfour implant sites does not exceed 1 for any implanted animal.\nlarge in size to allow for implantation of the test strips. Do not \nuse any muscular tissue other than the para vertebral site. \nThe animals must be anesthetized with a commonly used \nanesthetic agent to a degree deep enough to prevent muscular \nmovements, such as twitching. CPCSEA (Committee for the \nPurpose of Control and Supervision of Experiments on \nAnimals) guidelines for time being in force should be used for \nconducting animal experiments.\n2.2.25. Monocyte Activation Test\nThe monocyte activation test (MAT) is a test that is based on \nthe reaction of human blood cells [monocytes] to pyrogenic \nsubstances. The monocytes while reacting to the pyrogenic \nsu"}},{"@id":"https://www.openphar.org/data/ip/monographs/nutmeg-oil","@type":"IndexedMonograph","prefLabel":{"en":"Nutmeg Oil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nutmeg Oil\nJaiphal ka tail\nNutmeg Oil is the essential oil obtained by steam distillation \nof dried and crushed nuts of Myristica fragans Houttuyn \n(Fam. Myristicaceae). \n....\nNutmeg oil contains not less than 15.0 per cent and not more \nthan 28.0 per cent of a -pinene, not less than 13.0 per cent and \nnot more than 18.0 per cent of p -pinene, not less than 14.0per \ncent and not more than 29.0 per cent of sabinene, not less \nthan 2.0 percent.and not more than 7.0 percent of limonene, \nnot less than 0.5 per cent and not more than 2.0 per cent A-3 \ncarene,, not less than 2.0 per cent and not more than 6.0 per \necnt of y -terpinene, not less than 2.0 per cent and not more \nthan 6.0 per cent of terpinen-4-ol, not less, than 1,0 per cent \nand not more than 2.5 per cent safrole and not less titan 5.0 per \ncent and not more than 12.0 percent of myristicine.\nDescription. A clear colourless to light yellow liquid* free from \nsediment and suspended matter, spicy, sweet, aromatic odour\nwith characteristic nuances. \n... u\n4272\nwww.webofpharma.com\nOPIUM\n'l$2Q22-:~\nOpium\njdenttflcation\n¿ determine by gas chromatography (2.4.13).\n^■soltition- A 2.0per cent w/v solution of the oil under \n^amination in ethanol (95 per cent).\n^ferPncesolution. A 2.0 per cent w/v solution of nutmeg oil \n^^ethanql (95 per cent).\ngse.chromatographic system described in the Assay.\nTweaks m the chromatogram obtained with the test solution \ncorre^phds to the peaks in the chromatogram obtained with \ndereference solution. ‘\n^flashpoint (2.4.44). 46.0° to 50.0°:"}},{"@id":"https://www.openphar.org/data/ip/monographs/nystatin-ointment","@type":"IndexedMonograph","prefLabel":{"en":"Nystatin Ointment"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nystatin Ointment\nNystatin Ointment is a dispersion of Nystatin in microfine \npowder in a suitable ointment base.\nNystatin Ointment contains not less than 90.0 per cent and \nnot more than 130.0 per cent ofthe stated number of Units of \nnystatin.\n4. \nUsual strength. 100,000 Unitsperg."}},{"@id":"https://www.openphar.org/data/ip/monographs/nystatin","@type":"IndexedMonograph","prefLabel":{"en":"Nystatin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Nystatin\nNystatin is an antifungal substance produced by the growth \nof certain strains of Streptomyces noursei or by any other \nmeans. It consists mainly of polyenes, the principal component \nbeing nystatin A..\nNystatin has a potency of not less than 4400 Units per mg, \ncalculated on the dried basis.\nCategory. Antifungal.\nDescription. Ayellow to slightly brown powder; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/octyldodecanol","@type":"IndexedMonograph","prefLabel":{"en":"Octyldodecanol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Octyldodecanol\nG0H42O \nMol. Wt. 298.6\nOctyldodecanol is 2-octyl-l-dodecanol:\nOctyldodecanol contains not less than 90 per cent of C20H42O, \nthe remainder consisting mainly of related alcohols.\nCategory. Pharmaceutical aid.\nDescription. Aclear, colourless or yellowish, oily liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/oestradiol-benzoate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Oestradiol Benzoate Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Oestradiol Benzoate Injection\nOestradiol Injection is a sterile solution ofOestradiol Benzoate\nin Ethyl Oleate or other suitable ester, in a suitable fixed oil or\nin any mixture ofthese. It may contain suitable alcohols.\nOestradiol Benzoate Injection contains not less than 90.0 per\ncent and not more than 110.0 per cent ofthe stated amount of\noestradiol benzoate, C2sH2S03'\nUsual strength. 1mg perml."}},{"@id":"https://www.openphar.org/data/ip/monographs/oestradiol-benzoate","@type":"IndexedMonograph","prefLabel":{"en":"Oestradiol Benzoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oestradiol Benzoate\nQsl-hCh \nMol. Wt. 376.5\nOestradiol Benzoate is 17P-hydroxyestra-.l ,3,5(10)-trien-3-yl \nbenzoate.\n3099\nwww.webofpharma.com\nOestradiolBenzoate contains not less than 97.0,per cent and \nnot more than 103.0 per cent of C25H28O3, calculated on the \ndried basis. \n......\nCategory. Oestrogen. \n. .\nDescription. Colourless crystals or a white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oestradiol-injection","@type":"IndexedMonograph","prefLabel":{"en":"Oestradiol Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oestradiol Injection\nOestradiolBenzoate Injection\nOestradiol Injection is a sterile solution of Oestradiol Benzoate \nin Ethyl Oleate or other suitable ester, in a suitable fixed oil or \nin any mixture of these. It may contain suitable alcohols.\nOestradiolBenzoate Injection contains not less than 90.0 per \ncent and nbt more than 110.0 per cent of the stated amount of \noestradiol benzoate, C25H28O3.\nUsual strength. 1 mg per ml. ."}},{"@id":"https://www.openphar.org/data/ip/monographs/ofloxacin-infusion","@type":"IndexedMonograph","prefLabel":{"en":"Ofloxacin Infusion"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ofloxacin Infusion\nOfloxacin Infusion is a sterile solution of Ofloxacin in 5 per \ncent Dextrose Injection or in Sodium Chloride Injection.\nOfloxacin Infusion contains not less than 90.0 per cent arid \nnot more than 120.0 per cent of the stated amount of ofloxacin, \nf'lU [2.0FN5O4. '\nUsual strengths. 25 mg; 50 mg; 100mg;200mg;400mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/ofloxacin-ophthalmic-solution","@type":"IndexedMonograph","prefLabel":{"en":"Ofloxacin Ophthalmic Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ofloxacin Ophthalmic Solution\nOfloxacin Ophthalmic Solution is a sterile aqueous solution of \nOfloxacin.\nOfloxacin Ophthalmic Solution contains not less than 90.0 per \ncent and not more than 110.0 percent of the stated amount of \nofloxacin, Ci8H2oFN304.\nUsual strength. 0.3 per cent w/v."}},{"@id":"https://www.openphar.org/data/ip/monographs/ofloxacin-oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Ofloxacin Oral Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ofloxacin Oral Suspension\nOfloxacin Oral Suspension is a suspension of Ofloxacin in a \nsuitable aqueous vehicle.\nOfloxacin Oral Suspension contains not less than 90.0 per \ncent and not more than 110.0 per cent of the stated amount of \nofloxacin, C18H2qFN3O4.\nUsual strengths. 5 0 mg per 5 ml; 100 mg per 5 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/ofloxacin","@type":"IndexedMonograph","prefLabel":{"en":"Ofloxacin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ofloxacin\no .\nC18H20FN3O4 \n■ ■ ' Mol. Wt. 361.4\nOfloxacin is (7?S)-9-fluoro-3-methyl-10-(4-methylpiperazin-\n1-yl)-7-oxo-2,3-dihydro-7H-pyrido [1^,3,-Je]-l,4-benzox azi ne­\nb-carboxylic acid.\nOfloxacin contains not less than 98.5 per cent and not more \nthan 101.5 per cent of CiSH2qFN3O4, calculated on the dried \nbasis.\nCategory. Antibacterial.\nDescription. Apale yellow or bright yellow, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ointment","@type":"IndexedMonograph","prefLabel":{"en":"Ointment"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ointment \n. .\nQuiniodochlor arid Hydrocortisone Ointment contains \nQuiniodochlor and Hydrocortisone in a suitable base.\nQuiniodochlor and Hydrocortisone Ointment contains not less \nthan 90.0 per cent arid riot- more than 110.0 per cent of the \nstated amount of quiniodochlor, C9H5CIINO and not less than \n92.5 per cent and not more than 107i5 per cent of the stated \namount of hydrocortisone, C2TE()O5. \n' x-'-wr\n3432\nIP 2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/olanzapine","@type":"IndexedMonograph","prefLabel":{"en":"Olanzapine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Olanzapine\nOlanzapine is 2-methyl-4-(4-methyl-l-piperazinyl)-10H- \nthieno[2,3-Z>][l,5]benzodiazcpine. \n.\n3405\nwww.webofpharma.com\nOLANZAPINE\nOlanzapine contains not less than 98.0 per cent and not more \nthan 102.0 per cent of CnHjbN^, calculated on the anhydrous \nbasis.- ■ •• \n:\nCategory. Antipsychotic. .\nDescription. A yellow crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oleic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Oleic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oleic Acid\nH3C(H2C)6^/=^(CH2)6COOH J\nCI8H34O2 \nMol. Wt. 282.5\nOleic Acid consists mainly of (Z)-octadec-9-enoic acid, \nCi8H34O2, together with varying amounts of saturated and \nother unsaturated fatty acids and is obtained by the hydrolysis \nof fats or fixed oils and separation of the liquid acids by \nexpression or other suitable means. It may contain a suitable \nantioxidant.\nCategory. Pharmaceutical aid (emulsion adjuvant).\nDescription. A clear, yellowish to pale brown, oily liquid. On \nexposure to air it darkens in colour. <"}},{"@id":"https://www.openphar.org/data/ip/monographs/olmesartan-medoxomil","@type":"IndexedMonograph","prefLabel":{"en":"Olmesartan Medoxomil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Olmesartan Medoxomil\nOlmesartan Medoxomil is (5-methyl-2-oxo-l,3-dioxol-4- \nyl)methyl 4-( 1 -hydroxy-1 -methylethyl)-2-propyl-1 - [[2 ■ - (1H- \ntetrazol-5-yl)biphenyl-4-yl]methyl]-177-imidazole-5- \ncarboxylate. ’-J.:'w / ww-/ • ■\nOlmesartan Medoxomil contains not less than 97.5 per cent \nand not more than 102.0 per cent of C29Hj(jN6O6, calculated on \nthe anhydrous basis.\nCategory.Antihypertensive. \n,"}},{"@id":"https://www.openphar.org/data/ip/monographs/olopatadine-hydrochloride-ophthalmic-solution","@type":"IndexedMonograph","prefLabel":{"en":"Olopatadine Hydrochloride Ophthalmic Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Olopatadine Hydrochloride Ophthalmic Solution\nOlopatadine Hydrochloride Ophthalmic Solution is a sterile \naqueous solution of olopatadine hydrochloride. It may contain \nsuitable antimicrobial agents.\nOlopatadine Hydrochloride Ophthalmic Solution contains not \nless than 90.0 per cent and not more than 110.0 per cent of the \nstated amount of olopatadine, C2]H23NO3.,\nUsual strengths. 0.1 per cent w/v; 0.2 per cent w/v; 0.5 per \ncent w/v; 1.0 per cent w/v."}},{"@id":"https://www.openphar.org/data/ip/monographs/omeprazole","@type":"IndexedMonograph","prefLabel":{"en":"Omeprazole"},"edition":"ip-2022","category":"monographs","definition":{"en":"Omeprazole\nC!71I!9N3O3S \n■■■ Mol. Wt. 345.4\nwww.webofpharma.com\nIP 2022\nOMEPRAZOLE\nOmeprazole is 5.methoxy-2-[[(4-methoxy-3,5-dimethyl-pyridin- \n2-yl)methyl]sulfinyl]-177-benzimidazole.\nOmeprazole Contains not less than 99.0 per cent and not more \nthan lOhO per cent of C17H19N3O3S, calculated on the dried \nbasis.' \n' \n\\\nNOTE__Perform the tests and assay in subdued light and\nuse low-actinic glassware.\nCategory. Antiulcerative (protonpump inhibitor).\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oncacid","@type":"IndexedMonograph","prefLabel":{"en":"Oncacid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oncacid \n1.0\nReference solution. A 0.1105'2 per cent w/v solution of sodium I \nfluoride in water. Dilute 2.0 ml of the solution to 1000.0 nil |\nDescription. Ayellowish white or yellow powder..\nfoj^^forence solution (a), (b), (c) and (d). The test is not\nwith water (\\ pg per ml of fluoride ion). \n- ‘\nva|id unless the resolution between the peaks due to malic"}},{"@id":"https://www.openphar.org/data/ip/monographs/ondansetron-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Ondansetron Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ondansetron Hydrochloride\nC18H19N3O,HC1,2H2O \nMol. Wt. 365.9\nOndansetron Hydrochloride is (7f1S)-9-methyl-3-[(2-methyl-l/7- \nimidazol-1 -yl)methyl]-1,2,3,9-ietrahydro-4/7-carbazol- \n4-one hydrochloride dihydrate.\nOndansetron Hydrochloride contains not less than 98.0 per \ncent and not more than 102.0 per cent of C^H^NsO^Cl, \ncalculated on-the anhydrous basis.\n3121.\nwww.webofpharma.com\nCategory. Antiemetic. (5-HT3 receptor antagonist)\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ondansetron-injection","@type":"IndexedMonograph","prefLabel":{"en":"Ondansetron Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ondansetron Injection\nOndansetron Hydrochloride Injection\nOndansetron Injection contains not less than 95.0 per cent \nand not more than 105.0 per cent of the stated amount of \nondansetron, Ci8Hi<)N3O. \n. \n. . i\nUsual strength. 2 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/ondansetron-oral-solution","@type":"IndexedMonograph","prefLabel":{"en":"Ondansetron Oral Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ondansetron Oral Solution\nOndansetron Hydrochloride Oral Solution\nOndansetron Oral Solution is a solution of Ondansetron \nHydrochloride in a suitable vehicle.\nOndansetron Oral Solution contains not less than 95.0 per \ncent and not more than 105.0 percent of the stated amount of \nondansetron, C18H19N3O.\nUsual strengths. 2 mg per 5 ml; 4 mg per 5 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/ondansetron","@type":"IndexedMonograph","prefLabel":{"en":"Ondansetron"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ondansetron\nC18H19N3O \nMol. Wt. 293.4\nOndensetron is I,2,3,9-tetrahydro-9-methyl-3-[(2Tmethyl-\n1/7-imidazol-1 -yl)methyl]-4//-carbazo 1-4-one.\nOndansetron contains not less than 98.0 per cent and not \nmore than 102.0 per cent of Ci8H19N3O,. calculated on the \nanhydrous basis.\nCategory. Antiemetic.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ophthalmic-drops","@type":"IndexedMonograph","prefLabel":{"en":"Ophthalmic Drops"},"edition":"ip-2018","category":"monographs","definition":{"en":"Granules are preparations consisting of solid, dry aggregates \nof powder particles sufficiently resistant to withstand \nhandling. They are intended for,,oral administration. Some are \nswallowed as such, some are chewed and some are dissolved \nor dispersed in water or another suitable liquid before being \nadministered.\n10 particles have a maximum dimension greater than 50 gm \nand none has a maximum dimension greater than 100 gm.\nSterility (2.2.11). Comply with the test for sterility."}},{"@id":"https://www.openphar.org/data/ip/monographs/opium-powder","@type":"IndexedMonograph","prefLabel":{"en":"Opium Powder"},"edition":"ip-2022","category":"monographs","definition":{"en":"Opium Powder\nQpiujn Powder is Opium dried at a temperature not exceeding \n70°, reduced to a fine or moderately fine powder and adjusted \nby the addition of Lactose, suitably coloured with Caramel, or \nother suitable diluent to contain about 10 per cent of morphine \nand 2 per cent Of codeine.\nOpium Powder contains not less than 9.5 per cent w/w and \nnot more than 10.5 per cent w/w of morphine, C[7H|9NO3, and \nnót less than 1 ;9 per cent w/w and not more than 2.1 per cent \nw/w of codeine, Ci8H2íNO3, both calculated on the dried basis.\nCategory. Narcotic analgesic, antitussive.\nDescription. A light brown powder consisting of yellowish \nbrown or brownish red particles; odour, characteristic."}},{"@id":"https://www.openphar.org/data/ip/monographs/oral-solution","@type":"IndexedMonograph","prefLabel":{"en":"Oral Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oral Solution\nLevamisole ‘Hydrochloride Veterinary Mixture; \nLevamisole Veterinary Oral Solution; Levamisole \nVeterinary Mixture\nLevamisole Hydrochloride Veterinary Oral Solution is an \naqueous solution of Levamisole Hydrochloride containing,\nsuitable stabilising,.agents. \n:\nLevamisole Hydrochloride Veterinary Oral Solution contains\nnot less than 92.5 per cent and not more than 107.5 per cent of\nthe stated amount of levamisole hydrochloride, C,,H|»N>S,HCL\nUsual strength..0.25 pér cent w/w; 1.5 percent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Oral Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oral Suspension\nSulphamethoxazole and Trimethoprim Oral Suspension; \nCo-trimoxazole OralSuspcnsion;Co-trimoxazole Mixture\nTrimethoprim and Sulphamethoxazole Oral Suspension is a \nsuspension of Trimethoprim and Sulphamethoxazole in a \nsuitable flavoured vehicle. It contains 5 parts of \nSulphamethoxazole for 1 part, by weight, of Trimethoprim.\nTrimethoprim and Sulphamethoxazole Oral Suspension \ncontains not less than 90.0 per cent and hot more than\n110.0 per cent of the stated amounts of trimethoprini, \nC14IIlfjN4O3, and sulphamethoxazole, C,4biN3O3S.\nCategory.Antibacterial. ' r; '' ; \n‘ ' '• - 5\nUsual strengths. Trimethoprim 40 mg and Sulphamethoxazole \n200 mgin 5 ml; Trimethoprim 80 mg and Sulphamethoxazole \n400mgin5ml. \n■■\"■'■■\"/ \n’"}},{"@id":"https://www.openphar.org/data/ip/monographs/ormeloxifene-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Ormeloxifene Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ormeloxifene Hydrochloride\nCentchroman Hydrochloride; Ccntchroman\nCjoIhsNCyiCl. \nMol.Wt.493.5\nOrmeloxifene Hydrochloride is /raws-7-methdxy-2,2-dirriethyi- \n3-phenyl-4[4-(2-pyrrolidin'o-thoxy)phenyr|chrbman \nhydrochloride. ' \n. \" .\nOrmeloxifene Hydrochloride contains, not less than 98.5 per \ncent and not more than 101.5 per cent of CsoH^NCb^Cl, \ncalculated on the dried basis.\nCategory. Antifertility agent (female oral contraceptive).\nDescription. A white to off-white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ornidazole","@type":"IndexedMonograph","prefLabel":{"en":"Ornidazole"},"edition":"ip-2010","category":"monographs","definition":{"en":"Ornidazole\nOH\n~CI\n02N~rCH3\nC7HIQClN30 3\nMol. Wt. 219.6\nOmidazole is (RS)-I-chloro-3-(2-methyl-5-nitroimidazol-l-\nyl)propan-2-ol.\nOmidazole contains not less than 98.0 per cent and not more\nthan 101.0 p~r centofC7HIQClN30 3,calculatedon the anhydrous\nbasis.\nCategory. Antiamoebic.\nDose. 500 mg twice a day orally for five days.\nDescription. Awhite to yellowish white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/orphenadrine-citrate","@type":"IndexedMonograph","prefLabel":{"en":"Orphenadrine Citrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Orphenadrine Citrate\n' ch3. '\nClgH?3NO,C6lls()7 \nMol.Wt.461.5\nOrphenadrine Citrate is (/CS’)-dimethyl[2-(2-methyi- \nbenzhydryloxy)ethyl]amine dihydrogen citrate.\nOrphenadrine Citrate contains not less than 98.5 per cent and \nnot more than 101.0 per pent of C;1?JNO, CJlgQ?, calculated \non the dried basis. \n. .\nCategory. Skeletal muscle relaxant. \n■ ;;\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/orphenadrine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Orphenadrine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Orphenadrine Hydrochloride\nCI8H23NO,HC1 . \n\\ \nMol. Wt.305.8\nOrphenadrine Hydrochloride is (RS)-dimethyl [2-(2-methyl- \nbenzhydryloxy) ethyl]amine hydrochloride.\nOrphenadrine Hydrochloride contains not less than 98.5 per \ncent and hot more than 101.0 per cent of Ci8H23NO,HC1. \ncalculated on the dried basis.\n3134\nwww.webofpharma.com\nORPHENADRINE TABLETS\nIP 2022\nCategory. Antiparkinsonian. . -\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oseltamivir-oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Oseltamivir Oral Suspension"},"edition":"ip-2018","category":"monographs","definition":{"en":"Oseltamivir Oral Suspension\nOseltamivir Phosphate Oral Suspension\nOseltamivir Oral Suspension is a mixture consisting of \nOseltamivir Phosphate with buffering agents and other \nexcipients. It contains a suitable flavouring agent. It is filled in \na sealed container.\nThe suspension is constituted by dispersing the contents of \nthe sealed container in the specified volume of water just \nbefore use.\nOseltamivir Oral Suspension contains not less than 90.0 per \ncent and not more than 110.0 per cent of the stated amount of \noseltamivir CI6H281\\1204.\nThe contents of the sealed container comply with tlic \nfollowing requirement.\nUsual strength. 15 mg per ml.\nWater (2.3.43). Not more than 2.5 per cent, determined on 1.0 g.\nThe constituted suspension complies with the requirements \nstated under Oral liquids and with the following \nrequirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/oseltamivir-phosphate","@type":"IndexedMonograph","prefLabel":{"en":"Oseltamivir Phosphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oseltamivir Phosphate\nC16H2fiN2O4,HiPO4 <... w i \\ \nMol.Wt.410.4\nOseltamivir Phosphate is phosphoric acid salt of. ethyl \n(3/?,47?,5y)-4-(acetylamino)-5-ammo-3-( 1-ethylpropoxy)-\n1 -cyclohexene-1 -carboxylate.\n3136\nIP 2022\nOSELTAMIVIR PHOSPHATE\nOseltamivir Phosphate contain not less than 98.0per cent and \nnot more than 102.0 per cent of Ci6H28N2O/,, H3PO4, calculated \non the anhydrous basis.\nCategory. Antiviral.\nDescription. A white or off-white powder. \n. / \nw \\"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxacillin-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Oxacillin Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxacillin Sodium\nCjyli igNjNaOsS,! I2O ,. \n,, \nMol. Wt. 441.4\nOxacillin Sodium is Sodium 6-(5-methy1-3-phenyl-1,2-oxazole- \n4-carboxamido)penicillanate.\nOxacillin Sodium contains not less than 95.0 per cent and not \nmore than 102.0 per cent of C19H|8N3Nab5S, calculated on the \nanhydrous basis.\nCategory. Antibacterial.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxaliplatin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Oxaliplatin Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxaliplatin Injection\nOxaliplatin Injection is a sterile solution of Oxaliplatin in Water \nfor Injections.' .\nOxaliplatin Injection contains riot less than 90.0 per cent and \nnot more than 110.0 per Cent of C^N^Pt\nUsual strength. 5 mg per ml:"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxazepam","@type":"IndexedMonograph","prefLabel":{"en":"Oxazepam"},"edition":"ip-2010","category":"monographs","definition":{"en":"Oxazepam\nCI\nMol. Wt. 286.7\nOxazepam is 7-chloro-3-hydroxy-5-phenyl-1,3-dihydro-2H-\n1,4-benzodiazepin-2-one.\nOxazepam contains not less than 98.5 per cent and not more\nthan 101.0 per cent ofClsHIICINzOz, calculated on the dried\nbasis.\nCategory. Anxiolytic.\nDose. 15 to 30 mg, 2 to 3 times daily.\nDescription. A white or alrnostwhite, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxazoline","@type":"IndexedMonograph","prefLabel":{"en":"Oxazoline"},"edition":"ip-2018","category":"monographs","definition":{"en":"Oxazoline \t\n1.68\n1.01\nC8H9N304 \t\nMol. Wt. 211.2\nNicorandil is 2-(3-Pyridinecarboxamido)ethyl nitrate.\nInject the reference solution. The test is not valid unless the \ncolumn efficiency is not less than 2000 theoretical plates and \ntailing factor is not more than 2.0.\nNicorandil contains not less than 98.0 per cent and not more \nthan 102.0 per cent of C gH9N304, calculated on the anhydrous \nbasis.\nInject the reference solution and the test solution. In the \nchromatogram obtained with the test solution, the area of any \nsecondary peak is not more than the area of the principal peak \nin the chromatogram obtained with the reference solution \n(0.2 per cent). The sum of the areas of all the secondary peaks \nis not more than 3 times the area of the principal peak in the \nchromatogram obtained with the reference solution (0.6 per \ncent). Ignore any peak with an area less than 0.25 times the \narea of the principal peak in the chromatogram obtained with \nthe reference solution (0.05 per cent).\nCategory. Selective ATP dependent potassium channel opener.\n2-Chloro-4-nitroaniline. Not more than 100 ppm.\nDose. 10 to 20 mg twice daily for adults.\nBoil a quantity of the powdered tablets containing 0.1 g of \nNiclosamide with 20 ml ofmethanol, cool, and dilute to 50.0 ml \nwith I Mhydrochloric acid, filter. To 10.0 ml of this solution \nadd 0.5 ml of a 0.5 per cent w/v solution of sodium nitrite and \nallow to stand for 3 minutes. Add 1.0 ml of a 2 per cent w/v \nsolution of ammonium sulphamate, shake, allow to stand for \n3 minutes and add 1.0 ml of a 0.5 per cent w/v solution of N-(1-  \nnaphthyl) ethylenediamine dihydrochloride. Any pinkish \nviolet colour produced is not more intense than that obtained \nin a solution prepared at the same time and in the same manner \nusing 10.0 ml of a solution prepared by diluting 2.0 ml of a \n0.0005 per cent w/v solution of 2-chloro-4-nitroaniline in \nmethanol to 50 ml with / Mhydrochloric acid and beginning \nat the words \"add 0.5 ml of a 0.5 per cent w/v solution of \nsodium nitrite \"\nDescription. A white to off white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxcarbazepine","@type":"IndexedMonograph","prefLabel":{"en":"Oxcarbazepine"},"edition":"ip-2010","category":"monographs","definition":{"en":"Oxcarbazepine\nClsHIZNzOz,\nMol. Wt. 252.3\nOxcarbazepine is 10,11-dihydro-1O-oxo-5H-dibenz[b,jJazepine-\n5-carboxarnide.\nOxcarbazepine contains not less than 98.0 per cent and not\nmore than 102.0percent ofClsHlzNzOz,calculated on the dried\nbasis.\nCategory. Non-opioid analgesics.\nDose. 300 mg twice a day.\nDescription. An off-white to yellow crystalline powder.\nwww.webofpharma.com\nIP 2010"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxetacaine","@type":"IndexedMonograph","prefLabel":{"en":"Oxetacaine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxetacaine\nCajHnNaOa \nMol. Wt. 467.6\nOxetacaine is 2,2'-(2.-hydroxyethylimino)bis[A/-(a,a- \ndimethylphenethyl)-A-mcthylacctamidc]. /\nOxetacaine contains not less than 99.0 per cent and hot more \nthan 100.5 per cent of C28H4iN3O3 calculated on the dried basis.\nCategory. Local Anaesthetic.\nDescription. A white or almost white powder.\n3150\nwww.webofpharma.com\nIP2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxfendazole","@type":"IndexedMonograph","prefLabel":{"en":"Oxfendazole"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxfendazole\n. \nMok, Wt. 315.4 \n€)5HN3058\nOxfendazole is methyl5-(phenylsulphinyl)- \n2-benzimidazolecarbamate.\nOXFENDAZOLE\nOxfendazole- contains not less than 97.0 per. cent and not more. \nthan. 100.5 per « cent.of \noF CisHisN2O38, ¢ calculated on the dried \nbasis.\nCategory, Anthelmintic, °\nDescription. Awhite or almost white powder. :"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxide","@type":"IndexedMonograph","prefLabel":{"en":"Oxide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxide\nDried Aluminium Hydroxide consists largely of hydrated \naluminium oxide together with varying quantities of basic \naluminium carbonate and bicarbonate.\nDried Aluminium Hydroxide contains not less than 47.0 per \ncent and not more than 60.0 per cent of A12O3.\nDescription. A white, light, amorphous powder containing \nsome aggregates."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxprenolol-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Oxprenolol Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxprenolol Hydrochloride\nOH H\nOXPRENOLOL HYDROCHLORIDE\nOxprenolol Hydrochloride is (7?S)-l-(2-allyloxyphenoxy)-3- \nisopropylaminopropan-2-ol hydrochloride.\nOxprenolol Hydrochloride contains hot less than 98.5 per cent \nand not more than 101.5 per cent of C15H23N63,HC1, calculated \non the dried basis.\nCategory. Beta-adrenoceptor antagonist (antihypertensive; \nantianginal; antiarrhythmic).\nDescription. Awhite or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxyclozanide-premix","@type":"IndexedMonograph","prefLabel":{"en":"Oxyclozanide Premix"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxyclozanide Premix\nOxyclozanide Granules... ‘ ' So\nOxyclozanide Premix contains Oxyclozanide.:\nOxyclozanide Premix contains not lessthan 92.5 per cent and: \nnot more than’107.5 per-cent of the stated amount of \noxyclozanide, C,;HCl,NO,. \n:\nUsual strength. 5 per cent w/w: \n°\n4910"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxyclozanide","@type":"IndexedMonograph","prefLabel":{"en":"Oxyclozanide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxyclozanide\nCuHLCLNO, \n“Mol Wt. 401.5\nOxyclozanide is 2, 3,5- irichloro-N- “3, 5 dichloro- \n2-hydroxypheny!)-6-hydroxybenzamide,\nOniyelozanidé: contains not less 'than-98.0 per cent’ and! hot’ \n‘more than 101.0 Pet. \ni fent of. SuHRCLNGs. ‘Palonlated, on: the;\nIP2022 \nOXY.CLOZANIDE. VETERINARY ORAL:SUSPENSION:\nCategory. Anthelmintic.\nDescription. A pale cream tocream-coloured powder.\nIdentification .\nA. Determine by infrared absorption spectrophiotsinety 0 4: 6): \nCompare the spectrum with that obtained with oxyclozanide. \nIPRS or with the reference spectrum of oxyclozanide. \n— ~\nB, When examined 'in'the range’230 nm to 360 rim (2.4.7); a\n0.003 per cent w/v solution in’ JM methanolic hydrochlorié: \nacid exhibits‘a. maximum, only at about 300.nm, is: \nisabout. 0: 16.\nC. Melting ratige (2.4.21), 208° \n2118"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxygen-93-per-cent","@type":"IndexedMonograph","prefLabel":{"en":"Oxygen 93 Per Cent"},"edition":"ip-2010","category":"monographs","definition":{"en":"Oxygen 93 Per Cent\nOxygen 93 per Cent contains not less than 90.0 per cent and\nnot more than 96.0 per cent, vlv ofOz, the remainder consisting\nmostly of argon and nitrogen. It is produced from air by the\nmolecular sieve process.\nDescription. A colourless gas; odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxygen","@type":"IndexedMonograph","prefLabel":{"en":"Oxygen"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxygen\nO2 \n\" Mol. Wt. 32.0\nOxygen contains not less than 99.0 per cent v/v of O2.\nThis monograph applies to oxygen for medicinal use only.\nOxygen should be stored in approved metal cylinders, the \nshoulder of the metal cylinder should, be painted, white and \nthe remainder black. The cylinder should carry a label stating \n“Oxygen”. In addition, “Oxygen” or the symbol “O2” should \nbe stencilled in paint on the shoulder of the cylinder.\nWhen Oxygen is intended for use in a room in which magnetic \nresonance imaging (MRI) is being performed, the cylinder \nand fittings should be made from suitable non- ferromagnetic \nmaterials and labelled accordingly. \n■ \n1 -■\nwww.webofpharma.com\nIP 2022\nOXYMETAZOLINE HYDROCHLORIDE\nDescription. A colourless gas. \n- \n. \n■ ; • „"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxymetazoline-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Oxymetazoline Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxymetazoline Hydrochloride\nC.6H24N2O,Ha . . \n. : Mol. Wt. 296.8\nOxymetazoline Hydrochloride is Phenol, 3-[(4,5-dihydro-lH - \nimidazol-2-yl)methyl]-6-(l, 1 -dimethylethyl)-2,4-dimethyl-, \nmonohydrochlpride. 6-tert-Butyl-3-(2-imidazbiin-2-ylmethyl)- \n2,4-dimethylphenol monohydrochloride. . /\nOxymetazoline Hydrochloride contains not less than 98.5 per \ncent arid not more than 101.5 per cent of C16H24N2O,HC1, \ncalculated on the dried basis. .r .I.-’.'-..:;..'-\nDescription. A white or almost white powder. ■\nCategory. Sympathomimetic amine.\n3157\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/oxytetracycline-eye-ointment","@type":"IndexedMonograph","prefLabel":{"en":"Oxytetracycline Eye Ointment"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxytetracycline Eye Ointment\nOxytetracycline Hydrochloride Eye Ointment -\nOxytetracycline Eye Ointment contains not less than 90.0 per \ncent and not more than 115.0 per Cent'of the stated amount of \noxytetracycline hydrochloride, C^l/b^O^HCl. '\nUsual strength. 1 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxytetracycline-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Oxytetracycline Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxytetracycline Hydrochloride\nOH O ohoh° 0 ; J\nOH , HCI\nC22H24N2O9,HC1 f - \n: \\ ; K. Mol Wt 496 9\n.Oxytetracycline Hydrochloride is (fS,4aR,5S,5aR,6S, 12aX)-4-\nd imcthylamino-1,4,4a,5,5a,6,11,12a-6ctahydrb-3,5,6,10,12,12a- \nhexahydrbxy-6-methyi-l ,11 -dioxbnaphthacene-2- carboxamide \nhydrochloride, a substance produced by the7 growth of certain \nstrains of Streptbmyces rimosus or obtained by any other \nmeans. \nc.: ma;,am;a-.x oa x. ax 0.- o ■■\nOxytetracycline Hydrochloride contains not less than 94.5 \nper cent and not more than 102.0 per Cent of, C22H24N2O9, HCI, \ncalculated on the anhydrous basis, - : ;: j ::: < <\nCategory. Antibacterial. \n.7 \n~\n/Description. Apale yellow, crystalline powder; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxytetracycline-injection","@type":"IndexedMonograph","prefLabel":{"en":"Oxytetracycline Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxytetracycline Injection\nOxytetracycline Dihydrate Inj ection\nOxytetracycline Injection is a. sterile solution of oxytetracycline \nwith or without one or more :suitable .buffering agents, \nanaesthetics, preservatives, antioxidants, complexing agents \nand solvents.\nOxytetracycline Inj ectidn contains not less than 90.0 per cent \nand not more than 120.0 per cent of the - stated amount of \nanhydrous oxytetracycline, C22H24N2O9. \n. ; \n.;\nUsual strengths. 50mgperml;425mgper ml. • \n■■\nDescription. A clear, yellow to tan yellow solution. It may \nhave a greenish tinge."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxytocin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Oxytocin Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxytocin Injection\nOxytocin Injection is a sterile'solution'of Oxytocin in Water \nfor Injections.\nOxytocin Injection contains not less than 90.0 per cent and \nnot more than 110.0 per centofthe stated number of Units of \noxytocin activity.\nUsual strengths. 5 Units per ml; 10 Units per ml.\nDescription. Aclear colourless liquid. \n: ."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxytocin-nasal-solution","@type":"IndexedMonograph","prefLabel":{"en":"Oxytocin Nasal Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxytocin Nasal Solution\nOxytocin Nasal Solution is a solution of Oxytocin in a suitable \nsolvent containing an appropriate antimicrobial preservative.\nOxytocin Nasal Solution contains not,less than 85.0 per cent \nand not more than 120.0 per cent of thestated number of Units \nof oxytocic activity.. \n......... . \n.:\nUsual strength. 40 Units per ml.\nDescription. A clear, colourless solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/oxytocin","@type":"IndexedMonograph","prefLabel":{"en":"Oxytocin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Oxytocin\nCys-Tyr-ne-Gln-Asn-Cysr-Pro-Leu-GlyNH2\n..................... ■,./ ...... . Mol.WL 1007’2\nOxytocin is a cyclic nonapeptide hormone obtained by a \nprocess of fractionation from the posterior lobe of the pituitary \ngland of healthy oxen or other mammals or by : synthesis that \nhas the property of stimulating contraction of the uterus and \nmilk ejection in receptive animals. It may be presented as a \nsolid or as a solution in a solvent containing an appropriate \nantimicrobial preservative such as 0.2 percent w/v solution of \nchlorbutol, \nm\nIf it is derived frofn animal species, Oxytocin contains not less \nthan 95.0 per cent and not more than 105.0 per cent of the \nstated number of Units of oxytocic' activity If it is a synthetic \nproduct presented as a solid; it contains not less than 560 \nUnits per mg, calculated with reference to the peptide content \nand when presented as a liquid, it contains’not less than 150\nUnits per ml. \n:\nBy convention, for the purpose of labeling oxytocin \npreparations, ! mg of oxytocin peptide (C^H^O^S?) is \nequivalent to 600IU of biological activity. \n' \n'\nCategory. Uterine stimulant. . \n...\nDescription. When presented as a solid, a white dr almost \nwhite powder. When presented as a liquid; a clear colourless \nliquid. -w\\w >'■ ' ;"}},{"@id":"https://www.openphar.org/data/ip/monographs/paclitaxel-injection","@type":"IndexedMonograph","prefLabel":{"en":"Paclitaxel Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paclitaxel Injection\nPaclitaxel Injection is a sterile solution of Paclitaxel suitable \nfor dilution, for intravenous use.\nPaclitaxel Injection contains not less than 90.0 per cent and \nnot more than HO.Opercentofthe stated amount of paclitaxel, \nC47H5iNO]4.\nUsual strengths. 30 mg; 100 mg; 260 mg; 300 mg.\nDescription. A clear colourless to slight yellow viscous \nsolution."}},{"@id":"https://www.openphar.org/data/ip/monographs/paclitaxel","@type":"IndexedMonograph","prefLabel":{"en":"Paclitaxel"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paclitaxel\nTaxed\nC47H51NOm . \n; Mol. Wt 853.9\nPaclitaxel is 5 p ,20-epoxy-1,2 ck.4,7//, 1Of,13 a-hexahydroxytax-\n11 -en-9-one 4,10-diacetate 2-bcnzoate 13-ester with(22?,35)- \nJV-benzoyl-3-phenylisoserine.\nA taxane derivative first isolated from the bark ofthe Pacific \nyew tree, Taxus brevifolia.\nPaclitaxel contains not less than 97.0 per cent and not more \nthan 102.0 per cent of CpHsiNOu, calculated on the anhydrous \nbasis.\nCategory. Anticancer.\nDescription. A white or almost white powder.\nCAUTION — Paclitaxel is potentially cytotoxic. Great care \nshould be taken in handling the powder and preparing \nsolutions."}},{"@id":"https://www.openphar.org/data/ip/monographs/paediatric-retinol-oral-solution","@type":"IndexedMonograph","prefLabel":{"en":"Paediatric Retinol Oral Solution"},"edition":"ip-2018","category":"monographs","definition":{"en":"Paediatric Retinol Oral Solution\nCategory. Antixerophthalmic and antirachitic vitamins.\nVitamin A Paediatric Oral Solution contains  Vitamin A\nDose. Prophylactic, 1600 to 2500 Units of Vitamin A and 100 to \n200 Units of vitamin D once a day; therapeutic, 5000 to 10,000 \nUnits of Vitamin A and 400 to 1000 Units of vitamin D once a \nday.\nconcentrate oil, diluted in a suitable vegetable oil. It may \ncontain suitable antimicrobial agents and stabilizing agents \nsuch as antioxidants."}},{"@id":"https://www.openphar.org/data/ip/monographs/paediatric-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Paediatric Syrup"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paediatric Syrup\nParacetamol Paediatric Syrup is a solution of Paracetamol in a \nsuitable flavoured vehicle.\nParacetamol Paediatric Syrup contains not less than 95.0 per \ncent and not more than 105.0 per cent w/v solution of the \nstated amount of paracetamol, C8H9NO2.\nUsual strength. 125 rogper 5 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/paliperidone","@type":"IndexedMonograph","prefLabel":{"en":"Paliperidone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paliperidone\nC23H27FN4O3 \nMol. Wt. 426.5\nPaliperidone is (P7?^-3-[2-[4-(6-Fluoro-l,2-benzisoxazol-3-yl)- \npiperidin-1 -yl]ethyl]-9-hydroxy-2-methyl -6,7,8,9-tetrahydro- \n4//-pyrido|l ,2-a] pyrimidine-one.\nPaliperidone contains not less than 98.0 per cent and not more \nthan 102.0 per cent of C23H27FN4O3, calculated on the \nanhydrous basis.\nCategory. Antipsychotic.\nDescription. A white to yellow powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pamidronate-disodium-pentahydrate","@type":"IndexedMonograph","prefLabel":{"en":"Pamidronate Disodium Pentahydrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pamidronate Disodium Pentahydrate\nC3H9NNa207P2,5H2O \nMol. Wt. ,369.1\nPamidronate Disodium is phosphonic acid, (3-amino-1'1- \nhydroxypropylidene) bisdisodium salt, pentahydrate.\nPamidronate Disodium contains not less than 98.0 per cent \nand not more than 102.0 per cent of C3H9NNa2O7P2, calculated \non the anhydrous basis.\nCategory. Antiosteoporotic,\nDescription. Awhite, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pancreatin","@type":"IndexedMonograph","prefLabel":{"en":"Pancreatin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pancreatin\nPancreatin is a preparation of mammalian pancreas containing \nprotease, lipase and amylase activity. It may contain Sodium \nChloride.\nPancreatin contains not less than the minimum protease \nactivity, amylase activity and lipase activity determined under \nthe conditions of the Assay.\nCategory. Digestive enzyme.\nDescription. A white or buff-coloured, amorphous powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pantoprazole-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Pantoprazole Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pantoprazole Sodium\nCI&H14F2N3NaO4S, 1 /z H2O \nMol. Wt. 432.4\nPantoprazole Sodium is sodium 5-(difluromethoxy)-2[[(3,4 \ndimethoxy-pyridin-2-yl)methyl]sulphinyl]-benzimidazol-l-ide, \nsesquihydrate.\nPantoprazole Sodium contains not less than 98.0 per cent and \nnot more than 102.0 per cent of C16H14F2N3NaO4S, calculated \non the anhydrous basis.\nCategory. Antiulcer.\nDescription. A white to off-white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/papain","@type":"IndexedMonograph","prefLabel":{"en":"Papain"},"edition":"ip-2022","category":"monographs","definition":{"en":"Papain\nCarica papaya . ,\nPapain is an enzyme or a mixture of enzymes obtained from the \njuice of the unripe fruit of Carica papaya. Linii, (Fam,\nCaricaceae). It may contain a suitable diluent such as Lactose.\nPapain contains not less than the minimum protease activity \ndetermined under the conditions of the Assay.\nCategory. Proteolytic enzyme. \n; ; -r\nDescription. A whiteto light brown, amorphous Or slightly \ngranular powder; odour, characteristic. \n. j"}},{"@id":"https://www.openphar.org/data/ip/monographs/paracetamol-infusion","@type":"IndexedMonograph","prefLabel":{"en":"Paracetamol Infusion"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paracetamol Infusion\nAcetaminophen Infusion ;\nParacetamol Infusion is a sterile isotonic buffered solution \nfor intravenous infusion consisting of paracetamol with \nthe aid of a suitable auxiliary substances and alkali or \nacid.\nParacetamol Infusion contains not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of \nparacetamol CSH9NO2.\nUsual strength. 10 mg per ml.\nDescription. A clear, colourless solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/paracetamol-oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Paracetamol Oral Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paracetamol Oral Suspension\nAcetaminophen Oral Suspension\nParacetamol Qral Suspension's a suspension of Paracetamol \nin a suitable flavoured vehicle.\nParacetamol Oral Suspension contains not less than \n90.0 per cent and not more than 110.0 per cent of the stated \namount of paracetamol, CgH9NO2.\nwww.webofpharma.com\nIP 2022\nPARACETAMOL ORAL SUSPENSION\nUsual strength. 500 mg per 5 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/paracetamol-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Paracetamol Syrup"},"edition":"ip-2010","category":"monographs","definition":{"en":"Paracetamol Syrup\nParacetamol Oral Solution; Acetaminophen Syrup\nParacetamol Syrup is a solution ofParacetamol in a suitable\nflavoured vehicle.\nParacetamol Syrup contains not less than 95.0 per cent and\nnot more than 105.0 percentw/v solution ofthe stated amount\nofparacetamol, CsHgN02•\nUsualstrength. 125 mgper5ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/paraldehyde","@type":"IndexedMonograph","prefLabel":{"en":"Paraldehyde"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paraldehyde\nCgHjiOj\nMol. Wt. 132.7\nParaldehyde is 2,4,6-trimethy 1-1,3,5-trioxane, the cyclic trimer \nof acetaldehyde. It may contain a suitable amount of \nantioxidant. \n■ •\nCategory. Anticonvulsant in status epilepticus; hypnotic; \nsedative. •• \n. '\nDescription. A colourless or slightly yellow, transparent liquid.\nSolidifies at low temperature to form a crystalline mass."}},{"@id":"https://www.openphar.org/data/ip/monographs/parecoxib-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Parecoxib Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Parecoxib Sodium\nC19Hi8N2O4SNa \nMol. Wt. 392.4\nParecoxib Sodium, is A;-[4-(5 -Methyl-3 -phenyl- 1,2-oxazol- \n4-yl)phenylsulfonyl]propanamide sodium salt.\nParecoxib Sodium contains not less than 98.0 per cent and not \nmore than 102.0 per cent of Ci9Hj8N2O4SNa, calculated on the \nanhydrous-basis. . .\nCategory. Non steroidal anti-inflammatory drug.\nDescription. A white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/paroxetine-hydrochloride-hemihydrate","@type":"IndexedMonograph","prefLabel":{"en":"Paroxetine Hydrochloride Hemihydrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paroxetine Hydrochloride Hemihydrate\nC19H2IC1FNO3?/2H2O ’ • • • . • \n' 'Mol.Wt. 374.8\nParoxetine Hydrochloride Hemihydrate is (3 <S’,4Z?)-3-[( 1,3- \nBenzodioxol-5-yloxy)methyl]-4-(4-fluorophenyl)piperidine \nhydrochloride hemihydrate.\nParoxetine Hydrochloride Hemihydrate containsriot less than \n97;5.per cent andnotmore than 102.0 per. cent of Q9H21CIFNO3, \ncalculated on the anhydrous basis.\nCategory. Antidepressant.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/paroxetine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Paroxetine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Paroxetine Hydrochloride\nCI9H20FNO3,HCl \nMol. Wt 365.8\nParoxetine Hydrochloride is (3N,47?)-4-(4-Fkiorophenyl)-3-[ (3,4- \nmethylenedioxy)phenoxy]methyl]piperidine hydrochloride.\nParoxetine Hydrochloride contains not less than 97.5 per cent \nand not more than 102.0 per cent of C s9H20FNO3,HCl, calculated \non.the. anhydrous basis.\nwww.webofpharma.com\nIP’2022\nPAROXETINE HYDROCHLORIDE\nCategory.Antidepressant. \n-\nDescription. Awhite or almost white, hygroscopic, crystalline \npowder. It shows polymorphism (2.5.11)."}},{"@id":"https://www.openphar.org/data/ip/monographs/patha","@type":"IndexedMonograph","prefLabel":{"en":"Patha"},"edition":"ip-2022","category":"monographs","definition":{"en":"Patha"}},{"@id":"https://www.openphar.org/data/ip/monographs/pbolcodine","@type":"IndexedMonograph","prefLabel":{"en":"Pbolcodine"},"edition":"ip-2010","category":"monographs","definition":{"en":"Pbolcodine\nC23H30N204,H20\nMol. Wt. 416.5\nPholcodine is 7,8-didehydro-4,5a-epoxy-17-methyl-3-[2-\n(morpholin-4-yl)ethoxy]morphinan-6a-ol monohydrate.\nPholcodine contains not less than 98.0 per cent and not more\nthan 101.0 per cent of C23H30N204, calculated on the dried\nbasis.\nCategory. Cough suppressant.\nDos~. Upto 40 mg daily, in divided doses.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pemetrexed-disodium-heptahydrate","@type":"IndexedMonograph","prefLabel":{"en":"Pemetrexed Disodium Heptahydrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pemetrexed Disodium Heptahydrate\nC20H19N5Na2O6,7H2O \nMol. Wt. 597.5\nPemetrexed Disodium Heptahydrate is.a disodium (25)-2-[[4- \n[2-(2-amino--4-ox()-4,7-dihydn)-l/7-pyrrolo[2,3-i/Jpyriniidin-5- \nyj)ethyl]benzoyl]amino]pentanedioatc heptahydrate.\nPemetrexed Disodium Heptahydratc conlains nol less than \n97.5 per cent and not more than 102:0 per cent of C2t,H19N5Na2O6, \ncalculated on the anhydrous basis....:\nCategory. Thymidylate synthetase inhibitor; cytostatic.\nDescription. Awhite or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pemetrexed-injection","@type":"IndexedMonograph","prefLabel":{"en":"Pemetrexed Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pemetrexed Injection\nPemetrexed Injection is a sterile material consisting of \npemetrexed Disodium heptahydrate with or without bufferings \nagents and other excipients. It is filled in a sealed container.\nThe injection is constituted by dissolving the contents ofthe \nsealed container in the requisite amount of sterile Water'for: \nInjections, or with.suitable diluents.immediately before use.\nThe constituted solution complies with the requirements for: \nClarity of solution and Particulate matter stated under \nParenteral Preparations (Injections).\nPemetrexed Injection contains not less than 90.0 per cent and. \nnot more than 110.0 per cent of the stated amount of \npemetrexed, C2ftH2iN5O6.................\nUsual strengths. 100 mg; 500 mg. \n.\nThe contents of the sealed container comply with the: \nrequirements stated under Parental Preparations (Powder \nfor Injections) and with the following requirements. -"}},{"@id":"https://www.openphar.org/data/ip/monographs/penicillamine","@type":"IndexedMonograph","prefLabel":{"en":"Penicillamine"},"edition":"ip-2010","category":"monographs","definition":{"en":"Penicillamine\nD-Penicillamine\nCHs 0\nHsC--L - Jl\nHS/ ~N~~H\nCsHIlNOzS\nMol. Wt. 149.2\nPenicillamine is 3-mercapto-o-valine.\nPenicillamine contains not less than 98.0 per cent and not\nmore than 101.0 per centofCsHIINOzS, calculated on the dried\nbasis.\nCategory. Chelating agent in copper and lead poisoning;\nantirheumatoid arthritic.\nDose. In poisoning, 500 mg to 2 g daily, in divided doses or in\naccordance with the needs of the patient. In rheumatoid\narthritis, initial dose, 125 to 250 mg daily before food, increased\ngradually every 4 to 12 weeks until remission occurs; usual\nmaintenance dose, 500 to 750 mg daily.\nDescription. Awhite or almost white, crystalline powder.\nIP 2010"}},{"@id":"https://www.openphar.org/data/ip/monographs/penicillin-g-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Penicillin G Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Penicillin G Sodium\nCOONa\n°Yjn'5<ckj\nH H\nC16H„N2NaO4S \nMol. Wt 356.4\nBenzylpenicillin Sodium is sodium (6??)-6-(2- \nphenylacetamido) penicillanate, produced by the growth of \ncertain strains of Penicillium notatum or related organisms, \nor obtained by any other means.\nBenzylpenicillin Sodium contains not less than 96.0 per cent \nand not more than 100.5 per cent of penicillins, calculated as \nC16H17N2NaO4S on the dried basis.\nCategory. Antibacterial.\nDescription. Awhite or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/penicillin-v-potassium","@type":"IndexedMonograph","prefLabel":{"en":"Penicillin V Potassium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Penicillin V Potassium\nCi6H17KN2O5S \nMol. Wt. 388.5\nPhenoxymethylpenicillin Potassium is potassium (62?)-6-(2- \nphenoxyacetamido)penicillinate, produced by the growth of \ncertain strains of Penicillium notatum or related organisms \non a culture medium containing an appropriate precursor, or \nobtained by any other means. \n- '■\nPhenoxymethylpenicillin Potassium contains not less than \n86.0 per cent of total penicillins Ci6Hi7N2O5S, calculated on \nthe anhydrous basis. ' \n. i\nCategory. Antibacterial.\nDescription. A white, crystalline powder\nIdentification f ; \n; f \n;;\nTest A maybe omitted if tests B and.C are cdrriedout., Test B \nmay be omitted if test's A and C are carried out.\nA. Determine by infrared absorption spectrophotometry (2,4.6).. \nCompare the spectrum with that obtained -with \nphenoxymethylpenicillin potassium IPRS or with, the\nreference spectrum of phenoxymethylpenicillin potassium,. .\nB. It gives reaction (B) of penicillins and cephalosporins (2.3.1).\nC. Itgives reaction (A) ofpotassiumsalts (2.3.4)...\nTests ' \n' \n' \n'\npH (2.4.24). 5.5 to 7.5, determined in a 0.5 per cent w/v solution.\nSpecific optical rotation (2:4:22). + 2’15.0° to + 230:0°, \ndetermined in a 1.0 per cent w/v solution in carbon dioxide- \nfreewater. \n?•- y-\n3251\nwww.webofpharma.com\nPHENOXYMETHYLPENICILLIN POTASSIUM\nLight absorption (2,4,7). Absorbance of a 0.1 per cent w/v \nsolution in 0.1 M sodium hydroxide.at the maximum at about \n306 nm, not more than 0.33. Absorbance, of a 0.02 per cent \nw/v solution in OdM sodium hydroxide at the maximum at \nabout 274 nm, not less than 0:50..\nPhenoxy acetic acid.Not more than0.5 per cent.\nDetermine by liquid chromatography (2.4.14).\nTest solution. Weigh a suitable quantity of the substance \nunder examination, dissolve in phosphate buffer pH 6.6 and \ndilute to obtain a solution having a known concentration of \nabout 20 mg per ml.\nReference solution. Weigh a suitable quantity of\nphenoxyacetic acid, dissolve in the phosphate buffer pH 6,6 \nand dilute to obtain a solution having a known concentration \nof about 0.1 mg per ml.\nChromatographic system\n- a stainless steel column 25 cm x 4.6 mm, packed with\noctadecylsilane chemically bonded to porous silica \n(5 pm),\n- mobile phase: a mixture of 65 volumes of water,\n35 volumes of acetonitrile and 1 volume of glacial acetic \nacid,\nflow rate: 1 ml per minute, '\n- ' spectrophotometer set at 254 nm.\n- injection volume: 20 pl. \n•■•••• ; \n-\nInject the reference solution. The; tailing factor is not more \nthan 1.5 and the relative standard deviation for replicate \ninjections is not more than 2.0 per cent.' \n' \n‘: ''\nInject the reference solution and the test solution.. .. .<\nLimit of/?-hydroxyphenoxy methylpenicillin. Not more than \n5.0 percent. \n........ .......;.........\nCalculate the content of phenoxy acetic acid.\nUsing the chromatograms obtained with the test solution in \nthe Assay, calculate the.content ofp-hydroxyphenoxymethyl- \npenicillin from the peak response of/j-hydroxyphenoxy- \nmethylpenicillin and the sum of the peak responses of \np-hydroxyphenoXymethylpenici 11 in and phenoxy metfiyl-\npenicillin. ■ \n—\nWater (2.3.43). Not more than 1.0 per cent, determined on\nAssay. Determine1 by liquid chromatography (2.4.14),\"\nTest solution. Dissolve about 125 nig of the substance under \nexamination in the mobile phase and dilute to 50.0 ml with the \nmobile phase.\nReference solution (a).: Dissolve' a weighed quantity of \nphenoxymethylpenicillin potassium IRRS.in the-mobile, phase,\nand dilute to. obtain a solution having a.known concentration \nof about 2.5 mg per ml.\n‘ 3252\nTP2022\nReference solution (6). A solution in the mobile phase \ncontaining 0.25 per cent w/v each of benzylpenicillin potassititn> \nand phenoxymethylpenicillin potassium. \n^..W.\nChromatographic system........... \nJ\" -■\n- a stainless steel column 30 cm x 4 mm, packedydtfc\noctadecylsilane chemically bonded to porous silica \n(3 to 10 pm),\n- mobile phase: a mixture of 65 volumes of watey^\n35 volumes of acetonitrile an"}},{"@id":"https://www.openphar.org/data/ip/monographs/pentamidine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Pentamidine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pentamidine Injection\nPentamidine Isethionate Injection\nPentamidine Injection is a sterile material consisting of \nPentamidine Isethionate with or without buffering agents and \nother excipients. It is filled in a sealed container.\nThe injection is constituted by dissolving the contents of the \nsealed container in the requisite amount of sterile Water for \nInjections, immediately before use.\nThe constituted solution complies with the requirements for \nClarity of solution and Particulate matter stated under \nParenteral Preparations (Injections). .\n3219\nwww.webofpharma.com\nStorage. The constituted solution should be used immediately \nafter preparation but, in.any case, within the period \nrecommended by the manufacturer.\nPentamidine injection contains not less than 95.0 per cent and \nnot more than 105.0 per cent bf the stated amount of \npentamidine isethionate, C19H24N4O2,2C2H6O4S.\nUsual strength. 200 mg.\nThe contents of the sealed container comply with the \nrequirements stated under Parenteral Preparations\n(Powders for Injection) and with the following requirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/pentamidine-isethionate","@type":"IndexedMonograph","prefLabel":{"en":"Pentamidine Isethionate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Pentamidine Isethionate\nMol. Wt. 592.7\nPentamidine Isethionate is 4,4' -[pentane-l,5-diylbis(oxy)]\nbisbenzenecarboximidamide di(2-hydroxyethanesulphonate).\nPentamidine Isethionate contains not less than 98.5 per cent\nand not more than 101.0 per cent ofC19H24N402, 2C2H60 4S,\ncalculated on the dried basis.\nCategory. Antiprotozoal.\nDose. By intramuscular injection, 3 to 4 mg perkg body weight\ndaily for 10 days, maximum 200 mg.\nDescription. A white or almost white powder or crystals;\nodourless or almost odourless; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/pentazocine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Pentazocine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pentazocine Hydrochloride\nC19H27NO,HC1 \nMol.Wt.321.9\nPentazocine Hydrochloride is (2RS,6RS, 11 RS)-6,11- \ndimethyl-3-(3-methylbut-2-enyl)-l ,2,3,4,5,6-hexahydro-2, ; \n6-methano-3-benzazocih-8-ol hydrochloride.\nPentazocine Hydrochloride contains not less than 98.0 per \ncent and not more than 101.0 per cent bf C19H27NO,HC1, \ncalculated on the. dried basis.\nCategory. Narcotic analgesic. \n!\nDescription. A white or pale cream-coloured, crystalline \npowder. It shows polymorphism (2.5; 11)."}},{"@id":"https://www.openphar.org/data/ip/monographs/pentazocine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Pentazocine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pentazocine Injection\nPentazocine Lactate Injection\nPentazocine Injection is a sterile solution in Water for \nInj ections of either Pentazocine Lactate or pentazocine lactate \nprepared by the interaction of Pentazocine and Lactic Acid.\n3223\nwww.webofpharma.com\nPENTAZOCINE INJECTION\nPentazocine Injection contains not less than 95.0 per cent and \nnot more than 105.0 per cent of the stated amount of \npentazocine, C19H27NO:\nUsual strength. The equivalent of 30 mg of pentazocine per \nml; the equivalent of 60 mg of pentazocine per ml.\nDescription. A clear, colourless or almost colourless liquid.’"}},{"@id":"https://www.openphar.org/data/ip/monographs/pentazocine-lactate","@type":"IndexedMonograph","prefLabel":{"en":"Pentazocine Lactate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pentazocine Lactate\nC^NO^H^ \n■, . Mol. Wt. 375.4\nPentazocine Lactate is (27<S',6/?-S'J17?5')-6,ll-dimethyl-3-(3- \nmethylbut-2-enyl)-1,2,3,4,5,6-hexahydrd-2,6-methano-3- \nbenzazocin-8-ol lactate.\nPentazocine Lactate contains not less than 98.5 per cent and \nnot more than 101.0 per cent of C19H27NO,C31I6O3, calculated \non the dried basis.\nCategory. Narcotic analgesic.\nDescription. A white of pale cream-coloured, crystalline \npowder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pentazocine","@type":"IndexedMonograph","prefLabel":{"en":"Pentazocine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pentazocine\nC19H27NO \n- Mol. Wt. 285.4\nPentazocine is (2RS,6R5J 1AS)-6,1 l -dimethyl-3-(3-methylbut- \n2-enyl)-1,2,3,4,5,6-hexahydro-2,6-methanb-3-benzazocin-8-oL\nwww.webofpharma.com\nPENTAZOCINE HYDROCHLORIDE\nIP 2022\nPentazocine contains not less than 98.0 per cent and not more \nthan 101.0 per cent of C19H27NO, calculated on the dried basis.\nCategory. Narcotic analgesic.\nDescription. A white or pale cream powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pentobarbitone-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Pentobarbitone Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pentobarbitone Sodium\nSoluble Pentobarbitone; Pentobarbital Sodium\nCnH17N2NaO3 \nMol. Wt. 248.3\nI-methylbutyl]barbiturate. 1\nPentobarbitone Sodium is sodium 5-ethyl-5 - [(17?S)-\nPentobarbitone Sodium contains not less than 99.0 per cent \nand not more than 101.5 per cent of Cj iH17N2NaO3, calculated \non the dried basis.\nCategory. Hypnotic.\nDescription. A white, crystalline powder or granules; \nhygroscopic.\n3224\nwww.webofpharma.com\nPENTOBARBITONE TABLETS\nIP 2022-\nIdeotification\nA To 10 ml of a 1Q per cent w/v solution add 5 ml of 2 M acetic \nacid’ a white, crystalline precipitate is produced. Filter, wash \nthe precipitate with water and dry at 105°. Determine the \nmelting point ofthe dried precipitate (2.4.2.1). Mix equal parts \nof the dried precipitate and pentobarbitone IPRS and \ndetermine the melting point (2.4.21).. The difference between \nthe melting points (which are about 131°) is not greater than\n2°. \n- • \n••••••.\nB. Complies, with the test for identification of barbiturates \n(2.3.1), using the dried precipitate obtained in test A for \npreparing the test solution.\nC. To 10 mg add 10 mg of vanillin and 2 ml of sulphuric acid, \nmix and heat on a water-bath for 2 minutes; a reddish-brown \ncolour is produced. Cool and add 5 nil of ethanol', the colour \nchanges to violet.and then blue.\nD. Ignite 1 g; the residue gives reaction (A) of sodium salts\n(23,1)-;. ."}},{"@id":"https://www.openphar.org/data/ip/monographs/pentoxifylline","@type":"IndexedMonograph","prefLabel":{"en":"Pentoxifylline"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pentoxifylline\nC13H18N4O3 \nMol. Wt 278.3\nPentoxifylline is 1.77-purine-2,6-dione, 3,7-dihydro-3,7- \ndimethyl-1-(5-oxohexyl).\nPentoxifylline contains hot less than 98.0 per cent and not \nmore than 102.0 per cent of Ci3Hi8N4O3, calculated on the \ndried basis.\nCategory. Vasodilator.\nDescription. A white to almost white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/peppermint-oil","@type":"IndexedMonograph","prefLabel":{"en":"Peppermint Oil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Peppermint Oil\nPudinakatail\nPeppermint Oil is the essential oil obtained by steam distillation \nof the flowering herb Mentha piperita L.vax.(Fam. Lamiaceae).\nPeppermint Oil contains not less than 13.0 per cent w/w and \nnot more than 28.0 per cent w/w of menthone, and not less \nthan 32.0 per cent w/w and not more than 45.0 per cent w/w of \nmenthol. \n• ■ :■ ■ N: .■ /\n4278\nPATHA\nIP 2022;\nLosson drying (2.4.19). Not more than 12.0 per cent, determined Category. Pharmaceutical aid.\non 5.0 g by drying in an oven at 105°. : \n. ,. \n, . \n, \n. \nJ-«;-/....\n. - J ° ; \nDescription. A clear, almost colourless to amber yellowli\nMicrobial contamination^.2.9).Complies with the microbial \n~ \n‘ \n'\ncontamination tests. ■ \n:\n* \n” ^Qui(L:\nfree from sediment suspended matter rand characteristic of \nmint and menthol-like odour."}},{"@id":"https://www.openphar.org/data/ip/monographs/pepsin","@type":"IndexedMonograph","prefLabel":{"en":"Pepsin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pepsin\nPepsin is obtained from the gastric mucosa of pigs, cattle or \nsheep. It contains gastric proteinases that are active, in an \nacid medium, pH 1 to 5. It may contain a suitable diluent such \nas Lactose. \n■\nPepsin has an activity equivalent to its ability to digest not \nless than 3000 times its weight of coagulated egg albumin \nwhen determined by the method given under Assay 1!\nCategory. Proteolytic enzyme.\nDescription. A white or light buff-coloured, crystalline or \namorphous powder or translucent scales; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/percentage","@type":"IndexedMonograph","prefLabel":{"en":"Percentage"},"edition":"ip-2018","category":"monographs","definition":{"en":"Percentage\nPer centage\nw/v of \ndextrose \n(C6H,206)\nw/v of \nsodium \nchloride\n(NaCI)\n5\n0.11\n5 \t0.45\n5\n0.18\n5 \t0.45 \t10\n0.2\n5 \t0.9\n0.225\n5 \t0.9\n0.3\n5 \t0.9 \t\n10\n0.33\n2.5 \t0.9 \t25\n0.45\nDescription.  A clear, colourless or faintly straw-coloured \nsolution."}},{"@id":"https://www.openphar.org/data/ip/monographs/perphenazine","@type":"IndexedMonograph","prefLabel":{"en":"Perphenazine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Perphenazine\nMol. Wt 404.0\nCaH^ClNsOS\nPerphenazine is 2-[4-[3-(2-chloro-10H-phenothiazin-10- \nyl)propyl]piperazin-l-yl]ethanol.\nwww.webofpharma.com\nIP 2022\nPerphenazine contains not less than 99.0 per cent and not \nmore than 101 ;0 per cent of C21H26CIN3OS, calculated on the \ndried basis.\nCategory- Dopamine receptor antagonist; neuroleptic.\nDescription. Awhite or yellowish-white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pethidine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Pethidine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pethidine Injection\nPethidine Hydrochloride Injection; Meperidine \nHydrochloride Injection \nf „\nPethidine Injection is a sterile solution of Pethidine \nHydrochloride in Water for Injections. \n'■\nPethidine Injection contains, not less than 95.0 per cent and \nnot more than 105.0 per cent of pethidine hydrochloride, \nc15h21no2,hci. ' \n/■'.\nUsualstrength.50mgperml; lOOmgperml."}},{"@id":"https://www.openphar.org/data/ip/monographs/petrolatum","@type":"IndexedMonograph","prefLabel":{"en":"Petrolatum"},"edition":"ip-2022","category":"monographs","definition":{"en":"Petrolatum\nPetrolatum is a purified mixture of semisolid hydrocarbons \nobtained from petroleum. It may contain a suitable stabilizer.\nCategory. Pharmaceutical aid.\nTests ’ '\nMeltingrange(2.4i21:).380to600.' ■\nAlkalinity. To 35 g, add 100 ml of boiling water in a suitable \nbeaker, cover, and place on a stirring hot-plate maintained at \nthe boiling point of water. After 5 minutes, allow the phases to \nseparate. Draw off the separated water into a casserole, wash \nthe petrolatum further with two 50,-ml portions of boiling water, \nand add the washings to the casserole. To the. pooled \nwashings, add 1 drop of phenolphthalein TS, and. boil; the \nsolution docs not acquire a pink colour.\nAcidity; If the addition of phenolphthalein TS in the test for \nalkalinity produces no pink colour, add 0.1 ml of methyl orange \nTS; no red or pink colour is produced.\nConsistency. A penetrometer fitted with a polished cone- \nshaped metal plunger weighing 150 g, having a detachable \nsteel tip of the following dimensions: the tip ofthe cone has\n3240\nPETROLATUM .\nIP 20221\nan angle of 30°, the point of the tip is truncated to a diameter \nof 0.381 mm, the base ofthe tip is 8,38 mm in diameter, and the \nlengthofthe tip is 14.94 mm.,\nThe remaining portion of the cone has an angle of 90°, is \n28 mm in height, and has a maximum diameter at the base of \n65 mm. The containers for the. test are flat-bottom metal \ncylinders that are 100 mm in diameter and not less than 65 mm \nin height. They are constructed of at least 1.6 mm (16-gauge) \nmetal, and are provided with well-fitting, water-tight covers.\nPlace the required number of containers in an oven, bring \nthem and a quantity of the sample to a temperature of 82°, and \npour the sample into one or more of the containers, filling to \nwithin 6 mm of the rim.' Cool to 25° over a period of not less \nthan 16 hours, protected from drafts. Two hours before the \ntest, place the containers in a water-bath at 25°. If the room \ntemperature is below 23.5° or above 26.5°, adjust the \ntemperature ofthe cone to 25° by placing it in the water-bath \nwithout disturbing the surface Of the substance under test/ \nplace the container on the penetrometer table, and lower the \ncone until the tip just touches the top surface of the test \nsubstance at a spot 25 to 3 8 mm from the edge of the container \nAdjust the zero setting and quickly release the plunger, then \nhold it free for 5 seconds. Secure the plunger, and read the \ntotal penetration from the scale. Make three or more trials; \neach so spaced that there is no . overlapping of the areas of \npenetration. Where the penetration exceeds 20 mm, use a \nseparate container of the test substance for each trial. Read \nthe penetration to the nearest 0.1 mm. Calculate the average of \nthree or more readings, and conduct further trials to a total 6f\n10 if the individual results differ from the average by more \nthan ±3 per cent. . , > .\nFinal average of the trials is not less than 10.0 mm and not \nmore than 30.0 mm, indicating a consistency value of 100 to \n300. .< . \n.\nOrganic acids. Dissolve 20.0 g in 100 ml of a mixture of \n10 volumes of ethanol (95 percent) and 20 volumes of water. \nAgitate thoroughly, and heat to boiling. Add 1 ml of \nphenolphthalein TS and titrate rapidly with 0.1 M sodium\nhydroxide, with' vigorous /agitation to :the: production of a \nsharp pink endpoint, noting the colour change in the alcohol- \nwater layer; not more than 0:4 ml of 0.1M sodium hydroxide is \nrequired.\nColour\nTest solution. Melt 10 gon a steam-bath, and pour 5 ml ofthe \nliquid into a clear-glass 15-mmx 150-mm testtube, keepingthe \npetrolatum melted.\nReference solution. A mixture of 3.2 volumes offerric chloride\nCS and 1.2 volumes of cobaltous chloride CS.\nThe warm, melted liquid is not darker than 5 ml ofthe reference \nsolution in a similar tube; the comparison of the two being\nwww.webofpharma.com\nIP2022\nmade in reflected light; against a white background and the \npetrolatum tube being held directly against "}},{"@id":"https://www.openphar.org/data/ip/monographs/phenindione","@type":"IndexedMonograph","prefLabel":{"en":"Phenindione"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenindione\nC15HI0O2 \n... Mol. Wt. 222.2\nPhenindione is 2-phenylindane- 1,3-dione.\nPhenindione contains not less than 98.0' per cent and not \nmore than 100.5 per cent of C15H10O2, calculated on the dried \nbasis.\nCategory. Anticoagulant. \n<\nDescription. Soft, white or creamy-white crystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/pheniramine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Pheniramine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pheniramine Injection\nPheniramine Maleate Inj ection\nPheniramine Injection is a sterile solution of Pheniramine \nMaleate in Water for Injections.\nPheniramine Injection contains not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of \npheniramine maleate, Ci6H20N2, C4H4O4. .\nUsual strength. 22.75 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/pheniramine-maleate","@type":"IndexedMonograph","prefLabel":{"en":"Pheniramine Maleate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pheniramine Maleate\nC16H20N2,C4H4O4 \nMol. Wt. 356:4\nPheniramine Maleate is (j/AS'l-A^Y-dimelhyl-S-phenyl- \n3-(pyridin-2-yl)propan-l-amine hydrogen maleate. .\nPheniramine Maleate contains riot less than 99.0 per cent arid \nnot more than 101.0 per cent of C16H20N2,C4H4O4, calculated \non the dried basis. \n, \n. ; ■ ;\nCategory. Antihistaminic. \n; <\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenobarbital","@type":"IndexedMonograph","prefLabel":{"en":"Phenobarbital"},"edition":"ip-2010","category":"monographs","definition":{"en":"Phenobarbital\nMol. Wt. 232.2\nPhenobarbitone is 5-ethyl-5-phenylbarbituric acid.\nPhenobarbitone contains not less than 99.0 per cent and not\nmore than 101.0 per cent of ClzHlZNz03, calculated on the\ndried basis.\nCategory. Sedative; anticonvulsant.\nDose. 60 to 300 mg at night.\nDescription. Colourless crystals or a white, crystalline powder;\nodourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenobarbitone-injection","@type":"IndexedMonograph","prefLabel":{"en":"Phenobarbitone Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenobarbitone Injection\nPhenobarbital Sodium Injection; Phenobarbitone Sodium \nInjection; Soluble Phenobarbitone Injection\nPhenobarbitone Injection is a sterile solution of \nPhenobarbitone Sodium in a mixture of nine volumes of \nPropylene Glycol and one volume of Water for Injections..\nPhenobarbitone Injection contains not less than 95.0 per cent \nand not more than 105.0 per cent of the stated amount of \nphenobarbitone sodium, C^HnNaNaCb.\nUsual strengths. 30 mg, 60 mg, 65 mg and 130 mg per ml:"}},{"@id":"https://www.openphar.org/data/ip/monographs/phenolphthalein","@type":"IndexedMonograph","prefLabel":{"en":"Phenolphthalein"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenolphthalein\nC20Hi4O4 \n. J, ... \nMol.Wt.318.3\nPhenolphthalein is 3.3-bis(4-hydroxyphenyl)phihalide. ,:\nPhenolphthalein contains not less than 98.0 per cent and not\nmore than; 102.Q per cent of C20Hi4O4, calculated on the dried \nbasis. . \n. ■ ’;■■■' Io\nCategory. Laxative.\nDescription. A white, or yellowish white,. crystalline or\namorphous powder. \n> \n.........."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenoxyethanol","@type":"IndexedMonograph","prefLabel":{"en":"Phenoxyethanol"},"edition":"ip-2018","category":"monographs","definition":{"en":"Phenoxyethanol\n(,H171(N.205S \t\nMol. Wt. 388.5\nReference solution. Add 10.0 ml of the internal standard \nsolution to 1.0 ml of test solution (a) and dilute to 100.0 ml with \ndichloromethane.\nPhenoxymethylpenicillin Potassium is potassium (6R)-6-(2- \nphenoxyacetamido)penicillinate, produced by the growth of \ncertain strains of Penicillium notatum or related organisms \non a culture medium containing an appropriate precursor, or \nobtained by any other means.\n2-Phenoxyethanol\nChromatographic system\n0\na glass column 1.5 m x 4 mm, packed with silanised \ndiatomaceous earth support (150 to 180 mesh) coated \nwith 3 per cent w/w solution of polymethylphenyl-\nsiloxane, \ntemperature: \ncolumn. 130°, \ninlet port and detector at 200°, \nflame ionization detector, \nflow rate: 30 ml per minute using nitrogen as a carrier \ngas.\n-V,\nPhenoxymethylpenicillin Potassium contains not less than \n86.0 per cent of total penicillins CI6H17N20 5S, calculated on \nthe anhydrous basis.\n(' - \nOf t\nC81-11002 \t\nMol. Wt.138.2\nCategory. Antibacterial.\nPhenoxyethanol is 1-hydroxy-2-phenoxyethane.\nDose. For an adult, the equivalent of 250 to 500 mg of \nphenoxymethylpenicillin every 6 hours, at least 30 minutes \nbefore food. For a child every 6 hours, upto I year, 62.5 mg;\nPhenoxyethanol contains not less than 99.0 per cent and not \nmore than 100.5 per cent of C 8H 1002.\n1 to 5 years, 125 mg; and 6 to 12 years, 250 mg.\nInject 1 pl of the reference solution. The test is not valid unless \nthe resolution between the peaks due to phenoxyethanol and \nmethyl laurate is not less than 12.\nCategory. Pharmaceutical aid.\nDescription. A white, crystalline powder.\nDescription. A colourless, slightly viscous liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/phentolamine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Phentolamine Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Phentolamine Injection\nPhentolamine Mesylate Injection\nPhentolamine Injection is a sterile solution of Phentolamine\nMesylate in Water for Injections containing Dextrose.\nPhentolamine Injection contains not less than 95.0 per cent\nand not more than 105.0per cent of the stated amount of\nphentolamine mesylate, C 17H 19N30, CH40 3S.\nUsual strength. 10 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/phentolamine-mesylate","@type":"IndexedMonograph","prefLabel":{"en":"Phentolamine Mesylate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phentolamine Mesylate\nOH\nCI7H!9N3(),CIL,O3S l ; \n; \nMol. Wt. 377.5\nPhentolamine Mesylate is 3-[[4,5-dihydro-lFf-imida.zol-2- \nyl)methyl] (4-methylphenyl)aminpphenol methanesulplionate.\nPhentolamine Mesylate contains not less than 99.0 per cent \nand not more than 100.5 per cent of Ci7H19N3O, CH4O3S, \ncalculated on the dried basis.\nCategory. Alpha-adrenoceptor antagonist."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylalanine","@type":"IndexedMonograph","prefLabel":{"en":"Phenylalanine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenylalanine\n¿-Phenylalanine\nPhenylalanine contains not less than 98.5 per cent and not \ndwrethan 101.5 per cent of C9HiiNO2, calculated on the dried \nbasis.\nCategory, Amino acid\nDescription. A white crystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylephrine-eye-drops","@type":"IndexedMonograph","prefLabel":{"en":"Phenylephrine Eye Drops"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenylephrine Eye Drops\nPhenylephrine Hydrochloride Eye Drops\nPhenylephrine Eye Drops is a sterile solution of Phenylephrine \nHydrochloride in purified water.\nwww.webofpharma.com\nIP2022\nPHENYLEPHRINE INJECTION\nphenylephrine Eye Drops Contain not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nphenylephrine hydrochloride, C9Hi3NO2,HCl.\nUsual strengths. 2.5 per cent w/v; 5 per cent w/v; 10 per cent\nW/V."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylephrine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Phenylephrine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenylephrine Hydrochloride\nCJL3NO2,HC1 . \n• Mol. Wt. 203.7\nPhenylephrine Hydrochloride is (R)- 1-(3-hydroxyphenyl)- \n2-methylaminoethanol hydrochloride.\nPhenylephrine Hydrochloride contains hot less than 98.5 per \ncent and not more thari 101.0 per cent of C9Hj3NO2, HC1, \ncalculated on the dried basis.\nCategory. Sympathomimetic,\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylephrine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Phenylephrine Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Phenylephrine Injection\nPhenylephrine Hydrochloride Injection\nPhenylephrine Injection is a sterile solution ofPhenylephrine\nHydrochloride in Water for Injections.\nPhenylephrine Injection contains not less than 95.0 per cent\nand not more than 105.0 per cent of the stated amount.of\nphenylephrine hydrochloride, CgH13NOz,HCl.\nIP 2010\nUsual strength. 10 mgper ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylethyl-alcohol","@type":"IndexedMonograph","prefLabel":{"en":"Phenylethyl Alcohol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenylethyl Alcohol\nC8H10O \n/■ V'- \nMoLWt.122.2\nPhenylethyl Alcohol is I-Phenylethanol.\nCategory. Pharmaceutical aid.\nDescription. A clear, colourless liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylmercuric-acetate","@type":"IndexedMonograph","prefLabel":{"en":"Phenylmercuric Acetate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Phenylmercuric Acetate\nMol. Wt. 336.7\nPhenylmercuric Acetate is (acetato)phenylmercury.\nPhenylmercuric Acetate contains not less than 98.0 per cent\nand not more than 100.5 per cent ofCgHgHg02•\nCategory. Pharmaceutical aid (antimicrobial preservative).\nDescription. A white to creamy white, crystalline powder, or\nsmall white prisms or leaflets."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylmercuric-nitrate","@type":"IndexedMonograph","prefLabel":{"en":"Phenylmercuric Nitrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenylmercuric Nitrate\nPhenylmercuric Nitrate is a mixture of phenylmercuric nitrate, \nC6H5HgNO3 and phenylmercuric hydroxide, CJ J JIgOn.\nPhenylmercuric Nitrate contains not less than 62.5 per cent \nand not more than 63.5 per cent of mercury, Hg, calculated oh \nthe dried basis.' \n\" '• \n■':\nCategory. Antiseptic; pharmaceutical aid (antimicrobial \npreservative).\nDescription. A white or pale yellow powder. :"}},{"@id":"https://www.openphar.org/data/ip/monographs/phenylpropanolamine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Phenylpropanolamine Hydrochloride"},"edition":"ip-2010","category":"monographs","definition":{"en":"Phenylpropanolamine Hydrochloride\n, Hel\n~HI3NO,HCl\nMol. Wt.187.7\nPhenylpropanolamine Hydrochloride is (IRS,2SR)-2-amino-\nI-phenylpropan-l-01 hydrochloride.\nPhenylpropanolamine Hydrochloride contains not less than\n99.0 percent and notmorethan 101.5 percentofCcjHI3NO,HCl,\ncalculated on the dried basis.\nCategory. Adrenoreceptor antagonist.\nDescription. A white or almostwhite crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenyramidol-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Phenyramidol Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenyramidol Hydrochloride\nFenyramidol Hydrochloride = -\nc13h14n2o,hci \nMoi. wt.250.7\nPhenyramidol Hydrochloride is l-l)henyl-2-(2-pyridylamino)\nethanol hydrochloride.\nwww.webofpharma.com\nIP .2022:\nPhenyramidol Hydrochloride contains not less than 98.0 per \ncent and not more than 102.0 per cent of C13H, 4N2O,HC1. <\nCategory- Muscle Relaxant; Analgesic. ,\nDescription. A white to cream coloured crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenytoin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Phenytoin Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Phenytoin Injection\nPhenytoin SodiumInjection; Diphenylhydantoin Sodium\ninjection\nPhenytoin Injection is a sterile material consisting ofPhenytoin\nSodium with or without buffering agents and other excipients.\nIt is filled in a sealed container.\nThe injection is constituted by dissolving the contents of the\nsealed container in the requisite amount of sterile Water for\nInjection or other suitable solvent, immediately before use.\nThe constituted solution complies with the requirements for\nClarity of solution and Particulate matter stated under\nParenteral Preparations (Injections).\nStorage. The constituted solution should be used immediately\nafter preparation but, in any case, within the period\nrecommended by the manufacturer.\nPhenytoin Injection contains not less than 90.0 per cent and\nnot more than 110.0 per centofthe stated amount ofphenytoin\nsodium, ClsHjjNzNaOz.\nUsual strengths. 100 mg; 250 mg.\nDescription. A white powder; odourless; somewhat\nhygroscopic.\nThe contents of the sealed container comply with the\nrequir~ments stated under Parenteral Preparations\n(Powdersfor Injection) andwith thefollowing requirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenytoin-oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Phenytoin Oral Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenytoin Oral Suspension\nDiphenylhydantoin Oral Suspension . \\\nPhenytoin Oral Suspension is a suspension of phenytoin in a \nsuitable flavoured vehicle.\nPhenytoin Oral Suspension contains not less than 90.0 pef \ncent and not more than 110.0 per cent ofthe stated amount of \nphenytoin, C15H12N2O2. \nf\n3266 \nSttfclOMS\nIP 2022\nUsual strength. 25 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/phenytoin","@type":"IndexedMonograph","prefLabel":{"en":"Phenytoin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phenytoin\nC;5HI2N2O2 \n.. \n:........ , .Mol. Wt 252.3\nPhenytoin is 5,5<iiphenyIimidazolidine--2.4-dione. \n.\nPhenytoin contains not less than 99.0 per cent and not more \nthan 101.0 per cent of C^H^NaC^, calculated on the dried \nbasis..\nCategory. Anticonvulsant. ;\nDescription . A white or almost white, crystalline powder. \n-"}},{"@id":"https://www.openphar.org/data/ip/monographs/pholcodine-linctus","@type":"IndexedMonograph","prefLabel":{"en":"Pholcodine Linctus"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pholcodine Linctus\nPholcodine Linctus is a solution containing 0.1 per cent w/v \nsolution of Pholcodine and 1 per cent w/v solution of Citric \nAcid Monohydrate in a suitable flavoured vehicle.\nPholcodine Linctus contains not less than 0.090 per cent and \nnot more than 0.110 per cent w/v. of pholcodine,\nC23H30N2O4H2O.\nCategory. Opiojd cough suppressant. ."}},{"@id":"https://www.openphar.org/data/ip/monographs/phosphate-dodecahydrate","@type":"IndexedMonograph","prefLabel":{"en":"Phosphate Dodecahydrate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Phosphate Dodecahydrate\nNa2I I PO4,12H20 \t\nMol. Wt. 358. 1\nCalculate the content of Na 2HPO 4 from the expression\n1420(25 - nd/w (100 -  d), \nWhere  d is the percentage water content. \t\n\"\nReference solution (b). Dissolve 50 mg of propylparaben  RS \nin -2,51n1 of niethanol and dilute to 50.0 ml with the mobile \nphase. Dilute- 10.0 ml of this solution to 100.0 ml with the\nStidit*i .Thospl*te contains not less than 98.0 per cent and \nnot nixie thati. 101.0 per cent of Na 2HPO4, calculated on the\nrage. Store protected from moisture.\nanhydrous basis.\nmobile phase.\n3'2-32\n4,*\nReference solution (c).  Dilute 1.0 ml of the test solution to \n20.0 ml with the mobile phase. Dilute 1.0 ml of this solution to \n10.0 ml with the mobile phase.\nChromatographic system\n-\na stainless steel column 15 cm x 4.6 mm, packed with \noctadecylsilane bonded to porous silica (5 p.m), \n-\nmobile phase: a mixture of 35 volumes of 0.68 per cent \nw/v solution of potassium dihydrogen phosphate, and \n65 volumes of methanol, \n-\nflow rate: 1.3 ml per minute, \n-\nspectrophotometer set at 272 nm, \n-\ninjection volume: 10 pl.\nThe relative retention time with reference to propylparaben \nfor 4-hydroxybenzoic acid is about 0.3, for propylparaben \nimpurity C is about 0.7.\nInject reference solution (a). The test is not valid unless the \nresolution between the peaks due to propylparaben and \npropylparaben impurity C is not less than 5.0.\nInject reference solution (c) and the test solution. Run the \nchromatogram 2.5 times the retention time of the principal \npeak. In the chromatogram obtained with the test solution the \narea of any peak corresponding to 4-hydroxybenzoic acid \nmultiplied by 1.4 is not more than 8 times the area the principal \npeak in the chromatogram obtained with reference solution \n(c) (4.0 per cent). The area of any other secondary peak is not \nmore than the area of the principal peak in the chromatogram \nobtained with reference solution (c) (0.5 per cent). The sum of \nareas of all the secondary peaks other than 4-hydroxybenzoic \nacid is not more than twice the area of the principal peak in the \nchromatogram obtained with reference solution (c) (1.0 per \ncent). Ignore the peak with an area less than 0.2 times the area \nof the principal peak in the chromatogram obtained with \nreference solution (c) (0.1 per cent).\nChlorides (2.3.12). Dissolve 1.0 g in 20 nil of water, add 0.4 ml \nof nitric acid and filter. 15 ml of the filtrate complies with the\nlimit test for chlorides (330 ppm).\nSulphates (2.3.17). Dissolve 0.5 g in 40 ml of water, add 3.5 ml \nof 2 M hydrochloric acid, dilute to 60 ml with water and filter.\n15 ml of the filtrate complies with the limit test for sulphates \n(0.12 per cent).\nWater (2.3.43). Not more than 5.0 per cent, determined on\n1.0 g.\nAssay. Determine by liquid chromatography (2.4.14), as \ndescribed in the Related substances.\nInject reference solution (b) and the test solution.\nCalculate the content of C ioH I INa03, multi plying.the content \n-• \t\n• •  \nof propylparaben by a correction factor of\nStorage. Store protected from moisture.\n„--.\nSODIUM STARCH GLYCOLLATE \nip 2018 \nSODIUM PROPYLPARABEN\nChlorides (2.3.12). To 25 ml of solution A add 15 ml of water\nSodium Salic ∎ late\nwater-bath and then cautiously over a flame at about 600°. \nContinue heating until all black particles have disappeared, \nallow to cool, add 0.1 ml of 1 M sulphuric acid, heat to ignition \nonce again and allow to cool. Add 0.1 ml of 2 M ammonium \ncarbonate, evaporate to dryness and cautiously ignite. To \nthe residue add 5 ml of hydrochloric acid, evaporate to \ndryness on a water-bath and dissolve the residue in 100 ml of \nwater. 25 ml ofa solution complies with the limit test for heavy \nmetals, Method A (20 ppm).\nand 10 ml of  2 M nitric acid and filter. 25 ml of the filtrate\ncomplies with the limit test for chlorides (200 ppm).\nCOONa\nSulphates (2.3.17). 2.5 ml of solution A diluted to 15 ml with \ndistilled water  complies with the limit test for sulphates\nOH\n(600 PPn1)"}},{"@id":"https://www.openphar.org/data/ip/monographs/phosphoric-acid","@type":"IndexedMonograph","prefLabel":{"en":"Phosphoric Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phosphoric Acid\nOrthophosphoric Acid; Concentrated Phosphoric Acid\nH3PO4 \n; . Mol. Wt. 98.0\nPhosphoric acid contains not less than 84.0 per cent w/w and \nnot more than 90.0 per cent w/w of H3PO4. .\nCategory. Pharmaceutical aid (acidifying agent).\nDescription. A clear, colourless, syrupy liquid; corrosive. \nWhen kept at a low temperature it may solidify, producing a \nmass of colourless crystals which do not melt until the \ntemperature reaches 28°."}},{"@id":"https://www.openphar.org/data/ip/monographs/physical-appearance-and-color","@type":"IndexedMonograph","prefLabel":{"en":"Physical Appearance and Color"},"edition":"ip-2022","category":"monographs","definition":{"en":"Physical Appearance and Color \n|\n(Monoclonal)\nAnti-D (IgM) Monoclonal blood grouping reagent shouid be I \nvisibly clear with no turbidity, precipitate, particles .or gel I \nformation. Anti-D (IgM) Monoclonal blood grouping reagent I \nis colorless.- ■ \n■ , \n- \n.. ■ . i , I\nExpiration date. Thè expiration date for Anti-D (IgM) blood \ngrouping reagent is not less than 1 year at 2° to 8°.\nStorage. Storage at a temperature between 2° and 8°.\nPotency. It is defined as the reciprocal of the greatest reagent I \ndilution for which the reaction is graded at 1+. Anti-D. (IgM) | \nMonoclonal blood grouping reagent should have an average; | \npotency value greater than or equal to that of suitable reference: I \nstandard. \n|\nLabelling. Label states (1 ) Source of product; (2) Test method \n(s) recommended; (3) Storage temperature; (4) Preservative \nused and its concentration; (5) Statement “FOR IN VITRO \nDIAGNOSTIC USE”.\n’..Type of Reagent \nTest Red Bipod Cells \nSpecificity\nAnti-D (IgM) \nO+ve(R]rorRiR2) \nPositive\n;l' '(Monoclonal) \nO-ve (rr or r’r or r”r) \nNegative\nType of Reagent Test Red \nTitre \nI\nAnti-D Blend (IgM + IgG) Monoclonal \nReagent\nBlood Cells Immediate \nAt 37“for I\nspin. \n30 minutes:t I"}},{"@id":"https://www.openphar.org/data/ip/monographs/physostigmine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Physostigmine Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Physostigmine Injection\nPhysostigmine Injection is a sterile solution ofPhysostigmine\nSalicylate in Water for Injections.\nPhysostigmine Injection contains not less than 90.0 per cent\nand not more than 110.0 per cent of the stated amount of\nphysostigmine salicylate, ClsH21N302, C7H60 3.\nUsual strength. 600 flg perml."}},{"@id":"https://www.openphar.org/data/ip/monographs/phytomenadione-injection","@type":"IndexedMonograph","prefLabel":{"en":"Phytomenadione Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phytomenadione Injection\nPhytomenadione Injection is a sterile solution of \nPhytomenadione in Water for Injections with auxiliary \nsubstances.\nwww.webofpharma.com\nenadione Injection contains not less than 90.0 per cent \nPy^ore than 115.0 per cent of the stated amount of \n^¡nadione,\n^ strengths. 1 mg per 0.5 ml; 1 mg per ml; 10 mg per ml.\njpfton. Aclcar to slightly opalescent pale yellow coloured \n¿l^hen niaintained at a temperature below 25°.\nfptiffcatioii\nexamined in the range 230 nmto 350 nm (2.4.7), a 0.01\ns°hh*on ethanol shows absorption maxima at\nSsnihandminima at 292 nm."}},{"@id":"https://www.openphar.org/data/ip/monographs/phytonadione","@type":"IndexedMonograph","prefLabel":{"en":"Phytonadione"},"edition":"ip-2022","category":"monographs","definition":{"en":"Phytonadione\nC3iH46O2 \nMol. Wt. 450.7\nPhytomenadione is 2-methyL3-(3,7,ll,15-tetramethyl-2- \nhexadecenyl)naphthoquinone.\nPhytomenadione contains not less than 97.0 per cent and not \nmore than 103.0 per cent of C31H46O2\nPhytomenadione is a mixture of E- and Z-isomers containing \nnot more than 21.0 per cent bf the Z-isomers.\nCategory. Vitamin K analogue, anticoagulant.\nDescription. A clear, intense yellow, viscous, oily liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/pilocarpine-eye-drops","@type":"IndexedMonograph","prefLabel":{"en":"Pilocarpine Eye Drops"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pilocarpine Eye Drops\nPilocarpine Nitrate Eye Drops .\nPilocarpine Eye Drops is a sterile solution of Pilocarpine Nitrate \nin Purified Water \n.\nPilocarpine Eye Drops contains not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \npilocarpine nitrate, CnH]6N2O2,HNO3;\n3272\nPILOCARPINE NITRATE\nIP 2022;\nUsual strengths. 1 per cent w/v: 2 per cent w/v; 4-per cent w/y"}},{"@id":"https://www.openphar.org/data/ip/monographs/pilocarpine-nitrate-eye-drops","@type":"IndexedMonograph","prefLabel":{"en":"Pilocarpine Nitrate Eye Drops"},"edition":"ip-2018","category":"monographs","definition":{"en":"Pilocarpine Nitrate Eye Drops\non the dried basis.\nPilocarpine Eye Drops is a sterile solution of Pilocarpine Nitrate \nin Purified Water.\nCategory. Cholincrgic.\nThe retention time of the principal peak is about 20 minutes. \nThe elution order is pilocarpine impurity B (pilo&arpicatid), \npilocarpine impurity C (isopilocarpic acid), pilocarpine impurity \nA (isopilocarpine) and pilocarpine.\nDose. 20 to 40 pg.\nl'ilocaipine-Eye Drops contains not less than 90.0 per cent \nand not more: than 110.0 per cent of the stated amount of \npilocarpine nitrate, CIII-116N202, HNOA.\nDescription. Colourless crystals or a white, crystalline powder; \nodourless; sensitive to light.\nUsual strengths. 1 per cent w/v; 2 per cent w/v; 4 per\ncent w, v."}},{"@id":"https://www.openphar.org/data/ip/monographs/pilocarpine-nitrate","@type":"IndexedMonograph","prefLabel":{"en":"Pilocarpine Nitrate","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pilocarpine Nitrate\nC:i1I1£NW1IN0?, \n■ Mol. Wt. 271.3\nPilocarpine Nitrate is (35,47? )-3-ethyI-4-[(l -methyl-1.77-. \nimidazol-5-yl)methyl] dihydroiiiran-2(377)-one nitrate.\nPilocarpine Nitrate contains not'less than 98.5, per cent and\nnot more than 101:0 per cent of Gi i H; NYX HNO3, calculated \non the dried basis, .... \n,\nCategory. Cholinergic.\nDescription. Colourless crystals or a white, crystalline powder; \nsensitive to light. \n. J LT-”\nPILOCARPINE NITRATE"}},{"@id":"https://www.openphar.org/data/ip/monographs/pimozide","@type":"IndexedMonograph","prefLabel":{"en":"Pimozide"},"edition":"ip-2010","category":"monographs","definition":{"en":"Pimozide\nF\nF\nMo1.Wt. 461.6\nPimozide is 1-[I-[4,4-bis(4-fluorophenyl)butyl]piperidin-4-\nyl]-l,3-dihydro-2H-benzimidazol-2-one.\nPILOCARPINE NITRATE\nIP 2010\nPimozide contains not less than 99.0 per cent and not more\nthan 101.0 per cent ofCzsHz9FzN30, calculated on the dried\nbasis."}},{"@id":"https://www.openphar.org/data/ip/monographs/pindolol-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Pindolol Tablets"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pindolol Tablets\nPindolol Tablets contains not less than 90.0 per cent and not \nmore than 110.0 per cent ofthe stated amount of pindolol,\nUsual strengths. 5 mg; 15 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/pindolol","@type":"IndexedMonograph","prefLabel":{"en":"Pindolol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pindolol\nch3 ’\nCl4H20N2O2 \n. Mol.wt.248.3\nPindolol is (RS)-1 -indo 1-4-yloxy-3-isoprdpylaminopropan- \n2-ol. '\nPindolol contains not less than 99.0 per cent and not more \nthan 101.0 per cent of C14H2oN202, calculated on the dried \nbasis.\nCategory. Beta-adrenoceptor antagonist. .'■■ ■\n3275\nwww.webofpharma.com\nPINDOLOL\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pioglitazone-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Pioglitazone Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pioglitazone Hydrochloride\nO\nC19H20N2O3S,HCl \n: \nMol.Wt.392.9\nPioglitazone Hydrochloride is (R1S’)-5-{4-[2-(5-ethyl-2- \npyridinyl)ethoxy]benzyl}1hiazolidine-2,4-dione hydrochloride.\nPioglitazone Hydrochloride contains not less than 98.0 per \ncent and not more than 102.0 per cent of C19H20N2 O3S,HC1, \ncalculated on the dried basis.\n3277\nwww.webofpharma.com\nCategory. Antidiabetic.\nDescription. A white or almost white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/piperacillin-and-tazobactam-injection","@type":"IndexedMonograph","prefLabel":{"en":"Piperacillin and Tazobactam Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piperacillin and Tazobactam Injection\nPiperacillin and Tazobactam Injection is a sterile material \nconsisting of Piperacillin Sodium and Tazobactam Sodium with \nor without excipients. It is filled in a sealed container.\nThe injection is constituted by dissolving the contents ofthe \nsealed container in the requisite amount of sterile Water for \nInjections, immediately before use.\nThe constituted solution complies with the requirements for \nClarity of solution and Particulate matter stated under \nParenteral Preparations (Injections).\nStorage. The constituted solution should be used immediately \nafter preparation but, in any case, within the period \nrecommended by the manufacturer.\nPiperacillin and Tazobactam Injection contains not less than \n90.0 per cent and not more than 116.0 per cent of the stated \namounts of piperacillin, C23H27N5O7S and tazobactam, \nC10Hi2N4O5S, the labelled amounts representing proportions \nof piperacillin to tazobactam of 8:1. It may contain small \namounts of a suitable buffers and stabilizers.\n3286\nR 2022\nUsual strengths. Piperacillin, 4 g and Tazobactum, 500 mgper \nvial; Piperacillin, 2 g and Tazobactum, 250 mg per vial.\nThe contents of the sealed container comply with the- \nrequirements stated under Parenteral Preparations \n(Powdersfor Injection) and with the following requirements"}},{"@id":"https://www.openphar.org/data/ip/monographs/piperacillin-for-intravenous-infusion","@type":"IndexedMonograph","prefLabel":{"en":"Piperacillin for Intravenous Infusion"},"edition":"ip-2018","category":"monographs","definition":{"en":"Piperacillin for Intravenous Infusion\nPiperacillin for Intravenous Infusion is a sterile material \nconsisting of Piperacillin Sodium or Piperacillin Sodium \nprepared by the interaction of piperacillith - ,sodium :\n bicarbonate, \nwith or without excipients. It isfillidiri a sealed \ncontainer."}},{"@id":"https://www.openphar.org/data/ip/monographs/piperacillin-intravenous-infusion","@type":"IndexedMonograph","prefLabel":{"en":"Piperacillin Intravenous Infusion"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piperacillin Intravenous Infusion\nPiperacillin Intravenous Infusion is a 'sterile solution of \nPiperacillin Sodium in Water for Injections. It is prepared by \ndissolving Piperacillin for Intravenous Infusion in the requisite \namount of Water for Injections before use.\nThe intravenous infusion complies .with the requirements \nstated under Parenteral Preparations (Injections).\nPiperacillin for Intravenous Infusion\nPiperacillin for Intravenous .Infusion is .a sterile material \nconsisting of Piperacillin Sodium or Piperacillin Sodium \nprepared by the interaction of piperacillin with sodium \nbicarbonate, with or without excipients. It is filled in a sealed \ncontainer. \n; \n;\nThe constituted solution'complies with the requirements for \nClarity of solution and Particulate matter stated under \nParental Preparations (injections).\nStorage. The constituted solution should be used immediately \nafter preparation but, ih any case,' within the period\nrecommended by the manufacturer.\nPiperacillin for Intravenous Infusion contains nof less than \n94.0 per cent and hot more than 115.0 per cent of the stated\namount of piperacillin, C23H27N5O7S..- \n.....\nUsual strengths. 1 g per vial; 2 g per vial; 4 g per vial. ~\nThe contents of the sealed container comply with the \nrequirements stated under Parental Preparations (Powder \nfor Injections) and with the following, requirements. ."}},{"@id":"https://www.openphar.org/data/ip/monographs/piperacillin-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Piperacillin Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piperacillin Sodium\nC23H26N5NaO7S \nMol.Wt 539.5\n3.284\nIP 2022 W\nPiperacillin is Sodium (2S,-5R,6/i)-6-[[(2/?)-2-[[(4-ethyl-2,3. I \ndioxopiperazin-1 -yl)carbonyl] amino]-2-phenylacetyl]amino], .1 \n3,3-dimeihyl-7-oxo-4-thia-i-azabicyclo[3.2.0]heptane-2- < \ncarboxylate.\nPiperacillin Sodium contains not less than 95.0 per cent and 1 \nnot more than 102.0 per cent of C23H26N5NaO7S, calculated on I \nthe anhydrous basis. \n|\nCategory. Antibacterial. \n\" ' \n1\nDescription. A white or almost white powder, hygroscopic. |"}},{"@id":"https://www.openphar.org/data/ip/monographs/piperacillin","@type":"IndexedMonograph","prefLabel":{"en":"Piperacillin"},"edition":"ip-2010","category":"monographs","definition":{"en":"Piperacillin\n. H20\nMol.Wt. 535.6\nPiperacillin is (6R)-6-[R-2-(4-ethyl-2,3-dioxopiperazine-l-\ncarboxamido)-2-phenylacetamido]penicillanic acid\nmonohydrate.\nPiperacillin contains not less than 96.0 per cent and not more\nthan 102.0 per cent of CZ3Hz7Ns07S, calculated on the\nanhydrous basis.\nCategory. Penicillinantibacterial.\nDescription. A white oralmost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/piperazine-adipate","@type":"IndexedMonograph","prefLabel":{"en":"Piperazine Adipate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Piperazine Adipate\nIP 2010\nPiperazine Adipate contains not less than 98.0 per cent and\nnot more than 101.0 per cent ofC4H ION2, C6H IO0 4, calculated\non the anhydrous basis.\nCategory. Anthelmintic.\nDescription. A white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/piperazine-citrate-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Piperazine Citrate Syrup"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piperazine Citrate Syrup\nPiperazine Citrate Oral Solution; Piperazine Citrate Elixir\nPiperazine Citrate Syrup is a solution of Piperazine Citrate in a \nsuitable flavoured Vehicle.. . . \n■> . . \n. \n. .....\nPiperazine Citrate Syrup contains the equivalent of not less \nthan 92.5 per cent, and not more ,than 107.5. per cent of the \nstated amount of piperazine hydrate, C.; H10N2,6H2O.\nUsual strength. The equivalent of 750 mg of piperazine \nhydrate in 5 ml.\n(125 mg of Piperazine Citrate or 110 mg o f anhydrous piperazine \ncitrate is approximately equivalent to 100 mg of Piperazine \nHydrate). \n■ \n■"}},{"@id":"https://www.openphar.org/data/ip/monographs/piperazine-citrate","@type":"IndexedMonograph","prefLabel":{"en":"Piperazine Citrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piperazine Citrate\n(C4HjoN2)3,2C&Hg07 \nMol. Wt. 642.7 (anhydrous)\nPiperazine Citrate is a salt of piperazine with citric acid \ncontaining a variable amount of water of crystallisation.\nPiperazine Citrate contains not less than 98.0 per cent and not \nmore than 101.0 per cent of (C^ioN^, 2C6H8O7, calculated on \nthe anhydrous basis. \nw\nCategory. Anthelmintic.\nDescription. Awhite, granular powder. ,\nIdentification ,,\nTest A maybe omitted if tests B and C are carried out. Test B \nmay be omitted if tests A and C are carried out.\nA. Determine by infrared absorption spectrophotometry (2.4.6). \nCompare the spectrum with that , obtained with piperazine \ncitrate IPRS or with the reference spectrum; of piperazine \ncitrate. ■ ■ \n. . \n■\nB. In the test for Related substances, examine the plate after \nspraying with both the ninhydrin solutions. The principal \nspot in the chromatogram obtained with test solution (b) \ncorresponds to that in the chromatogram obtained with \nreference solution (a).\nC. A 10 per cent w/v solution gives the reactions of citrates \n(2.3.1). \n■ \n' -- ■\nAppearance of solution. A 5.0 per cent w/v solution is clear \n(2.4.1), and not more intensely coloured than reference solution \nBS8(2.4.I).\npH (2.4.24). 5.0 to 6.0, determined in a 5.0 per cent w/v solution.\nRelated substances. Determine by thin-layer chromatography \n(2.4.17), coating the plate with silica gel G.\nSolvent mixture. 60 volumes oi strong ammonia solution and \n40 volumes of ethanol. . \n. . . \n. . ..\nMobile phase. A freshly prepared mixture of 80 volumes of \nacetone and 20 volumes of strong ammonia solution.' •\nTest solution (a).' Dissolve 1 g of the substance under \nexamination in 10 ml ofthe solvent mixture. ■ ■'' '■\nTest solution (b). Dissolve 1 g of the substance under \nexamination in 100 ml of the solvent mixture.\nReference solution (a). A 1.0 per cent w/v solution of \npiperazine citrate IPRS in the solvent mixture.\nReference solution (b). A 0.025 per . cent w/v solution of \nethyl 'enediamihe in the solvent 'mixture.\nReference solution (c).,A 0.025 per cent w/v solution of \ntriethylenediamine in the solvent mixture.\nReference solution (d). A solution containing 0.025 per cent \nw/v of triethylenediamine and 1 per cent w/v bf the substance \nunder examination in the solvent mixture.\n3289\nwww.webofpharma.com\nApply to the plate 5 pl of each solution; Alter development; \ndry the plate at 105°, spray with a 0.3 per cent w/v solution of \nninhydrin in a mixture of 3 volumes of anhydrous acetic acid \nand 100 volumes of 1-butanol and then with a 0,15 per cent \nw/v solution of ninhydrin in ethanol' anti dry at 105° for\n10 minutes. Any secondary spot in the chromatogram obtained \nwith test solution (a) is not more intense than the spot in the \nchromatogram obtained with reference solution (b). Spray the \nplate with 0.05 M iodine and allow to stand for about\n10 minutes. Any spot corresponding to triethylenediamine in \nthe chromatogram obtained with test solution (a) is not more \nintense than the spot in the chromatogram obtained with \nreference solution (c)'. The test is not valid unless the \nchromatogram obtained with reference solution (d) shows two \nseparated spots. Ignore any spot remaining on the line of \napplication. \n.\nHeavy metals (2.3.13). 1.0 g complies with the limit test for \nheavy metals, Method A (20 ppm).\nSulphated ash (2.3.18).'Not more than 0.1 percent.\nWater (2.3.43). 10.0 to 14.0 per cent, determined on 0.3 g.\nAssay. Dissolve 0.2 g in 10 ml of anhydrous glacial acetic \nacid with gentle heating and dilute to 70 ml with the same \nsolvent. Titrate with 0.1 Mperchloric acid, using 0.25 ml of \n1-naphtholbenzein solution as indicator and titrating until \nthe colour of the solution changes from brownish yellow to \ngreen. Carry out a blank titration.\n1 ml of 0.1 Mperchloric acid is equivalent to 0.01071 g of \n(C^oN^^CfiHsOy. ; \nJ :\nStorage. Store protected from light and moisture."}},{"@id":"https://www.openphar.org/data/ip/monographs/piperazine-hydrate","@type":"IndexedMonograph","prefLabel":{"en":"Piperazine Hydrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piperazine Hydrate\nC4H10N2,6H2O \nMol. Wt. 194.2\nPiperazine Hydrate contains not less than 98.0 per cent and \nnot more than 101.0 per cent of C4Hi0N2, 6H2O.\nCategory. Anthelmintic.\nDescription. Colourless, glassy deliquescent crystals.\n3290\nwww.webofpharma.com\nPIPERAZINE PHOSPHATE\nIP 2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/piperazine-phosphate","@type":"IndexedMonograph","prefLabel":{"en":"Piperazine Phosphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piperazine Phosphate\nH\nI J , H3PO4) H2O .\nH\nC-H10N2,H3P()4,H2O \n; Mol. Wt. 202.2\nPiperazine Phosphate contains not less than 98.5 per cent and \nnot more than 100.5 per cent of QHkjN^HsPO^ calculated on \nthe anhydrous basis.\nCategory. Anthelmintic.\nDescription. A white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/piracetam","@type":"IndexedMonograph","prefLabel":{"en":"Piracetam"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piracetam\no\nVJ' o\nC6HwN2O2 \n. .. Mol.wt. 142.2\nPiracetam is 2-(2-oxopyrrolidin-l-yl)acetamide.\nPiracetam contains not less than 98.0 per cent and not more \nthan 102.0 per cent of C6H10N2O2jcalculated onthe dried basis.\nCategory. Nootropic.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pirfenidone","@type":"IndexedMonograph","prefLabel":{"en":"Pirfenidone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pirfenidone\nC12HnNO \n■ Mol.Wt.185.2\nP irfenidone is 5-methyl-1 -phenylpyrid i n-2-one.\nPirfenidone contains not less than 98.0 per cent and not more \nthan 102.0 per cent of CnHnNO, calculated on anhydrous \nbasis.\nCategory. Antifibrotic and anti-inflammatory.-\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/piroxicam-gel","@type":"IndexedMonograph","prefLabel":{"en":"Piroxicam Gel"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piroxicam Gel\nPiroxicam Gel contains not less than 95.0 per cent and not \nmore than 105.0 per cent of the stated amount of piroxicam, \nCbH13N3O4S. \n\\\nUsual strength. 0.5 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/piroxicam","@type":"IndexedMonograph","prefLabel":{"en":"Piroxicam"},"edition":"ip-2022","category":"monographs","definition":{"en":"Piroxicam\nPiroxicam is 4-hydroxy-2-methyl-/V-(2-pyridyl)-2H-1,2- \nbenzothiazine-3 -carboxamide^ 1,1 -dioxide.\nPiroxicam contains not less than 97.0 pef cent and not more \nthan 103.0 per cent of Ci5Hl3N3O4S, calculated on the \nanhydrous basis.\nCategory. Analgesic; antiinflammatory; antipyretic.\nDescription. An off-white to light tan or light yellow powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/plague-vaccine","@type":"IndexedMonograph","prefLabel":{"en":"Plague Vaccine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Plague Vaccine\nFormolised Plague Vaccine\n.Plague Vaccine is a sterile suspension of killed plague bacilli,\nYersinia peslis, of the 195ZP strain grown in a suitable enriched \n^medium such as acid hydrolysate of casein, harvested and \n.killed; by the addition of formaldehyde. It may contain a suitable\npreservative.\n¡Plague Vaccine contains in each ml of human dose not less \nfthanPi.O mouse median effective immunising doses (250 ED50).\nDescription. A turbid, golden yellow or brownish liquid with \n^ without flakes or clumps."}},{"@id":"https://www.openphar.org/data/ip/monographs/plaster-of-paris","@type":"IndexedMonograph","prefLabel":{"en":"Plaster of Paris"},"edition":"ip-2022","category":"monographs","definition":{"en":"Plaster of Paris\nDried Calcium Sulphate; Exsiccated Calcium Sulphate\nCaSO4, UH.O \nMol. Wt. 145.1\nPlaster of Paris is prepared by heating powdered gypsum, \nCaSO4,2H2O, at about 150° in a controlled manner such that it \nis substantially converted into the hemihydrate, CaSCVAHiO, \nwith minimum production of the anhydrous phases of calcium \nsulphate. It may contain suitable accelerators or decelerators.\nCategory. Surgical aid.\nDescription. A white or almost white powder; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/plastic-waste","@type":"IndexedMonograph","prefLabel":{"en":"Plastic Waste"},"edition":"ip-2022","category":"monographs","definition":{"en":"Plastic Waste \nManagement Rules, 2016\n6.2. CONTAINERS\nIP 2022\n(IS 10146), Polyvinyl Chloride (IS 10151), Polypropylene (IS\n10910), Cyclic Olefins, Polyamides [nylon 6 (IS 12247)], \nPolycarbonate (IS 14971), Poly (ethylene-vinyl acetate) (IS\n13601). However, if the manufacturer of Pharmaceutical articles \nintends to. use plastics made from polymers other than listed \nabove, it should be justified and authorised by appropriate \ncompetent authority.\nThe plastic identification codes as mentioned in IS 14534 may \nbe visibly marked on the plastic containers and/ or the label, \nwherever possible.\nThe plastic containers should be manufactured from materials \nthat do not include in their composition any substances that \ncan be extracted by the pharmaceutical contents in such \nquantities that alter the efficacy or stability of the product or \npresent a toxic hazard. Recycling of excess material (shavings, \ndust, etc. from the container manufacturing plant) of well- \ndefined nature and proportions may be permitted after \nappropriate validation.' However, the use of post­\nmanufactured material is strictly prohibited. Re-use of earlier- \nfilled bottles is strictly prohibited.\nFor general information, a summary of the manufacture and \nusage of plastic containers and closures is provided in the \nTable 1.\nTable 1 - Overview of the life cycle (stages) of Plastic Materials for Pharmacopoeial Articles"}},{"@id":"https://www.openphar.org/data/ip/monographs/pneumococcal-polysaccharide-conjugate-vaccine","@type":"IndexedMonograph","prefLabel":{"en":"Pneumococcal Polysaccharide Conjugate Vaccine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pneumococcal Polysaccharide Conjugate Vaccine\n(Adsorbed)\n4444\n3290\nPneumococcal Polysaccharide Vaccine (Liquid/\nAdsorbed)\n4447\nPiperazine Citrate Oral Solution\n3290\nPods of Cassia\n4292\nPiperazine Citrate Syrup :\n3290\nPolacrilin Potassium\n289,3300\nPiperazine Hydrate\n289,1111,3290\nPoliomyelitis Vaccine (Inactivated)\n4450\nPiperazine Phosphate .\n289,3291\nPoliomyelitis Vaccine, Live (Oral)\n4454\nPiperazine Phosphate Tablets\n3292\nPoloxamerl88\n■ . 1112\nPiper longum\n4280\nPoloxamers\n289,3301;\nPiper nigrum\n4262\nPolyamide-6 (PA-6) Containers\n1259\nPiper retrofractum\n4279\nPolycarbonate (PC) Containers\n1257\nPippali, Large\n913,1026,4279\nPolyacrylamide Gel Electrophoresis\n229\nPippali, Small\n913,1026,4280\nPoly(cyanopropyl) siloxane ;\n1112\nPiracetam\n.. 289,766,3292\nPoly(Ethylene-vinyl Acetate) (PEVA) Containers.\n1254\nPirfenidone\n289,767,3293.\nPolydimethylsiloxane, Activated ■\n2122\nPirfenidone Tablets\n3294\nPolyethylene Glycol 300\n1112\nPiroxicam\n.289,767,3295\nPolyethylene Glycol 400\n, . ■ 1112\nPiroxicam Capsules\n3296\nPolyethylene Glycol 600\n. 1H2\n3297 Polyethylene Glycol 1000 \n\" . \n1112\n3298 Polyethylene Glycol 1500 - \n: \n289,3302\n289,3298 Polyethylene Glycol 4000 \n; 289,3303\n. 4443 Polyethylene Glycol 6000 \n. . . \n. \n, . \n289,3303:\n4628 Polyethylene Glycol 20,000 \n1112\n,4240 Polyethylene Glycol 20,000 2-Nitroterephthalate ; V 1112\n4556 Polyethylene Glycol Mono-(p-isooctylphenyl) ether . 1107\nwww.webofpharma.com\nINDIAN PHARMACOPOEIA 2022\nPolyethylene Terephthalate (PET) Containers 1236\nPolyethylene (HDPE and LDPE) Containers \n1238\nPolymannuronicAcid \n1397\nPolymer Additives \n1261\nPolymorphism \n383\nPolyoxyethylene (10) isoocty locyclohexyl ether 1107\nPolypropylene (PP) Containers \n1247\nPolyoxyethylene 23 Lauryl Ether \n1H2\nPolyoxyethylene 20 Sorbitan Monolaurate \n3307\nPolyoxyethylene 80 Sorbitan Monooleate \n3308\nPolymyxin B Sulphate \n289,3304\nPolymyxin B for Injection \n3305\nPolyoxyl 35 Castor Oil \n289,3306\nPolyoxyl 40 Hydrogenated Castor Oil \n3307\nPolysaccharide Vaccines, Composition of \n413\nPolysorbate 20 \n289,1112,3307\nPolysorbate 80 \n289,1112,3308\nPolysorbate 80 Solution \n36\nPolystyrene \n483,484\nPolyvidone \n3315\nPolyvinyl Acetate Phthalate \n289,3309\nPolyvinyl Chloride, (PVC, Plasticized) Containers 1245\nPolyvinyl Alcohol \n289,3310\nPolyvinyl Chloride (PVC, Non-Plasticized) Containers 1242\nPolyvinylpyrrolidone \n3315\nPositron Emission Tomography Radiopharmaceuticals\n(PET-RPs) and Associated Radiopharmacy\nPractices \n4730\nPost-Translational Modifications of Proteins \n4571\nPotash Alum \n1068\nPotash, Caustic \n1114\nPotassium Acetate \n1112\nPotassium Antimonate \n1112\nPotassium Antimonate Solution \n1112\nPotassium Arsenite, 0.1 M \n1112\nPotassium Bicarbonate \n-- m2\nPotassium Bicarbonate Solution, Saturated Methanolic 1112\nPotassium Bisulphate \n1112\nPotassium Bromate \n1112,1144\nPotassium Bromate, 0.0167 M \n1112\nPotassium Bromate, 0.0333 M \n1112\nPotassium Bromide \n1112\nVolume 1: i toxxxiv and 1 to 1276; 1-1 to 1-108; Volume2: xxxy lo.xxxviii and 1277 to 2990; Volume 3: xxxix to xlii and 2991 to 4784; \nVolume 4: xliii to xlvi and 4785 to 5024; 1-109 to 1-216., ."}},{"@id":"https://www.openphar.org/data/ip/monographs/polacrilin-potassium","@type":"IndexedMonograph","prefLabel":{"en":"Polacrilin Potassium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Polacrilin Potassium\nPolacrillin Potassium is 2-propenoic acid, 2-methyl-, potassium \nsalt, polymer with diethenylbenzene.\nPolacrilin Potassium is the potassium salt of a unifunctional \nlow-cross-linked carboxylic cation-exchange resin prepared \nfrom methacrylic acid and divinylbenzene.\nPolacrilin Potassium contains not less than 20.6 per cent and \nnot more than 25.1 per cent of potassium, calculated on the \ndried basis.\nCategory. Pharmaceutical aid."}},{"@id":"https://www.openphar.org/data/ip/monographs/poloxamers","@type":"IndexedMonograph","prefLabel":{"en":"Poloxamers"},"edition":"ip-2022","category":"monographs","definition":{"en":"Poloxamers\n(CH2CH2O)a (CH(CH3)CH2OH)b (CH2CH2O)c H ' - \n’ •' ’\no is at least 15 and (CH2CH2O)aic is varied from 20 to 90% by weight\nMol. Wt. ranges from 1000 to >16000\nPoloxamers are polyethylenepropylpropyleneglycols.' ;\nSynthetic block copolymer of ethylene oxide and propylene \noxide represented by the following general formula:\nContent of Average \noxyethylene relative 7\nPropylene\nEthylene\noxide \nunits\noxide \nunits\nmolecular :-\n(per \ncent)\n. (a)\nmass\n,(b)\n, 124\n10-15\n18-23. ..\n.44.848.6 .\n2090-2360\n188\n75-85\n25-30\n79.9-83.7\n7680-9510\n237\n60-68\n3540 /\n70.5-74.3\n6840-8830-\n338\n137-146\n42-47\n81.4-84.9 . 12700-17400 .\n407..\n95-105\n54.60\n71.5-74.9\n9840-14600\nA suitable antioxidant maybe added.\nCategory. Pharmaceutical aid.\nDescription. Poloxamer 124 is a colourless or almost colourless \nliquid and poloxamers 188,237,338,407 are a white or almost \nwhite, waxy powder, microbeads or flakes.."}},{"@id":"https://www.openphar.org/data/ip/monographs/polyethylene-glycol-1500","@type":"IndexedMonograph","prefLabel":{"en":"Polyethylene Glycol 1500"},"edition":"ip-2010","category":"monographs","definition":{"en":"Polyethylene Glycol 1500\nMacrogol1500\nPolyethylene Glycol 1500 is a mixture ofthe polycondensation\nproducts of ethylene oxide and water obtained under\ncontrolled conditions. It is represented by the formula\nHOCH2[CH20CH2]nCH20H, where n is between 28 and 36.\nCategory. Pharmaceutical aid (ointment base).\nwww.webofpharma.com\nPOLYETHYLENE GLYCOL 1500\nDescription. A white or creamy white, soft, wax-like solid;\nodour, faint and characteristic."}},{"@id":"https://www.openphar.org/data/ip/monographs/polyethylene-glycol-4000","@type":"IndexedMonograph","prefLabel":{"en":"Polyethylene Glycol 4000"},"edition":"ip-2022","category":"monographs","definition":{"en":"Polyethylene Glycol 4000\nMacrogol4000\nPolyethylene Glycol 4000 is a mixture ofthe polycondensation \nproducts of ethylene oxide and water obtained under \ncontrolled conditions. It. is represented by the formula \nHOCH2[CH2OCH2]„CH2OH, where n is between 69 and 84.\nCategory. Pharmaceutical aid (ointment base).\nDescription. A creamy white, hard, wax-1 ike solid, powder or \nflakes."}},{"@id":"https://www.openphar.org/data/ip/monographs/polyethylene-glycol-6000","@type":"IndexedMonograph","prefLabel":{"en":"Polyethylene Glycol 6000"},"edition":"ip-2022","category":"monographs","definition":{"en":"Polyethylene Glycol 6000\nMacrogol 6000 .\nPolyethylene Glycol 6000 is a mixture ofthe polycondensation \nproducts, of ethylene oxide and water obtained under \ncontrolled conditions. It is represented by the formula \nHOCH2[CH2OCH2]kCH2OH, where n is between 112 and 158.\nCategory. Pharmaceutical aid (ointment base and tablet \nexcipient).\nDescription. A white to creamy white, wax-like solid or flakes.\nTests ■ ' ■ ■■\nAppearance of solution (2.4.1). A15.0 per cent w/v solution is \nnot more intensely coloured than reference solution BYS6.\npH (2.4.24). 4.5 to 7.5, determined in a 5.0 per cent w/v solution.\nFreezing point (2.4.11). 56° to 60°.\nViscosity (2.4,28), 250 mm2s“’ to 390 mnrs determined at\n100° by .Method A using a U-tube viscometer (size F). i\nArsenic (2.3.16). Mix 313 g with 3 g of anhydrous sodium \ncarbonate, add 10 ml of bromine solution and mix thoroughly! \nEvaporate to dryness1 on a water-bath, gently ignite and \ndissolve the cooled residue in 16 ml’of brominated \nhydrochloric acid and 45 ml of water. Remove the excess of \nbromine with 2 ml of stannous chloride solution AsT. The \nresulting solution complies with the limit test for 'arsenic\nHeavy metals (2.3113). Dissolve 4,0 g in 5 ml of a 1.0 per cent \nw/v solution of hydrochloric, acid and sufficient water to \nproduce 25 ml. . The resulting solution complies with the limit \ntest for'heavy metals, Method A (5 ppm).\nSulphated ash (2.3.18). Not more than 0.1 per cent.\nStorage. Store protected from moisture.\n3303\nwww.webofpharma.com\nPolymyxin B Sulphate\nPolymyxin\nR\nRt\nX\nY\nBl\n^ch3\n-CH3 ..\n—H\n—ch3\nB2\n-ch3\n-CH3\n—H\n—ch3\nB3\n^ch3\n—H\n—ch3\nBl-I\n^ch3 -ch3\n—ch3\n—H"}},{"@id":"https://www.openphar.org/data/ip/monographs/polymyxin-b-for-injection","@type":"IndexedMonograph","prefLabel":{"en":"Polymyxin B for Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Polymyxin B for Injection\nPolymyxin B for Injection is a sterile material consisting of \npolymyxin B sulphate. It is filled in a sealed container:\nThe injection is constituted by dissolving the. contents, of the \nsealed container in the requisite amount of sterile Water for \nInjections, or 0.9 per cent w/v sodium chloride injection or 1 \nper cent w/v procaine.hydrochloride injection, immediately \nbefore use. \n... .......\nthe constituted solution complies with the requirements for \nClarity of solution and Particulate matter stated under \nParenteral Preparations - (Injections).\nStorage. The constituted solution should be used immediately \nafter preparation but, in any case, with in the period \nrecommended by the manufacturer.\nPolymyxin B for Injection contains not less than 90.0 per cent \nand not more than 120.0 per cent of the stated amount of \npolymyxinB.\nUsual strength. 500000 units per vial.\nThe contents of the sealed container, comply with the \nrequirements stated under Parenteral Preparations\n(Powdersfor Injection) and with the following requirements.\nDetermine by thin-layer chromatography (2:4.17), coating the \nplate with silica gel G.\nMobile phase. A mixture of 4 volumes of methanol, 2 volumes \nof isopropyl'alcohol, 2 volumes of methylene chloride, \n2 volumes ofammonia solution and 1.5 volumes of water.\nTest solution. Dissolve a suitable quantity of Polymyxin B for \ninjection with 0. IM hydrochloric acid to obtain a solution \ncontaining about 10000 polymyxin B units per ml.\nReference solution. Dissolve a suitable quantity of polymyxin \nB sulphate IPRS in 0. IM hydrochloric acid to obtain a solution \ncontaining about 10000 polymyxin B units per ml.\n3305\nwww.webofpharma.com\nApply to the plate ,10pl of each solution. Place.theplate in a \npresaturated chromatographic chamber and allow the mobile \nphase to rise about three-fourtho f the length of the plate.. Dry \nthe plate at 105° for 10 minutes. Spray with 0.2 per cent \nw/v solution of ninhydrin in butyl alcohol and heat at 105° \nfor 5 minutes. The principal spot in the chromatogram obtained \nwith the test solution corresppnds to spot in the chromatogram \nobtained with the reference .solution.; ■.. ; \n: \n.\nNOTE — If the chromatogram of the test solution yield \nexcessive' streaking, proceed as directed for modified \nprocedure.\nModified procedure. Transfer the test solution to a centrifuge \ntube, add 10 ml of 1.2 per cent w/v solution of picric acid, \nvortex for 1 minute, centrifiige fob 10 minutes, arid discard the \nsupernatant. Wash the residue with 1 ml portion of water until \nno yellow, colour is observed in the washing. Discard the \nwashings and dry the residue under a stream of nitrogen at \n50°. Dissolve the residue in 1 ml of acetone, add 1 ml of freshly \nprepared 1 per cent v/v solution of sulphuric acid in acetone,\nshake, centrifuge for 5 minutes, and discard the supernatant. \nRinse thercsidue with' 1 ml of acetone, centrifuge and discard \nthe washing. Repeat the washing until no yellow colour is \nobserved. Dry the . residue under a stream of nitrogen at 50°. \nDissolve the residue in 0.5 mlpf O.l.Mdiydrochloric acid. \nRepeat the procedure using this modified test solution instead \nof the test solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/polymyxin-bl","@type":"IndexedMonograph","prefLabel":{"en":"Polymyxin Bl"},"edition":"ip-2022","category":"monographs","definition":{"en":"Polymyxin Bl\nC56H98N16O13 \nMol. Wt. 1203.5\nA-[(5)-4-Amino-1 - {[(25,3 R)-1 -.{[(5)-4-amino-1 -oxo-1 - \n( {(35,65,95,125,155,185,215)-6,9,18-tris(2-aminoethyi)-15- \nbenzyl-3-[(R)-l -hydroxyethyl]- 12-isobutyl-2,5,8,11,14,17,20- \nheptaoxo-1,4,7,10,13,16,19-heptaazacyclotricosan-21 - \nyl}amino)butan-2-yl] amino}-3-hydroxy-l-oxobutan-2- \nyl]amino}-l-oxQbutan-2-yl]-6-methyloctanamide.\nPolymyxin B2\nC55H96NI6O13 \nMol. Wt. 1189.5\nA'-[(5)-4-Amino-1 - {| (25,3R)-1 - {| (5)-4-amino-1 -oxo-1 - \n({(35,65,95,125,155,185,21 .S)-6,9,l 8-tris(2-aminocthy()-15- \nbenzyl-3-[(/?)- i -hydroxyethyl]-12-isobutyI-2,5,8,11,14,17,20- \nheptaoxo-1,4,7,10,13,16,19-hcptaa7acyc!otr icosan-21 - \nyl} amino)biilan-2-yi]amino}-3-hydroxy-1 -oxobutan-2- \nyl]amino}-l-oxobutan-2-yl]-6-methylheptanamide. :\nPolymyxin B3 \" • •\nC55H96NI6O13 \nMoLWt.1189.5\njV- [(5)-4-Ami no-1 - {[(25,3R)-1 - {[(5)-4-amino-l -oxo-1 -\n({(35,65,95,125,155,185,215)-6,9,18-tris(2-aminocthy I)-15- \nbenzyl-3 -[(R)-1 -hydroxyeihyl]-12-isobuty l-2,5,8,11,14,17,20-\nheptaoxo-1,4,7,10,13,16,19-heptaazacy clotri cosan-21 - \nyi}amino)butan-2-yl]amino}-3-hydroxy-l-oxobutan-2- \nyl]amino} -1-oxobutari-2-yI]octanamide.\nPolymyxinBl-I \n’ ' \n.\nCS6H98N16O53 \n■ \nMol Wt. 1203.5\n3304\nPOLYMYXIN B SULPHATE.,\nI? 2022\nA-[(5)-4-Amino-l-{[(25,3R)-l-{[(5)-4Taminp-l-oxo-L | \n({(35,65,95,125,155,185,215)-6,9,18-tris(2-aminoethyl)-15. | \nbenzyl-3-[(R)-l-hydroxyethyl]-12-[(5)-<ec-buty]]; . | \n2,5,8,11,14,17,20-heptaoxo-r,4,7,10,;13:,16,19i 1 \nheptaazacyclotricosan-21-yl}amino)butan-2-yl]amino}-3- | \nhydroxy-1 -oxobutan-2-yl] ami ho] -1 -dxobutan-2-yI]-6- | \nmethyloctanamide. \nf\nPolymyxin B Sulphate is the sulphate salt of a kind | \nof polymyxin, a substance produced by the growth of Bacillus | \npolymyxa (Prazmowski) Migula (Fam. Bacillaceae), or a mixture I\nof two or more such salts. It has a potency of hot less than | \n6000 Polymyxin B units per mg, calculated on the dried basis |\n'7. \n■■ \n: I\nCategory. Antibacterial. \n|\nDescription. Awhite to buff-coloured powder. \n|"}},{"@id":"https://www.openphar.org/data/ip/monographs/polyoxyethylene-20-sorbitan-monolaurate","@type":"IndexedMonograph","prefLabel":{"en":"Polyoxyethylene 20 Sorbitan Monolaurate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Polyoxyethylene 20 Sorbitan Monolaurate\nPolysorbate 20 is a mixture of partial lauric esters of D-glucitol \nand its anhydrides copolymerised with approximately 20 moles \nof ethylene oxide for each mole of D-glucitol and its anhydrides. \nThe lauric acid used for the esterification may contain other \nfatty acids.\nCategory. Pharmaceutical aid (non-ionic surfactant).\nDescription. A clear or slightly opalescent, oily, yellowish or \nbrownish yellow liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/polyoxyl-40-hydrogenated-castor-oil","@type":"IndexedMonograph","prefLabel":{"en":"Polyoxyl 40 Hydrogenated Castor Oil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Polyoxyl 40 Hydrogenated Castor Oil\nPolyoxyl 40 Hydrogenated Castor Oil contains mainly the tri­\nhydroxystearate ester of ethoxylated glycerol, with smaller \namounts of polyethylene glycol tri-hydroxystearate and of \nthe corresponding free glycols. It results from the reaction of \nglycerol tri-hydroxystearate with about 40 to 45 moles of \nethylene oxide.\nCategory. Pharmaceutical aid."}},{"@id":"https://www.openphar.org/data/ip/monographs/polyvinyl-alcohol","@type":"IndexedMonograph","prefLabel":{"en":"Polyvinyl Alcohol"},"edition":"ip-2018","category":"monographs","definition":{"en":"Polyvinyl Alcohol\n01-1_ n\n(C2H40).,\nPolyvinyl Alcohol is a water soluble synthetic polymer \nrepresented by the formula (C 2H40)n, in which the average \nvalue of n lies between 500 and 5000.\nPolyvinyl Alcohol is prepared by 85 per cent to 89 per cent \nhydrolysis of polyvinyl acetate. The apparent viscosity, in \nmPa.s at 20° of 4 per cent w/w aqueous solution is not less \nthan 85 per cent and not more than 115 per cent of the label \nclaim.\nCategory. Pharmaceutical aid.\nDescription. A white to cream-coloured granular powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/potassium-chloride-for-injection","@type":"IndexedMonograph","prefLabel":{"en":"Potassium Chloride for Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Potassium Chloride for Injection\nPotassium Chloride for Injection Concentrate\nPotassium Chloride for Injection is a sterile solution of \nPotassium Chloride in Water for Injection.\n4108\nww webofpharma com\n.....................................................     _ \njP2022\nPotassium Chloride for Injection contains not less th \n95.0 per cent and not more than 105.0 per cent of the st \namountofKCl. \n. \n7;"}},{"@id":"https://www.openphar.org/data/ip/monographs/potassium-chloride","@type":"IndexedMonograph","prefLabel":{"en":"Potassium Chloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Potassium Chloride\nKCI \nMol. Wt. 74.6\nPotassium Chloride contains not less than 99.0 per cent and \nnot more than 100.5 per cent of KCI, calculated on the dried \nbasis.\nCategory. Electrolyte replenisher.\nDescription. Colourless crystals or a white, crystalline powder.\nDissolve 10 g in 100 ml of carbon dioxide-free water prepared \nfrom distilled water (solution A). The solution gives the \nreactions of potassium salts and of chlorides (2.3.1).\nAppearance of solution. Solution A is clear (2.4.1), and \ncolourless (2.4.1). \n;\nAcidity or alkalinity. 5.0 g dissolved in 50 ml of carbondioxide- \nfree water requires not more than 0.5 ml of 0.01 M sodium\nhydroxide or 0.01 M hydrochloric acid for neutralisation to \nbromothymol blue solution.\nArsenic (2.3.10). Dissolve 10.0 g in 50 ml of water and add\n10 ml of stannated- hydrochloric acid AsT. The resulting \nsolution complies with the limit test for arsenic (I ppm).\nBarium. To 5 ml of solution A add 5 ml of water and 1 ml of\nIM sulphuric acid; the solution, after not less than 15 minutes, \nis not more opalescent than a mixture of 5 ml of solution A and \n6 ml of water.\nHeavy metals (2.3.13). Dissolve 2.0 g in 10 ml of water to \nwhich are added 2 ml of dilute acetic acid and 13 ml of water \nThe solution complies with the limit test for heavy metals, \nMethod A (10 ppm).\nCalcium and magnesium. Dissolve 1 g in 20 ml of water, add\n1 ml oidilute ammonia solution and 1 ml of sodiumphosphate \nsolution; the solution remains clear.\nIron (2.3.14). 20 ml of solution A complies withthe limit test for\niron(20ppm). \n■ ' : ;\nBromides. Dilute 1.0 ml of solution Ato 50.0 ml with water. To \n5.0 ml of the solution add 2.0 ml of phenol red reagent and \n1.0 ml of a 0.01 per cent solution? of chloramine T and mix \nimmediately. After exactly 2 minutes, add 0.15 ml of 0.1 M \nsodium thiosulphate, mix and dilute to 10.0 ml with water. The\nabsorbance of the solution measured at about 590 nm (2.4.7), \nusing water as the blank, is not more than that of a standard \nprepared at the same time and in the same manner, using 5.0 ml \nof a 0.0003 per cent w/v solution of potassium bromide \n(0.1 percent). \n_ j\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/potassium-clavulanate-diluted","@type":"IndexedMonograph","prefLabel":{"en":"Potassium Clavulanate Diluted"},"edition":"ip-2010","category":"monographs","definition":{"en":"Potassium Clavulanate Diluted\nMol. Wt. 237.3\nPotassium Clavulanate Diluted is a dry mixture ofPotassium\nClavulanate and Microcrystalline Cellulose, or Silica, colloidal\nanhydrous or Silica, colloidal hydrated.\nIP 2010\nPotassium Clavulanate Diluted contains not less than 91.2 per\ncent and not more than 107.1 per cent ofthe stated amount of\npotassium clavulanate, CsHsKNOs.\nCategory. Antibacterial.\nDescription. A white or almost white powder, hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/potassium-iodide","@type":"IndexedMonograph","prefLabel":{"en":"Potassium Iodide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Potassium Iodide\nKI\nMol Wt. 166.0\nPotassium Iodide contains not less than 99.0 per cent and \nnot more than 100.5 per cent of KI, calculated on the dried \nbasis.\nCategory. Antithyroid; antifungal; expectorant.\nDescription. Colourless crystals or a white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/potassium-permanganate","@type":"IndexedMonograph","prefLabel":{"en":"Potassium Permanganate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Potassium Permanganate\nKMnO4 \t\nMol. Wt. 158.0\nPotassium Permanganate contains not less than 99.0 per cent \nand not more than 100.5 per cent of KM nO4.\nCategory. Antiseptic.\nDescription. A dark purple or brownish black, granular p6tvder \nor dark purple or almost black slender, prismatic crystals, having\nPOTASSIUM IODIDE \n01 2018 \nPOVIDONE \nIP 201\na metallic lustre; odourless. It decomposes on contact with \ncertain organic substances.\nCategory. Food preservative.\n(10 ppm). Use lead standard solution (10 ppm pb), diluting\n1 ml standard solution to 10 ml with a mixture of equal \nvolumes of hydrochloric acid and water.\npescription. A white or almost white powder or granules."}},{"@id":"https://www.openphar.org/data/ip/monographs/potassium-sorbate","@type":"IndexedMonograph","prefLabel":{"en":"Potassium Sorbate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Potassium Sorbate\nDescription. A white or yellowish white powder or flakes; \nodourless or almost odourless; hygroscopic.\nCH 3 CH=CHCH=CHCOOK\nC6H,K02 \t\nMol. Wt.150.2"}},{"@id":"https://www.openphar.org/data/ip/monographs/povidone","@type":"IndexedMonograph","prefLabel":{"en":"Povidone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Povidone\nKMnO4 \n. \nMol.Wt.158.0\nPotassium Permanganate contains not less than 99.0 per cent \nand not more than 100.5 per cent of KMnO4.\nCategory. Antiseptic.\nDescription. A dark purple or brownish black, granular powder \nor darkpurplc or almost black slender, prismatic crystals, having \na metallic lustre. It decomposes on contact with certain organic \nsubstances."}},{"@id":"https://www.openphar.org/data/ip/monographs/powder","@type":"IndexedMonograph","prefLabel":{"en":"Powder"},"edition":"ip-2010","category":"monographs","definition":{"en":"Powder\nOxytetracycline Hydrochloride Veterinary Oral Powder;\nOxytetracycline Hydrochloride Soluble Powder;\nOxytetracycline Soluble Powder-----·--·-----------\nOXYtetraCyClIne Yetel\"inary Oral Powder is a mixture of\nOxytetracycline Hydrochloride and Lactose or other suitable\ndiluent.\nwww.webofpharma.com\nIP 2010\nOxytetracyclineVeterinary Oral Powder contains not less than\n90.0 per cent and not more than 110.0 per cent of the stated\namount ofoxytetracycline hydrochloride, CZ2Hz4NzOg,HCl.\nUsual strength. 5.6 per cent w/w of Oxytetracycline\nHydrochloride."}},{"@id":"https://www.openphar.org/data/ip/monographs/powdered-senna-leaf","@type":"IndexedMonograph","prefLabel":{"en":"Powdered Senna Leaf"},"edition":"ip-2022","category":"monographs","definition":{"en":"Powdered Senna Leaf\nCassia leaf; Cassia angustifolia\nPowdered Senna is Senna dried compound leaves of Cassia \nangustifolia L. Vahal or Cassia senna L;. (Fam. Leguminosae) \nreduced to a fine or very fine powder.\nCategory.Purgative, anthelmintic, febfifiige, vibandha\nDescription. A light brown to dark brown powder with faint\nand distinctive odour; taste, mucilaginous and disagreeable \nbut not distinctly bitter."}},{"@id":"https://www.openphar.org/data/ip/monographs/pralidoxime-chloride-injection","@type":"IndexedMonograph","prefLabel":{"en":"Pralidoxime Chloride Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pralidoxime Chloride Injection\nPralidoxime Chloride Injection is a sterile material consisting \nof Pralidoxime Chloride with or without buffering agents and \nother excipients. It is filled in a sealed container. \n1'5\nThe injection is constituted by dissolving the contents of the \nsealed container in the requisite amount of sterile Water for \nInjections, immediately before use.\nThe constituted solution complies with the requirements foh \nClarity of solution and Particulate matter stated under \nParenteral Preparations (Injections). \n■- m\nStorage. The constituted solution should be used immediately \nafter preparation but, in any case, within the period; \nrecommended by the manufacturer. \n, ,\nPralidoxime Chloride Injection contains not less than 90.0;per \ncent and not more than 110.0 per cent of the stated amount of \npralidoxime chloride, C7H9CIN2O. \nf ,\nUsual strength. 1 g. \n. ;\nDescription. A white to pale yellow powder. \n. //\nThe. contents of the sealed container comply with the \nrequirements stated under Parenteral Preparations (Powders \nfor Injection) and with the following requirements. \n. J E"}},{"@id":"https://www.openphar.org/data/ip/monographs/pralidoxime-chloride","@type":"IndexedMonograph","prefLabel":{"en":"Pralidoxime Chloride"},"edition":"ip-2018","category":"monographs","definition":{"en":"Pralidoxime Chloride\nCH3\nN , \t - NON \nci --\nC7H9CIN20 \t\nMol. Wt. 172.6\nPralidoxime Chloride is 2-hydroxyiminomethyl-\nl-methylpyridinium chloride.\nPralidoxime Chloride contains not less than 97.0 per cent and \nnot more than 103.0 per cent of C 7H9C1N20, calculated on the\ndried basis.\nCategory. Antidote for cholinesterase inhibitors.\nDose. By intravenous injection, 1 to 2 g as a 5 per cent w/v \nsolution, administered over not less than 5 minutes period; by \nintramuscular injection, 1 g initially, followed by 1 to 2 further \ndoses if necessary, upto a maximum of 12 g in 24 hours.\nDescription. A white to pale yellow, crystalline powder; \nodourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/prasugrel-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Prasugrel Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prasugrel Hydrochloride\nQoH20FNC)3S,Ha \nMol.Wt.409.9\nPrasugrel hydrochloride is Ethanone, 2-[2-(acetyloxy)-6,7 - \ndihydrothieno[3,2-c]pyridin-5(47/)-yl]-l-cyclopfopyl-2-(2- \nflubrdphehyl)-hydrochloride.\nPrasugrel Hydrochloride contains not less than 97.0 per cent \nand not more than. 102.0 per cent of C20H20FNO3S,. HC1, \ncalculated on the anhydrous basis.\nCategory . Anti thrombotic Agent.\nDescription. A white to almost white powder.\nA. Determine by infrared absorption spectrophotometry (2.4.6). \nCompare the spectrum with that obtained with prasugrel \nhydrochloride IPRS or with the reference spectrum of prasugrel \nhydrochloride.\nB. In the Assay, the principal peak in the chromatogram \nobtained with the test solution corresponds to the peak in the \nchromatogram obtained with the reference solution.\nC. It gives reactions of chlorides (2.3.1).\nRelated substances. A. Determine by liquid chromatography \n(2.4.14).\nSolvent mixture. 70 volumes of acetonitrile and 30 volumes \nof water.\nTest solution. Dissolve 75 mg of the substance under \nexamination in the solvent mixture and dilute to 50.0 ml with \nthe solvent mixture.\nReference solution (a). A 0.0015 per cent w/v prasugrel\nhydrochloride IPRS in the solvent mixture.\nReference solution fb). Dilute 1.0 ml of reference solution (a) \nto 50.0 ml with the solvent mixture.\nReference solution (c). Transfer 5 mg of prasugrel \nhydrochloride IPRS to a 50-ml volumetric flask, add 20 ml of \nthe solvent mixture and mix to dissolve; Add 1 ml of0.0003 per\ncent v/v of piperidine in aceton itrile and dilute to volume \nwith the solvent mixture. Heat the solution at 50° for one hour \nand cool to room temperature. Dilute 2.0 ml of the solution to\n10.0 ml with the solvent mixture.\nChromatographic system \nv\n- a stainless steel column 15 cm x 4.6 mm, packed with\noctadecylsilane bonded to porous silica (3 pm),\n- column temperature: 40°,\n- sample temperature: 10°,\n- mobile phase: a mixture of 65 volumes of 0.0IM\nmonobasic potassium phosphate, 25 volumes of \ntetrahydrofuran and 10 volumes of acetonitrile,\n- flowrate: 0.9mlperminute,\n- spectrophotometer set at 240 nm,\n- injection volume: 10 pl.\nName\nRelative \nretention time\nDesacetyl prasugrel diastereomer 11\n0.43\nDesacetyl prasugrel diastereomer 21\n0.45\nDesfluoro prasugrel2\n0.9\nPrasugrel\n1.0\n4~Fluoro prasugrel3\n1.2\n3-Fluoro prasugrel4\n1.3\n3319\nwww.webofpharma.com\n'5-.[2-CycIopropyl-l -(2-fluorophenyl)'2-oxoe,thyl]-5,.6,7>'7a- \ntetrahyd^othieno[3,2-c]pyridine-2(4H)-one. Desacetyl prasugrel \ndiastereomer land desacetyl, prasugrel-diastereomer 2 . are <a-pair of \ndiastereomers.''They are-used for resolution measurement,only,,.,\n25-(2'Cyclopropyi-2-oxo-L-pherLylethyl)-4,5,6,7' tetrahydrothieno \n[3,2-cJpyridin-2-yl acetate,\n35-[2-Cyclopropyl-l-(4-fluorophenyl)-2-oxoethyi] -4,5,6,7- tetra- \nhydrothieno[3,2-c]pyridin-2-yr acetate,: - \n-A ;\n45?-[2-CycIdprdpyl-l:-(3-fliidrophenyl)-2-oxoethyl] -4j5,6^7-- tetra- \nhydrothieno[3,2-c|pyridin-2-yl acetate, ’’A:: \n•\nInject reference solution (a),> (b) and (c). The test is not valid \nunless the resolution between the peaks due to desacetyl \nprasugrel diastereomer 1 and desacetyl prasugrel diastereomer \n2 is not less, than 1.5 in the chromatogram obtained;with \nreference solution (c). The relative standard deviation for \nreplicate .injections is not more than 2.0 per cent in the \nchromatogram obtained with reference solution (a) and the \nsignal to noise ratio is not less than 10 in the chromatogram \nobtained with reference solution (b). ,\nInject reference solution (a) and the test solution. In the \nchromatogram obtained with the test solution the area of any \npeak corresponding to desfluoro prasugrel is not more than \n0.2 times the area of the principal peak in the chromatogram \nobtained with reference solution (a) (0.2 per cent), the area of \nany peak corresponding to 4-fluoro prasugrel is not more than \n0.15 times the area of the principal peak in the, chromatogram \nobtained with reference solution (a) (0.15 per cent), and the "}},{"@id":"https://www.openphar.org/data/ip/monographs/pravastatin-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Pravastatin Sodium"},"edition":"ip-2010","category":"monographs","definition":{"en":"Pravastatin Sodium\no\nH3CYO\nCH3\nI\nH\nMol. Wt. 446.5\n1945\nPravastatin Sodium is sodium (3R,5R)-3,5-dihydroxy-7-\n[(IS,2S,6S,8S,8aR)-6-hydroxy-2-methyl-8-[[(2S)-2-\nmethylbutanoyl]oxy]-1 ,2,6,7,8,8a-hexahydronaphthalen-l-\nyl]heptanoate\nPravastatin Sodium contains not less than\n97.0 per cent and\nnot more than 102.0 per cent ofCz3H3sNa07, calculated on the\nanhydrous and ethanol free basis.\nCategory. Antihyperlipidaemic.\nDescription. A white to yellowish white powder or crystalline\npowder, hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/praziquantel","@type":"IndexedMonograph","prefLabel":{"en":"Praziquantel"},"edition":"ip-2022","category":"monographs","definition":{"en":"Praziquantel\nCi9H24N2O2 \nMol. Wt. 312.4\nPraziquantel is (11 b7?5)-2-(cyclohexyIcarbonyl)-l,2,3,6,7,\n1 lb-hexahydro-4Z7-pyrazino[2,1 -a]isoquinolin-4-one.\nPraziquantel contains not less than 97.5 per cent and not more \nthan 102.0 per cent of \ncalculated on the dried\nbasis, -\nCategory. Antihelminthic.; \n.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/prazosin-hydrochloride-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Prazosin Hydrochloride Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Prazosin Hydrochloride Tablets\nDescription. A white or almost white, crystalline powder: \nhygroscopic.\nChromatographic system\nPrazosin Tablets contain not less than 90.0 per cent and not \nmore than 110.0 per cent of the stated amount of pr \nC I9H2 IN504.\n- a stainless steel column 20 cm x 4 mm, packed with porous\nsilica particles, (5 gm), \n-\nmobile phase: 0.01 per cent w/v solution of diethylamine \nin a mixture of 96 volumes of methanol, 2 volumes of \nglacial acetic acid and 2 volumes of water \n-\nflow rate: 1 ml per minute,"}},{"@id":"https://www.openphar.org/data/ip/monographs/prazosin-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Prazosin Hydrochloride","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prazosin Hydrochloride\nPrazosin Hydrochloride is 2-f4-(2-furoyl)piperazin-l-yl]-6,7- \ndimethoxyquinazolin-4-ylamine hydrochloride. .\nPrazosin Hydrochloride contains not less than 98.5 per cent \nand not more than 101.0 per cent of Cj9H2IN5O4,HCl, calculated \non the anhydrous basis. \nz.\nCategory.Antihypertensive. . \n. \n-\nDescription. A white or almost white powder. \n= AMA\nwww.webofpharma.com\nIP.2O22:\nPRAZOSIN HYDROCHLORIDE"}},{"@id":"https://www.openphar.org/data/ip/monographs/prealfacalcidol","@type":"IndexedMonograph","prefLabel":{"en":"Prealfacalcidol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prealfacalcidol \n1.3\nC2-FL;O: \nMol. Wt. 400.6\n'triazoline adduct of pre~aifacalcidol,\n^rans-alfacalcidol,\nOb-calçidol.\nInject reference solution (c). The test is not valid unless the \nresolution between the peaks due to pre-alfacalcidol and \nalfacalcidol is not less than 4.0. \n:\nInject reference solution (b) and the test solution.. Run the \nchromatogram twice the retention time of the principal peak. \nIn the chromatogram obtained with the test solution, the area \nof any peak due to alfacalcidol impurities A, Band C, each ¡of, \nis not more than 0.5 times the area of the principal peak in the \nchromatogram obtained with reference solution (b) \n(0.5 per cent) and.the sum of areas of all the secondary peaks \nis not more than the area of the, principal peak Jn.the \nchromatogram obtained with reference solution (b) (LOper \ncent). Ignore any peak with an area less than 0.1 times the area \nof the principal peak in the chromatogram obtained with \nreference solution (b) (0.1 percent). •\nAssay. Determine by liquid chromatography (2.4.14), as \ndescribed under Related substances, with the following \nmodifications. \n'\nInject reference solution (a) and (c). The test is not valid unless \nthe resolution between the peaks due to pre-alfacalcidol and \nalfacalcidol is not less than 4.0 in the chromatogram obtain \nwith reference solution (c) and the relative standard deviation \nfor replicate injections is not more than 1.0 per cent in the \nchromatogram obtain with reference solution (a). ; \n: ? '\nInject reference solution (a) and the test solution.\nCalculate the content of C27H44O2.\nIBSf&iStore. protected from light and moisture, under\nat a temperature of 2° to 8°. The contents of an\n^Siied container are to be used immediately, •\n—i:' ' ''\n)(i-ginihe contains not less than 98.5 per cent and not more\nIlian 1013 per cent of C^H^NA» calculated on the dried basis.\n,,o> ammo acid.. .\nDescnption. A white or almost white crystalline powder or \ncolourless crystals. . .. ■\nIdBtification\nDetermine by infrared absorption spectrophotometry (2.4.6). \nCompare the spectrum with that obtained with L-arginine \nIPRSor with the reference spectrum of arginine. . \n."}},{"@id":"https://www.openphar.org/data/ip/monographs/precipitated-chalk","@type":"IndexedMonograph","prefLabel":{"en":"Precipitated Chalk"},"edition":"ip-2022","category":"monographs","definition":{"en":"Precipitated Chalk\nCaCO3 \nMol. Wt. 100.1\nCalcium Carbonate contains not less than 98.0 per cent and \nnot more than 100.5 per cent of CaCO3, calculated on the dried \nbasis. \nl\nCategory. Antacid; Pharmaceutical aid (excipient).\nDescription. A fine, white, microcrystalline powder.\nA. Dissolve 5.0 g in 80 ml of 2 M acetic acid. When \neffervescence ceases, boil the solution for 2 minutes, allow to\nrvAL \n4045\nwww.webofpharma.com\nCALCIUM CARBONATE\ncool, dilute to 100 ml with 2 M acetic acid and filter, if \nnecessary, through a sintered-glass filter reserving any residue \nfor the test for Substances insoluble in acetic acid’, the filtrate \n(solution A), gives reactions A and B of calcium salts (2.3.1).\nB. It gives reaction (A) of carbonates (2.3.1)."}},{"@id":"https://www.openphar.org/data/ip/monographs/prednisolone-acetate","@type":"IndexedMonograph","prefLabel":{"en":"Prednisolone Acetate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Prednisolone Acetate\n~3H3006\nMol.Wt. 402.5\nPrednisoloneAcetate is 11~,17a-dihydroxy-3,20-\ndioxopregna-l ,4~dien-2l-yl acetate.\nwww.webofpharma.com\nIP 2010\nPrednisolone Acetate contains notless than 97.0 per cent and\nnot more than 103.0 per cent of C23H3006, calculated on the\ndried basis.\nCategory. Antiinflammtory; immunosuppressant.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/prednisolone-sodium-phosphate","@type":"IndexedMonograph","prefLabel":{"en":"Prednisolone Sodium Phosphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prednisolone Sodium Phosphate\nOiiyW \nMol. Wt. 484.4\nPredisolone Sodium Pho sphate is 1113,17 a, 21 Ttrihydroxy- \npregna<l ,4-diene-3,20,-d i one-21 -(d i hydrogenphosphate) \ndisodium salt.\nPrednisolone Sodium Phosphate contains not less than 96.0 \npercent and not more than 102.0 percent of CfiiL/Na-CLP,\ncalculated on the anhydrous , basis.\nCategory. Antiinflammtory; immunosuppressant."}},{"@id":"https://www.openphar.org/data/ip/monographs/prednisolone","@type":"IndexedMonograph","prefLabel":{"en":"Prednisolone"},"edition":"ip-2010","category":"monographs","definition":{"en":"Prednisolone\nOH\n-OH\no\nMol. Wt. 360.4\nPrednisolone is 1113,17a,21-trihydroxypregna-l,4-diene-3,20-\ndione.\nPrednisolone contains not less than 96.0 per cent and not\nmore than 104.0 per cent ofCZ1HZ80 S, calculated on the dried\nbasis.\nCategory. Adrenocortical steroid.\nDose. Upto 30 mg daily, in divided doses.\nDescription. A white or almost white, crystalline powder;\nhygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/prednisone","@type":"IndexedMonograph","prefLabel":{"en":"Prednisone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prednisone\nC21H26O5 \n' 'z\" J. Mol. Wt. 358.4\nPrednisone is 17a,21 -dihydroxypregna-1,4-diene-3,11,20- \ntrione. \n■ •> ? -\nPrednisone contains not less than 96.0 per cent and not more \nthan 104.0 per cent of C2; H2(,O5, calculated on the dried basis.\nCategory. Adrenocortical steroid. \n’ j.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pregelatinised-starch","@type":"IndexedMonograph","prefLabel":{"en":"Pregelatinised Starch"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pregelatinised Starch\nPregelatinised Starch is prepared from maize starch, potato \nstarch or rice starch by mechanical, processing in the presence \nof water, with or without heat, to rupture all or part of the \nstarch granules and subsequent drying. It contains no added \nsubstances but it may be modified to render it compressible \nand to improve its flow characteristics1.\" ‘\nDescription. A white or yellowish-white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/preparations","@type":"IndexedMonograph","prefLabel":{"en":"Preparations"},"edition":"ip-2018","category":"monographs","definition":{"en":"Preparations\n(CInjomecptilo).\nyns\nAssay. Determine by liquid chromatography (2.4.14).\nTest solution. To 10 ml of the preparation under examination \nadd 40 ml of 5 M hydrochloric acid, mix well, allow to stand \nfor 1 hour to ensure solution of the sediment and dilute with \n0.03 M hydrochloric acid to obtain a solution containing\n 30 minutes. Alow to col, dilute carefuly with \nwater, add 1 g \nof zinc powder, shake and allow to stand for 10 minutes. Add \nan excess of sodium hydroxide solution, immediately connect \nthe flask to an ammonia distillation apparatus, mix the contents \nand distil the liberated ammonia into 20 ml of 0.005 Msulphuric \nacid prepared with carbon dioxide-free water. Rinse the \ncondenser tube into the flask containing the distillate, add \nsufficient carbon dioxide-free water to produce a total volume \nof about 50 ml and titrate the excess of sulphuric acid with\nCalculate the content of insulin from the area of the peaks due \nto the bovine, porcine or human insulin and that of any peak \ndue to the monodesamido derivative of the insulin from the \ndeclared content of insulin in bovine insulin RS, porcine \ninsulin RS or human insulin RS, as appropriate. For \npreparations containing both bovine and porcine insulin use \nthe sum of the areas of both the bovine and porcine insulin \npeaks and of any peak due to the desamido derivative of \neither insulin.\n20elU\nerePer  \nReference solution (a). A 0.08 per cent w/v of bovine insulin \nRS in 0.025 M hydrochloric acid.\nReference solution (b). A 0.08 per cent w/v of porcine insulin \nRS in 0.025 M hydrochloric acid.\n0.01 Msodium hydroxide to pH 6.0, using a glass electrode. \nCentrifuge a further volume containing 400 IU and reject the \nsupernatant liquid. Dissolve the residue in 10 ml of a 5 per \ncent w/v solution of nitrogen-free sulphuric acid, transfer to\nReference solution (c). A solution containing 0.04 per cent \nw/v of bovine insulin RS and 0.04 per cent w/v of porcine \ninsulin RS in 0.025 M hydrochloric acid for a preparation \ncontaining both bovine and pork insulin.\nStorage. Store in multiple dose containers at a temperature \nbetween 2° and 8°. It should not be allowed to freeze.\nLabelling. The label states (1) the strength in terms of the \nnumber of IU per ml; (2) the animal source or sources of the \ninsulin; (3) that the preparation should not be allowed to freeze; \n(4) that the container should be gently shaken before a dose \nis withdrawn; (5) the storage conditions.\na long -necked, round -bottomed flask, and repeat the \nprocedure described above beginning at the words \"add 0.3 g \nofnitrogen -free mercuric oxide, \". Calculate the percentage \nof insulin extractable with the buffered acetone solution from \nthe formula 100A/B, where A is the volume of 0.005 M \nsulphuric acid used in the first determination and B is the \nvolume used in the second determination.\nReference solution (d). A 0.04 per cent w/v each of human \ninsulin RS and porcine insulin RS in 0.025 M hydrochloric \nacid.\nChromatographic system\n- a stainless steel column 25 cm x 4.6 mm packed with\noctadecylsilane chemically bonded to porous silica \n(5 gm), \n- column temperature. 45°, \n- mobile phase. a mixture of 72.5 volumes of 0.1 M sodium"}},{"@id":"https://www.openphar.org/data/ip/monographs/prepared-ergot","@type":"IndexedMonograph","prefLabel":{"en":"Prepared Ergot"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prepared Ergot\nPrepared Ergot is ergot, which has been powdered arid \nimmediately deprived of most of its fat and adjusted to contain \ntotal alkalpids of required strength. Prepared, Ergot contain? \n90 to 110 per cent of the labeled amount of total alkaloids of\nUsual strengths. 0.15 per cent and 0.2 per cent. .f\nergot calculated as ergotoxine.\nDescription. Purplish brown coloured powder, odour and taste \ncharacteristic."}},{"@id":"https://www.openphar.org/data/ip/monographs/presapara","@type":"IndexedMonograph","prefLabel":{"en":"Presapara"},"edition":"ip-2018","category":"monographs","definition":{"en":"Presapara\ny. DtieotnesnnOin\nnjecbtyiolnicisu)\nCategory. Antidepressant.\n*id chromatography (2.4.14).\nDescription. A white to cream colour crystalline powder.\nTest solution. Dilute a volume of the injection containing \n20 mg ofAdrenaline Tartrate to 100.0 ml with the mobile phase.\nB. To 1 ml add dropwise a 0.25 per cent w/v solution of ferric \nchloride until an emerald-green colour is produced. Add \nsodium bicarbonate solution gradually; the solution changes \nfirst to blue and then to red. \nC.To 10 ml add 2 ml of disodium hydrogen phosphate solution \nand sufficient iodine solution to produce a brown colour. \nAdd 0.1 M sodium thiosulphate dropwise until excess iodine \nis removed; a red colour is produced."}},{"@id":"https://www.openphar.org/data/ip/monographs/prilocaine","@type":"IndexedMonograph","prefLabel":{"en":"Prilocaine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prilocaine\nCi3H20N2O • \n. Mol. Wt.220.3\nPrilocame :i$ propariamide, 2V“(2-methylphenyl)’2- \n(propylamino); 2-(Propylamino)-(2-propionotoluidide; (RS)~IV- \n(2-methylphenyl)-2-(prdpylamino) propanamide;\nPrilocaine contains not less than 98.6 per cent and not more \nthan 102.0 per cent of C13fI2qN2O, calculated on the anhydrous \nbasis'. ' \n’■ \n'\nCategory. Local anaesthetic\nDescription. Awhile or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/primaquine-phosphate","@type":"IndexedMonograph","prefLabel":{"en":"Primaquine Phosphate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Primaquine Phosphate\nClsHzIN30,2H3P04\nMol. Wt. 455.3\nPrimaquine Phosphate is (RS)-8-(4-amino-l-\nmethylbutylamino)-6-methoxyquinoline diphosphate.\nPrimaquine Phosphate contains not less than 98.5 per cent\nand not more than 101.5 per cent of ClsHzIN30,2H3P04,\ncalculated on the dried basis.\nCategory. Antimalarial.\nDose. The equivalent of 15 mg ofprimaquine, once a day for\n14 days.\nDescription. An orange, crystalline powder; odourless or\nalmost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/prions","@type":"IndexedMonograph","prefLabel":{"en":"Prions"},"edition":"ip-2018","category":"monographs","definition":{"en":"Prions\nPrions come from transmissible spongiform encephalopathies \n(TSE), The major source of contamination of a recombinant \nproduct is the use of animal-derived raw materials, which could \nharbor bovine pions (BSE agent). Currently, there are no assays \nthat are sensitive or specific enough to test raw materials or \nsources, and the only reliable prevention is to include barriers, \nsuch as avoidance of animal or human raw materials (e.g., \ntrypsin, serum, transferin, bovine/human serum albumin, \nprotein supplements, peptones).\nCleaved Forms. Cleaved forms are those where a peptide bond \nis cleaved, resulting in loss of a N- or C-terminal site or where \nan internal peptide bond is cleaved while at the same time the \nresulting fragments are kept together by means of disulfide \nbonds. These forms are detected by N- and C- terminal amino \nacid analysis.\nNucleic acids\nAggregates. Aggregates are target protein derivatives in which \ntwo or more molecules are linked together either by covalent \ninter-disulfide bonds or by hydrophobic interaction. Target \nprotein aggregates are formed as a result of hydrophobic \nintermolecular reactions or because of intermolecular disulfide \nbond formation under oxidizing conditions. Aggregates arc \nvery often antigenic, resulting in formation of antibodies \nagainst the target protein. Proteins exposed to even mildly \ndenaturing conditions may partially unfold, resulting in the \nexposure of hydrophobic residues to the aqueous-solvent, \nfavoring aggregation. It is generally believed that the \naggregation process is controlled by the initial  dimerization \nstep in a second order reaction. Consequently, high protein \nconcentrations will increase the aggregation rate. \nIntermolecular disulfide bond formation between cystinyl \nresidues takes place at alkaline pH under oxidizing conditions. \nProteins with reactive free thiol groups should be purified \nunder reducing conditions (typically 1 to 10 mM reducing \nagent) in the presence of EDTA. Even proteins with disulfide \nbonds may participate in intermolecular disulfide  bond\nNucleic acid contamination comes from host cell DNA/RNA \nor retroviral RNA. Nucleic acids are detected by monitoring \nabsorption of light at 260 nm. The residual content in drug \nsubstance (DS) or drug product (DP) is usually measured by \nPCR or amplification techniques. The maximum allowable \ncontent of nucleic acid per dose remains under continuous \nevaluation by regulatory agencies. \"Lot-to-lot\" testing for \nDNA content in biological products produced in cell lines \nshould be performed and lot release limits established which \nreflects a level of purity that can be achieved reasonably and \nconsistently.\nMicrobial agents including Mycoplasma\nMicrobial agents and fungi come from infection of the \nbioreactor during cell culture. Other sources are contaminated \nwater, buffers, raw materials, chromatographic columns, and \nequipment. Fermentation and cell culture biorcactors are prone \nto microbial infections. Viable cells can be identified by spread \nout of the cell suspension or sample solution on agar plates.\nMycoplasma\nMycoplasmas have for long been recognized as a contaminant \nof continuous cell cultures caused by an infection of the cell \nline or bioreactor. Working in closed systems under GMP will \nreduce the risk of .infection. The end of production test includes \nscreening for mycoplasmas. Mycoplasmas are difficult to \ndetect, the only reliable way of demonstrating infection is by \nagar plating, fluorescent dying of DNA, or by PCR\nHost cell proteins\nHost cell proteins (HCP) come from the host organism and \nconstitute a major purification problem due to variability \nstructure and surface properties. The amount released into \nthe culture medium depends on the expression system used, \nthe culture conditions and the process related cell lysis. \nExtraneous proteins may be introduced in the downstream \nprocess also. Several analytical methods have been used to \nmonitor HCP including SD"}},{"@id":"https://www.openphar.org/data/ip/monographs/probenecid","@type":"IndexedMonograph","prefLabel":{"en":"Probenecid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Probenecid\nC13H19NO4S .. \nMol. Wt.285.4\nProbenecid is 4-(dipropylsuIphamoyl)benzoic acid. >\nProbenecid contains not less than 99.0 per cent and not more \nthan 101.0 per cent of CisiHt^NC^S, calculated on the dried \n.basis.\nCategory . Uricosuric agent and for delaying renal excretion of \npenicillins and cephalosporins.; \n. j .\n3350\nIP 2022 J\nPRIMAQUINE TABLETS\nDescription. Awhite or almost white, crystalline powder. \nf"}},{"@id":"https://www.openphar.org/data/ip/monographs/procainamide-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Procainamide Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Procainamide Hydrochloride\nc13h21n3o,hci\nMol.Wt. 271.8\nProcainamide Hydrochloride is 4-amino-W-[2-(diethylamino) \nethyl)benzamide hydrochloride.\nProcainamide Hydrochloride contains not less than 98.0 per \ncent and not more than 101.0 per cent of C!3H2iN3O,HCl, \ncalculated on the dried basis.\nCategory. Antiarrhythmic,\nDescription. A white or very slightly yellow, crystalline \npowder; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/procainamide-injection","@type":"IndexedMonograph","prefLabel":{"en":"Procainamide Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Procainamide Injection\nProcainamide Hydrochloride Injection\nProcainamide Injection is a sterile solution of Procainamide\nHydrochloride in Water for Injections. It may contain Sodium\nMetabisulphite as a stabilising agent.\nProcainamide Injection contains not less than 95.0 per cent\nand not more than 105.0 per cent of the stated amount of\nprocainamide hydrochloride, C13Hz1N30, HC1.\nUsual strength. 100 mg perm1."}},{"@id":"https://www.openphar.org/data/ip/monographs/procaine-and-adrenaline-injection","@type":"IndexedMonograph","prefLabel":{"en":"Procaine and Adrenaline Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Procaine and Adrenaline Injection\nProcaine Hydrochloride and Adrenaline Bitartrate\nInjection; Procaine Hydrochloride and Epinephrine\nBitartrate Injection\nProcaine and Adrenaline Injection is a sterile solution of\nProcaine Hydrochloride and Adrenaline Bitartrate in Water\nfor Injections.\n1969\nPROCAINE AND ADRENALINE INJECTION\nProcaine and Adrenaline Injection contains not less than\n1.9 per cent and not more than 2.1 per cent w/v of procaine\nhydrochloride, C13HzoNzOz, HCI and the equivalent ofnot less\nthan 0.00175 percent and not more than 0.00225 per cent w/v\nofadrenaline, C9HI3N03.\nDescription. A clear, colourless solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/procaine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Procaine Hydrochloride"},"edition":"ip-2010","category":"monographs","definition":{"en":"Procaine Hydrochloride\n, Hel\nC13H20N202,HCl\nMol. Wt. 272.8\nProcaine Hydrochloride is 2-(diethylamino)ethy14-\naminobenzoate hydrochloride.\nProcaine Hydrochloride contains not less than 99.0 per cent\nand notmore than 101.0per cent ofC13H2oN202,HCl, calculated\non the dried basis.\nCategory. Local anaesthetic.\nDose. To be adjusted according to the site of operation and\nresponse of the patient.\nDescription. Colourless crystals or a white, crystalline powder;\nodourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/procaine-penicillin","@type":"IndexedMonograph","prefLabel":{"en":"Procaine Penicillin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Procaine Penicillin\nC13H20N2O2,C16HlgN2O4S,H2O \nMol. Wt. 588.7\nProcaine Penicillin is 2-diethylaminoethyl 4-amino benzo ate \n(67?)-6-(2-phenylacetamido)penicillanate monohydrate.\nProcaine Penicillin contains not less than 51 per cent and not \nmore than 59.6 per cent of penicillin G, calculated as \nC]6H18N2O4S, and not less than 37.5 per cent and not more \nthan 43.0 per cent of procaine, C13H20N2O2, both calculated on \nthe anhydrous basis.\nCategory. Antibacterial.\nDescription. A white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/procarbazine-hydrochloride-capsules","@type":"IndexedMonograph","prefLabel":{"en":"Procarbazine Hydrochloride Capsules"},"edition":"ip-2018","category":"monographs","definition":{"en":"Procarbazine Hydrochloride Capsules\nProcarbazine Hydrochloride Capsules contains not less than \n90.0 per cent and not more than 110.0 per cent of the stated \namount of procarbazine C 1211 19N30 .\nUsual strength. 50 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/prochlorperazine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Prochlorperazine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prochlorperazine Injection\nProchlorperazine Mesylate Inj ection \ny\nProchlorperazine Injection is a sterile solution of \nProchlorperazine: Mesylate in Water for Injections: free from :? \ndissolved air.; \n■ \n( \n■.Aby/f I\nProchlorperazine Injection contains not less than 95.0 per cent .1 \nand not more than 105.0 per cent of the stated amount of 1 \nprochlorperazine mesylate, C^0H24ClN3S,2CH4SO3. / \" ■\nUsual strength. 12,5 mg per ml. \ny"}},{"@id":"https://www.openphar.org/data/ip/monographs/prochlorperazine-maleate","@type":"IndexedMonograph","prefLabel":{"en":"Prochlorperazine Maleate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prochlorperazine Maleate\nC^Ho^ClN^S^CdU^: \n- \n> ■ Mol. Wt. 606.1\nl-yl)propyljphcnothiazine di(hydrogen maleate). (\nProchlorperazine Maleate is 2-chloro-10-['3-(4-iiietliylpipera7in-\nProchlorperazine Maleate contains not less than 98.0 per cent \nandnotmore than 101.0 per cent of C2OH24C1N3S ■2CjH4O4; \ncalculated on the dried basis. \n: > z >: n;\n'3358\nIP 2023\nCategory: Antipsychotic; antiemetic.\nDescription. A white or pale yellow, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/prochlorperazine-mesylate","@type":"IndexedMonograph","prefLabel":{"en":"Prochlorperazine Mesylate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Prochlorperazine Mesylate\nMol. Wt. 566.2\nProchlorperazine Mesylate is 2-chloro-10-[3-(4-\nmethylpiperazin-1-yl)propyl]phenothiazine\ndi(methanesulphonate).\nProchlorperazine Mesylate contains not less than 98.0 per\ncent and not more than 101.0per centofCzoHz4ClN3S,2CH4S03,\ncalculated on the dried basis.\nCategory. Antipsychotic; antiemetic.\nDose. As antipsychotic, by intramuscular injection, 12.5 to 25\nmg; twice or thrice daily; as antiemetic, by intramuscular\ninjection, 12.5 mg.\nDescription. A white or almost white powder; odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/procyclidine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Procyclidine Hydrochloride"},"edition":"ip-2010","category":"monographs","definition":{"en":"Procyclidine Hydrochloride\n, Hel\no\nCI9H29NO,HCI\nMol. wt. 323.9\nProcyclidine Hydrochloride is (RS)-I-cyclohexy1-1-phenyl-3-\npyrrolidin-1-ylpropan-1-01 hydrochloride.\n1974\nIP 2010\nProcyclidine Hydrochloride contains not less than 99.0 per\ncent and not more than 101.0 per cent ofC I9H29NO,HCI,\ncalculated on the dried basis.\nCategory. Antiparkinsonian.\nDose. Initially, 2.5 mg thrice daily, after meals increasing at\nintervals oftwo to three days by 2.5 to 5 mg daily; maximum,\n30 mg daily.\nDescription. A white, crystalline powder, odourless or almost\nodourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/progesterone-injectable-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Progesterone Injectable Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Progesterone Injectable Suspension\nProgesterone Injectable Suspension is a sterile suspension of \nProgesterone in Water for Injections.\nProgesterone Injectable Suspension contains not less than \n93.0 per cent and not more than 107.0 per cent of the stated \namount of progesterone, C2|H30O2.\nUsual Strengths: 25 mg per ml; 50 mg per ml; 100 mg per ml; \n200mgperml."}},{"@id":"https://www.openphar.org/data/ip/monographs/progesterone-injection","@type":"IndexedMonograph","prefLabel":{"en":"Progesterone Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Progesterone Injection\nProgesterone Injection is a sterile solution of Progesterone in \nEthyl Oleate or.other suitable ester, in a suitable fixed oil or in \nany mixture of these., It may contain suitable alcohols.\nProgesterone Injection contains not less than 92.5 per cent \nand not more than 107.5 per cent of the stated amount of \nprogesterone, C2iH30O2. \n‘ \n'\nUsual strengths. 25 mg per ml; 50 mg per ml; 100 mg per ml; \n250mgpermi. \n' •••<';!■!•.< t /. \n•• • c"}},{"@id":"https://www.openphar.org/data/ip/monographs/progesterone","@type":"IndexedMonograph","prefLabel":{"en":"Progesterone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Progesterone\nml with methanol.\nOaoCh \n’ Mol. Wt.314.5\nProgesterone is 4-Pregnene-3,20-dione.\nProgesterone contains not less than. 97.0 per cent and not \nmore than 103.0 per cent of C2lH30O2, calculated on the dried \nbasis.\nCategory. Steroidal hormone.\nDescription. A white or almost white crystalline powder or \ncolourless crystals. It shows polymorphism (2.5.11)."}},{"@id":"https://www.openphar.org/data/ip/monographs/promazine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Promazine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Promazine Hydrochloride\nC!7H2ON2S,HC1 \nMol. Wt. 320.9\nPromazine Hydrochloride is 10~(3-dimethylaminopropyl) \nphenothiazine hydrochloride.\nPromazine Hydrochloride contains not less than 99.0 per cent \nand not more than 101.0 per cent of Ci7H20N2S,HCl, calculated \non the dried basis.\nCategory. Neuroleptic.\nDescription. A white or almost white, crystalline powder, \nslightly hygroscopic in nature."}},{"@id":"https://www.openphar.org/data/ip/monographs/promazine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Promazine Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Promazine Injection\nPromazine Hydrochloride Injection\nPromazine Injection is a sterile solution of Promazine\nHydrochloride in Water for Injections free from dissolved air\nand containing suitable buffering and stabilising agents. The\nsolution is distributed in containers, the air in which is replaced\nby nitrogen or other suitable gas.\nPromazine Injection contains not less than 95.0 per cent and\nnot more than 105.0per cent ofthe stated amount ofpromazine\nhydrochloride, C17HzoNzS,HCl.\nUsual strengths. 50 mg in 1ml; 100 mg in 2 ml.\nDescription. A colourless or almost colourless liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/promethazine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Promethazine Hydrochloride"},"edition":"ip-2010","category":"monographs","definition":{"en":"Promethazine Hydrochloride\n, Hel\nMol. Wt. 320.9\nPromethazine Hydrochloride is (RS)-dimethyl(2-\nphenothiazin-1O-ylpropyl)amine hydrochloride.\nPromethazine Hydrochloride contains not less than 98.5 per\ncent and not more than 101.0 per cent of C17HzoNzS, HCI,\ncalculated on the dried basis.\nCategory. Antiemetic.\nDose. 20 to 50 mg daily, in single or divided doses.\nDescription. A white or faintly yellowish, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/promethazine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Promethazine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Promethazine Injection\nPromethazine Hydrochloride Injection\nPromethazine Injection is a sterile solution of Promethazine \nHydrochloride in Water for Injections free from dissolved air. \nIt may contain suitable stabilising agents, -\nPromethazine Injection contains not less than 95.0 per cent \nand not more than 105.0 per cent of the stated amount of \npromethazine hydrochloride, C]7H2ON3S,HC1.\nUsual strengths. 25. mg in 1 ml; 50 mg in:2 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/promethazine-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Promethazine Syrup"},"edition":"ip-2022","category":"monographs","definition":{"en":"Promethazine Syrup\nPromethazine Hydrochloride Syrup; Promethazine \nHydrochloride Oral Solution; Promcthazine Oral Solution\nPromethazine Syrup is a solution containing Promethazine \nHydrochloride in a suitable flavoured vehicle. \n■;\nPromethazine Syrup contains not less than 90.0’per cent and \nnot more than 110.0 per cent of the stated amount: of \npromethazine hydrochloride, C17H20N2S, HCI.\nUsual strength. 5 mg per 5 ml. \n? . ,"}},{"@id":"https://www.openphar.org/data/ip/monographs/promethazine-theoclate","@type":"IndexedMonograph","prefLabel":{"en":"Promethazine Theoclate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Promethazine Theoclate\n— Mol. Wt.499.0\nPromethazine Theoclate is the (A5)-dimethyl(2-pheno- m \nthiazin-10-y!propy famine salt of 8-phlorotheophylline.\nPromethazine Theoclate contains not less than 98.0 per cent\nand not more than 101.0 per cent of CnHaoN^SjCyHyClN^^. \ncalculated on the dried basis.\nCategory. Antiemetic.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/propane","@type":"IndexedMonograph","prefLabel":{"en":"Propane"},"edition":"ip-2018","category":"monographs","definition":{"en":"Propane\n10 mg of the residue in 1 ml of hydrochloric acid, add 0.1 g of .„ \npotassium chlorate and evaporate to dryness; a reddish\nFi3CCH3\nC3H8 \t\nMol. Wt. 44.1\nresidue remains which becomes purple on exposure to the \nvapour of ammonia.\nSulphur. Carefully open the container valve to produce a \nmoderate flow of gas. Do not direct the gas stream toward the \nface, but deflect a portion of the stream toward the nose, the \nodour free from the characteristic odour of sulphur \ncompounds.\nPropane is dimethyl methane.\nPropane contains not less than 98.0 per cent of C 3 1-18 ."}},{"@id":"https://www.openphar.org/data/ip/monographs/propionic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Propionic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propionic Acid\nC3H6O2 \nMol. Wt. 74.1\nPropionic Acid contains not less than 99.5 per cent and noi \nmore than 100.5 per cent of C3H6O2."}},{"@id":"https://www.openphar.org/data/ip/monographs/propofol-injection","@type":"IndexedMonograph","prefLabel":{"en":"Propofol Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propofol Injection \n*\nPropofol Injection is a sterile emulsion of Propofolin a suitabl^ \nbase..; y-;;. ermC.R 77-.:n'\\ \n-I\nPropofol Injection contains riot less1 than 95.0 per cent and \nnotmore than 105.0 per cent of the stated amount of propofol \nCl2Hi8O. \n'■ ' '7\nUsual strength. 10 mg per ml. \n; \n,"}},{"@id":"https://www.openphar.org/data/ip/monographs/propofol","@type":"IndexedMonograph","prefLabel":{"en":"Propofol"},"edition":"ip-2010","category":"monographs","definition":{"en":"Propofol\nMol. Wt. 178.3\nPropofol is 2,6-diisopropylphenol.\nPropofol contains not less than 98.0 per cent and not more\nthan 102.0 per cent ofC1zHlsO.\nCategory. General anaesthetic.\nDescription. A colourless or very light yellow, clear liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/propoxyphene-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Propoxyphene Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propoxyphene Hydrochloride\nCsH^NOjJiCl \nMol. Wt 375.9\nDextropropoxyphene Hydrochloride is (ly^Rj-l-benzyl-\n3-d imethylamino-2-methyl-l-phenylpropyl propionate \nhydrochloride.\nDextropropoxyphene Hydrochloride contains not less than\n98.5 percent and not more than 101.0 per cent of Cy-L^Cf.HCl, \ncalculated on the dried basis.\nCategory. Analgesic.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/propranolol-hydrochloride-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Propranolol Hydrochloride Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Propranolol Hydrochloride Tablets\nC10141205 \t\nMol. Wt. 212.2\nTest solution. Disperse a quantity of powdered tablets \ncontaining about 100 mg of Propranolol Hydrochloride in\nPropranolol Tablets contain not less than 92.5 per cent and \nnot more than 107.5 per cent of the stated amount of \npropranolol hydrochloride, C I6H2I NO2, HC1.\nPropyl Gallate is propyl 3,4,5-trihydroxybenzoate.\n100.0 mlofmethanol and filter.\nCategory. Pharmaceutical aid (antioxidant).\nReference solution. Dilute 1 ml of the test solution to 500 ml \nwith the mobile phase. \nChromatographic system\nUsual strengths. 10 mg; 40 mg.\nDescription. A white or creamy white, crystalline powder; \nodourless or almost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/propranolol-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Propranolol Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propranolol Hydrochloride\nCI6H21NO2,HC1. \nMol. Wt. 295.8\nPropranolol Hydrochloride is (RS)-1-[( l-methylethyl)amino]- \n3 -(naphthalen-1 -ylqxy)propan-2-61 hydrochloride.\nPropranolol Hydrochloride? contains not less than 99.0 per \ncent and not more than 101.0 per cent of C16H2iNO2,HCl, \ncalculated on the dried basis.\nCategory; Antihypertensive, antianginal arid antiarrhythmic \nagent. \n: ..\n3377\nwww.webofpharma.com\nPROPRANOLOL HYDROCHLORIDE\nDescription. A white or almost white powder. ;"}},{"@id":"https://www.openphar.org/data/ip/monographs/propranolol-injection","@type":"IndexedMonograph","prefLabel":{"en":"Propranolol Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propranolol Injection\nPropranolol Hydrochloride Injection\nPropranolol Injection is a sterile solution of Propranolol \nHydrochloride in Water for Injections containing Citric Acid.\nPropranolol Injection contains not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of\npropranolol hydrochloride, C16H21NO2,HC1.\nUsual strength. 1 mg per ml.\nA. Make alkaline with I M sodium hydroxide a volume \ncontaining 10 mg of Propranolol Hydrochloride and extract \nwith three quantities, each of 5 ml, of ether. Wash the combined \nextracts with water until the washings are free from alkali, dry \nwith anhydrous sodium sulphate, filter, evaporate the filtrate \nto dryness and dry the residue at 50° at a pressure of 2 kPa for\nOn the residue determine by infrared absorption \nspectrophotometry (2.4.6). Compare the spectrum with that \nobtained with propranolol hydrochloride IPRS treated in the \nsame manner or with the reference spectrum of propranolol.\nB. When examined in the range 230 nm to 360 nm (2.4.7), the \nsolution obtained in the Assay shows absorption maxima at\nabout 290 nm, 306 nm and 319 nm.\npH (2.4.24). 3.0 to 3.5.\nRelated substances. Determine by liquid chromatography\nTest solution. Dilute a volume of injection containing about\n100 mg of Propranolol Hydrochloride in 100 nil of acetonitrile.\nReference solution. Dilute 1.0 ml of the test solution to\n500.0 ml with the mobile phase.\nChromatographic system\n- a stainless steel column 20 cm x 5 mm, packed wi\nendcapped octadecylsilane bonded to porous silica\n(5 pm) (Such as Hypersil ODS),\n3379\nwww.webofpharma.com\nn- ■ ■ sulphate^ 10; ml; of a mixture of 1 volume of sulphuric\n. ■ i acidand 9. volumes of water, 20ml of a 1.7 per cent\nw/v solution of 'tetrabutylammoniUm dihydrogen\n. /■ orthophosphate', 370 mf of waZer and 600 m! of\n,i ricetonrirrie, adjusted to pH 3.3 with 2' M sodium\nhydroxide, \n. r \n. .,\n- flow rate: 1.8 ml per minute, . \ni., ....\n- spectrophotometer set at 292 nm,\n- injection volume: 10 pl.\nV \"5 £ J? £ £ * -Q :5 >: 3 H 3 4 b $ -I ?f £ L; £ > \nchromatogram 5 times the retention time ofthe prihcipM peak. \nIn the chromatogram obtained with thc test solution, the arca \nof any secondary peak is not more than the area ofthe principal \npeak in the chromatogram obtained with the reference solution \n(0.2 per cent) arid the'sirin' of the areas of all the secondary \npeaks is notmore than four times the area of the.principalpeak \nin the chromatogram; obtained, with the reference solution \n(0.8 per cent). :\nInject the reference solution and the test solution. Run the\nBacterial endotoxins (2.2.3). Notmore than 55;6 Endotoxin \nUnits per mg of propranolol hydrochloride.\nOther tests. Comply with the tests stated under Parenteral \nPreparations (Injections). \n3-■: i /\nAssay. To a measured volume containing 2 mg of Propranolol \nHydrochloride add sufficient methanol to produce 100.0 ml \nand measure the absorbance of the resulting solution at the \nmaximum at about 290 rim (2.4.7). Calculate the content of \nCl6H2!NO2, HC1 taking 206 as the specific absorbance at \n290nm.\nStorage. Store protected from light, in a single dose containers.\nPropranolol Tablets\nPropranolol Hydrochloride tablets .\nPropranolol Tablets contain not less than 92.5 per cent and \nnot more than 107.5 per cent of the stated amount of \npropranolol hydrochloride, C36H21NO2,HC1. \n:\nUsual strengths. 10 mg; 40 mg. \n, r"}},{"@id":"https://www.openphar.org/data/ip/monographs/propyl-gallate","@type":"IndexedMonograph","prefLabel":{"en":"Propyl Gallate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Propyl Gallate\no\nHO~O~CH3\nHO~\nOH\nMol. Wt. 212.2\nPropyl Qallate is propy13,4,5-trihydroxybenzoate.\nCategory. Pharmaceutical aid (antioxidant).\nDescription. A white or creamy white, crystalline powder;\nodourless or almost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/propyl-hydroxybenzoate","@type":"IndexedMonograph","prefLabel":{"en":"Propyl Hydroxybenzoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propyl Hydroxybenzoate\nO\nC[qHi2O3 \nMol. Wt. 180.2\nPropylparaben is propyl 4-hydroxybenzoate.: ..\nPropylparaben contains not less Than 98.0 per cent and not \nmore than 102.0 per centof C10H;2O3, calculated on the dried \nbasis.. \n, ■ \n... \n.\nCategory. Pharmaceutical aid (antimicrobial preservative).\nDescription. A white or almost white, crystalline powder or \ncolourless crystals.\nA. Determine by infrared absorption spectrophotometry (2.4.6). \nCdnipafe the spectrum with that obtained with propylparaben \nIPRS bf with the reference’ spectrum of propylparaben.\nB. Melting point (2.4.21). 96° to 99°.\nAppearance of solution, A 10.0 per cent w/v solution in ethanol \n(95 percent) is clear (2.4.1), and not more intensely coloured \nthan reference solution BYS6 (2.4.1).\nAcidity. Dissolve 1.0 gin sufficient ethanol (95 per cenflo \nproduce 10 ml. To 2 ml of the solution add 3 ml of ethanol \n(95 per cent), 5 ml of carbon dioxide-free water and 0.1 ml of \nbromocresol green solution. Not more than 0.1 ml of 0.1 M \nsodium hydroxide is required to change the colour of the\nsolution. ...\nRelated substances. Determine by liquid chromatography \n(2-4.14). : \n1\nTest solution. Dissolve50 mg of the substance under \nexamination in 2.5 ml of methanol and dilute to 50.0 ml with \nthe mobile phase. Dilute 10.0 ml of the solution to 100.0 ml \nwith the mobile phase? ■\nReference solution (a). Dissolve 5 mg of 4-hydroxybenzoic \nacid (propylparaben impurity A), 5 mg of ethyl parahydroxy­\nbenzoate (propylparaben impurity C) and 5 mg of the \nsubstance under examination in the mobile phase and dilute \nto 100.0 ml with the mobile phase. Dilute 1.0 ml of the solution \nto 10.0 ml with the mobile phase.\nReference solution (b). Dissolve 50 mg of propylparaben \nIPRS in 2.5 ml of methanol and dilute to 50.0 ml with the \nmobile phase. Dilute 10.0 ml of the solution to 100.0 ml with \nthe mobile phase.\n3385\nwww.webofpharma.com\nReference solution (c). Dilute 1.0 ml of the test solution to \n20.0 ml with the mobile phase. Dilute 1.0 ml of the solution to \n10.0 ml with the mobile phase.\nChromatographic system\n- a stainless steel column lS cm x 4.6 mm, packed with\noctadecylsilane bonded to porbus silica (5 pm),\n- mobile phase: a mixture of 35 volumes of 0.68 per cent\nw/v solution df potassium dihydrogen phosphate, and \n65 volumes of methanol, \n:\n- flow rate: 1.3 ml per minute,\n- spectrophotometer set at 272' rim,1! 1 i''1 !::'■ • ■ ‘: ”\n- injectionvolume: 10p.1. \n.\n;The relative retention timewith reference to propylparaben\nfor 4-hydroxybenzoic acid (propylparaben impurity A) is about \n0.3, for,ethyl parahydroxybenzoate, (propylparaben impurity \nC) is about 0.7......\nInject reference solution (a). The test is not valid unless the \nresolution between the peaks due to propylparaben and \npropylparaben impurity C is not less than 3.0. \n—\nInject reference solution (c) and the test, solution. Run the \nchromatogram; 2.5 times the retention time of the principal \npeak. In the chromatogram obtained with the test solution the\narea of any peak corresponding to propylparaben impurity A \nmultiplied by 1.4 is not more than the area the principal peak in \nthe chromatogram obtained with reference solution (c) (0.5 \nper cent), the area of any other secondary peak is not more \nthan the area of the principal peak in the chromatogram \nobtained with reference solution (c) (0.5 per cent) and the sum \nof areas of all the secondarypeaks is 'not more than twice the\n• ared of the.principal peak in the chromatogram obtained with \nreference solution (c) (1.0 per cent): Ignore the1-peak with an \narea less than 0.2 times the afea of the principal peak in'the \nchromatogram1 obtained with reference solution (c) (0/1 per\n'■cent). ; \n: \n-\nSulphated ash (2.3.18). Not more than 0.1 per cent.\nAssay. Determine by liquid chromatography (2.4.14) as \ndescribed under Related substances.\n: InjeCt reference solution.(b) and the test solution.;' ‘ ’ '' : ' \n'Ci;- i;;': O.UX O.j : 6 OH '■?./; eV; U.; \n■;;;. -\nCalculate the cont"}},{"@id":"https://www.openphar.org/data/ip/monographs/propylene-glycol","@type":"IndexedMonograph","prefLabel":{"en":"Propylene Glycol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propylene Glycol\n1,2-Propanediol; propane-1,2-diol\nC,H,O2 \nMol. Wt. 76.1\nPropylene Glycol is propane-1,2-diol.\nPropylene Glycol contains not less than 99.5 per cent of \nCd fO2.\nCategory. Pharmaceutical aid (humectant; solvent).\nDescription. A clear, colourless, viscous liquid; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/propyliodone-injectable-oil-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Propyliodone Injectable Oil Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propyliodone Injectable Oil Suspension\nPropyliodone Injectable Oil Suspension is a sterile suspension \nof Propyliodone in Peanut Oil.\nPropyliodone Injectable Oil Suspension contains not less \nthan 57.0 per cent and not more than 63.0 per cent of \nC10Hnl2NO3."}},{"@id":"https://www.openphar.org/data/ip/monographs/propyliodone","@type":"IndexedMonograph","prefLabel":{"en":"Propyliodone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propyliodone\nPropyliodone is Propyl 3?5-diiodo-4-oxo-l (4/7)pyridylacetate.\n3384\nPROPYLENE GLYCOL MONOCAPRYLATE \nIP 2022\nPropyliodone contains not less than 99.0 per cent and not \nmore than 101.0 per cent of CioHuLNOa,; calculated on the \ndried basis.\nDescription. A white to off-white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/propylthiouracil","@type":"IndexedMonograph","prefLabel":{"en":"Propylthiouracil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Propylthiouracil\nIP 2022\nPROPYLPARABEN\nPropylthiouracil is 2,3-dihydro-6-propyl-2-thioxopyrimidim \n4(17/)-one. \n‘ \n-3\nPropylthiouracil contains not less than 98.0 per cent and not s \nmore than 100.5 per cent of C7H10N2OS, calculated oh the dried \nbasis. : \n■ ■■ \n- \n•( : \n/: V; ?\nCategory. Antithyroid. \n;\nDescription. A white or pale cream-coloured crystals or ■ \ncrystalline powder. \nn ;"}},{"@id":"https://www.openphar.org/data/ip/monographs/propyphenazone","@type":"IndexedMonograph","prefLabel":{"en":"Propyphenazone"},"edition":"ip-2010","category":"monographs","definition":{"en":"Propyphenazone\nPropyphenazone is 4-isopropyl-2,3-dimethyl-l-phenyl-3-\npyrazolin-5-one.\nPropyphenazone contains not less than 99.0 per cent and not\nmore than 101.0 per cent ofC14HIsNzO, calculated on the dried\nbasis.\nCategory. Analgesic; antipyretic.\nDose. 1.5 to 3 g daily, in divided doses.\nDescription. A white or slightly yellowish, crystalline powder;\nodourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/protamine-sulphate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Protamine Sulphate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Protamine Sulphate Injection\nProtamine Sulphate Injection is a sterile, solution of Protamine\nSulphate in Water for Injections.\nProtamine Sulphate Injection contains not less than 80.0 per \ncent of the stated amount of protamine sulphate.\nUsual strengths. 50 mg in 5 ml; 100 mg in 10 ml' \n.\nIdentification....... \n, \n.... \n-- A.,..;\nA. Produces a precipitate’under the conditions of the \nAssay; ' \n! ?'\nB. Dilute a suilable volumc with water to give a solution \ncontaining 0.2 per ccnt w/v solution of Protamine Sulphate, \nTo. 5 ml of the solution add L ml of a 10 per pent w/v solution of \nsodium hydroxide and f ml of a 0.02 per cent w/v solution of\n/-naphthol and mix. Cool to 5° and add 0.5 ml of alkaline \nsodium hypobromite solution', an intense red colour is \nproduced. \n2 h."}},{"@id":"https://www.openphar.org/data/ip/monographs/protamine-sulphate","@type":"IndexedMonograph","prefLabel":{"en":"Protamine Sulphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Protamine Sulphate\nProtamine Sulphate is a purified mixtureof the sulphates of \nbasic peptides prepared from the sperm or mature testes of \nsuitable species of fish. It binds with heparin in solution, \ninhibiting its anticoagulant activity. It is prepared in conditions \ndesigned to minimise the degree of Microbial contamination.\nEach'mg of Protamine Sulphate precipitates not less than\n100 Units of heparin sodium IPRS, calculated on the dried \nbasis.. z ! \n.. .. \n. .< \n■\nCategory. Heparin antidote.\nDescription. A white or almost white powder; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/prothionamide","@type":"IndexedMonograph","prefLabel":{"en":"Prothionamide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Prothionamide\n2 ■■ \nMol. wt. 180.3\nProthionamide is 2-propy M-pyridmccarbothioamide.\nProthionamide contains not less than 99.0 per cent and not \nmore than 101.0 per cent of C8H10N2S,calculated on the dried \nbasis. \n..... \n■\nCategory. Antitubercular.\nDescription. Ayellow, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/protriptyline-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Protriptyline Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Protriptyline Hydrochloride\nProtriptyline Hydrochloride is 3-(5//-dibenzo[«,c/|cyclohept- \n5-yl)propyi(methyl)amine hydrochloride. , \n. .? J . , .y\nProtriptyline' Hydrochloride contains hbt less than 99.0 per \ncent and not more than 101.0 per cent of Ci9H21N,HC1, calculated \non the dried basis. \n7.\nCategory. Tricyclicantidepressant. ; \n7-\nDescription. A white to yellowish white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pseudoephedrine-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Pseudoephedrine Syrup"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pseudoephedrine Syrup\nPseudoephedrine Hydrochloride Syrup ,:\nPseudoephedrine Syrup is a solution of Pseudoephedrine \nHydrochloride in a suitable flavoured vehicle.\nPseudoephedrine Syrup contains not less than 90.0 per cent \nand not more than 110.0 per cent, of the stated amount of \npseudoephedrine hydrochloride, CioH15NOj HCI.\nUsual strength. 30 mg per 5 ml. \n> \n."}},{"@id":"https://www.openphar.org/data/ip/monographs/pseudomonas","@type":"IndexedMonograph","prefLabel":{"en":"Pseudomonas"},"edition":"ip-2010","category":"monographs","definition":{"en":"Pseudomonas\nmallei\n(Burkholderia mallei) has been grown and which has been\nfreed of the bacilli by filtration. The active fraction of the\n-filtrate;whichispredominantly--protein-innature,---isisolated\nbyprecipitation,washedandre-dissolved.in_phosphate\nbuffered saline at about neutral pH. It is then distributed in\nsterile containers that are inert towards the contents and sealed\nso as to exclude micro-organisms.\nIP 2010\nFor standardisation, four porties previously sensitised with\nP. mallei and two healthy ponies are injected intradermo-\npalpebrally with 0.2 ml ofthe preparation near the rim ofthe\nlower eye-lid of one eye. Typical reaction such as painful\nswelling ofthe palpebral tissue with mucopurulent discharge\nfrom the eye ofsensitised animals and no such reaction in the\nhealthy ponies should be seen. A similar test is performed\nwith the Standard preparation maintained by the Indian\nVeterinary Research Institute, Izatnagar. When the reactions\nofthe two preparations are comparable the batch is considered\nfit for use.\nMallein Purified Protein Derivative contains not less than\n0.95 mg per ml and not more than 1.05 mg per ml ofpurified\nprotein derivative.\nCaution - Mallein Purified Protein Derivative is not\ndangerous to humans, but the organism from which it is\npreparedispathogenic to man andmay befatal ifan infection\nis not treated properly. Treatment should begin promptly if\nan infection is suspected.\nDescription. A yellowish to brown, viscous liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/psoralen","@type":"IndexedMonograph","prefLabel":{"en":"Psoralen"},"edition":"ip-2018","category":"monographs","definition":{"en":"Psoralen\nCI I H603 \t\nMol. Wt. 186.2\nPsoralen is 7H-furo[3,2-g][1]benzopyran-7-one, obtained \nfrom the fruits of Psoralea carylifolia Linn. \n(Fam. Legumi-nosae) and from the leaves of Ficus carica \n(Fam. Urticaceae) or prepared by synthesis.\nPsoralen contains not less than 95.0 per cent and not more \nthan 101.0 per cent of C IIH603, calculated on the dried basis.\nCategory. Topical pigmenting agent.\nDescription. Colourless needles; odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/purified-rayon","@type":"IndexedMonograph","prefLabel":{"en":"Purified Rayon"},"edition":"ip-2022","category":"monographs","definition":{"en":"Purified Rayon\nViscose Fibre; Absorbent Viscose \n..Hi :,a.:\nCategory. Regenerated cellulose used in surgical dressings\nDescription. White or very slightly yellow, purified rayon is a \nfibrous form of bleached regenerated cellulose, which can be \nproduced with a lustrous or matt: appearance, and is soft to \nthe touch. The fibres can. be produced with ayerage, staple\nlength between 32 mm to 80 mm. \n...."}},{"@id":"https://www.openphar.org/data/ip/monographs/purified-water","@type":"IndexedMonograph","prefLabel":{"en":"Purified Water"},"edition":"ip-2022","category":"monographs","definition":{"en":"Purified Water\n1I2O :.H d ? ' W. \nWt. 18.0\nPurified Water is prepared bymeans of ion-exchange, reverse- \nosmosis, distiilatidrif or by any other appropriate means from \npotable water that complies with all relevant specifications.\nDuring its production, subsequent , storage and distribution,,\nadequate measures are taken to ensure that the microbial quality\nis controlled and counts do not proliferate. To detect any\nadverse trend, appropriate alert and action limits are set and\nfollowed. The adequacy of purification measures isindicated\nthrough conductivity displayed on-line or conducted offline\n(2.4,9). It contains no added substances. ■ g : ;<• - 4 ; '\nMicrobial contamination (2.2.9). (For monitoring purpose);\nTotal viable count not more than 100 efu per ml. Specified\npathogens should be absent. \nv : ; \n= 7.: -\n3964\nwww.webofpharma.com\n' ' L '\ntOfécb\"'f: ■ ' : ' ■' ■\n^^pnalkalinity To 10 ml, freshly boiled and cooled in a \nl^sijícate glass flask, add 0.05 ml of methyl red solution^\nclear, colourless and odourless liquid.\nis not red. To 10 ml add 0.1 ml of\nblC resu^n§ sokition is not blue,\ngeav^ihetals (2.3.13). Evaporate lSOmlto 15 nú; 12mlofthe\nsplution co^pl^es with the limit test for heavy metals’, Method \nP ^Q4 ppm). Use lead standard solution (I ppm Pb) to prepare \n¿¿s^ndard. Alternatively procedure as per ICP/IC/AAS may\nbe used.\nHQÍPfr If purified water complies with the requirementsfor \nconductivityprescribedfor water for Injection in bulk, it is \nnotnecessary to carry but the test for heavy metals."}},{"@id":"https://www.openphar.org/data/ip/monographs/puskara","@type":"IndexedMonograph","prefLabel":{"en":"Puskara"},"edition":"ip-2022","category":"monographs","definition":{"en":"Puskara"}},{"@id":"https://www.openphar.org/data/ip/monographs/pyrantel-embonate","@type":"IndexedMonograph","prefLabel":{"en":"Pyrantel Embonate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Pyrantel Embonate\nCOOH\nOH\nOH\nCOOH\nMol. Wt. 594.7\nPyrantel Pamoate is 1,4,5,6-tetrahydro-1-methyl-2-[(E)-2-(2-\nthienyl)vinyl]pyrimidine hydrogen; 4,4'-methylene bis(3-\nhydroxynaphthalene-2-carboxylate).\nPyrantel Pamoate contains not less than 98.0 per cent and not\nmore than 102.0 per cent of C34H30Nz06S, calculated on the\ndried basis.\nCategory. Anthelmintic.\nDose. 10 mg per kg\nDescription. Apale yellow or yellow powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyrantel-pamoate-oral-suspension","@type":"IndexedMonograph","prefLabel":{"en":"Pyrantel Pamoate Oral Suspension"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyrantel Pamoate Oral Suspension\nPyrantel Pamoate Oral Suspension is a suspension of Pyrantel \nPamoate in a suitable flavoured aqueous vehicle. : :\n3398\nPyrantel Pamoate Oral Suspension contains not less than \n90.0 per cent and not more than 110.0 per cent of the stated \namount of pyrantel, ChH14N2S. f \n;\nUsual strength. 50 mg per ml\nIdentification- .\nA. Determine by thin-layer chromatography (2.4.17), coating \nthe plate with silica gel H. \n’ Y,\nMobile phase. The upper layer of a mixture obtained by shaking \n20 volumes of methyl isobutyl ketone, 10 volumes of formic \nacid and 10 volumes of water.- \n■ \n'\nTest solution. Dilute a known volume of the oral suspension \nwith sufficient 0.05 M methanolic ammonia to produce a \nsolution containing about 8 mg of pyrantel per ml. Shake the \nmixture by mechanical means and centrifuge. Use the clear \nsupernatant liquid. \nt \n.\nReference solution. A solution of pyrantel pamoate IPRSiw\n0.05 Mmethanolic ammonia containing 0.008 per cent w/vof \npyrantel.\nApply to the plate 100 pl of each solution. Allow the mobile \nphase to rise to about 17 cm. Dry the plate in air and examine \nunder ultraviolet light at 365 nm. The principal spot in the \nchromatogram obtained with the test solution corresponds th \nthat in the chromatogram obtained with the reference solution-\nB. In the Assay, the major peaks in the chromatograrii obtained \nwith the test solution correspond to the peaks in ilie \nchromatogram obtained with the reference solution: ! ! : ;"}},{"@id":"https://www.openphar.org/data/ip/monographs/pyrantel-pamoate","@type":"IndexedMonograph","prefLabel":{"en":"Pyrantel Pamoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyrantel Pamoate\nPyrantelEmbonate\nPyrantei Pamoate is J,4,5,6-tetrahydro-l-methy 1-2-[(£)- \n2-(2-thienyl)vinyl]pyrimidine hydrogen;; 4,4'-methylene \nbis(3-hydroxynaphthalene-2-carboxylate)J ■\nPyrantel Pamoate contains not less than 98.0 per cent and not \nmore than 102.0 per cent of C^Hjo^OgS, calculated on the \ndried basis.\nCategory. Anthelmintic.\nDescription. A pale yellow or yellow powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyrazinamide","@type":"IndexedMonograph","prefLabel":{"en":"Pyrazinamide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyrazinamide\nPyrazinamide is pyrazine-2-carboxanude. -\nPyrazinamide contains not less than 99.0 per cent^and not\nmore than 100.5 per cent of C5H5N3O, calcu a e\nanhydrous i basis.\nCategory. Antitubercular.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyridostigmine-bromide","@type":"IndexedMonograph","prefLabel":{"en":"Pyridostigmine Bromide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyridostigmine Bromide\nch3\nC9Hl3BrN2O2 \n. Mol. Wt. 261.1\nPyridostigmine Bromide is 3-(Dimethylcarbamoyl)oxy-\n1-methylpyridinium bromide.\nPyridostigmine Bromide contains not less than 98.5 per cent \nand not more than 100.5 per cent of C9Hl3BrN262) calculated \non the dried basis.\nCategory. Anticholinesterase.\nDescription. Awhite crystalline powder.\nIdentification ..\nA. Determine by infrared absorption spectrophotometry (2.4.6). \nCompare the spectrum with that obtained with pyridostigmine \nbromide IPRS or with the reference spectrum of pyridostigmine \nbromide.\nwww.webofpharma.com\nPYRIDOSTIGMINE TABLETS\nIP 2022\ng When examine in the range 200 nm to 400 nm (2.4.7), a \n0 0035 per cent w/v solution in 0.1 Mhydrochloric acid gives \nabsorption maxima at 269 nm.\nC TO 100 rng in a test-tube, add 0.6 ml-of 1 M sodium \nhydroxide; an orange colour develops. When the mixture is \nheated,the colour changes to yellow and a strip of moistened \nred litmus paper held over the top of the test-tube turns blue.\nD A 2.0 per cent w/v solution gives the reactions of bromide\n(2.3.1)."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyridostigmine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Pyridostigmine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyridostigmine Injection\nPyridostigmine Bromide Injection\nPyridostigmineInjection is a sterile solution of Pyridostigmine \nBromide in a suitable medium.\nPyridostigmine Injection contains not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \npyridostigmine bromide, C9H13BrN2O2.\nUsual strength. 5 mg p er ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyridostigmine-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Pyridostigmine Tablets"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyridostigmine Tablets\nPyridostigmine Bromide Tablets\nPyridostigmine Tablets contains Pyridostigmine Bromide.\nPyridostigmine Tablets contain not less than 92.5 per cent\nand not more than 107.5 per cent of the stated amount of \npyridostigmine bromide, C9H13BrN2O2."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyridoxine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Pyridoxine Hydrochloride"},"edition":"ip-2010","category":"monographs","definition":{"en":"Pyridoxine Hydrochloride\nVitaminB6\n, Hel\nCgHlIN03,HCI\nMol. Wt. 205.6\nPyridoxine Hydrochloride is 5-hydroxy-6-methylpyridine-\n3,4-dimethanol hydrochloride.\nPyridoxine Hydrochloride contains not less than 99.0 per cent\nand not more than 101.0 per centofCgHIIN03,HCI, calculated\non the dried basis.\nCategory. B group vitamin; sideroblastic anaemia therapy;\nanti-isoniazid neuropathy.\nDose. In deficiency states, prophylactic, upto 2 mg daily;\ntherapeutic, 20 to 50 mg upto three times daily. Inmulti- vitamin\nPYRIDOXINE HYDROCHLORIDE\npreparations for oraluse, prophylactic, 500 J.tg to 1.5 mg daily;\ntherapeutic, 1.5 to 3 mg daily. In sideroblastic anaemia, 100 to\n400 mg daily, in divided doses. In isoniazid neuropathy,\nprophylactic, 10 mg daily; therapeutic, 50 mg three times daily.\nDescription. A white or almost white, crystalline powder;\nodourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyridoxine-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Pyridoxine Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Pyridoxine Tablets\nDescription. A white or almost white, crystalline powder. \nodourless.\nRelative \t\nCorrection \nretention time \t\nfactor\nPyridoxine Hydrochloride Tablets\nName"}},{"@id":"https://www.openphar.org/data/ip/monographs/pyrilamine-maleate","@type":"IndexedMonograph","prefLabel":{"en":"Pyrilamine Maleate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyrilamine Maleate\nC17H23N3O,C4H4O4 \nMol. Wt. 401.5\nMepyramine Maleate is 2-(/V-4-methoxybenzyl-W-2- \npyridylamino)ethyldimethylamine hydrogen maleate.\nMepyramine Maleate contains not less than 99.0 percent and \nnot more than 101.0 per cent of Ci.D^NAXCJ LO.;, calculated \non the dried basis.\nCategory. Histamine Hrreceptor antagonist.\nDescription. A white or slightly yellowish, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/pyrimethamine","@type":"IndexedMonograph","prefLabel":{"en":"Pyrimethamine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Pyrimethamine\nNH2\n: ■ C|/M nh2\nCI2H13CIN4 \nMol. Wt. 248.7\nPyrimethamine is 5-(4-chlorophenyl)-6-ethylpyrimidine-2,4- \ndiamine. ST--.■ . ■ \n- \n.\nPyrimethamine contains not less than 99.0 per cent and not \nmore than 101.0 per cent of C12H13C1N4, calculated on the dried \nbasis.\n^^.gd^-Antirnalarial.\nDescription. Colourless crystals or an almost white, crystalline \npowder.;"}},{"@id":"https://www.openphar.org/data/ip/monographs/quinalbarbitone-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Quinalbarbitone Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quinalbarbitone Sodium\nQuinalbarbital Sodium; Secobarbital Sodium;;\nSecobarbitone Sodium; Soluble Quinalbarbitone\n3412\nIP20&I\nQuinalbarbitone Sodium contains not less than 98.5 percent I \nand not more than 102;0 per cent of CijHnNzNaOy, calculated \non the dried basis. \nI\nCategory. Hypnotic; \nq;7 ;;\nDescription. A white powder; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/quinapril-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Quinapril Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quinapril Hydrochloride\nC2SH3oN2Os,HC1 \n. Mol. Wt.474.9\nQuinapril Hydrochloride is (S)-2-[(S)-W-[(S)“l-Carboxy-3- \nphenylpropyl] alanyl]-1,2,3,4-tetrahydro-3-isoquinoline-\ncarboxylic acid, 1 -ethyl ester, monohydrochloride.\nQuinapril Hydrochloride contains not less than?8.5 per cent \nand not more than 101.5 per cent of C25H3(jN2O5,HCl, calculated \non the anhydrous basis.\nCategory. Antihypertensive.\nDescription. A white to off-white powder, with a pink cast at \ntimes."}},{"@id":"https://www.openphar.org/data/ip/monographs/quinidine-bisulphate","@type":"IndexedMonograph","prefLabel":{"en":"Quinidine Bisulphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quinidine Bisulphate \n; ; ; j\n(^24X202)233804,2^0 \nMol. Wt. 783.0\nQuinidine Sulphate is (87?,9S3-6'-inethoxycinchonan-9-ol \nsulphate dihydrate. The alkaloid is obtained from the bark of \nvarious species of Cinchona and from Remijia pedunculate\nFluckiger (Fam. Rubiaceae) or prepared from quinine. J\nQuinidine Sulphate contains not less than 99.0 per cent and \nnot more than 101.5 per cent of alkaloid monosulphates, \ncalculated as (C2QH24N202)2,H2S04onthe dried basis.. .. .. ..;\nCategory. Antiarrhythmic. \n■ r.\nDescription. A white or almost white, crystalline powder or \nneedle-like crystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/quinine-acid-sulphate","@type":"IndexedMonograph","prefLabel":{"en":"Quinine Acid Sulphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quinine Acid Sulphate\nC2oH24N202Ji2S04,7H2p \nMol. Wt. 548.6\nQuinine Bisulphate is (8iS',9/^)-6'-mcthoxycinchonan-9-ol \nhydrogen sulphate heptahydrate. The alkaloid is obtained \nfrom the bark of various species of Cinchona.\nQuinine Bisulphate contains not less than 98.5 per cent and \nnot more than 101.5 per cent of alkaloid hydrogen sulphates, \ncalculated as C20H24N2O2,H2SO4 on the anhydrous basis.\nCategory. Antimalarial.\nDescription. Colourless or faintly yellow crystals or a white \nor faintly yellow, crystalline powder; efflorescent in dry air."}},{"@id":"https://www.openphar.org/data/ip/monographs/quinine-bisulphate","@type":"IndexedMonograph","prefLabel":{"en":"Quinine Bisulphate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Quinine Bisulphate\nQuinineAcid Sulphate\nOCH3\n~CH2\nH\nC2oH24N202,H2S04,7H20\nMol. Wt. 548.6\nQuinine Bisulphate is (8S,9R)-6' -methoxycinchonan-9-01\nhydrogen sulphate heptahydrate. The alkaloid is obtained\nfrom the bark ofvarious species of Cinchona.\nQuinine Bisulphate contains not less than 98.5 per cent and\nnot more than 101.5 per cent ofalkaloid hydrogen sulphates,\ncalculated as C2oH24N202,H2S04 on the anhydrous basis.\nCategory. Antimalarial.\nDose. Suppressive, 300 to 600 mg daily; therapeutic, 1.2 to 2 g\ndaily, in divided doses.\nDescription. Colourless or faintly yellow crystals or a white\nor faintly yellow, crystalline powder; efflorescent in dry air."}},{"@id":"https://www.openphar.org/data/ip/monographs/quinine-dihydrochloride-injection","@type":"IndexedMonograph","prefLabel":{"en":"Quinine Dihydrochloride Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quinine Dihydrochloride Injection\nQuinine Acid Hydrochloride Inj ection\nQuinine Dihydrochloride Injection is a sterile solution of \nQuinine Dihydrochloride in Water for Injections.\nQuinine Dihydrochloride Injection contains not less than \n95.0 per cent and not more than 105.0 per cent of the stated \narnountof quinine dihydrochloride, C2oH24N202,2HC1.\nUsual strength. 300 mg per ml.\n3423\nwww.webofpharma.com\nQUININE: DIHYDROCHLORIDE INJECTION\nDescription. Aclear, almost colourless to light yellow solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/quinine-dihydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Quinine Dihydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quinine Dihydrochloride\nQuinine Acid Hydrochipride:;;\nC20H24N2O2,2HCl \nMol. Wt. 397.3\n3422\nIP2022;1\nQuinine Dihydrochloride is the (8iS\\9/?)-6'- \nmethoxycinchonan-9-ol dihydrochloride. The alkaloid is. j \nobtained from the bark of various species of Cinchona., „ ■\nQuinine Dihydrochloride contains not less than 99.0 per cent \nand not more than 101.5 per cent of alkalo id dihydrochlorides \ncalculated as C20H24N2O2,2HCl on the dried basis.\nCategory. Antimalarial.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/quinine-sulphate","@type":"IndexedMonograph","prefLabel":{"en":"Quinine Sulphate","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quinine Sulphate\nMol. Wt.783.0\nQuinine Sulphate is (8S',9A)-6'-methoxycinchonan-9-ol \nsulphate dihydrate. The alkaloid is obtained from the bark of \nvarious species bf Cinchona.\nQuinine Sulphate contains not less than 99.0 per cent and not \nmore than 101.0 percent of alkaloid monosulphates, calculated \nas (C20II24N2O2)2,H2SO4 on the dried basis.\nCategory. Antimalarial.\nDescription White or almost white, needle-like crystals or a \ncrystallmepowder.\nQUININE SULPHATE"}},{"@id":"https://www.openphar.org/data/ip/monographs/quiniodochlor-cream","@type":"IndexedMonograph","prefLabel":{"en":"Quiniodochlor Cream"},"edition":"ip-2010","category":"monographs","definition":{"en":"Quiniodochlor Cream\nClioquinol Cream; Iodochlorhydroxyquinoline Cream;\nIodochlorhydroxyquin Cream\nQuiniodochlor Cream contains Quiniodochlor in a suitable\nbase.\nQuiniodochlor Cream contains not less than 90.0 per cent and\nnot more than 110.0 per cent of the stated amount of\nquiniodochlor, CgHsClINO.\n2028\nIP 2010\nUsual strength. 4 per cent w/v."}},{"@id":"https://www.openphar.org/data/ip/monographs/quiniodochlor-ointment","@type":"IndexedMonograph","prefLabel":{"en":"Quiniodochlor Ointment"},"edition":"ip-2018","category":"monographs","definition":{"en":"Quiniodochlor Ointment\nClioquinol Ointment; lodochlorhydroxyquinoline \nOintment; Iodochlorhydroxyquin Ointment \nbis,(- ffinethylcilyl)acetamide and 1.0 ml of internal standard \nQuiniodochlor Ointment contains Quiniodochl \t\n',-;:solutiOn, attach the cap, and mix. Heat in a water-bath at 50° \nbase.\nNchigga,\nQUINIODOCHLOR CREAM \nQUINIODOCHLOR AND HYDROCORTISONE CREAM\nQuiniodochlor Ointment contains not less than 90.0 pal \nand not more than 110.0 per cent of the stated amo \nquiniodochlor, C9H5CIINO.\natographic system\ncombine the filtered extracts and dilute to 50.0 ml with \n2-methoxyethanol. To 5.0 ml of this solution add 1 ml of water \nand sufficient ofa mixture of 24 volumes of 2-methoxyethanol \nand 6 volumes of water to produce 50.0 ml. To 10.0 ml of the \nsolution add 10 ml of2-methoxyethanol and 2 ml of a solution \nprepared by dissolving 0.5 g of ferric chloride hexahydrate \nin 80 ml of2-methoxyethanol and adding 0.1 ml of hydrochloric \nacid and sufficient 2-methoxyethanol to produce 100 ml. Dilute \nthe solution to 25.0 ml with 2-methoxyethanol and measure \nthe absorbance of the resulting solution at the maximum at \nabout 650 nm (2.4.7), using as blank a solution prepared \nby treating 10 ml of the aqueous 2-methoxyethanol in the \nsame manner beginning at the words \"add 10 ml  of \n2-methoxyethanol \"\nla glass column 1.83 m x 2 mm, packed with 3 per cent \n*quid phase G3 on 80 to 100-mesh support S1AB, \n- temperature:\nUsual strength. 4 per cent w/v.\ntolturm. 165°,"}},{"@id":"https://www.openphar.org/data/ip/monographs/quiniodochlor","@type":"IndexedMonograph","prefLabel":{"en":"Quiniodochlor"},"edition":"ip-2022","category":"monographs","definition":{"en":"Quiniodochlor\nClioquinol; lodochlorhydroxyquinoline: \nlodochlorhydrpxyquin :\nCdhClINO\nMol. Wt 305.5\nQuiniodochlor is 5-chloro-7-iodoquinolin-8-ol.\nQuiniodochlor contains not less than 97.0 per cent arid not \nmore than 103.0 per cerit of QHSC1INO, calculated ori the dried \nbasis.\nCategory. Antiamoebic; topical and.intestinal antiseptic.\nDescription. A yellowish white to brownish yellow powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/rabeprazole-injection","@type":"IndexedMonograph","prefLabel":{"en":"Rabeprazole Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rabeprazole Injection\nRabeprazole Sodium Injection\nRabeprazole Injection is a sterile material consisting of \nRabeprazole Sodium with or without excipients. It is filled in a \nsealed container.\nThe injection is constituted by dissolving the contents of the\nsealed container in the requisite amount of sterile Water for \nInjections, immediately before use.\nThe constituted solution complies with the requirements for \nthe Clarify of solution and Particulate matter stated under \nParenteral Preparations (Injections).\nStorage. The constituted solution should be used immediately \nafter preparation but, in, any case, within the period \nrecommended by the manufacturer.\nRabeprazole Injection contains not lessthan 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of \nrabeprazole sodium, ClgH2iN3O3SNa.\n3439\nwww.webofpharma.com\nUsualstrength. 20 mg.\nDescription. A white or off white powder.\nThe contents of the sealed container comply with the \nrequirements stated under Par enter at' Preparations \n(Powdersfor Injection) and with the following requirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/rabeprazole-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Rabeprazole Sodium"},"edition":"ip-2010","category":"monographs","definition":{"en":"Rabeprazole Sodium\nMol. Wt. 381.4\nRabeprazole sodium is 2-({[4-(3-methoxypropoxy)-3-methyl-\n2-pyridinyl]methyl}sulphinyl)-IH-benzimidazole sodium.\nRabeprazole sodium contains not less than 98.0 per cent and\nnot more than 102.0 per cent ofClsHzoN303S,Na, calculated on\nthe anhydrous basis.\nCategory. Antiulcer.\nDescription. A white to light yellow, crystalline powder,\nhygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/rabies-antiserum","@type":"IndexedMonograph","prefLabel":{"en":"Rabies Antiserum"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rabies Antiserum\nAntirabies Scrum; Antirabic Serum\nRabies Antiserum is a preparation containing the specific \nglobulin or its derivatives obtained by purification of \nhyperimmune serum or plasma of healthy horses or other \nsuitable animals having the specific activity of neutralising \nthe rabies virus. It may contain a suitable preservative.\nRabies Antiserum contains not less than 300 Units per ml.\nDescription. Aclear, colourless or pale yellow liquid free from \nsuspended particles or cream-coloured powder or pellet to be \nreconstituted with diluent supplied by the manufacturer;"}},{"@id":"https://www.openphar.org/data/ip/monographs/rabies-immunoglobulin","@type":"IndexedMonograph","prefLabel":{"en":"Rabies Immunoglobulin"},"edition":"ip-2018","category":"monographs","definition":{"en":"Rabies Immunoglobulin\nFor each assay, check the amount of virus used by performing \na control titration: from the dilution corresponding to\nHuman Rabies Immunoglobulin\nCategory. Immunological product.\n100 Cap5o per 0.1 ml, make three ten-fold dilutions. Add 0.1 ml \nofeach dilution to four chambers containing 0.1 ml of medium \nand add 0.2 ml of the cell suspension. The test is not valid \nunless the titre lies between 30  CCID50 and 300 CCID50. \nDilute the reference preparation to a concentration of 2 IU per \nml using non-supplemented culture medium (stock reference \ndilution, stored below -80°). Prepare two suitable predilutions \n(1:8 and 1:10) of the stock reference dilution so that the dilution \nof the reference preparation that reduces the number of \nfluorescent fields by 50 per cent lies within the four dilutions \nof the cell-culture slide. Add 0.1 ml of the medium to each \nchamber, except the first in each of two rows, to which add \nrespectively 0.2 ml of the two predilutions of the stock \nreference dilution transferring successively 0.1 ml to the other \nchambers.\nRabies Immunoglobulin is a liquid or freeze-dried preparation \ncontaining immunoglobulins, mainly immunoglobulin G. The \npreparation is intended for intramuscular administration. It is \nobtained from plasma from donors immunised  against rabies.\nThe stated potency is not less than 150  Units per ml. The \nestimated potency is not less than the stated potency and is \nnot greater than twice the stated potency. The confidence \nlimits (P = 0.95) of the estimated potency are not less than \n80.0 per cent and not more than 125.0 per cent.\nIt contains specific antibodies neutralising the rabies virus.\nHuman normal immunoglobulin may be added.\nIt complies with the monograph on Human Normal \nImmunoglobulin, except for the minimum number of donors\nCulture Medium for Growth of BHK 21 Cells\nand the minimum total protein content.\nCommercially  available  media that have a slightly different \ncomposition from that shown below  may also be used. \nSodium chloride \nPotassium chloride"}},{"@id":"https://www.openphar.org/data/ip/monographs/racecadotril-sachet","@type":"IndexedMonograph","prefLabel":{"en":"Racecadotril Sachet"},"edition":"ip-2022","category":"monographs","definition":{"en":"Racecadotril Sachet \njgj\nRacecadotril Sachet contains not less than 90.0 per cent and ! \nnot more than 110.0 per cent of the stated amount of \nracecadotril, C21H23NO4S. \n...... \n\";y|\nReference solution. A 0.03 per cent w/v solution of \nracecadotril IPRS in the solvent mixture.\nRelated substances. Determine by liquid chromatography\n(24.14). J \n:\nChromatographic system\nsolution. Disperse, a quantity of powder containing \n80/ing.pf Macecadotril in 70 ml acetonipile with the aid of \nultrasound for 30 minutes and dilute to 100.0 ml with \nacftpnitfile?.ffpex. ......\nUsual strengths. 10 mg; 3 0 mg. \n< i\n............. \n. Ji"}},{"@id":"https://www.openphar.org/data/ip/monographs/racecadotril","@type":"IndexedMonograph","prefLabel":{"en":"Racecadotril"},"edition":"ip-2022","category":"monographs","definition":{"en":"Racecadotril\nC21H2jNO4S . \nMol.Wt.385.5\nRacecadotril is (/?5)-Benzyl-jV-[3-(acetylthio)-2- \nbenzylpropanoyl] glycinate. /\nRacecadotril contains not less than :98.0 percent and not more \nthan LQ2.0 per cent of CzikfoNCLS, calculated on the dried \nbasis.; \n; \n■.\nCategory. Antidiarrhoea. : . ; . ; \n-\nIdentification .\nDescription. A white or almost white powder. \n.\nDetermine by infrared absorption spectrophotometry (2-.4.6). \nCompare : the spectrum with that obtained with -racecadotril \nIPRS or with the reference spectrum of racecadotril/ - u:\n3444\nRABEPRAZOLE GASTRO-RESISTANT AND ITOPRIDE PROLONGED-RELEASE CAPSULES\nIP 2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/radiolabelling","@type":"IndexedMonograph","prefLabel":{"en":"Radiolabelling"},"edition":"ip-2022","category":"monographs","definition":{"en":"Radiolabelling\nDescription.Sodium Iodide (1231) Solution For Radiolabelling\nis a clear colourless solution, Sodium Iodide (1231) Solution' \nFor Radiolabelling contains not less than 90.0 per cent'and \nnot more than 116.0 per cent of the stated iodine-;\n123 radioactivity at the date and time stated on the label/ \nSodium Iodide (1231) Solution For Radiolabelling should be’ \nused within 24 hours from date and time of preparation. Iodinc-\n123 is obtained by proton irradiation of xenon enriched in \nxenon-124 followed bythe decay of xenon-123 which is formed,, \ndirectly and by the decay of caesium-123. No carrier iodide \nand reducing agent are added."}},{"@id":"https://www.openphar.org/data/ip/monographs/radionuclide","@type":"IndexedMonograph","prefLabel":{"en":"Radionuclide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Radionuclide\nALI \n(Ingestion)\n(Inhalation)\n(Ci)\n(Ci)\n(Ci per ml)\nTc-99m\n8x10’\n2xl05\n1x10\"* .\nF-18\n5X104\n7xlff\n3xl0'5\n1-125\n4x10'\n6x10'\n3X10-6\nP-32\n6xl03\n3xl03\n' IxlO\"6\n1-131\n9x10'\n5x10'\n2 x1fr8\n4.0 Safety Considerations\nRadiopharmaceuticals owing to their detrimental effects on \nthe cellular structures, needs to be monitored for their harmful \neffects on the personnel involve in handling them. The critical \noperations include manufacture, storage, transport, \ncompounding, testing, dispensing, and administration to the \npatients.\nComplying as per ALARA (As Low As Reasonable \nAchievable) principle, in order to minimize the harmful effects \nof radiopharmaceuticals, there should be specialized \ntechniques for controlling the risk. A major consideration of \nthe ALARA principle includes exposure time, distance and \nradiation shielding. These factors should be carefully \nconsidered while designing the safety protocols for \nradiopharmaceuticals.\nRadiation Sign\nRestricted area .\n< 2 mR/h and < 100 mR/year\nCaution, Radiation Area\nmay exceed 5 mR per hour at \n30 cm from source\nmay exceed 100 mR per hour \nat 3 0 cm from sou rcc ; \n•\nCaution, High Radioactive\nArea \n'\nmay reach 500 R per hour at\nDanger, Very High Radiation \nArea , ■\n1 m from source (Not in NM)\nCaution Radioactive Material\n100 Ci for Cs-137 and Sr-89\n1 mCi for Mq-99, 1-123 and\nCo-57 \nf:’)—\n10 mCi for Tc-99m, Ga-67 and\nXe-133.\n4723\nwww.webofpharma.com\nRadiation safety'Instruments \nj T\nLaboratory survey V\nGM Survey meters, ' ■ ? ■; !\nHigh level exposure rate\nPortable Ion Chambers\nmonitoring\nPocket Dosimeter\nPersonnelexposure \nmonitoring\nWipe Test Counters\nGM Counters to detect low \nlevel activity\nFilm Badges,\nTo detect and measure \npersonnel exposure\nThermoluminescent\nDosimeters\nMore sensitive than film \nbadges\nScintillation Detectors\n— Portable scintillation survey detectors for gamma survey\nof lab surfaces\n- - Well type single channel analyzers for, measurement of\nwipe tests\n— Multiweil gamma.ray spectrometer to identify and quantify\ngamma contamination.\n5.0 Physical Characteristics of Radionuclides\nThe values are obtained from the database of the Rational \nNuclear Data Center (NNDC) at Brookhaven National \nLaboratory, Upton. N.Y, USA, directly accessible via Internet"}},{"@id":"https://www.openphar.org/data/ip/monographs/rafoxanide","@type":"IndexedMonograph","prefLabel":{"en":"Rafoxanide"},"edition":"ip-2010","category":"monographs","definition":{"en":"Rafoxanide\nMol. Wt. 626.0\nRafoxanide isN-[3-chloro-4-(4-chlorophenoxy)phenyl]-\n2-hydroxy-3,5-diiodobenzamide..\nRafoxanide contains not less than 98.0 per cent and not more\nthan 101.0 per cent ofCI9H1JChI2N03, calculated on the dried\nbasis.\nCategory. Anthelmintic.\nDose. Cows, buffaloes, sheep andgoats. 7 to 12 mg per kg of\nbody weight.\nDescription. A greyish-white to brown powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ramipril","@type":"IndexedMonograph","prefLabel":{"en":"Ramipril"},"edition":"ip-2010","category":"monographs","definition":{"en":"Ramipril\nCZ3H3ZNzOs\nMol. Wt. 416.5\nRamipril is (2S,3aS,6aS)-1-[(S)-2-[[(S)-I-(ethoxycarbonyl)-\n3-phenylpropyl]amino]propanoyl]\noctahydrocyclopenta[b]pyrrole-2-carboxylic acid.\nRamipril contains not less than 98.0 per cent and not more\nthan 101.0 per cent ofCz3H32NzOs.calculated on the dried basis.\nCategory. Antihypertensive.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ranitidine-hydrochloride-injection","@type":"IndexedMonograph","prefLabel":{"en":"Ranitidine Hydrochloride Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Ranitidine Hydrochloride Injection\nRanitidine Injection is a sterile solution of Ranitidine \nHydrochloride in Water for Injections and may be suitably \nbuffered.\nRanitidine Hydrochloride Injection contains not less than\n90.0 per cent and not more than 110.0 per cent of the stated \namount of ranitidine, C 3H22N403S.\nUsual strength. The equivalent of 50 mg of ranitidine in 2 ml \n(1.12 g of ranitidine hydrochloride is approximately equivalent \nto 1 g of ranitidine)."}},{"@id":"https://www.openphar.org/data/ip/monographs/ranitidine-oral-solution","@type":"IndexedMonograph","prefLabel":{"en":"Ranitidine Oral Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ranitidine Oral Solution\nRanitidine Hydrochloride Oral Solution.\nRanitidine Oral Solution is ;a solution of ranitidine \nhydrochloride in a suitable vehicle.\nRanitidine.Oral Solution contains not less than 90.0 per cent \nand not more than 1 lO.O.per cent of the stated amount of the \nranitidine,CijH^^CJS.. f. ? \n.... . \n. ' r\n■Usualstrength.75mgper5ml. \n;.-i"}},{"@id":"https://www.openphar.org/data/ip/monographs/raphe","@type":"IndexedMonograph","prefLabel":{"en":"Raphe"},"edition":"ip-2022","category":"monographs","definition":{"en":"A pesticide is any substance or mixture of substances intended \nfor preventing, destroying or controlling any pest, unwanted \nspecies of plants or animals causing harm during or otherwise \ninterfering with the production, processing, storage, transport \nor marketing of herb.\nTable 1- Permissible limits for Pesticide Residue\nSubstance\nLimit \n(mg/kg)\nSr.\nNo.\n1\nAlachlor\n0.02\n2\nAldrin and Dieldrin (sum of)\n0.05.\n3\nAzinphos-methyl\n1.0\n4\nBromopropylate\n3.0\n5\nChlordane (sum of cis-, trans - and \nOxythlordane)\n0.05\n6\nChlorfenvinphos\n0.5\n7\nChlorpyrifos\n0.2\n8\nChlorpyrifos-methyl\n0.1-\n9\nCypermethrin (and isomers)\n1-°\n10\nDDT (sum of p,p-‘DDT, o,p-‘DDT, \np,p-‘DDE and p,p-‘TDE\n1.0 .\n11\nDeltamethrin\n0.5\n12\nDiazinon\n0.5\n13\nDichlorvos\n1.0\n14\nDithiocarbamates (as CS2)\n2.0\n15\nEndosulfan (sum of isomers and\nEndosulfan sulphate)\n3.0\n16\nEndrin\n0.05\n17\nEthion\n2.0\n18\nFenitrothion\n0.5\n19\nFenvalerate\n1.5\n20\nFonofos\n0.05\n21\nHeptachlor (sum of Heptachlor \nand Heptachlorepoxide)\n0.05\n22\nHexachlorobenzene\n0.1 .\n23 .\nHexachlorocyclohexane isomers \n(other than y)\n0.324\n24\nLindane (y-Hexachlorocyclohexane)\n0.6\n25\nMalathion\n1.0\n26\nMethidathion\n0.2\n27\nParathion\n0.5\n28\nP arathion-methyl\n0.2\n29\nPermethrin\n1.0\n30\nPhosalone\n0.1\n31\nPiperonyl butoxide\n3.0\n32\nPirimiphos-methyl\n4.0\n33\nPyrethrins\n3.0\n34\nQuintozene (sum of quintozene, \npentachloroaniline and methyl \npentachlorophenyl sulphide)\n1.0\nTable 2 - Permissible Limits for Pesticide Residue\nbanned in India (2016)\nSr,\nSubstance\nLimit\nNo.\n(mg/kg)\n1\nAldrin and Dieldrin (sum of)\n0.05\n2\nChlordane (sum of cis-, trans- \nand Oxythlordane)\n0.05\n3\nChlorfenvinphos\n0.5\n4\nDDT (sum of p,p-‘DDT, o,p-‘DDT, \np,p-‘DDE and p,p-‘TDE\n1.0\n5.-\nDiazinon\n0.5\n6\nEndrin\n0.05\n7\nFenitrothion\n0.5\n8\nHeptachlor (sum of Hepfachlor \nand Heptachlorepoxide)\n0.05\n9\nLindane (y-Hexachlorocyclohexane)\n0.6\n407\nwww.webofpharma.com\nNOTE — Apart from the above, if any pesticides applied to\nthe herb before or after harvesting should also be tested- The \nlimit should be calculated using the following formula.\nADIxM\nMDDxlOO\nWhere, ADI = Acceptable daily intake as published by FAO-\nWHO,in milligrams per kilogram of body mass, \nM = body mass in kilograms (60 kg), <\nMDD = daily dose of herbal drug, in kilograms.\nIf the Herb is intended for the preparation of extracts, tinctures \nor other pharmaceutical forms whose preparation method \nmodifies the content of pesticides in the finished product, the \nlimits are calculated using the following expression:\nAxMx L\nMDDxlOO\nWhere, E = Extraction factor for of the method of\npreparation, determined experimentally.\nHigher limits can also be authorized, in exceptional cases, \nespecially when a plant requires a particular cultivation method \nor has a metabolism or a structure that gives rise to a higher \nthan normal content of pesticides. \n.\nSampling\nMethod. For containers up to 1 kg, take one sample from the \ntotal content, thoroughly mixed, sufficient for the tests. For \ncontainers between 1 kg and 5 kg, take three samples, equal in \nvolume, from the upper, middle and lower parts of the container, \neach being sufficient to carry out the tests. Thoroughly mix \nthe samples and take from the mixture an amount sufficient to \ncarry out the tests. For containers of more than 5 kg, take \nthree samples, each of at least 250 g from the upper, middle \nand lower parts ofthe container. Thoroughly mix the samples \nand take from the mixture an amount sufficient to carry out the \ntests, ■ .■\nSize of sampling. If the number (n) of containers is three or \nfewer, take samples from each container as indicated above \nunder Method. If the number of containers is more than three, \ntake “ + 1 samples for containers as indicated under Method, \nrounding up to the nearest unit if necessary”.\nThe samples are to be analyzed immediately to avoid possible \ndegradation ofthe residues. If this is not possible, the samples \nare stored in air-tight containers suitable for food contact, at \na temperature below 0°, protected from light.\nReagents. All reagents a"}},{"@id":"https://www.openphar.org/data/ip/monographs/reactivity","@type":"IndexedMonograph","prefLabel":{"en":"Reactivity"},"edition":"ip-2022","category":"monographs","definition":{"en":"Reactivity\nAhti-D(IgM) O+ve 1:>64 \n1:>128 I\n(Monoclonal) (R^orR^) \n|\nHaemolysis. It is defined as the release of hemoglobin from \nthe red cells as a result of osmotic effect or due to the breaking \nup of the red blood cells. No immune haemolysis should be \nobserved with the red blood cells used for specificity.\nAnti-D Blend or (IgM + IgG) Monoclonal blood grouping \nreagents are tested for their Physical Appearance, Color, \nPotency, Avidity, Intensity, Specificity, Rouleaux, Haemolysis \nand Prozone parameters and have values greater than or equal \nto the appropriate International Standards or suitable reference \npreparation used.\n.type of Reagent \nTest Red Blood Cells. Haemolysis\nAvidity, It is. defined as the time taken for agglutination to: \nappear first to the unaided eye when 1 volume of the Anti-D \n(IgM) Monoclonal blood grouping reagent is mixed with\n■: Anti-D (IgM) \nO +ve (Rtr or RiR2) \nAbsent\nf (Monoclonal) \nO-ve(rrorr’rorr”r) \nAbsent\n1 volume of a 40 per cent v/v suspension of human red \ncorpuscles of specific group and compared with the time taken' \nby that of the reference standard. Rapid mixing is performed \nby spreading with use of agitation, with a centrifugal spiral \nmovement to form a circular reaction surface about 3 cm ifl; \ndiameter. The value for avidity is the mean of three \nmeasurements."}},{"@id":"https://www.openphar.org/data/ip/monographs/recombinant-human-parathyroid-hormone","@type":"IndexedMonograph","prefLabel":{"en":"Recombinant Human Parathyroid Hormone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Recombinant Human Parathyroid Hormone \n(rhPTH1'34)\nSVSEIQLMHN LGKHLNSMER VEWLRKKLQD VHNF\nC181H391N55O5IS2 \nMol.Wt. approx. 4117.8 Da\nTeriparatide is a biologically active N-terminal fragment of \nendogenous (native) human parathyroid hormone produced \nby recombinant DNA technology in bacteria as host cells. It is \nproduced under conditions designated to minimize microbial \ncontamination of the product.\nTeriparatide contains not less than 90.0 per cent and not more \nthan 110.0 per cent of teriparatide (Ci8IH39]N55O5IS2), \ncalculated on anhydrous, acetic acid-free, and chloride-free \nbasis.\nCategory. Bone forming agent.\nDescription. White to practically white solid (Lyophilized \npowder/cake).\nHost cell-derived proteins. Not more than 100 ppm.\nHost cell-derived DNA. Not more than 10 ng per dose.\nEach batch of Teriparatide complies with the following \nrequirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/referenc","@type":"IndexedMonograph","prefLabel":{"en":"Referenc"},"edition":"ip-2018","category":"monographs","definition":{"en":"Referenc \n50.0 mi \\,\ne solution (a). Dilute 1.0 ml of the test solution to\ncent). The sum of areas of all the secondary peaks is not more\nitli water.\nC7,1115c12N202P,1120 \t\nMol. Wt. 279.1\nthan-the area of the principal peak in the chromatogram\nReferenc.( \n200.0 nil v\n obtaitid\n.with the reference solution (1.0 per cent). Ign ore any\nsolution (b). Dilute 1.0 ml of thel* solution to Cycldphosphamide is (RS)-2-bis(2-chloro-ethyl) amino- \nvial water. \nperhydro-13,2-oxazaphosphorinane 2-oxide monohydrate.\npeak with an area less than 0.05 times the area of the p nnciPal\n1724 `\nCyclophosphamide contains not less than 98.0 per cent and \nnot more than 102.0 per cent of C 7H 15C12N202P, calculated on \nthe anhydrous basis.\nCategory. Anticancer.\nDose. Orally or by intravenous injection, 100 to 150 mg daily.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/reference","@type":"IndexedMonograph","prefLabel":{"en":"Reference"},"edition":"ip-2018","category":"monographs","definition":{"en":"Reference \n .ith\nsolution. \nor \n\tDilue 1 ml of the test solution to 100 ml \nwith c\nDescription. A white or almost white, crystalline powder; \nodourless or almost odourless.\nchloroform.\nApply\nt o the plate 5µl of each solution. Allow the mobile \nphase to rise 10 cm. Dry the plate in air for 5 minutes, spray \nwith sulphuric acid and heat at 120° for 10 minutes until spots"}},{"@id":"https://www.openphar.org/data/ip/monographs/related","@type":"IndexedMonograph","prefLabel":{"en":"Related"},"edition":"ip-2018","category":"monographs","definition":{"en":"Related\nMol. Wt. 528.6\nsubstances. Determine by liquid chromatography\n90\n(2.4.14)\n30 \t\n10\n90\nTest soh\nBacterial endotoxins (2.2.3). Not more than 50.0 Endotoxin \nUnits per mg.\naim/. Dilute a volume of injection containing about\nInject reference solution (b)• The test is not valid unless the\n0.5 mg\nof Fentanyl to 10.0 ml with the mobile phase, if\nresolution between the peaks due to fentanyl and fentanyl\nnecessa\nrY.\nimpurity D is not less than 3.0.\nOther tests. Comply with the tests stated under Parenteral \nPreparations (Injections).\nIn, the\nReferen ce solution (a). Dilute 1.0 ml of the2tOria-Iuti6A to\nInject`ItferOC4 solution (a) and the test solution.\n100.0m 1 with the mobile phase. Dilute 5.0 ml f dissolution to \n20.0mi \nwith the mobile phase.\nchromatograrn Obtained with the test solution the area of all\"\nAssay. Determine by liquid chromatography (2.4.14).\nsecondary peak is not more than the area of the principal Peat'\n'21\\ \nNTe:\n,\n4 --,\nTest solution. Dilute a volume of injection containing about \n0.5 mg of Fentanyl to 10.0 ml with the mobile phase, if \nnecessary.\nReference solution. A 0.008 per cent w/v solution of fentanyl\ncitrate RS in the mobile phase.\nUse chromatographic system as described in the Related\nsubstances.\nInject the reference solution. The test is not valid unless the \nrelative standard deviation for replicate injections is not more \nthan 2.0 per cent. \nInject the reference solution and the test solution.\nCalculate the content of C 22H28N20 in the injection.\nStorage. Store protected from light.\nLabelling. The quantity of active ingredient is stated in terms \nof the equivalent amount of fentanyl."}},{"@id":"https://www.openphar.org/data/ip/monographs/relative","@type":"IndexedMonograph","prefLabel":{"en":"Relative"},"edition":"ip-2022","category":"monographs","definition":{"en":"Relative \nretention time\nfactor\nFinasteride impurityA1\n0.9\n2.4\nMol. Wt. 372.6\nFinasteride\n1.0\n—\nFinasteride impurity C2\n1.3\n0.72\n/Ar“(l)l-dimethylethyl)-3-oxo-4-aza-5a-androstane’17P-cabroxami(ie \ncarboxamide (A-l,5-aza amide)\nW-(1,1 -dimethylethyl)-3-oxo-4-azaandrosta-1,5-diene-1\n(dihydro finasteride).\nInject reference solution (b) and (c). The test is not valid unless \nthe signal to noise ratio is not less 40 for the principal peak ffl \nthe chromatogram obtained with reference solution (c) and \nthe peak to valley ratio is not less than 5.0 where Hp - height \nabove the baseline of the peak due to impurity^ \nand Hv = height above the baseline of the lowest point oft « \ncurve separating this peak from the peak due to finasteride m \nthe chromatogram obtained with reference solution (b).\nwww.webofpharma.com\nIP 2022\n>ct reference solution (c) and test solution (b). Run the \n^oinatogram twice the retention time of the principal peak.\nIn the chromatogram obtained with the test solution (b) the \narea of secondary peak corresponding to finasteride impurity\n\\ and finasteride impurity C is not more than 3 times the area \nofthe principal peak in the chromatogram obtained with the \njeference solution (c) (0.3 per cent), the area of any other \nsecondary peak is not more than the area ofthe principal peak\nchromatogram obtained with reference solution (c) (0.1\nper cent) and the sum of the areas of all the secondary peaks\nis not more than 5 times the area of the principal peak in the \nchromatogram obtained with reference solution (c) (0.5 per\ncent). Ignore any peak with an area less than 0. 5 times the\narea ofthe principal peak in the chromatogram obtained with \nreference solution (c) (0.05 per cent).\nLoss on drying (2.4,19). Not more than 0.5 per cent, determined\non 1.0 g by drying in an oven at 105°.\nAssay. Determine by liquid chromatography (2,4.14) as \ndescribed under Related substances.\nInject reference solution (a) and test solution (a).\nCalculate the content of C23H36N2O2. ■\nStorage. Store protected from light.\nFinasteride Tablets\nFinasteride Tablets containnot less than 95.0 per cent and not\nmore than 105.0 per cent of the stated amount of finasteride, \nWJA.\nUsual strength. 5 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/remdesivir","@type":"IndexedMonograph","prefLabel":{"en":"Remdesivir"},"edition":"ip-2022","category":"monographs","definition":{"en":"Remdesivir\n2-ylmethoxy]phenoxy-(1S)-phosphorylamino)propionic acid 2- \nethyl-butyl ester.\nRemdesivir contains not less than 98.0 per cent and not more \nthan 102.0 per cent of C27H35N6O8P, calculated on the \nanhydrous basis. \n. ; o ■/-<■ :\nCategory. Antiviral.\nDescription. A white to off white to yellow powder.\nA. Determine by infrared absorption spectrophotometry (2.4.6). \nCompare the spectrum with that obtained with remdesivir IPRS \nor with the reference spectrum of remdesivir. \n':\nB. In the Assay, the principal peak in the chromatogram \nobtained with the test solution corresponds to the peak in the \nchromatogram obtained with the reference solution.\nAppearance of solution.. A 2.0 per cent w/v solution in\nmethanol is clear (2.4.1) and colourless (2.4.1),\nSpecific optical rotation (2.4.22). -23.0° to -17.0°, determined \nin a 1.0 per cent w/v solution in methanol.\nRelated substances. Determine by liquid chromatography \n(2.4.14).\nSolvent mixture. 40 volumes of acetonitrile and 60 volumes \nof water.\nNOTE — Prepare the solutions immediately before use.\nTest solution. Dissolve 50 mg of the substance under \nexamination in the solvent mixture and dilute to 50.0 ml with \nthe solvent mixture.\nReference solution (a). A 0.005 per cent w/v solution of \nremdesivir,IPRS in the solvent mixture.\nReference solution (b). Dissolve 12.5 mg of remdesivir\nimpurity DIPRS (fragment-B) in 5 ml acetonitrile with the aid \nof ultrasound and dilute to 25.0 ml with the solvent mixture.\nReference solution (c). Dilute 10.0 ml of reference solution (a) \nand 1.0 ml of reference solution (b) to 100.0 ml with the solvent \nmixture. •• \nM‘:’ \n''\nChromatographic system\n- a stainless steel column 25 cm x 4.6 mm, packed with\noctadecylsilane with the extra selectivity of a penta fluoro\n• phenyl phase bonded to porous silica (5 pm) (Such as \nACEPFPC18),\n• \n• column temperature: 40°,\n- sample temperature: 10°,\n- mobile phase: A. a buffer solution prepared by\ndissolving 1.36 g of potassium dihydrogen phosphate\n1\nin 1000 ml of water,\nJ' ! \nB. a mixture of 90 volumes of acetonitrile\nand 10 volumes of water,\n3467\nwww.webofpharma.com\n- flow rate: 1.5 ml per minute,\nspectrophotometer sef.at245.nm and.27,5, nm,\ninjection volume: 5 pl. \n......r.\nMobile phase: B\nMobile phase A\nTime\n(in min.) \n(per cent v/v) \n(p<ir cent v/v.) . ;\n■ .. ...\nA 15\n25\n40\nr 60 .... . >; {\n35 '\n40\n60\n48’ ,\n. : ;80 \n■\n*>• Brnrn. \n. , . .15 .: \n,■\n.E: : ... 55 ffi: ci\n•85 \n-mse: 15 EmE\nName\nRelative\nCorrection\nretention time\nfactor c '\nRerndesivir impurity A1 ;\n0.17\n• 0.48 E\nRerndesivir impurity B2\n0:57\n0.53\nRerndesivir (Retention til \nabout 21 minutes) '\nme:\n1.0\n' '■ \n1' 1 27 : \n■•'/ ’< -T7YV\nI * JZ\nRerndesivir impurity D4\nL74\ni(2/fJ37?,4S,5A)-2-(4-aminopyrrolo[2,I-f][i,2,4]triaziii-7-yl)-3,4'\ndihydroxy-5-(hydroxymethyt)tetrahydrofuran-2-carbonitrile (Fragment \nA),\n2(3 aR>, 4R, &R,6a A)-4'-( 4-ami n opyfrolo[ 2,4 -f] [ 1,2; 4 ] tri azin -7*y I )-6 - - \n(hydrpxymethyl)72f2-dimethyltetrahydrofuran[3>4rd].[il,3],dipxel.e’4-- \ncarbonitrile (Acetonide), \n.\n12-ethyIbutyl((S)-(((3aR,4R,6R.6aR)-6-(4-aminopyrrolo[2,1-f] \n[1,2,4]t’ria:ziii-7-yl)-'6-cyaiio-2,2-dimethyItetrahydrofurd[3,4-d]1 \n[ 1,3]dioxol-4-yl)methoxy)(phen6xy)ph6!sphoryl)amiho)-Z;-aianinate - \n(Condensed), \n, . „ .\n4M-f(S)-(4Ynitrophenpxy) phenoxyphosphinyiJ-I'Ala.ine- 2- ethylbutyl \nester (Fragment 13). \n; .. . \n.\nInject reference solution (c}.; The. test is, not yalid.unless, they \ncolumn efficiency is not less than.2000 theoretical plates, the\nInjectreference solution (c) and the test solution at 2.45 nm. In \nthe chromatogram obtained with, the test solution; ,the. area of \nany peak corresponding to rerndesivir impurity A, B and C, \neach of, is not more than the area ofthe peak duo :t°rerndesivir \nin the chromatogram obtained with reference solution (c) \n(0.5 per pent), and the ;area of anyother secondary peak is not \nmore than. 0.6 times the area of.the peak due to rerndesivir in \nthe chromatogram obtained with reference: solution (c) \n(0.3 per"}},{"@id":"https://www.openphar.org/data/ip/monographs/reproducibility","@type":"IndexedMonograph","prefLabel":{"en":"Reproducibility"},"edition":"ip-2022","category":"monographs","definition":{"en":"Reproducibility\nReproducibility expresses the precision between laboratories \n(collaborative studies, usually applied to standardisation of \nmethodology).\nReproducibility is usually demonstrated by means of an inter­\nlaboratory trial.\nDetection Limit\nThe detection limit of an analytical procedure is the lowest \nconcentration of analyte in a sample that can be detected but \nnot necessarily quantitated as an exact value.\nThe detection limit is usually expressed as the concentration \nof analyte (e.g., percentage, parts per billion) in the sample.\nThe detection limit is usually demonstrated by measuring low \nconcentrations of the analyte and showing that a response is \nobtained.\nQuantitation Limit\nThe quantitation limit of an individual analytical procedure is \nthe lowest amount of analyte in a sample which can be \nquantitatively determined with suitable precision and accuracy. \nThe quantitation limit is a parameter of quantitative assays for\nlow levels of compounds in sample matrices, and is used \nparticularly for the determination of impurities and/or \ndegradation products.\n382\nwww.webofpharma.com\nIP2022\n2.5; 1.1. POLYMORPHISM\n[t is usually expressed as. the concentration of analyte (e.g', \npercentage, parts per billion) in the sample. .\nThe quantitation limit is usually demonstrated by measuring \n|0v; concentrations of the analyte and showing that a \nrepeatable response is obtained."}},{"@id":"https://www.openphar.org/data/ip/monographs/reserpine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Reserpine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Reserpine Injection\nReserpine Injection is a sterile solution of Reserpine in Water \nfor Injections prepared with the aid of a suitable acid. It may \ncontain suitable antioxidants.\nReserpine Injection contains not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of reserpine, \nww' : \n■\nUsual strengths. 1 mg per ml; 2.5 mg per ml.\nExtract a suitable volume of the injection containing 16 mg of \nReserpine with 10 ml of chloroform and evaporate the \nchloroform layer to. dryness. The residue complies with the \nfollowing tests..\nTest A may be omitted if tests B, C, D and E are carried out. \nTests B, C, D and E may be omitted if test A is carried out.\nA. Determine by infrared absorption spectrophotometry (2.4.6). \nCompare the spectrum with that obtained with reserpine IPRS \nor with the reference spectrum of reserpine.\nB. Dilute 1 ml of a 0.2 per cent w/v solution in chloroform to\n100 ml with ethanol (95per cent). When examined immediately \nafter preparation, in the range 230 nm tb 360 nm (2.4.7), the \nresulting solution shows an absorption maximum at about \n268 nm; absorbance at about 268 nm, about 0.55. Over the \nrange 288 nm to 295 nm, the spectrum exhibits a slight minimum \nand then a shoulder or a slight maximum; absorbance oyer \nthis range, about 0.34.\nC. To about 1 mg add 0.1 ml of a 0.1 per cent w/v solution of \nsodium molybdate in sulphuric acid; a yellow colour is \nproduced which changes to blue within 2 minutes.\nD. To 1 mg add 0.2 ml of a freshly prepared 1 per cent w/v \nsolution of vanillin in hydrochloric acid;-, a: pink- colour \ndevelops within 2 minutes.\nE. Mix about-0.5 mg with 5 mg of 4-dimethylaminobenzal- \ndehyde and 0;2 ml of glacial acetic acid and add 0.2 ml of \nsulphuric acid; a green, colour is produced; Add 1 ml of \nglacial acetic acid; the colour changes to red.\nBacterial endotoxins (2.2.3). Not more than 71.5 Endotoxin \nUnits per mg of reserpine.\nOther tests. Comply with the tests stated .under Parenteral \nPreparations (Injections).\nAssay. Protect the solutions from light throughout the assay.\n3477\nwww.webofpharma.com\nRESERPINE TABLETS\nMeasure a volume of the injection containing about 10 mg of \nReserpine and dilute with a 2 per cent w/v solution of citric \nacid to 100.0 ml: Extract 10:0 ml of the solution for \n2 minutes with three quantities, each of 15 ml; of chloroform. \nWash the combined extracts with 10 ml of a 1 per cent w/v \nsolution oisodium bicarbonate, add sufficient chloroform to \nproduce 50.0 ml, mix and evaporate 10.0 ml to dryness on a \nwater-bath. Dissolve the residue in 10 ml of ethanol (95 per \ncent), add 2 ml of 0.25 Msulphuric acid and 10 ml of ethanol \n(95 per cent) and warm gently to dissolve. Cool, dilute to\n100.0 ml with ethanol (95per cent) and dilute 5,6 ml to 50.0 ml \nwith the same solvent (solution A). Transfer 10.0 fnl to a bdiling \ntube, add 2 ml of 0.25 M sulphuric acid and 2 ml of a freshly \nprepared 0.3 per cent w/v solution of sodiumnitrite, mix and \nheat in a water-bath at 55° for 35 minutes. Cool, add 1 ini'of a \nfreshly prepared 5 per cent w/v solution of sulphamic acid \nand dilute to 25.0 ml with ethanol (95percent). Measure the \nabsorbance of the resulting solution at the maximum at about \n388 nm (2.4.7), using as the blank a solution prepared by \ntreating a further 10,0 ml of solution Ain the same manner and \nat the same time but omitting the sodium nitrite solution.\nCalculate the content of C33H40N2O9 from the , absorbance \nobtained by repeating the operation using reserpine IPRS in \nplace ofthe substance under examination.\nStorage. Store protected from light in single dose (or if \nstabilising agents are present, in multiple dose) containers.\nReserpine Tablets\nReserpine Tablets contain not less than 90.0 per cent and not \nmore than 110.0 per cent of the stated amount of reserpine, \nC33H40N2O9.\nUsual strengths. 100 pg; 250 pg; 500 pg; 1 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/reserpine","@type":"IndexedMonograph","prefLabel":{"en":"Reserpine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Reserpine\n1\nA. Mol. WL 608.7 v.|\nC33H40N2O9\nReserpine is methyl II, 17a-dimethoxy-18P-[(3,4;5-tri- \nmethoxybcnzoyl)oxy]-3p,20a-yohimbane-16p-carhoxylate i\nReserpine contains not less than 99.0 per cent and ndtihiore\nthan 101.0 per cent of total alkaloids andnot lessithan 98.0 per | \ncent and not more than 1,02.0 per cent of reserpine, \n1\nboth calculated on the dried basis. \n' ‘\nCategory.Antihypertensive. ....... ” ' ? 'J \nyg\nDescription. White to slightly yellow small crystals ora . | \ncrystalline powder which darkens slowly bn exposure tb light. . |"}},{"@id":"https://www.openphar.org/data/ip/monographs/ribavirin-for-inhalation","@type":"IndexedMonograph","prefLabel":{"en":"Ribavirin for Inhalation"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ribavirin for Inhalation\nRibavirin for Inhalation is a sterile ribavirin consisting of \nRibavirin with or without excipients. It is filled in a sealed \ncontainer.\nThe inhalation solution is constituted by dissolving the \ncontents of the sealed container in the requisite amount of \nsterilewaterfor injection, immediately before use.\nThe'constituted solution complies with the requirements for \nCldri^ &f solution and particulate matter stated under \nInhalation Preparations. \n' j\nStorage. The constituted solution should be used immediately \nafter: preparation but, in any case, within the period \nrecommended by the manufacturer. :\nRibavirin inhalation Solution contains not less than 95.0 per \ncent and not more than 105.0 per cent ofthe stated amount of \nWWlr':\nThe content of the .sealed container complies with the \nrequirements stated under Inhalation Preparations and with \nthe following requirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/ribavirin","@type":"IndexedMonograph","prefLabel":{"en":"Ribavirin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ribavirin\nCiHaNM:\" ' ' . \nMol.Wt 244.2\nRibavirin is i-P-D-ribofuranosyl-l#-l,2,4-triazole-3- \ncarboxamide.\nRibavirin contains not less than 98.0 per cent and not more \nthan 102.0 per cent of CSH12N4O5, calculated on the dried basis.\nCategory. Antiviral.\nDescription. A white or almost white crystalline powder. It \nshowspolymorph ism (2.5.11)."}},{"@id":"https://www.openphar.org/data/ip/monographs/riboflavin","@type":"IndexedMonograph","prefLabel":{"en":"Riboflavin"},"edition":"ip-2010","category":"monographs","definition":{"en":"Riboflavin\nLactoflavin; Vitamin B2\nMol. Wt. 376.4\nRiboflavin is 3,1O-dihydro-7,8-dimethyl-l0-[(2S,3S,4R)-\n2,3,4,5-tetrahydroxypentyl]benzo[g]pteridine-2,4-dione.\nRiboflavin contains not less than98.0 per cellt and not more\nthali 101.0 per celit of CI7H2oN406, calCulated on the dried\nbasis.\nCategory. B-group vitamin.\nwww.webofpharma.com\nIP 2010\nDose. Prophylactic, 1 to 4 mg daily; therapeutic, 5 to 10 mg\ndaily.\nDescription. A yellow to orange-yellow, crystalline powder;\nodour, slight."}},{"@id":"https://www.openphar.org/data/ip/monographs/rifampicin","@type":"IndexedMonograph","prefLabel":{"en":"Rifampicin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rifampicin\nRifampin,\nC43H58N4Oi2 ' ’■ \n' ■■ Mol. Wt.823.0\nRifampicin is(1.2Z, l,4£,24£)-(25', 16.9,175,18/?, 197?,20/?, \n21 S,22R,2 3 5)-1,2-dihydro-5,6,9,17,19-pentahydroxy- \n23-meth oxy-2,4,12,16,18,20,22-heptamethyl-8-(4-methyl- \npiperazin-l-yl iminomethyl)-! ,1 l-dioxo-2,7-(epoxypcntadeca-\n1,11,13-trienimino)naphtho[2,l-fi]furan-21-yl acetate.\nRifampicin contains not less than 97.0 per cent arid not more \nthan 102.0 per cent of C.rJl5SN.tO|2, calculated on the dried \nbasis. \n■ .w,.w \n7;'. ■’ \n■' 7 ■ w\nCategory. Antitubercular. ,\nDescription. A brick-red to reddish brown, crystalline powder.\n3484'\n2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/rilpivirine","@type":"IndexedMonograph","prefLabel":{"en":"Rilpivirine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rilpivirine\nC22H18N6.HC1 \nMol Wt 402.9\nRilpivirine is 4^{[4-({4-[(£)-2-Cyanovinyl]-2,6-dimethylphehyl} \nami no)pyrimidin-2-yl] amino) benzonitrile. 5\nRilpivirine contains not less than 98.0 per cent and-not more \nthan 102.0 per cent of C23H18N6.HCI, calculated on the \nanhydrous basis.\nCategory. Antiretroviral. \n..\nDescription. A white to pale brown colour powder; ■ m"}},{"@id":"https://www.openphar.org/data/ip/monographs/risedronate-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Risedronate Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Risedronate Sodium\nOH\nH°\nH°4\nMoLWt 305.1\nMol. Wt. 323.1\nC7H10NNaO7P2,H2O(Monohydrate)\nMol. Wt 350.1\nC7Hi0NNaO7p2,2.5H2O (Hemi-pentahydrate)\nRisedronate Sodium is l-Hydroxy-2-(3-pyridyl)ethane-\nl,l-diylbis(phosphonic acid) monosodium salt.\nRisedronate Sodium contains not less than 98.0 per cent and \nnot more than 102.0 per cent of C7H10NNaO7P2, calculated on \nthe anhydrous basis.\nCategory. Calcium regulator.\nDescription. Awhite to off-white powder.\nA. Determine by infrared absorption spectrophotometry (2.4.6), \ncompare, the spectrum with that obtained with risedronate \nsodium IPRS or with the reference spectrum of risedronate \nsodium.\nB. A 1.0 percent w/v solution gives, the reactions of sodium \nsalt (2.3.1).\n3497\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/risperidone-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Risperidone Syrup"},"edition":"ip-2022","category":"monographs","definition":{"en":"Risperidone Syrup\nRisperidone Oral Solution\nRisperidone Syrup contains not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of \nrisperidone, C23H27FN4O2. It may contain suitable preservative.\nUsual strength. 1 mg per ml.\nIn the Assay, the principal peak in the chromatogram obtained \nwith the test solution corresponds to the peak in the \nchromatogram obtained with reference solution (b).\n3501\nwww.webofpharma.com\nTests ■ ■\npH (2.4.24). 2.0 to 4.O., \n... .\nRelated substances. Determine . by liquid chromatography \n(2.4.14). \n......\nBuffer solution. AO.5 per cent w/v solution of ammonium \nacetate in water.\nTest solution. Transfer a suitable quantity ofthe syrup \ncontaining. 10 mg of Risperidone to a 50-ml volumetric flask, \nadd 25 ml of the buffer solution, fill with methanol almost to \nvolume and mix. Allow to cool to room temperature and dilute \nwith methanol to volume. \n,\nReference solution (a). Dissolve 2.5 mg of risperidone related \ncompounds mixture IPRS in 2 ml of methanol. Add 2 ml of \nwater and 5 ml of the buffer solution and allow to cool to room \ntemperature, dilute to 10.0 ml with methanol.\nReference solution (bf A 0.0005 per cent w/v solution of \nrisperidone IPRS in methanol.\nReference solution (c). Transfer 10.0 ml of reference solution \n(b) to a 50-ml volumetric'iflask. Add 10 ml of water and 25 ml of \nthe buffer solution and allow to cool to room temperature, \ndilute, with wezAmm/.to volume.\nReference solution (^.Transfer 2.0 ml of reference solution\n(b) to a 50-ml volumetric flask. Add 10 ml of water, and 25 ml of \nthe buffer solution and allow to cool to room temperature, \ndilute with methanol to volume.\nChromatographic system \n.\n- a stainless steel column 10 cm x 4.6 mm, packed with\noctadecylsiiane bonded to porous silica (3 pm),\n- mobile phase: a mixture of 78 volumes of the buffer\nsolution and 22 volumes of acetonitrile,\n- flow rate: 1.5 ml per minute,\n- spectrophotometer set at 275 nm,\n- injection volume: 10 pl.\nName\nRelative \nretention time\nfactor\nRisperidone m-A’-oxidc'\n0.33\n1.03\nB icyclori speridone2\n0.43\n1.49,\nRisperidone Z-oxirne3*\n0.53 ' ' \"\n—\nRisperidone\n; 1.0 ■ •\n—\n♦Process'impurity included for identification only. Process impurities \nare controlled in the-drug substance,\" and are. not to .be reported or \nincluded in the total impurities for the drug product,\n1 c is-3 - {2 -[4-(6-Fluoro-1,2-benzisoxazpl-3 -yl)-1 -piperidin yl] ethyl }-2- \nmethyI-6,7,8,9-tetrahydro-4H-pyrido[i,2-(2]pynmidih-4-drie TV-oxide,\n23-(4-Fluoro-2-hydroxypheny])-l-{2-(6,7,8,9-tetrahydro-2-methyl-4- \noxo-4/f-pyrido-[l ,2-a]pyrimidin-3-yI)ethyl}-2-az4'-l-azo'nia- \nbicyclo[2.2.2]oct-2-ene iodide,\n33-(2-{4-[(Z)'-(2,’4-Difluoroplienylj(hydroxyiminojmethyl]piperidin-l- \nyI}etliy])-2-methyl-6,7,8,9-tetrahydro-477-pyrido[l,2-alpyrimidin-4-\n3502 \nOllliilllMi\n„ \nRISPERIDONE TABLETS\nIP 202? ... .........   '....................................\nIP\nRISPERIDONE SYRUP\nStore protected from light, at a temperature not Inject the reference solution and the test solution,\nInject reference solution (a), (c) and (d). The test is not valj^ \nunless the resolution between the peaks due \nbicyclbrisperidone and risperidone Z-oxime is not less than\"\nexceeding 30°. Do not freeze. \nCalculate the content of C23H27FN4O2 in the medium.\n' \nQ. Not less than 75 per cent of the stated amount of\n1.5 in the chromatogram obtained with reference solution (a) \n■\nthe relative standard deviation for replicate injections is not I \nmore than 5.0 per cent in the chromatogram obtained with \nreference solution (c) and the signal-to-noise ratio for the \nprincipal peak is not less than 10.0 in the chromatogra^SlI \nobtained with reference solution (d). \n;\nC23H27FN4O2.\nRisperidone Tablets\nRelated substances. Determine by liquid chromatography \n(2.4.14), as described under Assay with the following \nmodifications.\nRisperidoneTablets contain not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of\nDilute sodium hydroxide so"}},{"@id":"https://www.openphar.org/data/ip/monographs/risperidone","@type":"IndexedMonograph","prefLabel":{"en":"Risperidone"},"edition":"ip-2022","category":"monographs","definition":{"en":"Risperidone\nC23H27FN4O2 \n' ;;i !*’• \nMol. Wt. 410.5\nRispcridoneis3-[2-[4-(6-Fluoro-l,2-benzisoxazol-3- \nyl)piper!dino]ethyl]-6,7,8,9-tetrahydro-2-methy 1-4/3 - \npyrido[L2-rz’|pyi-iini.dm-4-one. _;f:\nRisperidone contains not less than 98.0, pet; cent and not more \nthan 102.0 per cent of C23H27FN4d2, calculated on dried basis.\nCategory. Antipsychotic., \n, H r.\nDescription: A white or almost white powder. ' A\n. ■: D It U- .J i C; *3 i: 0i f ?’J i ■ :. 1 n ■ ?/■ i;: : i /. / ,r- H r< .= J; a i c ■. > jJ;; ; ’ \\;\nIdentification , \n; ;; \n-\nA: Determine by infrared absorption spectrophotometry (2.4.6). \nCompare ’ the spectrum with that obtained with risperidone \nIPRS or with the reference spectrum of risperidone. ;\nB. In the Assay, the principal peak in the chromatogram \nobtained with test solution (b) corresponds to the peak in the \nchromatogram obtained with reference solution (b).\ngrAAA /m. me- zgiA/\"; erne yep;.-"}},{"@id":"https://www.openphar.org/data/ip/monographs/ritodrine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Ritodrine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ritodrine Hydrochloride\nCI7H21NO3,HC1\nMol. Wt. 323.8\nRitodrine Hydrochloride is (7?1S)-erytAro-l-(4-hydrdxyphehyl)i \n2-(4-hydroxyph;enethylamin6)-1 -propanol. \n' ;:/l\nRitodrine Hydrochloride contains not less than 97.0 percent \nand not more than 103.0 per cent of C:7 II2iNO3,HC1, calculi \non the dried basis. \n..,.;:\nCategory. Tocolytic\nDescription. Awhite or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/ritodrine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Ritodrine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ritodrine Injection\nRitodrine Hydrochloride-Inj ection\nRitodrine Injection is a sterile solution of Ritodrine \nHydrochloride in Water for Injections.\nRitodrine Injection contains not less than 93.0 per cent and \nnot more than 105.0 per cent of the stated amount of ritodrine \nhydrochloride; C17H21NO3,HCI.\nUsual strength. 10 mg per ml.\nA. Dilute a suitable volume of the injection with methanol \n(30 per cent) to obtain a solution containing 0.01 per cent\nw/v of Ritodrine Hydrochloride. When examined in the range \n230 nm to 350 nm (2.4.7) exhibits a maximum at 275 nm and a \nshoulder at about280nm. \n?;\nB. In the Assay, the principal peak in the chromatogram \nobtained with the test solution corresponds to the principal\n3505\nwww.webofpharma.com\npeak in the chromatogram obtained with reference solution"}},{"@id":"https://www.openphar.org/data/ip/monographs/ritonavir","@type":"IndexedMonograph","prefLabel":{"en":"Ritonavir"},"edition":"ip-2010","category":"monographs","definition":{"en":"Ritonavir\nMol. Wt. 721.0\n2066\nwww.webofpharma.com\nIP 2010\nRitonavir is (5S,8S,lOS,IIS)-10-hydroxy-2-methyl-\n5-(1-methylethyl)-I-[2-(1-methylethyl)-4-thiazolyl]-3,6-dioxo-\n8,11-bis(phenylmethyl)-2,4,7,12-tetraazatridecan-13-oic acid\n5-thiazolylmethyl ester.\nRitonavir contains not less than 98.0 per cent and not more\nthan 102.0 per cent of C37H48N60SS2, calculated on the\nanhydrous basis.\nCategory. Antiretroviral.\nDose. 100 mg twice daily.\nDescription. A white to off-white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/rizatriptan-benzoate","@type":"IndexedMonograph","prefLabel":{"en":"Rizatriptan Benzoate","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rizatriptan Benzoate\nC1sHi9N5,C7H6O2 \nMol. Wt. 391.5\nRizatriptan Benzoate is A,A-DimethyI“2-[5-(l ,2,4-triazbl-\nl-ylnicthyl)-1//-indol-3-yl] ethyl amine benzoate. :\nRizatriptan Benzoate contains not less than 99.0 per cent and \nnot more than 101.0 per cent of Ci5Hl9N5, C7H6O2, calculated \non the dried basis.\nCategory. Antimigraine.\nDescription. A white to off white crystalline powder.\n3513\nwww.webofpharma.com\nRIZATRIPTAN BENZOATE"}},{"@id":"https://www.openphar.org/data/ip/monographs/robustness","@type":"IndexedMonograph","prefLabel":{"en":"Robustness"},"edition":"ip-2022","category":"monographs","definition":{"en":"Robustness\nThe robustness of an analytical procedure is a measure of its \ncapacity to remain unaffected by small but deliberate variations \nin method parameters and provides an indication of its \nreliability during normal usage.\nRobustness is usually demonstrated by making small deliberate \nchanges to one of the operating parameters of the method, \nanalysing samples and comparing the results to those obtained \nusing the prescribed method.\nRange\nThe range of an analytical method is the interval between the \nupper and lower concentration (amounts) of analyte (including \nthese concentrations) for which it has been demonstrated \nthat the analytical procedure has a suitable level of precision, \naccuracy and linearity.\nThe specified range is normally derived from linearity studies \nand depends on the intended application of the procedure. It \nis established by confirming that the analytical procedure \nprovides an acceptable degree of linearity, accuracy and \nprecision when applied to samples containing amounts of \nanalyte within or at the extremes ofthe specified range of the \nanalytical procedure.\nFor assays the range is usually not less than 80 to 120 per cent \nof the test concentration.\nFor determination of content uniformity the range is usually \nnot less than 70 to 130 per cent of the test concentration.\nFor determination of impurities the range is usually not less \nthan the reporting limit of the impurity to 120 per cent of the \nspecification.\nFor dissolution testing the range is usually ± 20 per cent over \nthe expected concentrations.\nRange is usually demonstrated by confirming that the \nanalytical procedure provides an acceptable degree of linearity, \naccuracy and precision when applied to samples containing \namounts of analyte within or at the extremes of the specified \nrange.\n2.5.11. Polymorphism\nPolymorphism (or crystal polymorphism) is a phenomenon \nrelated to the solid state. It is the ability of a compound in the \nsolid state to exist in different crystalline forms having the\nsame chemical composition. Substances that exist in a non­\ncrystalline solid state are said to be amorphous. .\nWhen this phenomenon is observed for a chemical element \n(for example, sulphur), the term allotropy is used instead of \npolymorphism.\nThe term pseudopolymorphism is used to describe solvates \n(including hydrates), where a solvent is present in the crystal \nmatrix in stoichiometric proportions; the term may also be \nextended to include compounds where the solvent is trapped \nin the matrix in variable proportions. However the term \npseudopolymorphism is ambiguous because of its use in \ndifferent circumstances. It is therefore preferable to use only \nthe terms “solvates” and “hydrates”.\nWhere a monograph indicates that a substance shows \npolymorphism, this may be true crystal polymorphism, \noccurence of solvates, allotropy or occurrence of the \namorphous form.\nThe identity of chemical composition implies that all crystalline \nand amorphous forms of a given species have the same \nchemical behaviour in solution or as a melt; in contrast, their \nphysico-chemical and physical characteristics (solubility, \nhardness, compressibility, density, melting point, etc.), and \ntherefore their reactivity and bioavailability may be different \nat the solid state.\nWhen a compound shows polymorphism, the form for which \nthe free enthalpy is lowest at a given temperature and pressure \nis the most thermodynamically stable. The other forms are \nsaid to be in a metastable state. At normal temperature and \npressure, a metastable form may remain unchanged or may \nchange to a thermodynamically more stable form.\nIf there are several crystalline forms, one form is \nthermodynamically more stable at a given temperature and \npressure. A given crystalline form may constitute a phase that \ncan reach equilibrium with other solid phases and with the \nliquid and gas phases.\nIf each crystalline form is the more stable within a given \ntemperature range, the change from one form "}},{"@id":"https://www.openphar.org/data/ip/monographs/rocuronium-injection","@type":"IndexedMonograph","prefLabel":{"en":"Rocuronium Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rocuronium Injection\nRocuronium Bromide Injection ' \n-\nRocuronium Injection is a sterile solution of Rocuronium \nBromide in Water for Injections.\nRocuronium Injection contains not less than 90.0 per cent and \nnot more than 110.0 per cent of the stated amount of \nrocuronium bromide, C32H53BrN2O4i\nUsual strength. 10 mg per ml.\nDescription. A clear colourless solution.\nIn the Assay, the principal peak in the chromatogram obtained \nwith the test solution corresponds to the peak in the \nchromatogram obtained with the reference solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/ronidazole-veterinary-oral-powder","@type":"IndexedMonograph","prefLabel":{"en":"Ronidazole Veterinary Oral Powder"},"edition":"ip-2010","category":"monographs","definition":{"en":"Ronidazole Veterinary Oral Powder\nRonidazole Veterinary Oral Powder is a mixture ofRonidazole\nwith suitable diluents.\nRonidazole Veterinary Oral Powder contains not less than\n92.5 per cent and not more than 107.5 per cent of the stated\namount ofronidazole, C6HgN40 4•\nUsual strength. 10 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/ronidazole","@type":"IndexedMonograph","prefLabel":{"en":"Ronidazole"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ronidazole \nifs} 1-methyl-2- [(carbamoyloxy)methyl]- -5-\n4917\nwww.webofpharma.com\nRONIDAZOLE \nIP 2022\nRonidazole contains not less than 98.5.per cent and not-more \nthan 101.0 per cent of CsHgNyOu, calculated on 1 the anhydrous \nbasis.\nCategory. Antiprotozoal.\nDescription. A white to yellowish-brown powder; odourless\nor almost.odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/ropivacaine-hydrochloride-injection","@type":"IndexedMonograph","prefLabel":{"en":"Ropivacaine Hydrochloride Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ropivacaine Hydrochloride Injection\nRopiVadaiheHydfochloride Injection is a sterile solution of\nopivacaine Hydrochloride in Water for Injections. •\nRopivacaine Hydrochloride Injection contains not less than \n90.0 per cent and not more than LI 0.0 per cent of the stated \namount of C17H26N2O,HC1.\nUsual strengths. 2.0 mg per ml; 5.0 mg per ml; 7.5 mg per ml; 10 \nmg per ml.\nDescription. A clear, colourless solution.\nA. In the Assay, the principal peak in the chromatogram \nobtained with the test solution corresponds to the peak in the \nchromatogram obtained with reference solution.\nB. In the Enantiomeric purity, the principal peak in the \nchromatogram obtained with the test solution corresponds to \nthe peak in thè chromatogram obtained with the reference \nsolution.\nLimit of Ropivacaine related compound A (2,6-Dimethylaniline \nhydrochloride). Determine by liquid chromatography (2.4.14) \nas described under Assay with the following modifications.\nTest solution. Dilute a volume of injection to obtain a solution \ncontaining 0.2 per cent w/v of ropivacaine hydrochloride in \nthe mobile phase.\nUse chromatographic system and reference solution as \ndescribed under assay.\n- flow rate: 1.5 ml per minute,\nInject the reference solution. The test is not valid unless the \nresolution between the peaks due to ropivacaine hydrochloride \nand ropivacaine hydrochloride impurity Ais not less than 5.0 \nand signal- to- noise ratio for the ropivacaine hydrochloride \nimpurity A is not less than 10.\nInject the reference solution and the test solution. In the \nchromatogram obtained with test solution, the area of the \npeak due to ropivacaine impurity A is not more than 0.1 times \nof the area of the principal peak in the chromatogram obtained \nwith the reference solution (0.01 per cent).\nEnantiomeric purity. Determine by liquid chromatography \n(2.4.14). \n.\nTest solution. Dilute a volume of injection with mobile phase \nto obtain a solution containing 0.0075 per cent w/v of \nRopivacaine Hydrochloride.\nReference solution. A solution containing 0.0075 per cent w/v\nof ropivacaine hydrochloride IPRS and 0.000075 per cent of \nropivacaine hydrochloride impurity B IPRS in the mobile \nphase.\n3527\nwww.webofpharma.com\nChromatographic system \n■ y;,::\nL A t a »stainless steel (column 10 cm x 4.O mni packed with\nimmobilised a-1 acid glycoprotein on spherical silica \nparticles(5pm), , \nmobile phase: take 35.0 ml of isopropylalcohol into a \n500-ml volumetric flask and make up the volume with \nbuffer solution prepared =by diluting 7.5 ml of / :M \nmonobasic sodium phosphate solution and 28.5 ml of \n0.5 M dibasic sodium phosphate dihydrate solution to \na 1000 ,ml with water and mix. Adjusted to pH 7.2, if \n\"• necessary, \n: ‘ '• \n: \n: '\n- flow rate: 1ml per minute, ' \n!\n- spectrophotometer set at 220 nm, \n- injection volume: 20 pl. \n• /\nThe relative retention times are about 0.75 for ropivacaine \nimpurity B and 1.0 for ropivacaine. \n/\nInject the reference solution. The test is not valid unless the \nresolution between the peaks due to ropivacaine hydrochloride \nand ropivacaine hydrochloride impurity B is not less than 1.5.\nInject the test solution. The area of any secondary peak \ncorresponding to ropivacaine hydrochloride impurity B is hot \nmore thari 2.0 per cent, calculated by area normalisation;\nOther tests. Comply with the tests stated under Parenteral\nPreparations (Injections).\nBacterial endotoxins (2.2.3). Not more than 60 Endotoxin Unit \nper g of Ropivacaine Hydrochloride.\nAssay. Determine by liquid chromatography (2;4.14).\nTest solution. Dilute a volume of injection with mobile phase \nto obtain a solution containing 0.025 per cent w/v of \nRopivacaine Hydrochloride.\nReference solution: A solution, containing 0i025 per cent w/v\nof ropivacaine hydrochloride IPRS and 0.000025 per cent w/ \nv of ropivacaine hydrochloride impurity AIPRS in the mobile \nphase.\nChromatographic system\n- a stainless steel column 15 cm x 3.9 mm, packed with\n. : octadecylsilane bonded.to porous silica (5 "}},{"@id":"https://www.openphar.org/data/ip/monographs/ropivacaine-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Ropivacaine Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Ropivacaine Hydrochloride\nC17H26N2O,IIC1,H2O \nMol. Wt. 328.9\nRopivacaine Hydrochloride is (5)-()-l-Propylpiperidmc-2- \ncarboxylic acid (2,6-dimethylphenyl)amide hydrochloride \nmonohydrate; (/)-(-)- l-Propyl-2’,6’-pipccoloxylicline \nhydrochloride monohydrate.\nRopivaqaine Hydrochloride: contains not less than 98.5 per \ncent and not more than 101.0 ¡per ccnt of CDDN’Oj ICL \ncalculated on the anhydrous basis. . : ;\nCategory. Local anaesthetic.\nDescription . A white, crystalline powder. 1"}},{"@id":"https://www.openphar.org/data/ip/monographs/rosemary-oil","@type":"IndexedMonograph","prefLabel":{"en":"Rosemary Oil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rosemary Oil\nReflux 2.0 g of powdered substance under \nxanunihion with 100 ml of n-hexane on water-bath for \n30 ipinutes, cool and filter. Concentrate under vacuum to 5 ml.\nPuskara\nRosemary Oil is the essential oil obtained by steam distillation \nof the twigs and blossoming tips of Rosmarinus officinalis\nPushkarmula, Orris root; Inula racemosa\nsolution. Reflux 2.0 g ofpuskara IPBRS with 100 ml \nof on water-b4t11 for 30 minutes, cool and filter.\nLinn. (Fam. Lamiaceae).\nRosemary Oil (Indian variety) contains not less than 2.0 per \ncent and not more than 10.0 per cent of borneol, and not less \nthan 15.0 per cent and not more than 40.0 per cent of a-pinene.\n£oncéhtratc under vacuum to 5 ml.\nApplÿ to the plate 10 pl of each solutionas band length 8 mm.\n^{owthbmobile phase to rise 8 cm. Dry the plate in air and \nexamine in thd ultraviolet light at 254 nm and 366 nm. Spray the\nDescription. A clear, pale yellow to amber yellow liquid, free \nfrom sediment and suspended matter, spicy, characteristic and\nsulphuric acid reagent and heat the \nplate at 105° for 10 minutes and examine in day light. \nThe chromatographic profile of the test solution is similar to\nanise-like odour."}},{"@id":"https://www.openphar.org/data/ip/monographs/rosiglitazone-maleate","@type":"IndexedMonograph","prefLabel":{"en":"Rosiglitazone Maleate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Rosiglitazone Maleate\n(COOH\nCOOH\nClsHI9N303S,CJ1404\nMol. Wt. 473.5\nRosiglitazone Maleate is (RS)-5-{p-[2-(methyl-2-pyridylamino)\nethoxy]benzyl}-2,4-thiazolidinedione maleate (1: 1).\nRosiglitazone Maleate contains not less than 98.0 per cent\nand not more than 102.0 per cent of ClsHI9N303S,C4H404,\ncalculated on the anhydrous basis.\nCategory. Antidibatic\nDescription. A white to off-white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/rosiglitazone-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Rosiglitazone Tablets"},"edition":"ip-2010","category":"monographs","definition":{"en":"Rosiglitazone Tablets\nRosiglitazone Maleate Tablets\nRosiglitazone Tablets contains not less than 90.0 per cent and\nnot more than 110.0 per cent of the stated amount of\nrosiglitazone, ClsH19N303S,\nUsual strengths. 1mg; 2 mg; 4 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/rosuvastatin-calcium","@type":"IndexedMonograph","prefLabel":{"en":"Rosuvastatin Calcium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rosuvastatin Calcium\n(C22H27ENjO6S)2.Ca „ . \nMol. Wt. 1001.1 |\nRosuvastatin Calcium is (E)-(3R,5S)-7- {4-(4-tluorophenyl)- g\n6-isopropyl-2- {methyl(methylsulphonylaminb)]pyriniidiii' | \n5-y 1} -3,5-d ihydroxyhepten-6-oic acid calcium?; • ■\" \n? . n: .■ |\nRosuvastatin Calcium contains not less than 98.0 per ebrit | \nand not more than 102.0 per. cent of (CjaHijENjOfiSjiiGa. | \ncalculated on the anhydrous basis. \nA:/... HJ) |\nCategory. Antihyperlipidaemic. \n|\nDescription. An off- white to creamish white powder. \n|\nu \n1"}},{"@id":"https://www.openphar.org/data/ip/monographs/rouleaux","@type":"IndexedMonograph","prefLabel":{"en":"Rouleaux"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rouleaux\nAnti-A, \nB. , \nAbsent\n(Monoclonal) \n0 \nAbsent\nProzone., ft is defined as a phenomenon in which negative \nreactions are obtained with low dilutions of an antibody, while \na positive reaction is obtained with higher dilutions. For this 1 \nvolume of Anti-A Monoclonal Blood Grouping Reagent is \nmixed with 1 volume of2-3 per cent red cell suspension in test \ntubes which exhibit the antigen corresponding to the reagent\nantibody for “15 minutes”, “30 minutes” and “60.minute^ b \nthe reaction grades are the same or increase as the incubjf||M \ntime increases, no prozone is present and if the reaction griBy y\ndecrease as the incubation time increases, a prozone is presere .\n' Typé of Reagent ' Test Red Blood Cells ■ Prozonèyf\n' Anti-A \nA, \nAbsent?»\n_______ :__ l_--------------------------------------------------- ;------------------;\n■• -■m ■■ ■■ ■■■■■ ■' \n■ ■ . ; ■■■ ■■ ■ ■■\n.(Monoclonal). ■ \nA2 . \n. Absenf|||^\n__________________________ A2B___________ Absentfly\nExpiration date. The expiration date for Anti-A blood grouping \nreagent is not less than 1 year at 2° to 8°.\nStorage. Store at a temperature between 2° and 8°. \n?: \n;\nLabelling. The label states that the source material wasi$( \nreactive for hepatitis B surface antigen, but that no known \ntest method offers assurance that products derived from hurii^ \nblood will not transmit hepatitis in case of polyclonal. Label \nalso states that it is for in vitro diagnostic use. '\nNOTE—The labeling is in black lettering imprinted on pap'èi \nthat is white or is coloured completely or in part to mafeky \nthe specified blue colour standard. \n' '.1'!Î3Æ.\n. . : ■ ■. ■ ■ '\n■ -■■■.■ ■■ ■■■ . : ■■■ ■■ ■\nAnti-B Blood Grouping Serum\n-;Aip\nAnti-B Blood Grouping Serum is a sterile, liquid or dried \npreparation containing the particular blood group antibodies \nderived from high-titered blood plasma or serum of human \nsubjects, with or without stimulation by the injection of Bipod \nGroup Specific Substance B (or AB). It contains a suitable \nantimicrobial preservative. \n... \n■ : ; mbj"}},{"@id":"https://www.openphar.org/data/ip/monographs/roxithromycin","@type":"IndexedMonograph","prefLabel":{"en":"Roxithromycin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Roxithromycin\nC4IH76N2O15 \n... f: .......... Mol.^t.837.0\nRoxithromycin is (3Ä,41S, 55,6Ä^7Ä,9Ä,115,12R, 13^14/?H’ \n[(2,6-dideoxy-3-C-methyl-3-CLmethyl“a~L^rzÄpTiexo-'\nwww.webofpharma.com\nIP 2022\nnvianosyl)oxy]- 14-ethyl-7,12,13-trihydroxy-10-[(£)-[(2- \nJ^QXyethoxy)methoxy]imino]-3,5,7,9,l 1,13-hexamethyl-6-\nrf3 4 6-trideoxy-3-(dimefliylamino)-y0-D-xy/o-hexopyranosyl] \n0Xy]oXâcyclotetradecan-2-one; erythromycin 9-(£)-[O4(2- \nnietiioxyethoxy)methyl]oxime].\nRoxithromycin contains hot less than 96.0 per cent and not \nmore thanJ02.0 per centof C^lT^NpO.s, calculated on the\nanhydrous basis,\nCategory'. Antibacterial.\nDescription. A white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/rs-50000","@type":"IndexedMonograph","prefLabel":{"en":"Rs 50000"},"edition":"ip-2018","category":"monographs","definition":{"en":"Rs 50000 \nForeign $ \t\n2200 \n£ \t\n1400 \n(Plus GST as applicable)\nISBN No. 978-93-81238-16-5\n9 7 8 9 3 8 I 2381  Li 5 \n05\nINDIAN \nPHARMACOPOEIA\n2018\nVolume II\nMinistry of Health & Family Welfare\n: The Indian Pharmacopoeia Commission\nIndian Pharmacopoeia Laboratory \nGovt. of India, Ministry of Health & Family Welfare \nSector 23, Raj Nagar, Ghaziabad-201 002\n: CSIR-National Institute of Science Communication And\nInformation Resources, Vigyan Sanchar Bhawan \nPusa Gate, Dr. K.S. Krishnan Marg, New Delhi-110 012\n-\nINDIAN PHARMACOPOEIA 2018\nCONTENTS\nVOLUME I\nNotices\nV\n‘ii\nPreface\nxl\nIndian Pharmacopoeia Commission\nAcknowledgements\nIntroduction\nGeneral Chapters\nIndex\nVOLUME H\nGeneral Notices , \t\n1075\nGeneral Monographs on Dosage Forms \t\n1083\nMonographs on Drug substances, Dosage forms and\nPharmaceutical aids Monographs A to M \t\n1123\nVOLUME III\nGeneral Notices \t\n2665\nMonographs on Drug substances, Dosage forms and\nPharmaceutical aids Monographs N to Z \t\n2673\nMonographs on Vaccines and Immunosera for Human Use \t\n3563\nMonographs on Herbs and Herbal Products \t\n3719\nMonographs on Blood and Blood-related Products \t\n3825\nMonographs on Biotechnology Derived Therapeutic Products \t\n3949\nMonographs on Allergen Products \t\n4065\nMonographs on Radiopharmaceutical Preparation \t\n4071\nVOLUME IV\nGeneral Notices \t\n4151\nNotice \t\n4159\nMonographs on Drug substances, Dosage forms, Pharmaceutical Aids,\n4161\nBiologicals, Diagnostics, ImmunosemandSyrgic\n1-103\nIndex\nINDIAN PHARMACOPOEIA 2018\nVolume II\nCONTENTS\nGeneral Notices\n1075\nGeneral Monographs on Dosage Forms\n.... \t\n1083\nMonographs on Drug Substances, Dosage Forms and Pharmaceutical Aids\nMonographs A to M\n.... \t\n1123\nINDIAN PHARMACOPOEIA 2018 \nGENERAL NOTICES\nGENERAL NOTICES\nGeneral Statements\n1077\nName\n1077\nOfficial and Official Articles\n1077\nOfficial Standards\n1077\nAdded Substances\n1077\nAlternative Methods\n1078\nMeanings of Terms\n1078\nProvisions Applicable to Monograptikand Test Methods\n1078\nExpression of Contents\n1078\nExpression of Concentrations\n1078\nAbbreviated Statements\n1079\nWeights and Measures\n1079\nMonographs\n1079\nGeneral Monographs\n1079"}},{"@id":"https://www.openphar.org/data/ip/monographs/rupatadine-fumarate","@type":"IndexedMonograph","prefLabel":{"en":"Rupatadine Fumarate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Rupatadine Fumarate\nRupatadine Fumarate is 8-Chloro-6,11-dihydro-117\n[l-[(5-methyl-3-pyridinyl)methyl]-4-piperidinylidene]- \n5H-benzo[5,6]cyclohepta[ 1 ;2-ó]pyfidine fumarate.; \nr\nRupatadine Fumarate contains riot less than 98.0 per cent arid \nnot more than 102.0 per cent of C30H30CIN3O4, calculated on \nthe dried basis. - \n-m;- Avm\n$>2022\nCategory. Antiallergic. \n; ;;\nDescription. An off-white to pale yellow, powder. '' ;"}},{"@id":"https://www.openphar.org/data/ip/monographs/saccharin-sodium","@type":"IndexedMonograph","prefLabel":{"en":"Saccharin Sodium"},"edition":"ip-2022","category":"monographs","definition":{"en":"Saccharin Sodium\nSoluble Saccharin .\nO\nC\\H4NNaO;S,xH2O \nmm . Mol. Wt. 205.2\nSaccharin Sodium is the sodium salt of 1,2-benzisothiazol- \n3(2/7)-3-one 1,1-dioxide.\nSaccharin Sodium contains not less than 99.0 per cent and not \nmore than 101.0 per cent of C7H4NNaO3S, calculated on the \nanhydrous basis.\nIt may be anhydrous or contain a variable quantity of water.\nCategory . .Pharmaceutical aid (sweetening agent)., .\nDescription.1 A white,‘crystalline powder, or colourless;crystals; \nefflorescent in dry air. \n:: y\n3546 \nMiMMiMiigM\n$2022\nSACCHARIN"}},{"@id":"https://www.openphar.org/data/ip/monographs/saccharin","@type":"IndexedMonograph","prefLabel":{"en":"Saccharin"},"edition":"ip-2018","category":"monographs","definition":{"en":"Saccharin\nC71-151403S \t\nMol. Wt. 183.2\nSaccharin is 1,2-benzisothiazol-3(2H)-one 1,1-dioxide.\nSaccharin contains not less than 98.0 per cent and not more\nthan 101.0 per cent of C 7H5NO3S, calculated on the dried basis.\nt fa ,\nBlank solution. Evaporate 200 ml of dichloromethane to \ndryness in a water-bath at a temperature not exceeding 40°. \nDissolve the residue in 1 ml of dichloromethane.\nik \nIt may contain a variable quantity of water.\nCategory. Pharmaceutical aid (sweetening agent).\nReference solution. Dissolve 20 mg of o-toluenesulphonamide \nand 20 mg of p-toluene sulphonamide in dichloromethane \nand dilute to 100 ml with the same solvent. Dilute 5 ml of the \nsolution to 50 ml with dichloromethane. Evaporate 5 ml of the \nfinal solution to dryness in a current of nitrogen. Dissolve the \nresidue in 1 ml of the internal standard solution.\nDescription. White crystals or a white, crystalline powder; \nodourless or with a faint, aromatic odour.\nntinificoi be\nion"}},{"@id":"https://www.openphar.org/data/ip/monographs/safinamide-methane-sulphonate","@type":"IndexedMonograph","prefLabel":{"en":"Safinamide Methane Sulphonate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Safinamide Methane Sulphonate\nC17H19FN?O2CH4SO3 \nMol Wt. 398.5\nSafinamide Methane Sulphonate is (S)-2-(4-(3-Fluoro- \nbenzyloxy)benzylamiho)propanamide \nmethane sulphonate.\nSafinamide Methane Sulphonate contains not less than 98.0 \nper cent and riot more than 102.0 per cent of \nCnHigF^ChCFUSOs, calculated ori dried basis:\nCategory. Antiparkinsonian.\nDescription. A white to off-white powder.\nIn the Assay, the principal peak in the, chromatogram obtained \nwith the test solution corresponds to the peak in the \nchromatogram obtained with the reference solution.\nRelated substances. Determine by liquid chromatography \n(2.4.14).\n3547\nwww.webofpharma.com\nTest .solution. . Dissolve 50 mg of the substance under \nexamination in mobile phase and diluted to 50.0 ml with mobile \nphase.; , \n... ....\nReference solution. A 0.01 percent w/v solution of safinamide \nmethane sulphonateIP RS inthe mobile phase. - \n.. !::\nChromatographic system\n■- a stainless steel column 15 cm x 4.6 mm, packed with\noctylsilane bonded to porous silica (5 pm), '\n, -column temperature: 30°, \n, z — \n■\n~ mobile phase: a mixture of 45 volumes of buffer solution\nprepared to dissolve 6.8 g of potassium dihydrogen \northbfhosphdte and 2.2Tg of sodium octdnesulfohate\nin 1000 ml of water, 10 volumes of acetonitrile and 45 \nvolumes of methanol, -\n- flow rate: 1 ml per minute,\n- spectrophotometer set at 220 nm,\n- injection volume: 10 pl. \n/\nInject the reference solution,; The test is not; valid: unless the \ncolumn efficiency is not less than 2000 theoretical plates and \ntailing factor is not more than 2.0.\nInject the reference, solution and the test solution. In the \nchromatogram obtained with test solution the area of any \nsecondary peak is not more than 0.1 time the area of the \nprincipal peak in the chromatogram obtained with the reference\nsolution (1.0 per cent) and the sum of the area all the secondary \npeaks is not more than 0.2 time the area of the principal peak in \nthe chromatogram obtained with the reference solution \n(2.0 per cent). \n-1\nLoss on drying (2.4.19). Not more than 1.0 per cent, determined \non 1.0 g by drying in an oven at 105° for 3 hours.\nAssay. Determine by liquid chromatography (2A14)'.\nTest solution. Dissolve 50 mg of the. substance under \nexamination in mobile phase and dilute to 50.0 ml with mobile \nphase.\nReference solution. A 0.1 per cent w/v solution of safinamide \nmethane sulphonate IP RSin themobile phase.: \n,\nChromatographic system \n■. ;=.: 3 ; .\n- a stainless steel column 15 cm x 4.6 mm, packed with\noctylsilane bonded to porous silica (5 pm),\n- column temperature: 30°, \n;.....\n- mobile phase: a mixture of 45 volumes of buffer solution\nprepared to dissolve 6.8 g of potassium dihydrogen\n■ orthophosphate ¿nd 2:22 g of sodium octdnesulfonate\nin 1000 ml ofwater,; 10 volumes of acetonitrile and 45 \nvolumes of methanol,\n- flow rate: 1 ml per minute,\nspectrophotometer set at 220 nm, ¿ 3 • - \n:\n- injection volume: 10 pl. \n:; > ;\n3548"}},{"@id":"https://www.openphar.org/data/ip/monographs/sahajana-leaf","@type":"IndexedMonograph","prefLabel":{"en":"Sahajana Leaf"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sahajana Leaf\nSaijna leaf; Moringa oleifera\nSahajana consist of dried leaves of Moringa oleifera Lamk. \n(Fam. Moringaceae)\nCategory. Antidiarrhoeal, antibacterial, antiinflammatory, anti \nmicrobial and anticancer. \n-\nDescription. Leaves are small, dark green in colour with smooth \nsurface. ■ • \n■"}},{"@id":"https://www.openphar.org/data/ip/monographs/sahajana-stick","@type":"IndexedMonograph","prefLabel":{"en":"Sahajana Stick"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sahajana Stick\nRS TEST \tRS TEST \n(Under day light) \t\n(Under day light after \nspraying with 5.0 per\nRS TEST \n(Under day light after \nspraying with anisaldehyde\nRS \t\nTEST \n(Under UV light\nRS TEST \n(Under day light after \nspraying with 0.5 per \ncent ninhydrin solution)\nRS TEST\n(Under UV light\nat 254 nm)\nat 366 nm)\nsulphuric acid reagent)\ncent sulphuric acid) \nTLC Chromatogram of Sahajana Stick\nSarpagandha\nRS TEST\nRS TEST \t\nRS TEST\nRS \t\nTEST \nlight at.30tun)\nRS \t\nTEST \n(Under day light after spraying \nwith anisaldehyde sulphuric acid\nRS \t\nTEST \n(Under UV light at 254 nm)\n(Under day light after \nspraying with 0.5 per \ncent ninhydrin solution)\n(Under day light) \t\n(Under day light after\n- \t- \t\nspraying with 5.0 per \n.• ,\n- cent sulphuric acid)\nreagent)\n-r1 ,c Chromatog,ram of Sarpagandha\nr,am U.fSahajana Leaf\n755\n3.2. THIN LAYER CHROMATOGRAMS OF HERBS AND PROCESSED HERBS"}},{"@id":"https://www.openphar.org/data/ip/monographs/salbutamol-inhalation","@type":"IndexedMonograph","prefLabel":{"en":"Salbutamol Inhalation"},"edition":"ip-2010","category":"monographs","definition":{"en":"Salbutamol Inhalation\nSalbutamol Inhalation Aerosol; Albuterol Inhalation\nAerosol\n. Salbutamol Inhalation is a suspension ofmicrofine Salbutamol\nor Salbutamol Sulphate in a suitable liquid in a suitable\n2084\nIP 2010\npressurised container. It may contain suitable pharmaceutical·\naids such as surfactants, stabilising agents etc.\nSalbutamol Inhalation delivers not less than 80.0 per cent and\nnot more than 120.0 per cent of the sfated amount of\nsalbutamol, C13H21N03,per inhalation, by actuation ofthe valve.\nUsual strength. 100 Jlg in each metered-dose."}},{"@id":"https://www.openphar.org/data/ip/monographs/salbutamol-syrup","@type":"IndexedMonograph","prefLabel":{"en":"Salbutamol Syrup"},"edition":"ip-2010","category":"monographs","definition":{"en":"Salbutamol Syrup\nAlbuterol Sulphate Syrup; Salbutamol Sulphate Syrup\nSalbutamol Syrup contains Salbutamol Sulphate equivalent\nto not less than 90.0 per cent and not more than 110.0 per cent\nofthe stated amount ofsalbutamol, C 13HZ1N03•\nUsual strength. The equivalent of2 mg ofsalbutamol in 5 ml.\n(1 mg ofSalbutamol Sulphate is approximately equivalent to\n830 f.!g ofsalbutamol)."}},{"@id":"https://www.openphar.org/data/ip/monographs/salbutamol","@type":"IndexedMonograph","prefLabel":{"en":"Salbutamol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Salbutamol\nAlbuterol • - \n, <7 \n\\\nSalbutamol is (AS)-1 -(4-hydroxy-3-hydroxymethyIphehyl)- \n2-(ter/-butylamino)ethanol: \n- 3¡ . . ■\nSalbutamol contains not less than 98.Ö per cent and not more \nthan1010 per cent of C^I UNCL, calculated on the dried basis.\nCategory. Beta-adrenoceptor agonist. \n’ f'\nDescription. A white or almost white, crystallinepowder;"}},{"@id":"https://www.openphar.org/data/ip/monographs/salicylic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Salicylic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Salicylic Acid\n,/ cooh\n/OH\nC7H6O3 \nMol. Wt. 138.1\nSalicylic Acid is 2-hydroxybenzoic acid.\nSalicylic Acid contains not less than 99.0 per cent and not \nmore than 100.5 per cent of C7H6O3, calculated on the dried \nbasis. ho ■\nCategory. Keratolytic.\nDescription. White or colourless, acicular crystals or a white, \ncrystalline powder.\nIdentification h' ’ ■ . \n' ■ ■ ■ ■\nTest A may be omitted if tests B and C are carried out. Test B \nmay be omitted if tests A and C are carried out.\n’Phenol.\nA. \nDetermine by infrared absorption spectrophotometry (2.4.6). \nCompare the spectrum with that obtained with salicylic acid \nIPRSbi with the reference spectrum of salicylic acid.\nB. \nDissolve about 30 mg in 5 ml of 0.05 Msodium hydroxide, \nneutralise if necessary and dilute to 20 ml with water. 1 ml of \ndie solution gives reaction (A) of salicylates (2.3.1).\nC-Meltingrange. 158° to 161° (2.4.21)."}},{"@id":"https://www.openphar.org/data/ip/monographs/salmeterol-and-fluticasone-propionate-powder-for-inhalation","@type":"IndexedMonograph","prefLabel":{"en":"Salmeterol and Fluticasone Propionate Powder for Inhalation"},"edition":"ip-2010","category":"monographs","definition":{"en":"Salmeterol and Fluticasone Propionate Powder for Inhalation\nconsists ofFluticasone Propionate and Salmeterol Xinafoate\nin microfine powder either alone oradmixed with Lactose in a\npre-metered unit for use in a suitable powder inhaler.\nwww.webofpharma.com\nSalmeterol and Fluticasone Propionate Powder for Inhalation\ncontains not less than 90.0 per cent and not more than\n125.0 per cent ofthe stated amountsofsalmeterol C2sH37N04\nand fluticasone propionate, C2sH31F30SS per unit dose."}},{"@id":"https://www.openphar.org/data/ip/monographs/salmeterol-xinafoate","@type":"IndexedMonograph","prefLabel":{"en":"Salmeterol Xinafoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Salmeterol Xinafoate\nHO \n;;\nC25H37NO4,C|1H8O3 \nMol.Wt.603.7\nSalmeterol Xinafoate is (J?5)-4-hydroxy-aÇ[[[6r.(4rphenÿl.* \nbutoxy)hexyl]amino]methyl]-l,3-benzenedimethanoi\n1 -hydroxy-2-naphthoate.\nSalmeterol Xinafoate contains not less than 97.0 per cent and \nnot more than 102.0 per cent of C^H^NCF calculated ôn thé \nanhydrous'basis.' \n'\nCategory. Bronchodilator.\nDescription, A white to off-white powder. \n, ... ■,. ,:j- ;; {."}},{"@id":"https://www.openphar.org/data/ip/monographs/saquinavir-mesylate","@type":"IndexedMonograph","prefLabel":{"en":"Saquinavir Mesylate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Saquinavir Mesylate\n, ch3so3h\nc^N6O5zCH4O3S \nMol. Wt. 767.0\nSaquinavir mesylate is(S)-iV-[(aS’)-a-{(l/ri-2-[(3S.4aS',8a5j- \n3*Üértrbqtylcarbamoy 1) octahydro -2( 1H)-isoquino ly I] -\nl-hydroxyethyl}phenethyl]-2-quinaldamidosuccinamide \nmethanesulphonate.\nSaquinavir Mesylate contains not less than 98.5 per cent and \nnot more than 101.0 per cent of C38HS0N6O5, CH4O3S, calculated \non the anhydrous basis.\nCategory. Antiretroviral.\nDescription. A white or almost white powder.\nA. Determine by infrared absorption spectrophotometry (2.4.6), \nCompare the spectrum with that obtained with saquinavir \nmesylate IPRS or with the reference spectrum of saquinavir \nmesylate.\nB. In the Assay, the principal peak in the chromatogram \nobtained with the test solution corresponds to the peak in the \nchromatogram obtained with reference solution (a).\nSpecific optical rotation (2.4.22). -.69.6° to -66.8°, determined \nin a 0.5 per cent w/v solution in methanol at 436 nm.\nRelated substances. Determine by liquid chromatography \n(2.4.14), as described under Assay using the test solution and \nreference solution (c).\nInject reference solution (c). Calculate the amount of related \nsubstances by area normalisation method. In the \nchromatogram obtained with the test solution, the area of any \nsecondary peak is not more than the area of the principal peak \nin the chromatogram obtained with reference solution (c) \n(0.1 per cent) and the sum of the areas of all the. secondary \npeaks is not more than 5 times the area.pf the principal peak in \nthe chromatogram obtained with reference solution (c) \n(0.5 percent).\nHeavy metals (2.3.13). 1.0 g complies with the limit test for \nheavy metals, Method B (20 ppm).\nMethanesulphonic acid. 11.9 to 13.1 percent w/w, calculated \non the anhydrous basis, determined by the following method. \nWeigh 0.1 g of the substance under examination, dissolve in \n50 ml of methanol. Titrate with 0.1 M sodium hydroxide, \ndetermining the end-point potentio-metrically (2.4.25). Carry \nout a blank titration.\n1 ml of 0.1 M sodium hydroxide is equivalent to 0.00961 g of \nCH3SO3H.\nSulphated ash (2.3.18). Not more than 0.1 per cent.\nWater (2.3.43). Not more than 1.0 per cent, determined on 0.5 g.\nAssay. Determine by liquid chromatography (2.4.14).\nTest solution. Dissolve 25.0 mg of the substance under \nexamination in 100.0 ml of the mobile phase.\n3561\nwww.webofpharma.com\nReference solution (a). A 0.025 per cent w/v solution of \nsaquinavir mesylate IPRS in the mobile phase.'.;, ■. ,.. .\nReference solution /¿/Dissolve suitable quantities of \nsaquinavir impurity A IPRS and saquinavir mesylate IPRS in \nthe mobile phase to obtain a solution containing 2 pg per ml of \nsaquinavir impurity A and 0.25 mg per ml of saquinavir \nmesylate.\nReference solution (c). A 0.000025 per cent w/v solution of \nsaquinavir mesylate IPRS in the mobile phase.\nNOTE—Store the buffer solution protected from light. Make \nadjustments if necessary for system suitability.\nChromatographic system \n-\n- \na stainless steel column 25 cm x 4.6 mm, packed with \noctadecylsilane bonded to porous silica (5 pm),\n- mobilephase:amixtureofl40volumesof l.OperCent\nV/v solution of triethylamine in water, adjusted to \npH 2.5 with orthophosphoric acid, 50 volumes of \ntetrahydrofuran and 10 volumes of acetonitrile.\n- \nflow rate: 1 ml per minute,\n- spectrophotometer set at 21 Onm,\n- injection volume: 20 pl.,\nThe relative retention times are about 0.89 for saquinavir \nimpurity A and about 1.0 for saquinavir mesylate.\nInject reference solution (b). The test is not valid unless the \nresolution between the peaks due to saquinavir impurity A \nand saquinavir mesylate is not less than 1.5, the column \nefficiency determined from the saquinavir mesylate peak is \nnot less than 500 theoretical plates and the relative.standard \ndeviation for replicate injections is not more than2.0 per cent.\nInject reference solution (a) and the test solution. Run the \nchromatograms 3 times the retention time of the principal peak.\nCal"}},{"@id":"https://www.openphar.org/data/ip/monographs/saquinavir","@type":"IndexedMonograph","prefLabel":{"en":"Saquinavir"},"edition":"ip-2010","category":"monographs","definition":{"en":"Saquinavir\nMol. Wt. 670.8\nSaquinavir is (S)-N-[(fJS)-a-{(IR)-2-[(3S,4aS,8aS)-\n3-(tert-butylcarbamoyl)octahydro-2(1H)-isoquinolyl]-\n1-hydroxyethyl}phenethyl]-2-quinaldamidosuccinamide.\nSaquinavir contains not less than 98.5 per cent and not more\nthan 101.0 per cent ofC38HsoN60s, calculated on the anhydrous\nbasis.\nCategory. Antiretroviral.\nDose. 1 g twice daily.\nDescription. A white crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sarpagandha-powder","@type":"IndexedMonograph","prefLabel":{"en":"Sarpagandha Powder"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sarpagandha Powder"}},{"@id":"https://www.openphar.org/data/ip/monographs/sarpagandha-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Sarpagandha Tablets"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sarpagandha Tablets\nRauwolfia serpentina Tablets\nSarpagandha Tablets contain not less than 85.0 per cent w/w \nand not more than 115.0 per cent w/w of stated amount of the \nalkaloids contents mainly of resetpine together with ajmalicine.\nCategory. Antihypertensive, antipsychotic, neurosedative, \nniddrapradaa.\nUsual strengths. 0.1 mg; 0.25 mg.."}},{"@id":"https://www.openphar.org/data/ip/monographs/saunf","@type":"IndexedMonograph","prefLabel":{"en":"Saunf"},"edition":"ip-2022","category":"monographs","definition":{"en":"Saunf\n.......................................................   ... \nIPW\nSaunf contains not less than 0.60 per cent of aneth i \ncalculated on the dried basis. \n\" \n! $\nCategory. Carminative, spasmolytic. \n; f :\nDescription. The fruits are oval-oblong, greenish brown to \nyellowish brbwn in colour. They have an aromatic\ncharacteristic odour and the taste is sweet aromatic."}},{"@id":"https://www.openphar.org/data/ip/monographs/schisandra-dry-extract","@type":"IndexedMonograph","prefLabel":{"en":"Schisandra Dry Extract"},"edition":"ip-2022","category":"monographs","definition":{"en":"Schisandra Dry Extract\nSchisandra chinensis: \n'\nSchisandra Dry Extract is obtained by extracting Schisandra \nchinensis (Fam. Schisandraceae) fruit with methanol or any \nother suitable solvent. \n;\n4290\nSCHISANDRA FRUIT\nIP 2022\nSchisandra Dry Extract contains not less than 2.0 per cent \nw/w of schisandrin, calculated on the dried basis.......\nCategory. Energizer, Hepatoprotective ■ : :"}},{"@id":"https://www.openphar.org/data/ip/monographs/schisandra-fruit","@type":"IndexedMonograph","prefLabel":{"en":"Schisandra Fruit"},"edition":"ip-2022","category":"monographs","definition":{"en":"Schisandra Fruit\nChinese Magnolia Vine; five-flavor Berry; Schisandra\nIt consists of whole, dried or steamed and dried, ripe fruit of \nSchisandra chinensis (Fam. Schisandraceae)\nSchisandra fruit contains not less than 0.4 per cent w/w.of \nschisandrin calculated on the dried basis.\nCategory. Energizer, hcpatoprotective . \n/\nDescription. Fruits are irregularly spheroid and have a diameter \nof 5 to 8 mm. The fruits surface is oily and wrinkled and color \nis red to black brown depending on its degree of ripeness.\nA. Macroscopic — The berry is more or less spherical, up to \n8mm in diameter; red, reddish- brown or blackish outer surface, \nsometimes covered in a whitish frost, strongly shrivelled \npericarp, presence of 1-2 reniform, yellowish-brown, lustrous \nseeds, with thin seed-coat.'\nB. Microscopic — Examine under a microscope using chloral \nhydrate solution. The powder shows the following diagnostic \ncharacters: reddish-brown fragments of pericarp, consisting \nof 1 layer of thin-walled epicarp cells, accompanied by sparse \noil cells and several layers of ovoid, more-or-less flattened \nmesocarp cells, fragments of the outer testa of the seed \nconsisting of thick-walled, finely channelled sclereids, \npolygonal in surface view (15-50 pm in diameter) and in palisade \narrangement in side view; fragments of the inner testa with \nsclereids, isolated or in small groups, abolit 80 pin in diameter, \nwith slightly thickened and markedly1 channelled walls, \nfragments of endosperm consisting of polyhedral cells \ncontaining oil droplets and aleürônè grains.\nC. Determine by thin-layer chromatography (2.4,17) coating \nthe plate with silica gel GF254.\nMobile phase. A mixture of 2 volumes of acetic acid, 22 \nvolumes of ethyl acetate and 46 volumes of toluene.\nTest solution. Reflux about 2 g. of coarsely powdered \nsubstances under examination with 20 ml of methanol for 10 \nminutes, cool and filter. Reflux the residue further with 2 x 20 \nml of methanol, cool and filter, combine all the filtrates and \nconcentrate under vacuum to 10 ml.\nReference solution. Reflux about 0.5 g of schisandra 1PBRS \nwith 10 ml of methanol for 10 rrïïnùtes, cool and filter. Reflux \nthe residue further with 2 x 10 ml oîmethanol, cool and filter, \ncombine all the filtrates and concentrate under vacuum to \n5 ml.\nApply to the plate 10 pl of each solution as bands 10 mm by 2 \nmm. Allow the mobile phase to rise 10 cm. Dry the plate at 100-\n105°. Spray the warm plate with a 10 per cent w/v solution of \nsulphuric acid in methanol. Heat at 120° for 10 minutes \nexamine in ultraviolet light at 254 nm and 366 nm. The \nchromatographic profilé of thé test solution is similar to that \nof the reference solution.\n4289\nwww.webofpharma.com\nTests ;it.c —\nForeign organic matter (2.6.1). Not more than 2.0 per cent.\nTotalash (2.3.19). Not more than 6.0 per cent. \n; -\nHeavy metal (2.3.13). 1.6’ g complies with the limit test for \nheavy metals, Method B (20 ppm). ; \n-\nLoss: on.drying; (2;4.19); Not more than 10.0 per cent, \ndetermined on 1 gpowder of herbal drug by drying in an oven \nat 105°for3 hours. n:; : \nf\nMicrobial Contamination (2.2.9). Complies with the microbial \ncontamination test.\nAssay. Determine by liquid chromatography (2.4.14).\nTest solution. Weigh about 1 g of the powdered sample, add \n90 ml of methanol, sonicate for 30 minutes and heat on a \nboiling water bath, filter and make final volume up to 100.0 ml \nwith methanol.\nReference solution. Dissolve 5.0 mg of schisandrin IPRS in\nmethanol and dilute to 100.0 ml with the same solvent.\nChromatographic system\n- a stainless steel column 250 cm x 4.6 mm packed with\noctadecylsilane bound to porous silica (5 pm), ,\n- mobile phase: A. a mixture of 35 volumes of water and\n65 volumes of methanol,\nB. methanol,\n- a gradient programme using the conditions given below, \n- flow rate; 1 ml per minute,\n- spectrophotometer set at 250 nm,\n- injectionvolume: lOpl.\nTime mobile phase A mobile phase B \n(in min.) (per cent v/v) (per cent v/v)\no ioo \" o ."}},{"@id":"https://www.openphar.org/data/ip/monographs/scopolamine-butylbromide","@type":"IndexedMonograph","prefLabel":{"en":"Scopolamine Butylbromide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Scopolamine Butylbromide\nC21H30BrNO4 \nMol. Wt. 440.4\nHyoscine Butylbromide is (lS,3s,5R,6R,lS,3r)-6,7-epoxy- \n8-butyl-3-[(S)-tropoyloxy]tropanium bromide.\nHyoscine Butylbromide contains not less than 98.0 per cent \nand not more than 101.0 per cent of C2iH30BrNO4, calculated \non the dried basis.\nCategory. Parasympatholytic.\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/scopolamine-hydrobromide-injection","@type":"IndexedMonograph","prefLabel":{"en":"Scopolamine Hydrobromide Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Scopolamine Hydrobromide Injection\n0.3\nDescription. Colourless crystals or a white, crystalline powder, \nodourless; efflorescent.\nHyoscine Hydrobromide Injection is a sterile solution of \nHyoscine Hydrobromide in Water for Injection.\nHyoscine Hydrobromide Injection contains not less than \nrn \t\n9Q.0er cent:and not more than 110.0 per cent of the stated \n0.6 \t\namount of hyoscine hydrobromide, CI7H2IN04,HBr,3H20. \nUsual strength. 400 1..tg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/scopolamine-hydrobromide","@type":"IndexedMonograph","prefLabel":{"en":"Scopolamine Hydrobromide"},"edition":"ip-2022","category":"monographs","definition":{"en":"Scopolamine Hydrobromide\n, HBr,3H2O\nCI7H2iNO4,HBr,3H2O \nMol. Wt. 438.3\nHyoscine Hydrobromide is (119,35,5R,6R,7S)-6,7-epoxytropan- \n3 -yl(S)-tropate hydrobromide trihydrate.\nHyoscine Hydro bromide contains not less than 99.0 per cent \nand not more than 101.0 per cent of Ci7H21NO4,HBr, calculated \non the anhydrous basis.\nCategory. Parasympatholytic.\nDescription. Colourless crystals or a white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/scorpion-venom-antiserum","@type":"IndexedMonograph","prefLabel":{"en":"Scorpion Venom Antiserum"},"edition":"ip-2022","category":"monographs","definition":{"en":"Scorpion Venom Antiserum\nAnti Scorpion Venom Scrum; Scorpion Antivenin\nScorpion Venom Antiserum is a sterile preparation containing \nantitoxic globulins or their derivatives that have the power of\nspecifically neutralizing the venom of one or more species of \nscorpion. It is obtained from the serum or plasma of healthy \nequines or other suitable animals immunized against venoms \nof specified species of scorpion. It is a liquid preparation or a \nfreeze dried product. It may contain a suitable preservative.\nDescription.: A clear to slightly opalescent colorless or pale \nyellow liquid free from suspended particles or cream colored \npowder or pellet which when reconstituted with the diluent \nsupplied by the manufacturer with freeze-dried product yields \na clear, colorless or pale yellow liquid.\nSpecifically renders the corresponding venom or venoms \nharmless to susceptible^ animals. It may also be identified or \nby any other alternate suitable in vitro method.\nOther tests. Complies with the tests stated under Antisera.\nPotency. Each milliliter of the preparation under examination \ncontains sufficient antivenom globulin to neutralize not less \nthan 1 mg of Ho lie nt oil a tumulus (Red scorpion) venom. .\nPreparation of 1 per cent venom. Allow the vials containing \nlyophilized venoms to reach room temperature in order to avoid \ncondensation of water which may cause errors in weighing. \nPrepare 10 mg per ml of the venom solutions; separately , in \nsaline solution, sterile. Shake the solutions very gently to \navoid foaming and centrifuge at 20,000 g in cold conditions \nfor 10 minutes. Decant the supernatant slowly and sterilize \nusing 0.22 pm cellulose nitrate membrane. Store the filtered \nvenom solutions in pre-sterilized glass vials. ;\nLD50 of venom. The .quantity of venom, when injected \nintravenously, causes death of 100 per cent of animal \npopulation in a group after 24 hours.\nTake graded quantities of the 1 per cent venom solution insuch \na manner that the.middle dilution contains the doseexpected \nto be the LD50 in sufficient quantity of salinesolution,; sterile \nto make volume up to 5 ml. lnject a doseof 0.5ml intravenously, \nof each dilution into at least 5 mice, eachweighing 18-20 g, per \ndilution. Observe the mice for 24 hours and calculate LD50 \nusing suitable statistical method, \n.. 2 \n;\nSuitable venom. Due to limitations to prepare a:reference \nstandard; for scorpion venoms, considering their individual \nseasonal and geographical variations observed, suitable\n4469\nwww.webofpharma.com\nSNÄKE< VENOM ANTISERUM\nIP 2022\nvenom should be prepared by adjusting the venom to a specific \nLD50 value before using the same for the potency testing of \nantiserum. Scorpion venom should be adjusted to:50 pg as \none LD50. Adj ust the LD5 O of Scorpion yenon from \nreconstituted (1.0 per cent) venon to desired LD50.\nDetermination Ofpotency of the anti scorpion venom serum: \nThe potency of the scorpion venom antiserum is determined \nby estimating? the ability of the antiserum to protect mice or \nother suitable animals against the lethal effect of a fixed dose \nof suitable venom of the relevant species of the; venom.\nPrepare challenge dose of venom, ln< such a way that 1.0 ml \ncontains the specified amount of venom to be neutralized, \nfrom 0.2 per cent stock solution of venom; Prepare appropriately \ndiluted serum such that l .O tnl neutralizes the specified amount \nof the venom. Mix equal quantities of venom and antiserum \ndilution and incubate at 37° for 30 minutes. Inject a dose of 0.5 \nml intravenously, of each dilution into at least 2 mice, each \nweighing 18-20 g, Observe for survival of mice after 48 hours. \nInject one MLD and negative control.\nStorage. Store the freeze-dried preparation in a cool, dark place. \nStore the liquid preparation at a temperature of 2° to 8° and do \nnot expose to light. Do not allow to freeze.\nLabeling. The label states (1) the volume of contents and in \ncase of a freeze-dried preparation, the directions for \nreco"}},{"@id":"https://www.openphar.org/data/ip/monographs/secnidazole","@type":"IndexedMonograph","prefLabel":{"en":"Secnidazole"},"edition":"ip-2022","category":"monographs","definition":{"en":"Secnidazole\n°2N^<Ny-CH3 ..\nMol. Wt. 185.2\nSecnidazole is (RS)-1 -(2-methyl-5-nitroimidazol-1 -yl)\nPropan-2-ol.\nSecnidazole contains not less than 98.0 per cent and not more \nthan 101.0 per cent of C7H[ tN3O3, calculated on the anhydrous\nCategory. Antiamoebic.\nDescription. A white to yellowish white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/selegiline-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Selegiline Hydrochloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Selegiline Hydrochloride\nch3\nch3\n, HCl\n„MoLWt 223.7\nCbH17HHC1\nSelegiline Hydrochloride is(A)-M ethyl( «-methyl phenethyl ) \nprop-2-ynÿlâminè hydrochloride.\nSelegiline ËÉ0fochloride contains not less than 99.0 per cent \naninotmorethan 101.0 per cent of Ci3HnN,HCl, calculated \non the dried basis.\nCategory. Antiparkinsonian.\nDescription. Awhite or almost white, crystalline powder.\nIdentification ■\nA. Determine byinfrared absorption spectrophotometry (2.4.6). \nCompare7 the spectrum with that obtained with selegiline \nhydrochloride IP RS or with the reference spectrum of selegiline \nhydrochloride\nB. It gives reaction (A) of chlorides (2.3.1 ).\nTeStS :: \n•\npH (2.4.24). 3.5 to 4.5, determined in a 2.0 per cent w/v solution\nm carbon dioxide-free water\n^Pecificoptical rotation (2.3.22). 12.0° to 10.0°, determined \n°na 10.0 per cent w/v solution in carbon dioxide-free water.\nRelated substances. Determine by liquid chromatography \n(2.4.14).\n7est solution. Dissolve 20 mg of the substance under\nexamination in the mobile phase and dilute to 10.0 ml with the \nmobile phase.\nReference solution (a). A solution containing 0.1 per cent \nw/v of selegiline hydrochloride IPRS and 0.02 per cent w/v \nof butyl parahydroxybenzoate in the mobile phase. Dilute 1.0 \nml of the solution to 20.0 ml with the mobile phase.\nReference solution (b). Dilute 1.0 ml of the test solution to\n10.0 ml with the mobile phase. Dilute 1.0 ml of the solution to \n50.0 ml with the mobile phase.\nChromatographic system\n- a stainless steel column 25 cm x 4.6 mm, packed with\noctylsilane bonded to porous silica (5 pm),\n- mobile phase: a mixture of 500 volumes of acetonitrile\nand 500 volumes of butylammonium acetate buffer \nsolution pH 6.5 prepared by dissolving 4 ml of \nbutylamine in 900 ml of water, adjusted to pH 6.5 with \nacetic acid and dilute to 1000 ml with water,\n- flowrate: 1 mlperminute,\n- spectrophotometer set at 215 nm,\n- injection volume: 20 pl.\nInject reference solution (a). The test is not valid unless the \nresolution between the peaks corresponding to selegiline and \nbutyl parahydroxybenzoate is not less than 3.0.\nInject reference solution (b) and the test solution. Run the \nchromatogram 1.7 times the retention time of the principal \npeak. In the chromatogram obtained with the test solution, \nthe area of any secondary peak is not more than the area of \nthe principal peak in the chromatogram obtained with reference \nsolution (b) (0.2 per cent) and the sum of areas of all the \nsecondary peaks is not more than 2.5 times the area of the \nprincipal peak in the chromatogram obtained with reference \nsolution (b) (0.5 per cent). Ignore any peak with an area less \nthan 0.1 times the area of the principal peak in the chromatogram \nobtained with reference solution (b) (0.02 per cent).\n(S)- Selegiline. Determine by liquid chromatography (2.4.14).\nSolvent mixture. 10 pl of butylamine and 1 ml of 2-propanol.\nTest solution. Dissolve 20 mg of the substance under \nexamination in the solvent mixture and dilute to 10.0 ml with \nthe mobile phase.\nReference solution (a). Dissolve 8 mg of (RS)-selegiline \nhydrochloride IPRS in the solvent mixture and dilute to 10.0 \nml with the mobile phase.\nReference solution (b). Dilute 0.5 ml of reference solution (a) \nto 20.0 ml with the mobile phase.\nChromatographic system\n- a stainless steel column 25 cm x 4.6 mm, packed with\nsilica gel OD for chiral separations (5 pm),\n- mobile phase: a mixture of 0.2 volume of 2-propanol\nand 99.8 volumes of cyclohexane,\n- flow rate: 1 ml per minute,\n- spectrophotometer set at 220 nm,\n- injection volume: 20 pl.\n3565\nwww.webofpharma.com\nThe retention time of /^-selegiline is about 10 minutes.\nInject reference solution (a). The test is not valid unless the \nresolution between the peaks corresponidng to (S)-seiegiline \nand (7?)-selegiline is not less than 1.5.\nInject reference solution (b) and the test solution. In the \nchromatogram obtained with the test solution, the area of any \npeak corresponding to (^-selegiline i"}},{"@id":"https://www.openphar.org/data/ip/monographs/senna-dry-extract","@type":"IndexedMonograph","prefLabel":{"en":"Senna Dry Extract"},"edition":"ip-2022","category":"monographs","definition":{"en":"Senna Dry Extract\nSenna Dry Extract is produced from Senna leaves or pods of \nCassia angùstifôlia(Tinnevelly Senna) or Cassia dcütifàlia \n(Cassia Senna) as calcium salts.\nSenna dry extract contains not less than 85,0 per cent w/w and \nnot more than 115.0 per cent w/w of the stated amount of total\nsennosides, calculated as sennoside Ei, as calcium salt on \ndried basis.\nCategory. Purgative, anthelmintic, febrifuge, vibandha.\nDescription. A light brown to. dark brown powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/senna-leaf","@type":"IndexedMonograph","prefLabel":{"en":"Senna Leaf"},"edition":"ip-2022","category":"monographs","definition":{"en":"Senna Leaf"}},{"@id":"https://www.openphar.org/data/ip/monographs/senna-pods","@type":"IndexedMonograph","prefLabel":{"en":"Senna Pods"},"edition":"ip-2018","category":"monographs","definition":{"en":"Senna Pods\nRS \t\nTEST\nRS \t\nTEST \n(Under UV light at 254 nm)\nitC Chromatograint§enna Pods\n758\n3.2. THIN LAYER CHROMATOGRAMS OF HERBS AND PROCESSED HERBS \nIP 2018\nSenna Dr Extract\nVINO \n4$110\nOP WO\nRS \t\nTEST\nRS \t\nTEST \n(Under UV light at 366 nm)\nRS \t\nTEST \n(Under day light after spraying\nRS \t\nTEST \n(Under day light after spraying\n(Under UV light at 254 nm )\nwith 20 per cent, v/v nitric acid\nTLC Chromatogram of Senna Dry Extract \nShankhpushpi\nwith 20 per cent, v/v nitric acid\nsolution)\nsolution)\n4\nRS \t\nTEST \nRS \t\nTEST \n(After spraying with \n-anisaldehyde sulphuric\nRS \t\nTEST\nRS \t\nTEST \n(At 365 nm after spraying \nwith anisaldehyde sulphuric\n(Under UV light at 254 nm) (Under CV light at 366 nm)\nRS \t\nTEST \n(Under day light after spraying\nacid_ reagent\nacid reagent)\nwith 20 per cent, v/v nitric acid\nTLC Chromatogram of Shankhpush pi\nsolution)\n759\n3.2. THIN LAYER CHROMATOGRAMS OF HERBS AND PROCESSED HERBS"}},{"@id":"https://www.openphar.org/data/ip/monographs/seratrodast","@type":"IndexedMonograph","prefLabel":{"en":"Seratrodast"},"edition":"ip-2022","category":"monographs","definition":{"en":"Seratrodast\nc^iwV ’J/;’”'. \n;;■ Moiwt.354.4\nSeratrodast is 7-Phenyl-7-(2,4,5-trimethyl-3,6-dioxocyclohexa-\ni,4-dien-.l-yl)hcptanoic acid.\nSeratrodast contains not less than 98.0 per cent and not more \nthan ;102.0 per cent of C22H26O4, calculated on the dried basis.\nDescription. A pale yellow to orange powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/serratiopeptidase","@type":"IndexedMonograph","prefLabel":{"en":"Serratiopeptidase"},"edition":"ip-2010","category":"monographs","definition":{"en":"Serratiopeptidase\nSerratiopeptidase is a proteolytic enzyme for oral use which is\nproduced by bacteria of genus Serratia.\nSerratiopeptidase contains not less than 2000 units and not\nmore than 2600 units ofserratiopeptidase activity per mg.\nCategory. Prolytic enzyme.\nDescription. A grayish white to pale brown pow4er with\ncharacteristic odour."}},{"@id":"https://www.openphar.org/data/ip/monographs/sertaconazole-nitrate-cream","@type":"IndexedMonograph","prefLabel":{"en":"Sertaconazole Nitrate Cream"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sertaconazole Nitrate Cream\nSertaconazole Nitrate Cream contains Sertaconazole Nitrate \nin a suitable cream base.\nSertaconazole Nitrate Cream.contains not less than 90.0 per \ncent and not more than 110.0 per cent of the stated amount of \nsertaconazole nitrate, C20H15CbN2OS in a suitable cream base.\nUsual strength. 2 per cent w/w. ’ \\"}},{"@id":"https://www.openphar.org/data/ip/monographs/serum-albumin-nanocolloid-injection","@type":"IndexedMonograph","prefLabel":{"en":"Serum Albumin Nanocolloid Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Serum Albumin Nanocolloid Injection\n(99,’!Tc-IISA-NC Injection)\nCategory: Diagnostic.\nDescription. 99mTc-HSA-NC Injection is a clear, colourless\nsterile solution, containing not less than 90.0 per cent and not \nmore than 110.0 per cent of the stated \"mTc-radioaCtivity at \nthe date and time stated on the label. Not less than\n90.'0 per cent of the total technetium-99m is present as\n99mTc“HSA-NC. 99mTc-HSA-NC injection should be used \nwithin 4 hours from the timc of preparation.\nRadiopharmaceutical preparation. 99tnTc-HSA-NC Injection \nis prepared aseptically following the manufacturer’s \ninstructions provided with the kit. The kit contains human \nalbumin, stannous chloride, Tween 20, ascorbic acid and buffer.\n99mTc as sodium pertechnetate (fission or non-fission), is used \nwith the kit to make 99mTc-HSA-NC Injection."}},{"@id":"https://www.openphar.org/data/ip/monographs/serum","@type":"IndexedMonograph","prefLabel":{"en":"Serum"},"edition":"ip-2010","category":"monographs","definition":{"en":"Serum\nBrucella abortus Working Standard Serum is serum ofcattle\ninfected with Brucella abortus biotype I, or serum raised in\nrabbits against smooth cultures of B. abortus strain 99 or\nstrain 544 which is suitably diluted with healthy cattle serum\norrabbit serum as appropriate. It contains 0.01 per cent w/v of\nthiomersal as antibacterial preservative.\nThe serum is suitably standardised so that a 1 in 500 dilution\ngives 50 per cent agglutination in tube agglutination test in\ncomparison with the Brucella abortus standard serum."}},{"@id":"https://www.openphar.org/data/ip/monographs/shankhpushpi","@type":"IndexedMonograph","prefLabel":{"en":"Shankhpushpi"},"edition":"ip-2022","category":"monographs","definition":{"en":"Shankhpushpi\nShankhpushpi consists of whole plant of Convolvulus \npluricaulis Choisy (Fam. Convolvulaceae).\nShankhpushpi contains not less than 0.1 per cent to 0.3 per \ncent of Scopoletin, calculated on the dried basis.\nCategory. Antiu Icerogenic, anti depressant, antiepileptic, \nhepatoprotective and anti-inflammatory.\nDescription. A light green yellowish, in colour and slightly \nbitter in taste with characteristic odour.\nA. Macroscopic — Root. Cylindrical, straight and branched, : \n7-12 cm long, 0.1-0.4 cm thick, the root is faintly longitudinally \nstriated and exhibits small circular rootlet scars, fractured\n•, \n' / • 1 \n, : . ’ : ‘ ‘ \n'J ! ? ; ; \n’lAt1 C:.! ’7:i'Q0\nsurface and is yellowish brown to light brown in colour.\nStem. Cylindrical and aerialstems densely covered with hairs. \nThe stemis 2 to 6nmiindiameter:and20.to.50cminlérigth, \nlight green in colour, taste is slightly bitter.. -,:r -. L\nLeaf. Shortly petiolate, linear-lanceolate, acute, hairy on both\nsurfaces; 0.5-2 cm long and 10-0.5 cm broad; light green.\nFlower. White or pinkish; solitaiy or in pairs sessile or sub \nsessile in the leaf axis; sepals narrow, linear lanceolate, sparsely \nhairy; corolla shortly discoid; stamen 5,free, epipetalous, \nalternate with the petals, inserted deep in the corolla tube; \novary superior and bicarpellary\nFruit. Capsule, oblong globose with coriaceous, pale brown \npericarp. ' ' ’-‘V'\nSeed. Brown, minutely puberulous. : \n: \n;\nB. Microscopic — TfódZi-T.S.-óf root shows outer cork \ncomposed of 10-15 years of tangentially elongated, thick-\n4295\nwww.webofpharma.com\nSHANKHPUSHPI\nwalled suberized cells, cortex many layered, parenchymatous, \ntraversed by yellowish-brown tanniniferbus secretory cells \nand starch grains, phloem composed of sieve elements, \nphloem parenchyma and phloem rays. Xylem vessel solitary \nor* in groups of 2-5; tracheids and parenchyma pitted; \nmedullary rays 1-3 seriate; starch grains, round to oval in \nshape,¡simple or compound’ measuring 3-8 p, in diaïïieter.\nStem. Phloem very narrow, xylem ring wider, vessels scattered \nthroughout but abundantly towards inner region, medullary \nraÿs uni seriate, central pith parenchymatous, encircled by \ngroups of perimedullary phloem. \nJ\nLeaf. T.S. of leaf shows convex midrib on the lower side andai \nthé upper side, a smallcentfàlly placed notch. A single layered \nepjderinis is present which is covered with thick striated cuticle \nand long unicellular trichomes. A two layered palisade region \nlies underneath the epidermis of the lamina. A layer of spongy \nparenchyma is seen in between the upper and lower palisade \ntissue.\nC. Determine by thin layer chromatography (2.4.17), coating \nthe plate with silica gel GF254.\nMobile phase. A mixture of 4 volumes of toluene, 2.5 volumes \nof chloroform., and 3.5 volumes of acetone.\nTest solution. Reflux 2 g of coarsely powdered substance under \nexamination with 50 ml of methanol for 30 minutes, cool and \nfilter. Reflux the residue further with 50 ml bf methanol, cool \nand filter. Combine the filtrates and concentrate under vacuum \nto 25.0ml.\nReference solution. Reflux 2 g of shankhpushpi IPBRSpftâs \n50 ml of methanol for 30 minutes, cool and filter. Reflux the \nresidue further with 50 ml of methanol, cobl and filter. Combine \nthe filtrates and concentrate under vacuum to 25.0 ml.\nApply to the plate 10 pl of both test and referehce'sblution as \nbands bf 10 mm by 2 mm. Allow thé mobile phase to rise 8 cm.\nDry the plate in air and examine in ultraviolet light at 254 nm \narid 366 nm. Spray with anisaldehyde sulphuric acid reagent \nand heat the plate at 100° for 10 minutes. Examine the plate in \nday light. The chromatographic profile of the, test solution is \nsimilar to that of the reference solution.\nTests' \nr . .-.w ■.\nForeign organic matter (2,6.1). Not more than 1.0 per cent.\nEthanol- soluble extractive (2.6.2). Not less than 6:0 per cent\nWater soluble extractive (2.6.3). Not less than 13.0 per cent.\nTotal ash (2,3.19). Not more than 20.0 pe"}},{"@id":"https://www.openphar.org/data/ip/monographs/shatavari","@type":"IndexedMonograph","prefLabel":{"en":"Shatavari"},"edition":"ip-2022","category":"monographs","definition":{"en":"Shatavari"}},{"@id":"https://www.openphar.org/data/ip/monographs/shati","@type":"IndexedMonograph","prefLabel":{"en":"Shati"},"edition":"ip-2022","category":"monographs","definition":{"en":"Shati\nShati consists , of the dried rhizomes of Hedychium spicatum \nBuch.-Ham.ex Smith (Fam. Zingiberaceae).\nShati contains not less than 0.80 per cent w/w of p-methoxy \ncinnamic acid ethyl ester, calculated on the dried basis.\nCategory. Antiasthmatic, antiseptic, indicated in skin diseases, \nanalgesic, kasa.\nDescription. A reddish-brown outer surface and white in side, \nshort and uneven fracture and camphoraceous odour with \naromatic and pungent taste. •••"}},{"@id":"https://www.openphar.org/data/ip/monographs/shellac","@type":"IndexedMonograph","prefLabel":{"en":"Shellac"},"edition":"ip-2022","category":"monographs","definition":{"en":"Shellac\nLac ■\nShellacconsists of a purified substance prepared from the \nresinous secretion of the female insect, Laccifer lacça Kerr \n(Fairi. Coccoidae). Shellac is a polyester resin consisting of \ninter-and intra-esters of polyhydroxyl carboxylic acids formed \nfrom Certain hydroxyl acids and sesquiterpinic acids, and also \ncontains variable amounts of wax.\nThere arc four types of shellac depending on the nature of the"}},{"@id":"https://www.openphar.org/data/ip/monographs/sildenafil-citrate","@type":"IndexedMonograph","prefLabel":{"en":"Sildenafil Citrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sildenafil Citrate\no\nC^HjMOhS ; \n' \n/. Mol. Wt. 666.7\nSildenafil Citrate is 5-[2-ethoxy-5-(4-methylpiperazinyl- \nsulphonyl)phenyl]-l-methyl-3-«-propyl-1,6-dihydro- \n7#-pyrazolo[4,3-<7]pyrimidin-7-one citrate.\nSildenafil Citrate contains not less than 98.0 per cent and not \nmore than 102.0 per cent of C28H3gN6O[]S, calculated on the \nanhydrous basis.\nCategory. Used in erectile dysfunction.\nDescription. A white to off white powder.\nDetermine by infrared absorption spectrophotometry (2.4.6). \nCompiare the spectrum that obtained with sildenafil citrate \nIPRS or with the reference spectrum of sildenafil citrate.\nCitricacid. 28.0 per centto 34.0 per cent.\nWeigh 0.2 g of the substance under examination and transfer \ninto a 250-ml conical flask, add 50 ml of methanol and sonicate\nwww.webofpharma.com\nSILDENAFIL. CITRATE\nlodissolve.then addSOml of wafen Titrate ydthfi EM sodium \nhydroxidesolutionrdragphenolphthalein indicator until the \ncolour changes from colourless topink. . \n-x, ;y sdri .<•\n1 ml- of 6:1 M'sodiumhydroxide is equivalent to 0.006403 g of\nC6H8O7. \nuh\nRelated.substance^; Determine, by liquid: chromatography\n(2.4.14)/ \n./. \n2 g\nNOTE—Use freshlyprepared solution.\nSolvent mixture.; 30 volumes of water, and. ,70 volumes; of \nacetonitrile.\nTest solution. Dissolve 50. mg of the substance under \nexamination in 100.0 ml of the solvent mixture.\nReference solution (a). A 0.05 per cent w/v solution of \nsildenafil citrate IPRS in the solvent mixture.\nReference solution (6). Dilute 10.0 ml of reference solution (a) \nto 100.0 ml with the solvent mixture. Further dilute 3.0 ml of the\nsolution to 100.0 ml with the solvent mixture.\nChromatographic system \n/ c? •:5?-c..c. •\n- a stainless steel column 25 cm x 4.6 mm, packed with\noctadecylsilane bonded to porous silica (5 pm) (Such \nas Hypersil ODS Cl 8), .\n- mobile phase: A, dissolve 3 ;85 g of ammonium acetate\nin 1000 ml of water, adjusted to pH 7.5 with ammon ia\n. . solution,\nB. acetonitrile,\n- a gradient programme using the conditions given below, \n- flow rate: 1 ml per minute,\n- spectrophotometer set at 240 nm,\n;. -• injection volume: 20 pl.\nNiobile phase A Mobile phase B\n. (percenv/v) ■ (percent v/v) ’\nTime \n(in min.)\n■ ■ ■ -: 65 ■ \n- \n35\n- 0\n: 15 : :\n30\n20 \n80\n20...... ' i, ; '' 80'\n40\n./• \n65 \na';:'-: \np - . -.< >\n45\n65 \n35 •\n50\nThe relative retention time with reference to sildenafil for citric \nacid is about 0.11, for N-oxide is about. 0.29 and for \nchlorosulphpnyl is about 1.6. \n...... /-••-. . : 1 ,\nInject reference solution (b). The test is not valid unless the \ncolumn efficiency is not less than 2000 theoretical plates and \ntailing factor is not more than 2.0. \n. v:. -< c\nInject reference solution (b) ’and the test solution. In the \nchromatogram obtained with test solution the areaof the peak\ndue to N-oxide impurity is not more than 1,67.. times the are^f \nthe principal peak in the chromatogram obtained with refereh^ \nsolution (b) (0,5 per pent), the area of peak due t0 \nchlorosulphonyl is not more than 0.67 times th^aréa.^^ \nprincipal peak in the chromatogram obtained with feÿéte^ç \nsolution (b)(0.2 per cent), the area of any othér secondai^ \npeak is riot more than the area of the principal peak ïa \nchromatogram obtained with 'reference solution (b j: (Ôi’d \ncent)I , and the ' sum of areas of all the secondary Jjeaks^^ \nmore than 3.3 times the area of the principal peak in g \nchromatogram obtained with reference solution (b) (LÔ jjd \ncent).' Ignore any peak corresponding to citric acid.\nHeavy metals (2:3:13 ) : 1.0 g compiies with the ¡limittest for \nheavy metals, Method B (20 ppm). \nfrL : z\nSulphated ash (2.3.18). Not more than 0.1 per cent,. ,..///\nWater (2.343). Not more than 2.5 per cent, determined on\nXu-:::; \n/Vi\nAssay. Determine by liquid chromatography (2.4,14).....\nNOTE— Use freshly prepared solution. \n; i v: vi/ukkii/\nSolvent mixture. 30 volumes of water and 70 volumes of \nacetonitrile: \n';y ’ \n' (7':\nTest solution. Dissolve 50 mg of the substancejhnder \nexamination "}},{"@id":"https://www.openphar.org/data/ip/monographs/silver-nitrate","@type":"IndexedMonograph","prefLabel":{"en":"Silver Nitrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Silver Nitrate\nAgNO: \nMol. Wt. 169.9 |\nLoss on ignition represents the amount of S iO2 iri the amount | \nof the substance taken for the test for Loss on ignition, / \n|\nStorage. Store protected from light. \n■■ - ■ g\nSilver Nitrate contains not less than 99.0 per cent and not \nmore than 100.5 per cent of AgNO3. 1 \n; \n?|\nCategory. Local anti-infective. , \n. ;,7... '■ '/i\nDescription. Cplourless.cjystals or a white, crystalline powder, ¿g"}},{"@id":"https://www.openphar.org/data/ip/monographs/silver-sulphadiazine-cream","@type":"IndexedMonograph","prefLabel":{"en":"Silver Sulphadiazine Cream"},"edition":"ip-2022","category":"monographs","definition":{"en":"Silver Sulphadiazine Cream\nSilver Sulphadiazine Cream contains not less than 90.0 per \ncent and not more than 110.0 per cent of the stated amount of \nCI0H9AgN4O2S;\nUsual strength. 1 per cent w/w."}},{"@id":"https://www.openphar.org/data/ip/monographs/silver-sulphadiazine","@type":"IndexedMonograph","prefLabel":{"en":"Silver Sulphadiazine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Silver Sulphadiazine\nCioHLjAgNAS \nMol. Wt. 357.1\nSilver Sulphadiazine is benzcnesulphonamide, 4-amino-7V-2- \npyrimidinyl, rnonosilver(F) salt.\nSilver Sulphadiazine contains not less than 98.0 per cent and \nnot more than 102.0 per cent of CioHçAgN^S, calculated \nonthe dried basis.\nCategory. Antiinfective.\nDescription. A white to creamy-white crystalline powder. \nStable in air, but turns yellow on exposure to light."}},{"@id":"https://www.openphar.org/data/ip/monographs/simvastatin","@type":"IndexedMonograph","prefLabel":{"en":"Simvastatin"},"edition":"ip-2018","category":"monographs","definition":{"en":"Simvastatin\nC25H3805 \nMol.Wt. 418.6\nSIMVASTATIN TABLETS \nSILVER SULPHADIAZINE CREAM \nIP 201 8\nSimvastatin contains not less than 97.0 per cent and not  Tn4\nore \nthan 102.0 per cent of C25H3805, calculated on the dried basi s.\narea of the principal peak in the chromatogram obtained with\nInject reference solution (a). The test is not valid unless \nresolution between the peaks due to lovastatin and \nepilovastatin and simvastatin is not less than 4.0.\nreference solution (b) (0.4 per cent). The sum of the areas of all\nthe secondary peaks other than lovastatin and epilovastatin \nis not more than twice the area of the principal peak in the \nchromatogram obtained with reference solution (b) (1.0 per \ncent)- ignore any peak with an area  less than 0.1 times the area \nof the principal peak in the chromatogram obtained with\n A suitable antioxidant may be aded.\nCategory. Antihyperlipidaemic.\nInject reference solution (c) and the test solution.\nDose. 5 mg to 10 mg per day.\nCalculate the content of simvastatin.\nDescription. A white or almost white, crystalline powder.\nStorage. Store protected from light and moisture, under \nnitrogen.\nre \nti efearle; eine estoaliust(i2o n.3(. b13) 0.0 \n.).15 per\n tp) \nies with the limit test for"}},{"@id":"https://www.openphar.org/data/ip/monographs/siris","@type":"IndexedMonograph","prefLabel":{"en":"Siris"},"edition":"ip-2022","category":"monographs","definition":{"en":"Siris\nSiris consists of dried stem bark. of Albizia leb beck (Linn.) \nBcnth. (Fam. Fabaceac). Siris contains not less than 0.03 per \ncent w/w of catechin hydrate, calculated on the dried basis.\nCategory. Anti-inflammatory, Anti-histaminic, Antioxidant, \nAntitussive. \n-\n4302\nSIRIS\nÏP 2022\nDescription. It is a medium to large sized;tree,growi \nthroughout India and up to 900 m above mean sea level also ‘ \nlower Himalayas and in the Andaman and Nicobar Islands\nIdentification .\nA Macroscopic—Bark 1.5-2.5 cm thick, dark brown, youn \nbark with transversely elongated lenticels, older one rough \nlongitudinally fissured and transversely cracked; exhibit well \ndeveloped, brown to blackish brown rhytidoma, which often \npeels off in the flakes exposing a buff coloured inner surface\nshowing impressions of lenticels. The inner surface is smooth^ \nyellowish to grayish brown in color, longitudinally finely \nstriated. Fracture is fibrous. Perceptible acrid and astringent \ntaste and no characteristic odour.\nB. Microscopic — Transverse section of the mature bark \nexternally shows about 4-10 min thick rhytidoma occupying \nalmost one third the area of the entire bark, remaining tissue \nbeing mostly of secondary phloem. Rhytidoma is composed \nof alternate zones of various tissues like cork, cortex, pericycle \nand phloem, deeply coloured with brown pigment and tannin; \nIsolated prisms of calcium oxalate, groups of sclerids and stone \ncells of various sizes and thickness also traversed throughout \nthis region. The living tissue of the bark is mainly composed \nof wide secondary phloem consisting of groups of tangentially \nrunning sieve tissues frequently getting obliterated. \nCompanion cells and phloem parenchyma alternating with \nphloem fibers are associated with idioblast-containing prisms \nof calcium oxalate crystals; groups of stone cells occasionally \nassociated with fibers. Medullary rays uni- to tri-seriate, mostly \nmulti-seriate and wavy in outer phloem, arid running almost \nparallel in the inner phloem region. Simple starch grains present\nin the paranchymatous cells of the phloem. \n;\nPowder highly fibrous reddish brown. The diagnostic \nmicroscopical characters include isolated or groups of thick­\nwalled, pitted, lignified stone cells of different sizes and shapes; \nfragments of thick-walled fibers; paranchymatous cells \nassociated with idioblast containing prisms of calcium oxalate \ncrystals; cork cells in surface view; paranchymatous cells with \nstarch grains; tangentially and radially cut medullary rays with \nfibers and prismatic crystals of calcium oxalate.\nC. Determine by thin-layer chromatography (2,4.17), coating \nthe plate with silica gel GF254. \nf *\nMobile phase, A mixture of 5 volumes of toluene, 5 volumes \nof ethyl acetate and 1 volume of formic acid. > ; d\nTest solution: Defat 10.0 g of the powdered substance unde1, \nexamination with 50 ml ofpetroleum ether (60-80°). Reflux \nthe residue under examination with 50 ml of methanol for \nminutes, cool and filter. Reflux the residue further for 2 x 50 , \nof methanol, cool and filter; Combine : all the filtrates an\nconcentrate under vacuum to 5.0 ml. \n;;\nwww.webofpharma.com\n^e^nce> solution. A 0.01 per cent w/v solution of catechin\nStarch\n^rate IPRS m methanol.\n.^pply to the plate 10 pl of each solution as bands of 10 mm by\n7 nun- Allow the mobile phase to rise 8 cm. Dry the plate in air \nand examine under ultraviolet light at 254 nm, 366 nm and day \nlight The chromatographic profile of the test solution is similar\n(o that of the reference solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sisomicin-sulphate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sisomicin Sulphate Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sisomicin Sulphate Injection\nSisomicin Sulphate Injection is a sterile solution of Sisomicin \nSulphate in Water for Injection. It may contain one or more \nsuitable buffers, chelating agents and preservatives.\nSisomicin Sulphate has a potency not less than 580 gg of \nsisomicin per mg, calculated on the dried basis.\nTest solution. Weigh and powder 20 tablets. Weigh a quantity \nof the powder containing about 100 mg of Simvastatin, disperse\nSisomicin injection contains not less than 90.0 per cent and \nnot more than 120.0 per cent of stated amount of sisomicin,\nCategory. Antibacterial.\nin 100 ml of solution A and filter. Dilute 5.0 ml isf the solution \nto 50.0 ml with solution A.\nC I 9H37N5 \n.\nDescription. A off-white powder.\nUsual strengths. 10 mg per ml; 50 mg per ml.\nReference solution. A 0.01 per cent w/v solution of simvastatin \nRS in solution A."}},{"@id":"https://www.openphar.org/data/ip/monographs/snake-venom-antiserum","@type":"IndexedMonograph","prefLabel":{"en":"Snake Venom Antiserum"},"edition":"ip-2010","category":"monographs","definition":{"en":"Snake Venom Antiserum\nSnake Antivenin; Snake Antivenom Serum; Snake\nVenomAntitoxin\nSnake Venom Antiserum is a sterile preparation containing\nantitoxic globulins or their derivatives that have the power of\nspecifically neutralising the venom ofone or more species of\nsnakes. It may be obtained from the serum or plasma ofhealthy\nequines or other suitable animals immunised against venoms\nof specific species usually elapine and viperine. It may be a\npurified liquid preparation or a freeze-dried product. It may\ncontain a suitable preservative.\nDescription. A clear to slightly opalescent, colourless orpale\nyellow liquid, free from suspended particles or cream-coloured\npowder or pellet which when reconstituted with the diluent\nsupplied by the manufacturer with the freeze-dried product\nyields a clear, colourless or pale yellow liquid.\n2441\nwww.webofpharma.com\nTETANUS ANTITOXIN"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-acetate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Acetate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Acetate\nCH3COONa,3H2O\nC^NaO* 3H2O \nMol. Wt. 136.1\nSodium Acetate contains not less than 99.0 per cent and not \nmore than 101.0 per cent of C2H3NaO2, calculated on the \ndried basis.\nCategory. Pharmaceutical aid (for peritoneal dialysis fluids).\nDescription. Colourless crystals or a white, crystalline powder.\nDissolve 10.0 g in sufficient carbon dioxide-free water to \nproduce 100.0 ml (solution A).; 1ml of solution A gives reaction \n(B) of acetates and reaction (A) of sodium salts (2.3.1).\nAppearance\" of solution.; Solution A is clear (2.4.1), and \ncolourless(2.4.1). \nP -\npH (2.4.24). 7.5to 9.0, determined in a 5.0 per cent w/v solution.\nArsenic (2.3.1'0). Dissolve 5.0 g in 50 ml of \nand add 15 ml\nof stannated hydrochloric acid AsT. The resulting solution \ncomplies with the limit test for arsenic (2 ppm) .\nCalcium and magnesium. Not more than 50 ppm, calculated \nas Ca, determined by the following niethod. Mix 200 ml of \nwater with 10 ml of ammonia buffer pH 10.0,0.1 g of mordant \nblack 11 mixture and 2 ml of 0.05 Mzinc chloride. Add \ndrop wise 0.02 M disodium edetate until the- colour changes \nfrom violet to blue. To this solution add 10 g of the substance \nunder examination, shake to dissolve and. titrate with \n0.02 M disodium 'edetate uritil the blue colour is restored. Not \nmore than 0.65 ml of 0.02 M disodium edetate is required.\nHeavy metals (2.3.13). 12 ml of solution A complies with the \nlimit test for heavy metals, Method D (10 ppm), using 10 ml of \nlead standard solution (1 ppm Pb).\nIron (2.3.14). 20 ml of solution A complies with the limit test for\nChlorides (2.3.12). 10 ml of solution A complies with the limit \ntest for chlorides (250 ppm).\n3589\nwww.webofpharma.com\nSODIUM ACETATE\nSulphates (2.3.17). 7;5 ml of solution A complies with the limit \ntest for sulphates (200 ppm). : :: <■\nReducing substances. Dissolve 1.0 g in 100 ml of boiling water, \nadd 5 ml of 1Msulphuric acid and 0.5 ml of0.002 Mpotassium \npermanganate, mix and boil gently for 5 minutes; the pink\ncolour is not completely discharged.\nLoss on drying (2.4.19). 39.0 to 40.5 per cent, determined on \n0.2 g by drying in an oven at 130°. Place the substance under \nexamination in the oven while the oven is still cold.\nAssay. Dissolve 0.25 g in 50 ml of anhydrous glacial acetic \nacid, add 5 ml of acetic anhydride, mix and allow to stand for \n30 minutes. Titrate with 0.1 Mperchloric acid, using Ó.3 nil of \n1-naphtholbenzein solution as indicator, until a green colour \nis produced. Carry out a blank titration.\n1 ml of 0.1 Mperchloric acid is equivalent to 0.00820 g of \nC2H3NaO2. ■ \n' ' \n: ; \n-/\nSodium Acetate intended for use in the preparationof dialysis \nsolutions complies with the following additional requirement.\nAluminium. Dissolve 20 g in 100 ml of water and adjust to \npH 6.0 by the addition of about 10 ml of 1 M hydrochloric \nacid. Extract with successive quantities of 20,20 and 1.0 ml of \na 0.5 per cent w/v solution of 8-hydroxyquinoline in \nchloroform and dilute 'the combined1 extracts to 5 0 ml with \nchloroform ': Use as thé’ standard solution a mixtüré ôf 2.0 ml of \naluminium 'standard solution f 2 ppm Al), 10 ml of acetate \nbuffer pH 6.0 and 98 ml of water treated in the same manner \nand as the blank solution a mixture of 10 ml of acetate buffer \npH6.0‘àndTOO ml of water treated in the sâme'manner. Measure\nthe fluorescence (2.4.5) of the test solution and the standard \nsolution,,u$ing an excitation wavelength ,qf about 392 nm and \nemission: wavelength of about 518 nm, and .setting thé \ninstrument to zero with the blank solution in each casé. The \nfluorescence of the test solution is not more than that of the \nstandard solution (0.2 ppm).' ’ ' \n' \n■'••••:\nStorage. Store protectedfrom light, , . \n. . . . .\nLabelling. The label states whether or hot the; material is \nintended for. use in: thé manufacture of dialysis solutions.\nSodium Alendronate Trihydrate\nSodium Alendronate \n; \n. < u .r:\nHO'P-ONa . \n;\n- \n. 3H2O . \n,\n. ho'oh .It\"!\nC4H12NNaO7P2,3H2O "}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-acid-phosphate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Acid Phosphate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Acid Phosphate Injection\nSodium Acid. Phosphate Injection is a sterile solution. \nof \nSodium Acid Phosphate in Water for Injections.:\nSodium Acid Phosphate Injection contains not less than 90.0 \nper.cent and not more than | 10.0 per cent of the stated amount\nof sodium acid phosphate, NaH,PO,, 2H,0.\nUsual strength. Elemental Phosphorus 8 per cent w/v;"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-acid-phosphate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Acid Phosphate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Acid Phosphate\nNaH2P04,2H20\nMol. Wt. 156.0\nSodium Dihydrogen Phosphate Dihydrate contains not less\nthan 98.0 per cent and not more than 100.5 per cent of\nNaH2P04, calculated on the dried basis.\nCategory. Urinary acidifier.\nDose. 2 to 4 g.\nDescription. Colourless crystals or a white powder; odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-alendronate-tablets","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Alendronate Tablets"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Alendronate Tablets\nAlendronic Acid Tablets; Alendronate Sodium Tablets\nSodium Alendronate Tablets contains Sodium Alendronate \nTrihydrate.\nSodium. Alendronate Tablets contain , sodium alendronate \nequivalent to not less than 95.0 per cent and not more than\n105.0 per cent of the stated amount of alendronic acid , \nC4HI3NO?P?.. \n■- \n.\nUsual strength. 10 mg."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-aminosalicylate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Aminosalicylate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Aminosalicylate\nSodiumPAS ,\nC7H6NNaO3,2H2O. \nMol. Wt. 211.2\nSodium Aminosalicylate is sodium 4-amino-2-hydrpxy- \nbenzoate dihydrate. : \n: : - 1 \n'\nSodium Aminosalicylate contains not less than 99.0 per cent \nand not more than 101.0 per cent of Ç7H6NNaO3, calculated on \nthe anhydrous basis. ' \n:\nCategory.Amitubcrcular. \n, .. ...\nDescription. A white to cream coloured crystalline powder.\n3594\nb f h"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-ascorbate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Ascorbate","la":"Identification"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Ascorbate\nI\nHCOHRO\nNad\nOH\nCHzOH\nMol. Wt. 198.1\nSodium Ascorbate is L-ascorbic acid monosodium salt.\nSodium Ascorbate contains not less than 99.0 per cent and\nnot more than 101.0 per cent ofC6H7Na06, calculated on the\ndried basis.\nCategory. VitaminC.\nDose. The equivalent ofup to 1 g of ascorbic acid daily.\nDescription. White or faintly yellow crystals or a crystalline\npowder; odourless or almost odourless. It darkens gradually\non exposure to light.\nwww.webofpharma.com\nSODIUM ASCORBATE"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-benzoate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Benzoate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Benzoate\nCOONa\n6\nC7HsNaOz\nMol. Wt. 144.1\nSodium Benzoate contains not less than 99.0 per cent and not\nmore than 100.5 per cent ofC7HsNaOz, calculatedon the dried\nbasis.\nIP 2010\nCategory. Phannaceutical aid(preservative).\nDescription. A white, crystalline or granularpowder or flakes;\nodourless or with a faint odour; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-bicarbonate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Bicarbonate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Bicarbonate Injection \n|\nSodium Bicarbonate Intravenous Infusión1 \n; ■ L‘ ■ \n|\nSodium Bicarbonate Injection is a sterile solution of Sodium | \nB ¡carbonate in Water for 1 njections. \n'' / 1'ri' |\nriwri; ri . ri; ri.--./ ri .■ \nririMriQi-fj-ri-jriri;/ I\nSodium Bicarbonate Injection contains not less than 94.0 per f \ncent and not more than 106.0 per cent of the stated amount of | \nsodium bicarbonate, NaHCOj. \n..... ... ... \n|\nCategory. Electrolyte replenisher; systemic alkaliser ri |\nUsual strengths. 1.4,4.2,5.0,7.5 and 8.4 per cent w/v.. \n|\nDescription. Aclear, colourless solution. \nI\npo ;:.;7 ... . W.W. w w- ■ . -w;.. \n|"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-bicarbonate-intravenous-infusion","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Bicarbonate Intravenous Infusion"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Bicarbonate Intravenous Infusion\nSodium Bicarbonate Injection is a sterile solution ofSodium\nBicarbonate in Water for Injections.\nSodium Bicarbonate Injection contains not less than 94.0 per\ncent and not more than 106.0 per cent ofthe stated amount of\nsodium bicarbonate, NaHC03•\nCategory. Electrolyte replenisher; systemic allcaliser.\nUsualstrengths. 1.4,4.2,5.0,7.5 and 8.4 percentw/v.\nDescription. A clear, colourless solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-bicarbonate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Bicarbonate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Bicarbonate\nSodium I lydrogen Carbonate\nAssay. Weigh 1.5 g, dissolve in 50 ml of carbon dioxide-free \nwater and titrate with 1 M hydrochloric acid using 0.2 ml of \nmethyl orange solution  as indicator.\nCategory. Pharmaceutical aid (preservative). \t)01\nNaHCO3 \t\nMol. Wt. 84.0\nDescription. A white, crystalline or granular powder or flakes; \nodourless or with a faint odour; hygroscopic.\nSodium Bicarbonate contains not less than 99.0 per cent and \nnot more than 101.0 per cent of NaHCO 3 .\n1 ml of 1 M hydrochloric acid is equivalent to 0.08401 g of \nNaHCO3."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-carbonate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Carbonate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Carbonate\nNa2CO3 \t\nMol. Wt. 106.0 (anhydrous)\nNa2CO3, H2O \t\nMol.Wt.124.0 (monohydrate)\nSodium Carbonate is anhydrous or contains one molecule of \nwater of hydration.\nSodium Carbonate contains not less than 99.5 per cent and \nnot more than 100.5 per cent of Na 2CO3, calculated on the \ndried basis.\nCategory. Pharmaceutical aid (alkalising agent)\nDescription. Anhydrous - A white or almost white, slightly \ngranular powder, hygroscopic.\nMonohydrate - A white, crystalline powder or colourless \ncrystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-chloride-hypertonic-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Chloride Hypertonic Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Chloride Hypertonic Injection\nHypertonic Saline\nSodium Chloride Hypertonic Injection is a sterile 1.6 per cent \nw\\?o|^tipn of Sodium Chloride in Water for Injections. It \ncontains ho antimicrobial agent.\nSodium Chloride Hypertonic Injection contains not less than"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-chloride-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Chloride Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Chloride Injection\nSodium Chloride Intravenous Infusion\nSodium Chloride Injection is a sterile 0.9 per cent w/v solution \nof Sodium Chloride in Water for Injections. It contains no \nantimicrobial agent.\nSodium Chloride Injection contains not less than 0.85 per cent \nw/v and not more than 0.95 per cent w/v of sodium Chloride, \nNaCl.\nDescription. A clear, colourless solution.\nIt gives the reactions of sodium salts and reaction (A) of \nchlorides(2.3.1).\nHeavy metals (2.3.13). Evaporate 67 ml to about 20 ml, add 2 ml \nof dilute acetic acid and dilute to 25 ml with water. The solution \ncomplies with the limit test for heavy metals, Method A \n(0.3 ppm).\n3603\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-chloride-irrigation-solution","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Chloride Irrigation Solution"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Chloride Irrigation Solution\nReadily carbonisable substances. Heat 0.2 g, in powder, with\nSodium Chloride Irrigation Solution is  a sterile solution \ncontaining 0.9 per cent w/v of Sodium Chloride in Water for \nInjections.\n10 ml of sulphuric acid (96 per cent w/w) in a water-bath at \n90° ± 1° for 1 hour and cool rapidly. The solution is not more \nintensely coloured than reference solution YS2 or GYS2 (2.4.1).\nCategory. Systemic alkalinising agent.\nDose. 1 to 10 g.\nSodium Chloride Irrigation Solution contains not less than \n0.85 per cent w/v and not more than 0.95 per cent w/v of \nsodium Chloride, NaCl. It contains no antimicrobial agent.\nDescription. White, granular crystals or a white, crystalline \npowder; odourless; slightly deliquescent in moist air.\nWater (2.3.43). 11.0 to 13.0 per cent, determined on 0.3 g and \nafter stirring for 15 minutes before titrating.\nAssay. Dissolve 0.15 g in 20 ml of  anhydrous glacial acetic \nacid, warming to about 50\". Allow to cool. Titrate with  0.1 M \nperchloric acid, using 0.25 ml of I -naphtholbenzein solution"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-chloride","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Chloride"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Chloride\nNaCl \n- \n■ Mol. Wt.58.4\nSodium Chloride contains not less than 99.0 per cent and not \nmore than 100.5 per cent ofNaCl, calculated oh the dried Basis.\nCategory. Pharmaceutical aid (tonicity agent); fluid arid \nelectrolyte replenisher.\nDescription. White or colourless crystals or a white crystalline \npowder.\nA. It gives the reactions of chlorides (2.3.1). \n<\nB. A 2Q per cent w/v. solution in.carbon dioxide-free water \nprepared from distilled water (solution A) gives the reactions \nof sodium salts (2.3.1).\nAppearance of solution. Solution A is clear (2.4.1), and \ncolourless(2.4:1). \n' ■■\nAcidity or alkalinity. To 20 rial of solution A add 0.1 ml of \nbromothymol blue solution', not more than 0.5 ml of \n0.01 M hydrochloric acid or of 0.01 M sodium hydroxide is \nrequired to change the colour of the solution.\nArsenic (2.3.10). Dissolve 10.0gin50ml of water and 12ml of \nstannated hydrochloric acid AsT, The resulting solution \ncomplies with the limit test for arsenic (1 ppm).\nBarium. Dissolve 2 g in 10 ml of water, and add 2 ml of dilute \nsulphuric acid', no turbidity is produced within 2 hours.\nBromide. To 0.5 nil of solution A add 4.0 ml of water, 2.0 ml of \nphenol red reagent and 1.0 ml of 0.01 per cent w/v solution of\nchloramine—and mix immediately. After exactly 2-minutes, \nadd 0.15 ml of 0.1- Msodium thiosulphate^ mix and dilute to\n10,0 ml with water. The absorbanceof the solution measured \nat about 590 nm (2.4.7), using water as the blank, is not more \nthan that of the standard solution prepared, at the same time \nand in the same manner, starting with the addition of“ 2.0 ml\n3599\nwww.webofpharma.com\nofphenol red reagent.^rising 5.0 ml of a 0.0003 per cent \nw/v solution of potassium bromide (100 ppm);\nCalcium arid magnesium Not more than 50 ppm, calculated \nas Ca, determined by the following method. Dissolve 20.0 g in \n200 ml of water, and add 0.1 ml of hydrochloric, acid, 5 ml of \nstrong ammonia-ammonium chloride solution, 5 drops of\neribchrome black T solution and titrate with 0.005 Mdisodiiim \nedetate to a blue end-point.\n1 ml of 0.005 Mdisodium edetate is equivalent to 0.0002004 g \nofCa.\nFerrocyanide. Dissolve 2.0 g in 6 ml of water and add 0.5 mlof \na mixture of 5 ml of a 1 per cent w/v solution of ferric ammonium \nsulphate in a 0.25 per cent w/v solution of sulphuric acid, and\n95 ml of a 1 per cent w/v solution of ferrous sulphate;, no blue \ncolour is produced within 10 minutes.\nHeavy metals (2.3.13). 4.0 g in 2 ml of diluteacetic acid and \nsufficient water to produce 25 ml. The solution complies with \nthe limit test for heavy metals, Method A (5 ppm).\nIodide. Moisten 5 g by adding dropwise, a solution freshly \nprepared by mixing 25 ml of iodide-free starch solution 2 ml of\n0.5 Msulphuric acid, 0.15 ml of sodium nitrite solution and \n25 ml of water and examine the mixture in daylight; the \nsubstance shows ho blue colour ;after 5 riiiriUtes.\nIron (2.3.14). 2:0 g dissolved in 20 ml oiwater complies with \nthe limit test for iron (20 ppm).\nSulphates (2.3.17). 2.5 ml of solution A diluted to 15 ml with \nwater complies with the limit test for sulphates (300 ppm), ;\nLoss on drying (2.4.19). Not more thanl.Q percent, determined \non 1.0 g by drying in an oven at 105° for 3 hours. . . .\nAssay. Dissolve 0.1g in 50 ml of water in a glass-stoppered \nflask. Add 50.0 ml of 0.1 Msilver nitrate, 5 ml of 2 M.nitric \nacid and.2 ml of,dibutyl phthalate, shake well and titrate with \n0.1 Mammonium thiocyanate using 2 ml offerric ammonium \nsulphate solution as indicator, until the colour becomes reddish \nyellow. ' ' \n' ' ” \n- - \n'1\n1 ml of 0.1Msilver nitrate is equivalent to 0.005844 g of NaCl.\nSodium Chloride intended for use in:.the manufacture of \nparenteral preparations or in the manufacture of dialysis\nsolutions complies with the following. additional \nrequirement. ... \n. * .\nPotassium. Not more than 0.1 per cent; determined by flame \nphotometry (2:4.4) or by method A for atomic absorption\nspeefrophotometry (2.4.2), using a 1"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-citrate-irrigation-solution","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Citrate Irrigation Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Citrate Irrigation Solution\nSodium Citrate Irrigation Solution is a sterile solution of sodium \ncitrate in water for injections containing anhydrous citric acid \nor citric acid monohydrate.\nSodium Citrate Irrigation Solution contains'not less than \n95.0 per cent and not more than 105.0 per cent of the stated \namount of sodium citrate, C6H5Na3O7,2H2O.\nUsual strength. 3 per cent w/v.\nDescription A colourless solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-diatrizoate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Diatrizoate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Diatrizoate Injection\nDiatrizoate Sodium Injection ■\nSodium Diatrizoate Injection is a sterile solution of Sodium \nDiatrizoate in Water for Injections. It may contain small \namounts of suitable buffers, stabilisers and antimicrobial agents \nbut the preparation intended for intravenous administration \ncontains no antimicrobial preservative.\nSodium Diatrizoate Injection contains not less than 95.0 per \ncent and hot more than 105.0 per cent ofthe stated amount of \nsodium diatrizoate, C11HsI3N2NaO4.\nUsual strengths. 25 per cent w/v; 40 per cent w/v.\nEvaporate a volume ofthe injection containing 1 g of Sodium \nDiatrizoate to dryness. The residue complies with following \ntests..\nA. Heat 0.5 g of residue in a crucible; violet vapours of iodine \nare evolved.\nB. To 20 mg of the residue add 5 ml of 7 Msodium hydroxide \nand boil gently under a reflux condenser for 10 minutes. Cool, \nadd 5 ml of 2 Mhydrochloric acid and cool in ice for 5 minutes. \nAdd 4 ml of a 1 per cent w/v solution of sodium nitrite, cool in \nice for 5 minutes, add 0.3 g oisulphamic acid, shake gently \nuntil effervescence ceases and add 2 ml of a 0.4 per cent w/v \nsolution oiN-(l-naphthyl) ethylenediamine dihydrochloride-, \nan orange-red colour is produced.\nC. Heat 0.5 g of residue with 1 ml of sulphuric acid on a water­\nbath until a pale violet solution is produced, add 2 ml of ethanol \n(95 per cent) arid heat again;' odour of ethyl acetate is \nproduced.\nFree amine. To a volume containing 1.0 g of Sodium Diatrizoate \nin a 50-ml glass-stoppered volumetric flask, add 5 ml of water,\n10 ml of 0.1 M sodium hydroxide and 25 ml of dimethyl \nsulphoxide.. Stopper the flask, mix the contents gently and\ncool in ice, protected from light. After 5 minutes, slowly add \n2 ml of hydrochloric acid, mix and allow to stand for 5 minutes. \nAdd 2 ml of a 2 per cent w/v solution of sodium nitrite, mix \nand allow to stand for 5 minutes. Add 1 ml of a 8 per cent \nw/v solution of sulphamic acid, mix and allow to stand \nfor 5 minutes. Add 2 ml of a 0.1 per cent w/v solution'of \nN-(l-naphthyl)ethylenediamine dihydrochloride in a 70. per\ncent w/v. solution of 1,2-propanediol and mix. Remove the \nflask from the ice and allow to stand in water at 25° ± 2° for\n10 minutes, with occasional shaking. Add sufficient’ dimethyl \nsulphoxide to produce 50 ml and mix. Within 5 minutes, measure\n3607\nwww.webofpharma.com\nSODIUM DIATRIZOATE INJECTION\nthe absorbance of the resulting solution .at the maximum at \nabout 470 nm (2.4.7), using as the blank a solution prepared \nby treating 5 ml of water in flie same mánner;: absorbance, not \nmore than 0.40, calculated on the anhydrous basis. ,\nFree iodine and iodide. To.a volume containing 2.0 g of Sodium \nDiatrizoate in 24 ml of water taken in a 50-ml glass-stoppered \ncentrifuge tube add 5 ml oí toluene and 5 ml of 1M sulphuric \nacid, shake well and centrifuge; no red colour appears in the \ntoluene layer. To the mixture add 1 ml, of a 2 per cent w/v \nsolution of sodium nitrite, shake and centrifuge; any red colour \nin the toluene layer is not more intense than that produced in \na solution prepared in the same manner using 2.0 ml of a \n0.025 per cent w/v solution ofpotassium iodide and 22-ml of \nwater (220 ppm).\nBacterial endotoxins (2.2.3). Not more than 5.6 Endotoxin Units \nper ml for injections containing 20.0 per cent of sodium\ndiatrizoate; not more than 1.3 Endotoxin Units per ml'for \ninjections containing 25.0 per cent of sodium diatrizoate; and \nnot more than 5.Q Endotoxin Units per ml for injections \ncontaining 50,0 per cent of sodium diatrizoate.\nOther tests. Comply with the tests stated under Parenteral \nPreparations (Injections).\nAssay. Weigh 0.5 g in a glass-stoppered conical flask, add\n12 ml of 5 M sodium hydroxide and 1 g oí zinc powdér and \nboil under a reflux condenser for 30 minutes. Cool, rinse the \ncondenser with 30 ml of water, filter through cotton and wash \nthe flask and filter with two quantities; each of 20 ml, of water: \nTo the combined "}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-diatrizoate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Diatrizoate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Diatrizoate\nDiatrizoate Sodium\nCOONa\nCnH8I3N2NaO4 \nMok Wt 635.9\nIB 2022\nSodium Diatrizoate is sodium 3 ,5-diacelamido-2,4,6^0^ \nbenzoate. \n-. \n.-.w\nSodium Diatrizoate contains not less than 98.0,.per cppt and \nnot more than 101.0 per cent of C( iHgI3N2NaO4, calculatedOn \nthe anhydrous basis. .\nCategory. Urographic radio-opaque substance.\nDescription. A white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-dihydrogen-phosphate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Dihydrogen Phosphate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Dihydrogen Phosphate \n(Dihydrate) \n0.251 g\nSterility (2.2.11). Complies with the test for sterility.\nFrom the volume of 0.1 Msodium hydroxide required subtract \na volume, in ml, equal to 1.28 times the number of mg of \nNaH2PO4,2H20 present, as determined in the Assay for sodium \nacid phosphate.\nOther tests. Comply with the tests stated under Parenteral \nPreparations (Injections).\nWater for Injection to \n100 \t\nml\nNOTE - 14 ml are to be used for 100 ml of whole blood.\nAssay. For sodium citrate  - Pipette 50.0 ml into a beaker and \ntitrate with 1.3 M hydrochloric acid to a pH of 1.98 ± 0.02, \ndetermining the end-point potentiometrically (2.4.25). Carry \nout a blank titration with 50 ml of water.\nDescription. A clear, colourless or faintly straw-coloured liquid; \nodourless.\n1 ml ofthe remainder is equivalent to 0.007005 g ofC 6H8O7,H2O.\nFor sodium dihydrogen phosphate dihydrate - Dilute 5.0 ml \nto 100.0 ml with water. Transfer 5.0 ml to a 25-m1 graduated \nflask and add 10.0 ml of a 2.8 per cent w/v solution of sulphuric \nacid followed by 2.0 ml of a 2.5 per cent w/v solution of \nammonium molybdate, mixing after each addition. Add 1.0 ml \nof aminohydroxynaphthalenesulphonic acid solution and \nsufficient water to produce 25.0 ml, mix and keep aside at 25° \nfor 10 minutes. Measure the absorbance (A 1) of the resulting \nsolution at the maximum at about 660 nm (2.4.7) using as the \nblank 5 ml of water treated in the same manner. Calculate the \ncontent of NaH,PO4,2H20 in each ml of the solution under \nexamination from the absorbance (A,) obtained by \nsimultaneously carrying out the operation using 5.0 ml of a \nsolution of potassium dihydrogen phosphate containing \n0.11 mg of KH 2PO4 per ml (C) and from the expression"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-fluoride","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Fluoride"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Fluoride\nNa1. \t\nMol. Wt. 42.0\nSodium Fluoride contains not less than 98.5 per cent and not \nmore than 100.5 per cent of NaF, calculated on the dried basis.\nCategory. Preventive for dental caries.\n- \t\nF:'14-- N- \n..fr-- \t\nT. \n.  \nDescription. A white powder or colourless crystal. ' --- -'-c-  , Storage. Store wprotected from moisture. \n..,-7---V1:-,__.-7_ z.\n- I\nSODIUM DIATRIZOATE INJECTION \nIP 2018 \nSODIUM FUSIDATE \n11)201 8"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-formaldehyde-sulphoxylate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Formaldehyde Sulphoxylate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Formaldehyde Sulphoxylate\n' \n+ /OH ,2H2O - ■\nNa O .\nCH3ÑaÓ5S,2H2O \nMol Wt. 154.1\nSodium Formaldehyde Sulphoxylate is monosodium \nhydróxyinétharic stilphinate dihydratc. It may contain a \nsuitable stabilising agent such as sodium carbonate.\nSodium Formaldehyde Sulphoxylate contains an amount of \nCHjNaOjS equivalent to not less than 45.0 per cent and \nnot more thari 55.0 per cent of SO2, calculated oh the dried\nbasis. \n''■_■■■■\nCategory. Pharmaceutical aid (antioxidant).\nDescription. White crystals or hard white masses."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-fusidate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Fusidate","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Fusidate\nC3ln4/NaO6 \n. Mol. Wt. 538.7\nSodium Fusidate is sodium (17Z)-16p-acetoxy-3a,lla-di- \nhydroxyfusida-17(20),24-dierie-2'l-oatei, produced by the \ngrowth of certain strains di'Fusidium coccineum or by any \nother means. 1\nSodium Fusidate contains not less than 97.5 per cent and not \nmore than 101.0 per cent of C^H^NaO/calculatcd on the \nanhydrous basis.\nCategory. Antibacterial.\nDescription. A white or almost white, crystalline powder;\nslightly hygroscopic.\n3609\nwww.webofpharma.com\nSODIUM FUSIDATE"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-hydrogen-carbonate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Hydrogen Carbonate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Hydrogen Carbonate\nSodium Bicarbonate contains ñót less than 99.Ó pér cent arid \nnot more than 101.0 per cent of NaHCO3.\nCategory. Electrolyte replenisher; systemic alkaliser. < ;; ;\nDescription. A white? crystalline powder or small, opaque, \nmonoclinic crystals. It gradually forms sodium carbonate on \nheating in the dry state or in solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-hydroxide","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Hydroxide"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Hydroxide\nSpecific optical rotation (2.4.22). +5.0° to +8.0°, determined at\nCaustic Soda\n20° by dissolving 1.5 g in 25 ml of water, adding 0.1 ml of\n5 M ammonia and diluting to 50 ml with water.\nNaOH\nMol. Wt. 40.0\nSodium Hydroxide contains not less than 97.0 per cent and\nnot more than 100.5 per cent oftotal alkali, calculated as NaOH.\nCategory. Pharmaceutical aid (allcalising agent).\nDescription. White, crystalline masses supplied as sticks,\npellets or slabs; deliquescent. Readily absorbs carbon dioxide.\nCAUTION -\nGreat care should be exercised in handling\nSodium Hydroxide as it rapidly destroys tissues."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-hyposulphite","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Hyposulphite"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Hyposulphite\nTest solution (a).  Dissolve 0.5 g of the substance under \nexamination in water and dilute to 10.0 ml with water. -4410\nNa2S203,5H20\nMol. Wt. 248.2\nSodium Stibogluconate Injection contains not less than \n9.5 per cent w/v and not more than 10.5 per cent w/v of \npentavalent antimony, Sb.\nTest solution (h). Add 5 ml of a 0.2 per cent v/v solution of \nethanol (internal standard) to 0.5 g of the substance under \nexamination and dilute to 10.0 ml with water.\nSodium Thiosulphate contains not less than 99.0 per cent \nand not more than 101.0 per cent of Na2S 203,5H20.\nUsual strength. The equivalent of 100 mg of pentavalent \nantimony per ml.\nCategory. Antidote to cyanide poisoning.\nReference solution. Add 1 ml of a 1.0 per cent v/v solution of \nmethanol to 5 ml of a 0.2 per cent v/v solution of the internal \nstandard and dilute to 10.0 ml with water. \nRt4\nDose. By intravenous or intramuscular injection, 300 mg to 1 g.\nDescription. A clear, colourless or faintly straw-coloured \nsolution.\nDescription. Colourless large crystals or a coarse, crystalline \npowder; odourless; deliquescent in moist air and effloresces \nin dry air at temperature above 33°. It dissolves in its water of \ncrystallisation at about 49°.\nChromatographic system"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-lactate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Lactate Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Lactate Injection\nA. Carefully dissolve 5.0 g in 12 ml of distilled water, add\nSodium Lactate Intravenous Infusion\n17 ml of 7 M hydrochloric acid, adjust the pH to 7.0 with \n1 M hydrochloric acid and add sufficient distilled water to \nproduce 50 ml (solution A). 2 ml of solution A gives reaction\nSodium Lactate Injection is a sterile solution containing\nCompound Sodium Lactate and \nDextrose Injection\n1.85 per cent w/v of sodium lactate in Water for Injections. It is \nprepared from Lactic Acid with the aid of Sodium Hydroxide \nand sufficient Dilute Hydrochloric Acid to adjust the pH of \nthe solution.\n(A) of sodium salts (2.3.1).\nB.pH of a 0.01 per cent w/v solution, not less than 11.0 (2.4.24).\nCompound Sodium Lactate with Dextrose Intravenous \nInfusion; Ringer-Lactate Solution with Dextrose for \nInjection; Hartmann's Solution with Dextrose for \nInjection."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-lauryl-sulphate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Lauryl Sulphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Lauryl Sulphate\nSodium Lauryl Sulphate is a mixture of sodium alkyl sulphates \nconsisting .mainly of sodium dodecyl - sulphate^ \nC^[CH2])0ÇH2OSO3Na. _\n$odium Lauryl Sulphate contains not less than 85.0 per cent \n«sodium alkyl sulphates, calculated as CTlfyNaChS.\nDescription. A white or pale yellow powder or crystals.\nA. A 1 per cent w/v solution, when shaken, produces plenty \nof foam.\nB. Mix 0.1 ml of a 1 per cent w/v solution with 0.1 ml of a 0.1 per \ncent w/v solution of methylene blue and 2 ml of 1M sulphuric \nacid, add 2 ml of dichloromethane and shake; the dichloro- \nmethane layer is intensely blue.\nC. Mix about 10 mg with 10 ml of ethanol and heat to boiling \non a water-bath, shaking frequently. Filter immediately and \nevaporate the ethanol. Dissolve the residue in 8 ml ofwater, \nadd 3 ml of 2 M hydrochloric acid, evaporate the solution to \nhalf its volume and cool. Filter and to the filtrate add 1 ml of\nbarium chloride solutions awhile, crystalline precipitate is \nproduced.\nD. It gives reaction (B) of sodium salts (2.3.1).\nAlkalinity. Dissolve 1.0 g in 100 ml of carbon dioxide-free \nwater and add 0.1 ml of phenol red solution. Not more than \n0.5, ml of 0.1 Mhydrochloric.acid is required to change the \ncolour of the solution.\nNon-esterified alcohols. Not more than 4 per cent, determined \nby the following method. Dissolve 10.0 g in 100 ml of water, \nadd 100 mF of ethanol (95 per cent) and extract the solution \nwith three quantities, each of 50 ml, of n-pentane, adding \nsodium chloride, if necessary, to promote separation of the\ntwo layers. Wash the combined organic layers with three \nquantities, each of 50 ml, of water. Dry the organic solution \nover anhydrous sodium sulphate, filter and evaporate on a \nwater-bath until the odour of pentane is no longer detectable. \nHeat the residue at 105° for 15 minutes, cool and weigh.\nSodium Chloride and Sodium Sulphate. Not more than a total \nof 8.0 per cent, determined by the following methods.\nFor sodium chloride — Dissolve 5.0 g in 50 ml of water, add\n2 M nitric acid drop wise until the solution is neutral to litmus \npaper, add 2 ml of potassium chromate solution and titrate\nwith 0.1 M silver nitrate.\n1 ml of 0.1 Msilver nitrate is equivalent to 0.005844 g of NaCl.\nFor sodium sulphate — Dissolve Ó.5 g in 20 ml of water, \nwarming gently if necessary, and add 1 ml of a 0.05 per cent \nw/v solution of dithizone in acetóne. If the solution is red, \nadd 1 Mnitric acid, dropwise, until it becomes bluish green. \nAdd 2 ml of dichloroacetic acid solution and 80 ml of acetone\nand titrate with 0.01 M lead nitrate until a permanent orange- \nred colour is obtained.\n3617\nwww.webofpharma.com\n1 ml; of 0.01 M lead nUrate is equivalent to 0.001420 g of \nNa2SO4. ...........; \n.... ;;......■....... . ■■ ; ...... .....\nAssay. Weigh 1.15 g, dissolve in sufficient water to produce\n1000.0 ml, warming if necessary. To 20.0 ml add 15 ml of \nchloroform, 10 ml. of dilute sulphuric acid and\n1 nil of dimethyl yellow-oracet blue B solution and titrale \nwith 0.004 M benzethonium chloride, shaking vigorously\nand allowing the: layers to separate after each addition, until \nthe chloroform layer acquires a permanent clear green colour.\n1 ml of 0.004 M benzethonium.chloride is equivalent to \n0.001154 g of sodium alkyl sulphates, calculated as \nC!2Il25NaO4S. • \n: f ■\nStorage. Store protected from moisture."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-metabisulphite","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Metabisulphite"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Metabisulphite\nSodium Pyrosulphite; Sodium Disulphite\nNa2S2O5 \nMol. Wt. 190.1\nSodium Metabisulphite may be prepared by saturating a \nsolution of Sodium Hydroxide with sulphur dioxide and \nallowing crystallisation to occur.\nSodium Metabisulphite contains not less than 95.0 per cent \nand not more than 100.5 per cent of Na2S2O5.\nCategory. Pharmaceutical aid (antioxidant).\nDescription. Colourless, prismatic crystals or a white or creamy \nwhite powder. ... . . .; \n; \n. ."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-methyl-hydroxybenzoate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Methyl Hydroxybenzoate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Methyl Hydroxybenzoate\nCsH7Na03\nMol. Wt. 174.1\nSodium Methylparaben is the sodium salt ofmethyl\n4-hydroxybenzoate.\nSodium Methylparaben contains not less than 99.0 per cent\nand not more than 102.0 per cent ofCsH7Na03' calculated on\nthe anhydrous basis.\nCategory. Pharmaceutical aid (antimicrobial preservative).\nDescription. A white, crystalline powder; odourless or almost\nodourless; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-nitrite-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Nitrite Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Nitrite Injection\nSodium Nitrite Injection is a sterile solution of Sodium Nitrite \nin Water for Injections. \n-\nSodium Nitrite Injection contains riot less than 95.0 per cent \nand not more than 105.0 per cent of the stated amount of \nNaNO2. ’ \n.\nUsual strength. 30 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-nitrite","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Nitrite"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Nitrite\nNaNO2 \nMol. Wt. 69.0\nSodium Nitrite is nitrous acid, sodium salt.\nSodium Nitrite contains not less, than 97.0 per .cent and not \nmore than 101.0 per cent ofNaNO2, calculated on the dried \nbasis.\nA 10 per cent w/v solution complies with the tests of sodium \nsalts (2.3.1) and nitrite (2.3.1).\nHeavy metals (2.3.13). Dissolve 1 g in 6 ml of 3 Mhydrochloric \nacid, and evaporate on a steam-bath to dryness. Reduce the \nresidue to a coarse powder, and continue heating on the steam­\nbath until the odor of hydrochloric acid no longer is perceptible. \nDissolve the residue in 23 ml of water, and add 2 ml of 1 M \nacetic acid. The solution complies with the limit test for heavy \nmetals, method A (20 ppm).\nLoss on drying (2.4.19). Not more than 0.25 per cent, drying it \nover silica gel for 4 hours.\n3619\nwww.webofpharma.com\nAssay. Dissolve, 1; gin 250:0 ml of waler. Pipette 25 ml of the \nsolution into: a - mixture of 50.0I ml of; 0.02 :M potassium \npermanganate, 50 ml of w/er and 20 ml of dilute sulphuric\n«ezf/. When adding the sodium nitrite solution, immerse the \ntip of the pipctte beneath the surface of thfe. permanganate \nmixture. Stopper lhe flask, allow it to stand for 15 minutes with \noccasional shaking and add 3 g o£potassium iodide and titrate \nthe liberated iodine withe 0.1 M. sodium thiosulphate using\nstarch solution, added, towards the end of titration as an \nindicator. Carry out a blank titration. '\n1ml of 0.02 Mpotassium permanganate is equivalent to \n0.00345 g of NaNO2.\nStorage,. Store protected ■ from moisture, at a temperature \nbetween 15° to30°. \n.<■ \n-u ,."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-nitroprusside-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Nitroprusside Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Nitroprusside Injection\nsolution pH 4.6. Use three 50-m1 volumetric flasks (A, B, C).\nTo flask B, add 1.0 ml offerricyanide standard solution\nSodium Nitroprusside Injection is a sterile material obtained \nfrom a solution of Sodium Nitroprusside by freeze drying. It \nmay contain excipients. It is filled in a sealed container. \nThe injection is constituted immediately before use by \ndissolving Sodium Nitroprusside Injection in the requisite \namount of Glucose Intravenous Infusion (50 g per litre) and \ndiluting the resulting solution with 250 to 500 times its volume \nof Glucose Intravenous Infusion (50 g per litre). \nStorage. The constituted solution should be used immediately \nafter preparation but, in any case, within the period \nrecommended by the manufacturer. \nSodium Nitroprusside Injection contains not less than \n90.0 per cent and not more than 110.0 per cent of the stated \namount of sodium nitroprusside dihydrate, Na 2Fe(CN)5NO, \n2H20.\n(50 ppm Fe(CN)6) : To flasks A and B, add 1 ml of a 0.5 per cent\nON \n/CN \nNC - Fe- ON\nw/v solution of ferrous ammonium sulphate. To the three \nflasks, add 10.0 ml of the solution of the substance under\nC N \nNat\nNC \\\nexamination. Dilute the contents of each flask to 50.0 ml\nwith water. Allow to stand for 30 minutes. The absorbance of \nthe solution  in flask A measured at 720 nm (2.4.7) using the \nsolution in flask C as the compensation liquid is not more \nthan the absorbance of the solution in flask B measured at \n720 nm using the solution in flask A as the compensation\nNa2[Fe(CN)5N01,2H20 \t\nMol. Wt. 298.0\nSodium Nitroprusside is sodium pentacyanonitrosylferrat e.\nSodium Nitroprusside contains not less than 99.0 per cent \nand not more than 100.5 per cent of  sodium \npentacyanonitrosylferrate (111)-Na 2[Fe(CN)5N0], calculated on \nthe anhydrous basis.\nFliciid\neurroc(2y0a0nPidPem). \ns.Dissolve 4.0 g in 100.0 ml of water. Use three \n50-m1  volumetric flasks (A, B, C). To flask B, add 2.0 ml \nofferrocyanide standard solution (100 ppm Fe(CN) 6). To \nflasks A and B, add 1 ml of  ferric chloride solution.  To the \nthree flasks, add 25.0 ml of the solution of the substance under \nexamination. Dilute the contents of each flask to 50.0 ml with \nwater. Allow to stand for 30 minutes. The absorbance of the \nsolution in flask A measured at 695 nm (2.4.7) using the \nsolution in flask C as the compensation liquid is not more \nthan the absorbance of the solution in flask B measured at \n695 nm using the solution in flask A as the compensation \nliquid (200 ppm).\nCategory. Vasodilator.\nDescription.  A reddish-brown powder or crystals.\nUsual strength. 50 mg per vial. \nThe contents of the sealed container comply with the \nrequirements stated under Parenteral Preparations \n(Powders for Injection) and with the following requirements."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-nitroprusside","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Nitroprusside"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Nitroprusside\nONX /CN\nNC—Fé—CN\nNCZ XCN\nNa2\nNa2[Fe(CN)5NO],2H2O \nMol. Wt. 298.0\nSodium Nitroprusside is sodium pcntacyanon itrosylferrate '■\nSodium Nitroprusside contains not less than 99.0 per cent \nand not more than 100.5 per cent of sodium \npentaçyanonitrosylferrate (l[I)-Na2[Fc(CN)sNO], calculated on \nthe anhydrous basis.\nCategory. Vasodilator. \n/ .\nDescription. A reddish-brown powder or crystals."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-phosphate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Phosphate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Phosphate\n,2HzO\nMol. Wt. 514.4\nRiboflavin Sodium Phosphate is monosodium 3,lO-dihydro-\n7,8-dimethyl-10-[(2S,3S,4R)-2,3,4-trihydroxypentyl]\nbenzo[g]pteridine-2,4-dione 5-phosphate dihydrate.\nRiboflavin Sodium Phosphate contains the equivalent ofnot\nless than 73.0 per cent and not more than 79.0 per cent of\nCI7H2oN406, calculated on the dried basis.\nCategory. B-group vitamin.\nDose. Prophylactic, the equivalent of 1to 4 mg ofriboflavine\ndaily; therapeutic, the equivalent of5 to 10 mg ofriboflavine\ndaily. (1.37 g ofriboflavine sodium phosphate is approximately\nequivalent to·1 g ofriboflavine).\nDescription. A yellow to orange-yellow, crystalline powder;\nhygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-polymannuronate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Polymannuronate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Polymannuronate\nSodium Alginate consists mainly of the sodium salt of alginic \nacid which is a mixture of polyuronic acids [(C6H8O6)n] \ncomposed of residues ofD-mannuronic acid and L-guluronic \nacids and is obtained mainly from algae belonging to the order \nPhaeophyceae.\nCategory. Pharmaceutical aid (viscosity-increasing agent).\nDescription. A cream-coloured to pale yellowish brown \npowder.\nA. Dissolve 0.2 g with shaking in 20 ml of water and to 5 ml of \nthe resulting solution add 1 ml of calcium chloride solution', \na voluminous gelatinous precipitate is produced.\nB. To TO'ini of the solution obtained in test A add 1 ml of\n1 M sulphuric acid’, a gelatinous mass is produced.\nC. To 5 mg add 5 ml of water, 1 ml of a freshly prepared 1 per \ncent w/v solution of naphthalene- 1,3-diol'in. ethanol (95 per\n3593\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-propyl-hydroxybenzoate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Propyl Hydroxybenzoate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Propyl Hydroxybenzoate\nMol. Wt. 202.2\nSodium Propylparaben is the sodium salt ofpropyl\n4- hydroxybenzoate.\nSodium Propylparaben contains not less than 99.0 per cent\nand not more than 102.0 per cent ofCIOHIINa03, calculated on\nthe anhydrous basis.\nCategory. Pharmaceutical aid (antimicrobial preservative).\nDescription. A white, crystalline powder; odourless or almost\nodourless; hygroscopic."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-salicylate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Salicylate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Salicylate\nCOONa\n~OH\nV\nC7HsNa03\nMol. Wt. 160.1\nSodium Salicylate is sodium 2-hydroxybenzoate.\n2134\nwww.webofpharma.com\nIP 2010\nSodium Salicylate contains not less than 99.0 per cent and not\nmore than 101.0 per cent ofC7HsNa03' calculated on the dried\nbasis.\nCategory. Anti-inflammatory; analgesic.\nDose. 500 mg to 2 g, with food; in the treatment of acute\nrheumatism, 5 to 109 daily, in divided doses.\nDescription. Colourless, small crystals or shiny flakes or a\nwhite, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-starch-glycollate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Starch Glycollate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Starch Glycollate\nSodium Carboxymethyl Starch\nSodium Starch Glycollate is the sodium salt of a poly-a-\nglucopyranose in which some of the hydroxyl groups are in\nthe form ofcarboxymethyl ether.\nSodium Starch Glycollate contains not less than 2.8 per cent\nand not more than 4.5 per cent of sodium', Na, calculated on\nthe material washed with Ethanol (95 per cent) and dried as\ndescribed under Assay.\nCategory. Phannaceutical aid (tablet disintegrant).\nDescription. A very fine, white or off-white, free-flowing\npowder; odourless or almost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-stibogluconate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Stibogluconate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Stibogluconate Injection\nSodium Antimony Gluconate Injection v \n|\nSodium Stibogluconate Injection is a sterile solution of Sodium | \nStibogluconate in Water for Injections. Inj ection in multiple | \ndose containers must not contain phenol as preservative, I\nSodium Stibogluconate, injection contains not’less than i \n9.5 per cent w/y and not more than 10.5 per cent w/v of | \npentavalent antimony, Sb. \n-, \n■ |\n■ ■ ■ \n■■ ■ \n■ ■ ■■■■• ■ >> ViV, W:. : g\nUsual strength. The equivalent of 100 mg of pentavalent |\nantimony per ml. ... - \n.. . ■ \n..... -, I\nDescription. A clear, colourless or faintly straw-coloured | \nsolution. \n.. \ng\n.. - . .... . . . . >... ...... - :■ | \n... . ■■■ ■■ , ■ ... .■■. . .■ . . ;■■■..■ .. |\nIdentification ■ \n-ww-- ■. \nI\nA. It is ¿fec/ro-rotatory. \n............ . \n|\nB. Dilute 2 rill to 10 ml with water arid pass hydrogen sulphide | \nthrough thè solution:' no immediate precipitate is;produced. |\nContinue to pass hydrogen sulphide through the solution for | \nseveral minutes; an orange precipitate is produced. ; \n|\nC. The residue obtained'by evaporation to7’ dryness, after | \nincineration, gives the reach ons of anti mony compounds and | \nthe reactions ofsodium salts (2.3.1). \nI\n.-yvo-w, \n.. \nG o «- \n|"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-stibogluconate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Stibogluconate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Stibogluconate\nSodium Antimony Gluconate\nSodium Stibogluconate is mainly the disodium salt of \np-oxy-bis[gluconato(3 )-O2, O2 //-hydraxoanti mony].\nThe method of manufacture is such as to ensurc consistently \ncontrolled reaction stoichiorrietry in order to yield sodium \nstibogluconate that is satisfactory with regard to intrinsic \ntoxicity.\nSodium Stibogluconate contains ridt'less than 30.0 per cent \nand not more than 34.0 per cent of pentavalent antimony, \ncalculated on the dried and methanol-free basis.\nCategory. Antiprotozoal.\nDescription. A colourless, mostly amorphous powder.\nA; Ari aqueous solution is dextro-rotatory.\nB, Pass hydrogen sulphide into a ,5 per centw/v solution for \nseveral minutes; an orange precipitate is produced.\nC. When heated, it chars without melting, emitting an odour \nof burnt sugar and leaving a residue which gives the reactions \nof antimony compounds and the reactions of sodium salts \n(2.3.1). ■ \n/ \n' ■ \n■ \n■ \n■■■' \n■ •’\npH (2.4:24). 5.0 to 5.6, determined in the solution obtained in \nthe test for Stability of solution.\n3627\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-thiosulphate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Thiosulphate Injection"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sodium Thiosulphate Injection\nSodium Hyposulphite Injection\nSodium Thiosulphatc Injection is a sterile solution of Sodium \nThiosulphate in Water for Injections.\nSodium Thiosulphate Injection contains not less than \n95.0 per cent and not more than 105.0 per cent of the stated \namount of sodium thiosulphate, Na-S 203,5H20.\nUsual strength. 100 mg per ml.\nDescription. A clear, colourless solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-thiosulphate","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Thiosulphate"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sodium Thiosulphate\nSodiumHyposulphite\nNa2S203,5H20\nMol. Wt. 248.2\nSodium Thiosulphate contains not less than 99.0 per cent\nand not more than 101.0 per cent ofNa2S203,5H20.\nCategory. Antidote to cyanide poisoning\nDose. By intravenous or intramuscular injection, 300 mg to 1 g.\nDescription. Colourless large crystals or a coarse, crystalline\npowder; odourless; deliquescent in moist air and effloresces\nin dry air at temperature above 33°. It dissolves in its water of\ncrystallisation at about 49°."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-valproate-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Valproate Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Valproate Injection\nSodium Valproate Injection is a sterile aqueous solution of \nsodium valproate, formed from the interaction of valproic acid \nand sodium hydroxide, in Water for Injections, and one or \nmore suitable buffering or sequestering agents.\nSodium Valproate Injection contains sodium valproate \nequivalent to not less than 90:0 per cent and not more than\n110.0 per cent of the stated amohnt of valproic acid, CsHi6O2. \nIt contains no antimicrobial agents.\nUsual strength. 20 mg per ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodium-valproate-oral-solution","@type":"IndexedMonograph","prefLabel":{"en":"Sodium Valproate Oral Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodium Valproate Oral Solution\nSodium Valproate Élixir\nSodium Valproate Oral ‘Solution is a solution of Sodium \nValproate in a suitable flavoured vehicle.\nSodium Valproate Oral Solution contains riot less than \n95.0 per cent andnbt more than 105.0 per cent of the stated \namount of sodium valproate, C8H15NaO2.\nUsual strength. 200 mg in 5 ml."}},{"@id":"https://www.openphar.org/data/ip/monographs/sodiumlhiosulphate","@type":"IndexedMonograph","prefLabel":{"en":"Sodiumlhiosulphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sodiumlhiosulphate\nSodiumHyposulphite\n: \n’ Mol. Wt: 248.2\nSodium Thiosulphate contains not less than 99.0 per cent \nand not more than 101.0 per cent ofNa2S2CA5F12O.\nCategory. Antidote to cyanide poisoning.\nDescription. Colourless large crystals or a coarse, crystalline \npowder; deliquescent in moist air and effloresces in dry air at \ntemperature above 33°. It dissolves in its water of crystallisation \nataboiit49°:"}},{"@id":"https://www.openphar.org/data/ip/monographs/soluble-fluorescein","@type":"IndexedMonograph","prefLabel":{"en":"Soluble Fluorescein"},"edition":"ip-2022","category":"monographs","definition":{"en":"Soluble Fluorescein\nC2OH10Na2O5 \nMol. Wt. 376.3\nFluorescin Sodium is disodium 2-(3-oxo-6-oxido-377-xanthen- \n9-yl)benzoate. ;\nFluorescein Sodium contains not less than 98.5 per cent and \nnot more than 100.5 per cent ofC20HipNa2O5, calculated on the \ndried basis.\nCategory. Diagnostic aid (dye for detection of corneal lesions \nand'foreign bodies).\nDescription. An orange-red powder; hygroscopic.\n2384\nFLUORESCEIN SODIUM\nIP 2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/soluble-saccharin","@type":"IndexedMonograph","prefLabel":{"en":"Soluble Saccharin"},"edition":"ip-2018","category":"monographs","definition":{"en":"Soluble Saccharin\nN - Na , x1-1 20\n0 '0 \n0\nC7H4NNa03S,xH20 \t\nMol. Wt. 205.2\nSaccharin Sodium is the sodium salt of 1,2-benzisothiazol-\n3(211)-3-one 1,1-dioxide.\nSaccharin Sodium contains not less than 99.0 per cent and not \nmore than 101.0 per cent of C 7H4NNa03S, calculated on the \nanhydrous basis.\nCategory. Pharmaceutical aid (sweetening agent).\n-s;-•\nefflorescent in dry air. \nDescription. A white, crystalline powder or colpurscrys s;'\nSAFINAMIDE METHANE SULPHONATE \nSACCHARIN \n11'2018 \t ip 2018\ntemperature not exceeding 40°. With a small quantity of\nand remove the excess of bromine with a sufficient quantity of \nstannous chloride solution AsT. The resulting solution \ncomplies with the limit test for arsenic (2 ppm)."}},{"@id":"https://www.openphar.org/data/ip/monographs/solution-for-irrigation","@type":"IndexedMonograph","prefLabel":{"en":"Solution for Irrigation"},"edition":"ip-2018","category":"monographs","definition":{"en":"Solution for Irrigation\nCompound Sodium Lactate Solution for Irrigation is a sterile \nsolution containing 0.24 per cent v/v of Lactic Acid (equivalent \nto 0.32 per cent w/v of sodium lactate) with 0.6 per cent w/v of \nSodium Chloride, 0.04 per cent w/v of Potassium Chloride and \n0.027 per cent w/v of Calcium Chloride in Water for Injections.\nCompound Sodium Lactate Solution for Irrigation contains \nnot less than 0.27 per cent and not more than 0.32 per cent\nw/v of sodium, Na, not less than 0.019 per cent-6 -nd not more \nthan 0.022 per cent w/v of potassium, K, not less than 0.37 per \ncent and not more than 0.42 per cent w/v of total chloride, Cl,\n- \t -\n-,3226\n1P 2018 \nSODIUM LAURYL SULPHATE \nCOMPOUND SODIUM LACTATE INJECTION \n1 P 2018\nindicator until a reddish yellow colour is produced. Carry out\nB.Mix 0.1 ml of a 1 per cent w/v solution with 0.1 ml of a 0.1 per \ncent w/v solution of methylene blue and 2 ml of 1 Msulphuric \nacid, add 2 ml of dichloromethane and shake; the dichloro-\nmethane layer is intensely blue.\nnot less than 0.025 per cent and not more than 0.029 per cent \nw/v of calcium chloride, CaCl 2,2H20, and not less than \n0.23 per cent and not more than 0.28 per cent w/v of lactate, \ncalculated as C 3H603. It contains no antimicrobial agent.,(041\na blank titration.\nml of 0.1 Msilver nitrate is equivalent to 0.003545 g of total \nchloride, calculated as Cl.\nC. Mix about 10 mg with 10 ml of ethanol and heat to boiling \non a water-bath, shaking frequently. Filter immediately and \nevaporate the ethanol. Dissolve the residue in 8 ml of water, \nadd 3 ml of  2 M hydrochloric acid, evaporate the solution to \nhalf its volume and cool. Filter and to the filtrate add 1 ml of \nbarium chloride solution; a white, crystalline precipitate is \nproduced.\nFor kw/ate-Determine by liquid chromatography (2.4.14).\nCategory. Irrigation fluid.\nTest solution. The preparation under examination.\nDescription. A clear, colourless solution.\nReference solution. A 0.28 per cent w/v solution of lithium \nlactate RS in the mobile phase."}},{"@id":"https://www.openphar.org/data/ip/monographs/solution","@type":"IndexedMonograph","prefLabel":{"en":"Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Solution \n(CCS) \n- \n(FCS) \n> \nCSS) \nYellow-brown 02 \n12 \nRG\nPink-red. \nsia 10. pin Tyne \ncar \n9.0: \nGreen-blng ©) \noe \n20-20 \nBOF \nViolet \nhg \n68400\nThe test solution is not more intensely coloured than the \nappropriate refereace solution.\nSterility (2.2.11). Complies with the'test for sterility.”\nStorage. Store protected from light and heat. \n—\nLabelling. The label states (1) The gauge number; Q the \niength in centimetres or in metres; ‘By where appropriate, that\nthe strand \ni is coloured and intended to remain SO during us \nuse.\nSterile Poly (Ethylene Terephthalate) —\n \nwww.webofpharma.com\nSuture in Distributor\nSterile Poly (Ethylene Terephthalate) Suture in Distributor for\nveterinary use is obtained by drawing poly (ethylene \nterephthalate) through a suitable die. The. sutureris: prepared \nby braiding very fine filaments in suitable numbers, depending\non the gauge required. \nIt may be' whitish in colour, or may be” \n“coloured with authorised, colouring’ matter or pigments\nauthorised iby. the competent authority. The sutureis sterilised.\n* Description. ‘It is practically insoluble i in most of thie usual \n“Organic solvents, but is attacked by strong: alkaline solutions.\n: It is incompatible with phenols. \n: \n:\n_, [dentification\npo \nA. It dissolves with difficulty when heated in dimethyl.\n' formamide. and in dichlorobenzene. \n:\n4 B. To 50 mg add 10 mi of, hydrochlorie acid. The material\n~ remains intact even after i immersion for 6 hours. \n‘\nTt complies with the tests” prescribed in the monograph on \n\"Sterile Non- ‘absorbable. ‘Strands in distributor. \nFig:1: Simple ‘knot\n  Storage. Store protected from light and‘heat._\nIP 2022 \nSTERILE POLYAMIDE 6/6 SUTURE, IN DISTRIBUTOR\nLabelling. The label states (1) The gauge number; (2) the \nlength in centimetres or in metres; (3) where appropriate, that \nthe strand is coloured and intended to remain so during use.\nSterile Polyamide 6 Suture in \nDistributor\nSterile Polyamide 6 Suture in Distributor for veterinary use is \nobtained by drawing through a suitable die a synthetic plastic \nmaterial formed by the polymerisation of caprolactam. \nIt \nconsists of smooth, cylindrical monofilaments or braided\nfilaments, or lightly twisted strands sheathed with the same \nmaterial. It may be coloured with colouring matter authorised \nby the competent authority. The suture is sterilised.\nDescription. It is practically insoluble in the usual organic\nsolvents, it is not attacked by dilute alkaline solutions (for \nexample 10 per cent solution of sodium hydroxide) but is \nattacked by dilute mineral acids (for example 2.0 per cent\nsulphuric acid), by hot glacial acetie acid and by 70 per cent \nm/m formic acid."}},{"@id":"https://www.openphar.org/data/ip/monographs/somatropin-for-injection","@type":"IndexedMonograph","prefLabel":{"en":"Somatropin for Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Somatropin for Injection\nSomatropin for Injection is a freeze-dried, sterile preparation \nofa protein having the structure (191 amino-acid residues) of \nthe major component of growth hormone produced by the \nhuman pituitary.\nSomatropin for Injection contains not less than 89 per cent \nand not more than 105 per cent of the stated potency. By \nconvention, for the purpose of labelling of somatropin \npreparations 1 mg of anhydrous somatropin is equivalent to \n3.0 IU of biological activity.\nSomatropin for Injection is prepared either from somatropin or \nfrom somatropin concentrated solution, or by a method based \non recombinant DNA (rDNA) technology in which the \ninjectable preparation is produced without the isolation of an \nintermediate solid or liquid bulk. In the later case, during the \ncourse of product development, it must be demonstrated that \nthe manufacturing process produces a product having a \nbiological activity of not less than 2.5 IU per mg, using a \nvalidated bioassay based on growth promotion and approved \nby the competent authority. The purified preparation, to which \nbuffers and stabilizers may be added, is filtered through a \nbacteria-retentive filter, aseptically distributed in sterile \ncontainers of glass type I (6.2.1) and freeze-dried. The \ncontainers are immediately sealed so as to exclude microbial \ncontamination and moisture.\nUsual strength. 5 mg (15 IU), 6 mg (18 IU), 10 mg (30 IU) and\n12 mg (36 IU).\nHost cell derived proteins (HCP). Not more than 100 ppm.\nHost cell or vector derived DNA. Not more than 10 ng per \ndose.\nDescription. White or almost white powder"}},{"@id":"https://www.openphar.org/data/ip/monographs/sorbic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Sorbic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sorbic Acid\nh3c^^cooh\nC6H8O2 \nMol. Wt 112.1\nSorbic Acid is (2/?,4A)-hexa-2,4-dienoic acid. ) t; .y\nSorbic Acid contains not less than 99.0 per cent and not more \nthan 101.0 per cent of C(;H8O2, calculated on the anhydrous \nbasis.\nCategory. Pharmaceutical aid (antimicrobial preservative).\nIdentification-' •••• \n'■-\n*\nDescription. Awhite or almost white, crystalline powder.\nTest A may be omitted if tests B and C are carried out. Tests 5\nand C may be omitted if test A is carriedout. ! 1 '■ 1 :\nA. Determine by infrared absorption spectrophotometry (2.4-O- \nCompare the spectrum with:-that obtained - with’ sorbic \nIPRS or With the reference spectrum of sorbic acid: ’ “ ;, ; /\nB. Dissolve 50 mg in sufficient water to producc 250 nil ^rd \ndilute 2 ml of the solution to 200 ml with 0.1 M hydrochloric\nacid. \n■■ \n'.rodp\n3646\nwww.webofpharma.com\nSORBITAN. OLEATE\nIP2Q22................. _...................................................................\nexamined in the range 230 nm to 360 nm (2.4.7), the\n1 * e solution shows an absorption maximum at about \n^^fedbancoatabout 264 nm,-.0.43.to 0.51.\nDissOIve0.2g in 2 ini of ethanol (95 per cent) and add \n0 7 mlj \nwater, the solution is decolorised."}},{"@id":"https://www.openphar.org/data/ip/monographs/sorbitan-oleate","@type":"IndexedMonograph","prefLabel":{"en":"Sorbitan Oleate"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sorbitan Oleate\nH 0 \t\nOH\nC 1 7 Fl 33 )\nOH\nC24H4406 \t\nMol. Wt. 428.6\nSorbitan Oleate is mixture usually obtained by esterification \nof 1 mole of sorbitol and its mono-and di- anhydrides per mole \nof oleic (cis-9-octadecenoic) acid. A suitable antioxidant may \nbe added.\nNOTE-When sorbitan mono-oleate is demanded, Sorbitan\nOleate shall be supplied.\nCategory. Pharmaceutical aid.\nDescription. A brownish-yellow, viscous liquid."}},{"@id":"https://www.openphar.org/data/ip/monographs/soyabean-oil","@type":"IndexedMonograph","prefLabel":{"en":"Soyabean Oil"},"edition":"ip-2022","category":"monographs","definition":{"en":"Soyabean Oil\nSoyabean Oil is a fixed oil obtained from the seeds of Glycine \nsoja Sieb. and Zucc. and Glycine max(L) Merr. (G. hispida \n(Moench) Maxim.) by extraction and subsequent refining; it \nmay contain a suitable antioxidant. !f. \n, ... .\nCategory. Pharmaceutical aid.\nDescription. A clear, pale-yellow coloured liquid, with a bland \ntaste that solidifies at-10° to-16°. \n; \n,"}},{"@id":"https://www.openphar.org/data/ip/monographs/special-reagents","@type":"IndexedMonograph","prefLabel":{"en":"Special Reagents"},"edition":"ip-2018","category":"monographs","definition":{"en":"Special Reagents\n, All-trans-Vitamin A Acetate\nDescription. A white to very yellow, free flowing crystals.\nSolubility. Very soluble in ethanol (95 per cent) in chloroform, \nin ether, in light petroleum, in fats and in fixed oils; practically\ninsoluble in water.\nLight absorption. Absorbance of a 0.0003 per cent w/v \nsolution in 2-propanol at about 325 nm, not less that 0.458, in \n(•elohexane at about 327.5, not less that 0.455 and in ethanol \nat about 326 nm, not less than 0.464 (2.4.7).\nMelting range. 57° to 60° (2.4.21). \t \")r.\nRelative absorbance. Measure the absorbancc,.(2.4.7), of a \n0.0003 per cent w/v solution cvc/ohexane at about 327.5 nm\n2.3.41. ASSAY OF VITAMIN A \t\nIP 2018\nW 2018 \t\n2.3.42. ASSAY OF VITAMIN D\nand at the following wavelengths. The relative absorbances, \ncalculated with reference to the absorbance at about 327.5 nm, \nare within the limits stated in Table 2.\nElute the column with 2,2,4-trimethylpentane, adjusting the \nrate of flow from the bottom of the column to 2 to 3 ml per \nminute and collect successive 5 ml fractions of the eluate. \nMeasure the absorbance of each fraction at the maximum at \nabout 263 nm and there from determine the position, relative \nto volume of eluate, at which the elution of ergocalciferol \nbegins and finishes.\n2.3.42. Assay of Vitamin D\nThe assay should be completed promptly and care should be \ntaken throughout the procedure to keep to a minimum the \nexposure to air and to actinic light by the use of inert gas and \nlow actinic glassware. All the operations should be carried \nout in subdued light.\nTable 2\nWavelength\nRelative \nabsorbance\n(nm)\n300 \n0.545 to 0.565\nColumn No. 2. Mix 5 g of adsorbent with sufficient 2,2, \n4-trimethylpentane to form a slurry and transfer the slurry to \nthe chromatograph tube. Pack the tube carefully with the aid \nof glass plunger and discard the eluate.\nSpecial Reagents\n312.5 \n0.845 to 0.865\nAdsorbent: A chromatographic grade of kaolin such as Florex \nXXS or of fuller's earth having a water content corresponding \nto not less than 8.5 per cent and not more than 9.0 per cent of \nloss on drying at 105° for 6 hours.\n337.5 \n0.845 to 0.865\n345 \n0.685 to 0.705 \n360 \n0.290 to 0.310\nProcedure\nWeigh accurately a quantity of the substance under \nexamination equivalent to about 400 Units of vitamin D. For \ncapsules, the mixed contents of 20 capsules may be used as \nthe sample. Add 10 ml of a freshly prepared 0.01 per cent w/v \nsolution of butylated hydroxytoluene in ethanol (95 per cent),\nNOTE -Adjust the water content, if necessary, by drying in \nvacuum at room temperature, restoring the water required \nand equilibrating by shaking for 2 hours.\nProcedure\nWeigh accurately a quantity of the substance under \nexamination containing not less than 500 Units of vitamin A \nand not more than 1 g of fat. Add about 50 mg of hydroquinone, \n30 ml of ethanol and 3 ml of a 50 per cent w/v solution of \npotassium hydroxide. Boil gently under a reflux condenser in\nStandard preparation of vitamin D. Dissolve 0.01 g of \nergocalciferol RS or cholecalciferol RS (for assaying \nsubstances labelled to contain Vitamin D as ergocalciferol or \nas cholecalciferol respectively) in sufficient purified\n15 ml of a 50 per cent w/v solution of potassium hydroxide \nand 5 ml of ethanol (95 per cent). Reflux on a water-bath for \n30 minutes, cool, transfer the solution to a separator with the \naid of 50 ml of water, add 75 ml ether and shake vigorously. \nAllow to separate, transfer the aqueous layer to a second \nseparator and extract with three successive quantities, each \nof 30 ml, of ether, adding each ethereal extract to the liquid in \nthe first separator and finally discarding the aqueous solution.\na stream of oxygen free nitrogen for 30 minutes, cool rapidly \nand add 30 ml of water. Transfer to a separator with the aid of \nthree quantities, each of 50 ml, of ether and extract the vitamin \nA by shaking for 1 minute. After complete separation discard \nthe aqueous layer and wash the extract with fou"}},{"@id":"https://www.openphar.org/data/ip/monographs/specific","@type":"IndexedMonograph","prefLabel":{"en":"Specific"},"edition":"ip-2018","category":"monographs","definition":{"en":"Specific\nji\nRelated substances. Determine by I iquid chromatography\nCategory. Antiinflammtory; immunosuppressant.\nLoss on drying (2.4.19). Not more than 0.5 per cent, determined \non 1.0 g by drying in an oven at 105°.\nDose. 5 to 60 mg daily, in divided doses.\n4111i\nNOTE -Prepare the solutions immediately before use.\nN(2 OA 4\nDescription. A white or almost white, crystalline powder.\nSolvent mixture.  Equal volumes of acetonitrile and buffer \nsolution pH 4 prepared by mixing 1 volume of dilute \nhydrochloric  acid, 5 volumes of a 6.81 per cent w/v solution \nof sodium  acetate, 15 volumes of a 3.73 per cent w/v solution \nof potassium  chloride and 79 volumes of water.\nAssay. Dissolve 0.1 g in 100.0 ml of ethanol (95 per cent). \nDilute 2 ml of this solution to 100 ml with the same solvent. \nMeasure the absorbance at the maximum at about 243 nm \n(2.4.7). Calculate the content of C 23H3006 taking 370 as the \nspecific absorbance at 243 nm."}},{"@id":"https://www.openphar.org/data/ip/monographs/specificity","@type":"IndexedMonograph","prefLabel":{"en":"Specificity"},"edition":"ip-2018","category":"monographs","definition":{"en":"Specificity\nAnti-B \n(Monoclonal)\nA l\nNegative\nA, B\nPotency. It is defined as the reciprocal of the greatest reagent \ndilution for which the reaction is graded at 1+. Anti-B \nMonoclonal Blood Grouping Reagent should have an average \npotency value greater than or equal to that of the reference \npreparation.\nPositive \nPositive \nNegative\nB"}},{"@id":"https://www.openphar.org/data/ip/monographs/spectinomycin-hydrochloride","@type":"IndexedMonograph","prefLabel":{"en":"Spectinomycin Hydrochloride"},"edition":"ip-2010","category":"monographs","definition":{"en":"Spectinomycin Hydrochloride\n,2HCI,5HzO\nMol. Wt. 495.4\n2687\nSPECTINOMYCIN HYDROCHLORIDE\nSpectinomycin Hydrochloride is [2R-\n(2a,4a~,5a~,6~, 7~,8~,9a,9aa, 1Oa~)]-decahydro-4a,7,9-\ntrihydroxy-2-methyl-6,8-bis(methylamino)-4H-pyrano[2,3-b]\n[1,4]benzodioxin-4-one dihydrochloride pentahydrate.\nSpectinomycin Hydrochloride contains not less than 95.0 per\ncent and not more than 100.5 per cent of CI4H24N207,2HCl,\ncalculated on the anhydrous basis.\nCategory. Antibacterial.\nDose. Large farm animals and poultlY. By intramuscular or\nintravenous injection, the equivalent of 10 to 20 mg of\nspectinomycin per kg ofbody weight daily.\n(Each 30 mg ofspectinomycin hydrochloride is approximately\nequivalent to 20 mg ofspectinomycin).\nDescription. A white or almost white, crystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/spectinomycin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Spectinomycin Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Spectinomycin Injection\nSpectinomycinHydrochloride Injection\nSpectinomycin Injection is a sterile material consisting of\nSpectinomycin Hydrochloride with or without auxiliary\nsubstances. It is filled in a sealed container.\nThe injection is constituted by suspending the contents of\nthe sealed container in the requisite amount of sterile Water\nfor Injections, immediately before use.\nStorage. The constituted suspension should be used\nimmediately afterpreparation but, in any case, within the period\nrecommended by the manufacturer.\nSpectinomycin Injection contains not less than 90.0 per cent\nand not more than 110.0 per cent the stated amount of\nspectinomycin, CJ4Hz4Nz07.\nThe contents of the sealed container comply with the\nrequirements stated under Parenteral Preparations\n(Powders for Injection) and with thefollowing requirements.\nUsual strength. Equivalent of2 g ofspectinomycin.\nDose. Allspecies except adult ruminants. 50 to 100 mg per kg\nof body weight."}},{"@id":"https://www.openphar.org/data/ip/monographs/spectrometry","@type":"IndexedMonograph","prefLabel":{"en":"Spectrometry"},"edition":"ip-2022","category":"monographs","definition":{"en":"Spectrometry\nInductively Coupled Plasma Spectrometry is a plasma-based \ninstrumental technique, which is useful for pharmaceutical \nanalyses. The inductively coupled plasma (ICP) is a high- \ntemperature excitation source that desolvates, vaporizes, and \natomizes aerosol samples and ionizes the resulting atoms. The \nexcited analyte ions and atoms can then subsequently be \ndetected by observing their emission lines, a method termed \ninductively coupled plasnja-atomic emission spectroscopy \n(ICP-AES; also referred to as inductively coupled plasma' \noptical emission spectroscopy (ICP-OES)), or the excited or \nground state ions can be determined by a technique kndwn as \ninductively coupled plasma-mass spectrometry (ICP-MS). ICP- ■ \nAES and ICP-MS may be used for either single- or multi-element\nanalysis and used for either sequential or simultaneous \nanalyses with good sensitivity over an extended linear range.\nInductively Coupled Plasma-Mass Spectrometry\nInductively. Coupled Plasma-Mass Spectrometry (ICP-MS) is . \na mass spectrometry method that uses an inductively coupled \nplasma (ICP) as the high-temperature excitation source that \ndesolvates, vaporizes, and atomizes aerosol samples and \nionizes the resulting atoms: ICP-MS utilizes the ability ofthe \niCBto generate charged ions from the element species within \na, sample. These ions are then directed into a mass \nspectrometer, which separates them according to their mass- \nto-charge ratio (m/z). Most mass spectrometers have a\nquadrupole system or a magnetic sector. Ions are transported \nfrom the plasma through 2 cones (sampler and skimmer, cones, \nforming the interface region) tothe ion optics. The ion optics\n333\nwww.webofpharma.com\nconsist of an electrostatic lens, which takes ions from an area \nat atmospheric pressure to the-mass filter at.a vacuum of 10-8 \nPa or less, maintained with a turbo molecular pump. After their \nfiltration, ions of the selected mass/charge ratio are directed \nto a detector (channel electromultiplier, Faraday cup, dynodes), \nwhere ion currents are converted into electrical signals. The \nelement is quantified according to the number of ions arriving \nand generating electrical pulses per unit time.\nApparatus\nInductively coupled plasma-mass spectrometer (ICP-MS) \nconsists of sample-introduction system with peristaltic pump \nfor delivering the solution at constant flow rate into a nebuliser, \nradio-frequency (RF) generator, plasma torch, interface region \nincluding cones to transport ions to the ion optics, mass\nspectrometer, detector and a data-acquisition unit..\nInterference\nThe prime characteristic of an ICP-MS instrument is its \nresolution, i.e. the efficiency of separation of two close masses. \nQuadrupole instruments are, from this point of view, inferior \nto magnetic-sector spectrometers. Mass interference is the \nmajor problem, for example by isobaric species that \nsignificantly overlap the mass signal of the ions of interest, \nespecially in the central part of the mass range (for example \n40-80 a.m.u.). .The combination of atomic ions leads to \npolyatomic or molecular interferences (i.e.40Ar, KO with 56Fe \nor \"Ar,40Ar with S0Se). Matrix interference may also occur \nwith some analytes. Some samples have an impact on droplet \nformation or on the ionization temperature in the plasma, These \nphenomena may lead to the suppression of analyte signals. \nPhysical interference is to .be, circumvented by using the \nmethod of internal standardization or by standard addition,. \nThe element used as internal standard depends on the element \nto be measured: 59Co and 1 l5In, for example, can be used:as. \ninternal standards. \n,\nProcedure\nSample Preparation\nSample preparation is critical to the success of plasma-based \nanalysis and is the first step in performing any analysis via \nICP-MS. The most conventional means by which samples are \nintroduced into the plasma is via solution nebulization.' \nSamples may be dissolved in any appropriate solvent. There \nis a strong pr"}},{"@id":"https://www.openphar.org/data/ip/monographs/spectroph","@type":"IndexedMonograph","prefLabel":{"en":"Spectroph"},"edition":"ip-2018","category":"monographs","definition":{"en":"Spectroph\nCategory. Pharmaceutical aid (solvent).\n4\nsolution of redistilled acetaldehyde in aldehyde-free ethanol \n(95 per cent).\nBenzene and related substances. Determine by gas \nchromatography (2.4.13).\nTest solution. The substance under examination.\nReference solution (a). A 0.1 per cent v/v solution of \n2-butanol reagent in the test solution.\nReference solution (b). A solution containing 0.1 per cent v/v \neach of 2-butanol reagent and 1-propanol in the test solution.\nReference solution (c). A 0.0002 per cent v/v solution of \nbenzene in the test solution.\nChromatographic system\n-\na glass column 1.8 m x 2 mm, packed with acid-washed \ndiatomaceous support (80 to 100 mesh) coated with 15 \nper cent w/w of polyethyelene glycol 400, \n-\ntemperature: \ncolumn. 50°, \ninlet port. 150°, \n-\nflame ionisation detector at 250°, \n-\nflow rate: 30 ml per minute, using nitrogen as the carrier \ngas.\nInject separately 2µl of each of the test solution and reference \nsolution (a). The chromatogram obtained with the test solution \nshows no peak with a retention time similar to the peak due to \n2-butanol (retention time relative to isopropyl alcohol, about \n1.5) obtained with reference solution (a). Inject 21.tlof reference \nsolution (b) and adjust the sensitivity of the system so that \nthe heights of the peaks due to 2-butanol and propanol in the \nchromatogram obtained with reference solution (b) are not \nless than 50 per cent of the full scale of the recorder.\nThe test is not valid unless the resolution between the peaks \ndue to 2-butanol and propanol in the chromatogram obtained \nwith reference solution (b) is at least 1.2.\nInject 2 p.1 each of reference solution (c) and the test solution. \nThe area of any peak due to benzene in the chromatogram \nobtained with the test solution is not greater than the difference \nbetween the area of the peak due to benzene in the \nchromatogram obtained with reference solution (c) and that \nof the peak due to benzene in the chromatogram obtained \nwith the test solution.\nIn the chromatogram obtained with reference solution (a) the \nsum of the areas of any peaks other than the principal peak \nand the peaks due to 2-butanol is not greater than 3 times the \narea of the peak due to 2-butanol (0.3 per cent).\nFusel oil constituents. Place 25 ml in a porcelain dish protected \nfrom dust and allow the liquid to evaporate-on-a water-bath \nuntil a little of the liquid remains. Remove tote dish from the \nwater-bath and allow the liquid to eva0 -rate at room\n1? 201 8 \nETHANOL \nIP 2018 \nETHANOLAMINE\ntemperature till the dish is almost dry. No foreign odor II is \nperceptible. Add 1 ml of sulphuric acid; no red or broom \n \ncolour is produced.\nmore than 0.2 ml of 0.1 Msodium hydroxide to produce a pink\n2-butanol (retention time relative to isopropyl alcohol, about \n1.5) obtained with reference solution (a). Inject 2µl of reference \nsolution (b) and adjust the sensitivity of the system so that \nthe heights of the peaks due to 2-butanol and propanol in the \nchromatogram obtained with reference solution (b) are not \nless than 50 per cent of the full scale of the recorder.\nNc°1el°tIlhianol. To 1 drop add 1 drop of water, I drop of dilute \nphosphoric acid and 1 drop of potassium permanganate \nsolution. Mix, allow to stand for 1 minute and add sodium \nbisulphite solution dropwise until the permanganate colour\nNon-volatile matter. Evaporate 100.0 ml in a tared dish on a\n water-bath and dry the residue at 105°; the residue \nweighs not \nmore than 5 mg.\nis discharged. If a brown colour remains, add 1 drop of dilute \nphosphoric acid. To the colourless solution add 5 ml of freshly\nThe test is not valid unless the resolution between the peaks \ndue to 2-butanol and propanol in the chromatogram obtained \nwith reference solution (b) is at least 1.2.\nAssay. Determine at 25° the relative density (2.4.29) \ncalculate from the Alcohol Table the content of C 2H60 at 15.56°.\nand\nprepared chromotropic acid solution and heat on a water-\nbath at 60° for 10 "}},{"@id":"https://www.openphar.org/data/ip/monographs/spectrophotometer","@type":"IndexedMonograph","prefLabel":{"en":"Spectrophotometer"},"edition":"ip-2018","category":"monographs","definition":{"en":"Spectrophotometer\nctrophotometer set at 254 nm and at 300 nm for reference\nNOTE - Prepare the solution immediately before use. \n-9\nC H,H 12CINO, \t\nMol. Wt. 213.7\nTest solution. Dissolve 0.1 g of the substance uncler \nexamination in 50.0 ml of the mobile phase. \nRef*nce so lion (a). Dissolve 20 mg of bacitracin zinc RS\nt \nInject referencesolution (b) and the test solution. In the \nchromatogram \ntogram obtained with the test solution, the area of \npeak\no\nBaclofen is (RS)-4-amino-3-(4-chlorophenyl)butyric acid.\n due\nto bacitracin impurity E is not more than - 1.2 times the \nhe peak in the chromatogram obtained with reference\nBack)fen -contains not less than 98.0 per cent and not more \nthan 101 ..0 per cent of C l0H l2CINO2, calculated on the \nanhydrous 'basis.\narea f \nsolution\nin wirker, add -01 ml of dilute hydrochloric acid and dilute to\n(b) (6.0 per cent).\nm ltth water\nCategory. Muscle relaxant.\nDose. 15 mg per day; maintenance dose is 30 to 75 mg daily.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/spiramycin","@type":"IndexedMonograph","prefLabel":{"en":"Spiramycin"},"edition":"ip-2022","category":"monographs","definition":{"en":"Spiramycin\nH.C. \nHef \n6°\nGH,\nCasHayN2Oy4 \nMol. Wt. 843.1\nSpiramycin is (4R,58,6R,7R,9R,10R,11E,13£,16R)-10--\n{[(22,55S,6R)-5-(Dimethylamino)-6- methyltetrahydro-2H- \npyran-2-yl]oxy}-9,16-dimethyl-5- -methoxy+2-oxo- -7-(2- \noxoéthyl)oxacyclohexadeca- 11, 13-dien+ 6-y1-3,6:dideoxy-4-O-\n(2,6-dideoxy-3-C’methyl-a-Zribo- -hexopyranosy!)- -3- \n(dimethytamino}- t- 5-glucopyranoside. \n.\nSpiramiycin contains not less than 3900 Units; sper me, calculated\non the, dried basis. \n: \nCony\nCategory. Antibacierial.\nDescription. A white « or slightly velo \npowder sight \nhygroscopic.\n- \nIdentification. \n|\nA. When examined ‘iin the range 220 im to’360 nm (2.4.7), a’\n0.001 per'cent wiv solution in methinol shows atv absorption \nmaximum only at about 2321 nm; absorbance at ‘about 232 nm,\nabout 0:34: \n7\n4923\nwww.webofpharma.com\nSPIRAMYCIN:\nIP 2022:\nB: Dissolve 0.5 g in a mixture of 10 ml of 0.05.M sulphuric \nacid and 25 ml of water. Adjusted to pH 8.0 with: 0.1 Msodium \nhydroxide \nand dilute: :to.: 50..ml: with \nwater. \nTo\n5 ml of the resulting solution add 2 mi of a.mixture of I.volume \nof water and 2. volumes of i sulphuric acid, a brown colour i Is, \nproduced."}},{"@id":"https://www.openphar.org/data/ip/monographs/spironolactone","@type":"IndexedMonograph","prefLabel":{"en":"Spironolactone"},"edition":"ip-2010","category":"monographs","definition":{"en":"Spironolactone\no\nMol. Wt. 416.6\nSpironolactone is 7a-acetylthio-3-oxo-17a-pregn-4-ene-\n21,17~-carbolactone.\nSpironolactone contains not less than 97.0 per cent and not\nmore than 102.0 per centofC24H320 4S, calculated on the dried\nbasis.\nCategory. Diuretic.\nDose. 100 to 200 mg daily, in divided doses.\nDescription. A yellowish white to buff coloured powder;\nodourless or with a slight odour ofthioacetic acid. It exhibits\npolymorphism."}},{"@id":"https://www.openphar.org/data/ip/monographs/standard-preparation","@type":"IndexedMonograph","prefLabel":{"en":"Standard Preparation"},"edition":"ip-2022","category":"monographs","definition":{"en":"Standard Preparation\nThe Standard Preparation is the 1 st International Standard for \nTuberculin, purified protein derivative (PPD), mammalian, \nestablished in 1951, consisting of PPD derived from cultures \nof M. tuberculosis (supplied in ampoules containing 5,00,000 \nUnits) or another suitable preparation the potency of which \nhas been determined in relation to the International Standard."}},{"@id":"https://www.openphar.org/data/ip/monographs/stavudine-oral-solution","@type":"IndexedMonograph","prefLabel":{"en":"Stavudine Oral Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Stavudine Oral Solution\nStavudine Oral Solution is a mixture consisting of Stavudine \nwith buffering agents and other excipients. It contains a \nsuitable flavouring agent. It is filled in a sealed container.\nThe oral solution.is constituted by dispersing the contents of \nthe sealed container, in the specified volume of water just \nbefore issue. \n< ■:.\nStavudine Oral Solution contains not less than 90.0 per cent \nand not more than 110.0 per cent of the stated amount of \nstavudine C10Hi2N2O4.\nThe constituted solution, when stored at the temperature and \nfor the period stated on the label during which it may\" be \nexpected to be satisfactory for use, contains not less than \n90.0 per cent of the stated amount of stavudine, Ci0H12N2O4.\nUsual strength. 1 mg per ml.\nThe contents of the sealed container comply with the \nrequirements stated under Oral Liquids and’with the \nfollowing requirements.\nIn the Assay, the principal peak in the chromatogram obtained \nwith the test solution corresponds to the peak in the \nchromatogram obtained with reference solution (a). .\n3657\nwww.webofpharma.com"}},{"@id":"https://www.openphar.org/data/ip/monographs/stavudine","@type":"IndexedMonograph","prefLabel":{"en":"Stavudine"},"edition":"ip-2010","category":"monographs","definition":{"en":"Stavudine\nMol. Wt. 224.2\nStavudine is 2',3'-didehydro-3'-deoxythymidine.\nStavudine contains not less than 98.0 per cent and not more\nthan 102.0 per cent of CIOH 12Nz0 4, calculated on the dried\nbasis.\nwww.webofpharma.com\nSTAVUDINE\nCategory. Antiretroviral.\nDose. 30 to 40 mg twice daily depending on body weight of\nthe patient.\nDescription. A white or almost white powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/stearic-acid","@type":"IndexedMonograph","prefLabel":{"en":"Stearic Acid"},"edition":"ip-2022","category":"monographs","definition":{"en":"Stearic Acid\nStearic Acid consists of a mixture of fatty acids, chiefly stearic \nacid (CiafI36O2) and palmitic acid (C|6H32O2). It may contain a \nsuitable antioxidant.; :L '■■■ '■ \n: \n; ; - -\nStearic Acid contains not less than 40.0 per cent of Ci8H36O2 \nand the sum ofthe contents of.CiaH36O2 and Ci6H32O2 is not \nless than 90.0 per cent. '\nCategory.. Pharmaceutical aid (tablet lubricant;.^emulsion \nadjunct). \n¡ \nî-ww-wwww.\n........................................ . ........... ' .........................   G*20$\nDescription. A white powder or white, greasy, flaky crystal \nor hard masses showing signs of crystallisation..\n. i :... Vj Hu * ; íj"}},{"@id":"https://www.openphar.org/data/ip/monographs/stearyl-alcohol","@type":"IndexedMonograph","prefLabel":{"en":"Stearyl Alcohol"},"edition":"ip-2022","category":"monographs","definition":{"en":"Stearyl Alcohol\nStearyl Alcohol is a mixture of solid alcohols consisting chiefly \nof 1-octadecanol, (C18H38O).\nStearyl Alcohol contains not less than 95.0 per cent of C?8H3SO.\nCategory,. Pharmaceutical aid (stiffening agent).\nDescription. ^ white, unctuous mass or almost white flakes or \ngranules.\nStilboestrol\nTeStS;¿::;.;;.; ...\nDiethylstilboestrol\nAppearance of solution. Dissolve 0.5 g in 20 ml of ethanol \n(95 per cent) bySeating to boiling and allow to cool. The\nsoliítíón is clear (2.4.1), arid not more intensely coloured than \nreference solution BS6 (2.4.1). ’\nMelting range (2.4.21). 55° to 60°.\nAdd value (2.3.23). Not more than 2.0.\nHydroxyl value (2.3.27). 195 to 220. . \n.\nIodine value (2.3.28). Not more than 2.0 (iodine bromide \nW^pí#¿detepnined on 2.0 g dissolved in 25 ml of chloroform, \nWarmingiifnecessary to:effect solution.;:\nSaponification Valúe (2,3.37). Not more than 2.0, determined \nonlO.Og. '• - ■: \n; ■\nDetermine by gas chromatography (2.4.13).\nTest solution. Dissolve 0.1 g of the substance Under"}},{"@id":"https://www.openphar.org/data/ip/monographs/step-1","@type":"IndexedMonograph","prefLabel":{"en":"Step 1"},"edition":"ip-2018","category":"monographs","definition":{"en":"Step 1\n(Activated) Factor V III. FactorIXa, phospholitid, Ca -- \nFactor X \t\n> Factor Xa\nStep 2. Terminate the activation by the addition of aprewarmed \nreagent containing a chromogenic substrate. Quantify the \nrate of substrate cleavage, which must be linear with the \nconcentration of factor Xa formed, by measuring the \nabsorbance change at an appropriate wavelength using a \nspectrophotometer, either monitoring the absorbance \ncontinuously, thus allowing the initial rate of substrate cleavage \nto be calculated, or terminating the hydrolysis reaction after a \nsuitable interval by lowering the pH by the addition of a \nsuitable reagent, such as acetic acid (50.0 per cent w/v C 2H4O2) \nor a citrate solution (1 mol per litre) at pH 3. Adjust the \nhydrolysis time to achieve a linear deveropmeiff .\nStep 2\nChromogenic substrate \t\nFactor Xa \t> Peptide + C'hroinophore\nFigure 2.\nBoth steps employ reagents that may be obtained commercially \nfrom a variety of sources. Although the composition of \nindividual reagents may be subject to some variation, their \nessential features are described in the following specification. \nDeviations from this description may be permissible provided \nthAt it has been shown, using the International Standard for \nlitigtai 'blood coagulation factor VIII concentrate as the\n chromophore with time Appropriate hydrolyis times are \nusually between 3 to 15 minutes, but deviations i„ble\narch., that the results obtained do not differ significantly.\nIt is important to demonstrate by validation the suitability of \nthe kit used, notably by checking the time course of factor Xa \ngeneration in order to determine the time taken to reach \n50.0 per cent of the maximal factor Xa generation.\nReagents. The coagulation factor reagent comprises purified \nproteins derived from human or bovine sources. These include \nfactor X, factor IXa, and a factor VIII activator, usually \nthrombin. These proteins are partly purified, preferably to at \nleast 50.0 per cent, and do not contain impurities that interfere \nwith the activation of factor VIII or factor X. Thrombin may be \npresent in its precursor form prothrombin, provided that its \nactivation in the reagent is sufficiently rapid to give almost \ninstantaneous activation of factor VIII in the assay. \nPhospholipid may be obtained from natural sources or be \nsynthetically prepared, and must, to a substantial extent, \nconsist of the species phosphatidylserine. The components \nof the complete reagent are usually divided into at least 2 \nseparate reagents, each lacking the ability to generate factor \nXa on its own. One of the reagents contains calcium ions. \nAfter reconstitution, the reagents may be combined provided \nthat no substantial amounts of factor Xa are generated in the \nabsence of factor VIII. In the final incubation mixture, factor \nVIII must be the only rate-limiting component.\nThe 2nd step comprises the quantification of the formed factor \nXa, employing a chromogenic substrate that is specific for \nfactor Xa. Generally this consists of a derivatised short peptide \nof between 3 to 5 amino acids, joined to a chromophore group. \nOn cleavage of this group from the peptide substrate, its \nchromophoric properties shift to a wavelength allowing its \nspectrophotometric quantification. The substrate must also \ncontain appropriate inhibitors to stop further factor Xa \ngeneration, e.g. chelating agents, and to suppress thrombin \nactivity."}},{"@id":"https://www.openphar.org/data/ip/monographs/sterile-clonazepam-concentrate","@type":"IndexedMonograph","prefLabel":{"en":"Sterile Clonazepam Concentrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sterile Clonazepam Concentrate\nSterile Clonazepam Concentrate is a sterile solution of \nclonazepam in a suitable solvent.\nThe concentrate complies with the requirements of \nConcentrate for Injections stated under Parenteral \nPreparations and with the following requirements.\nSterile Clonazepam Concentrate contains not less than 95.0 per \ncent and not more than 105.0 per cent of the stated amount of \nclonazepam, C15Hl0ClN3O3.\nDescription. A clear, colourless or slightly greenish yellow \nsolution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sterile-dobutamine-concentrate","@type":"IndexedMonograph","prefLabel":{"en":"Sterile Dobutamine Concentrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sterile Dobutamine Concentrate\nSterile Dobutamine Concentrate is a sterile solution of \nDobutamine Hydrochloride in Water for Injections. . ,\nSterile Dobutamine Concentrate contains not less .than 95.0 \nper cent and not more than 105.0 per cent of the stated amount \nof dobutamine, C18H23NO3. ;\n2148\nIP 2022\nThe concentrate complies with the requirements fOr \nConcentrates for Injections or Injections stated under \nParenteral Preparations and with the following \nrequirements. .\nDescription. A colourless or pale yellow solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sterile-dopamine-concentrate","@type":"IndexedMonograph","prefLabel":{"en":"Sterile Dopamine Concentrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sterile Dopamine Concentrate\nSterile Dopamine Concentrate is a sterile solution of Dopamine \nHydrochloride in Water for Injections.\nThe concentrate complies with the requirements for \nConcentrates for Injections or Injections stated under \nParenteral Preparations and with the following \nrequirements.\nSterile Dopamine Concentrate contains not less than 95.0 per \ncent and not more than 105.0 percent of the stated amount of \ndopamine hydrochloride, QI I- |NO2,HC1.\nDescription. A colourless or pale yellow solution."}},{"@id":"https://www.openphar.org/data/ip/monographs/sterile-noradrenaline-concentrate","@type":"IndexedMonograph","prefLabel":{"en":"Sterile Noradrenaline Concentrate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sterile Noradrenaline Concentrate\nSterile Noradrenaline Concentrate is a sterile, isotonic solution \ncontaining 0.2 per cent w/v of Noradrenaline Bitartrate in \nWater for Injections.\nSterile Noradrenaline Concentrate contains not less than \n0.18 per cent and not more than 0.23 per cent w/v of \nnoradrenaline bitartrate, C8Hj ]NO3,C4H6O6,H2O."}},{"@id":"https://www.openphar.org/data/ip/monographs/sterile-water-for-inhalation","@type":"IndexedMonograph","prefLabel":{"en":"Sterile Water for Inhalation"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sterile Water for Inhalation\nSterile Water for Inhalation is Water for Injection in Bulk that \nis distributed in suitable containers of glass or any: other \nmaterial; sealed'and sterilized by heat under conditions that \nensure that the water compilés with; the test for ? bacterial \nendotoxins. It is free, from any added substances, ; Each \ncontainer contains a sufficient quantity of Water for Inhalation \nto permit the withdrawal of nominal volume.\n■ \nncUv h-'d;' \n■ m \nUg\nSterile Water for Inhalation should not be used for parenteral \nadministration or for other sterile dosage forms.\nCategory, Pharmaceutical aid\nDescription, A clear, colourless and, odourless liquid „"}},{"@id":"https://www.openphar.org/data/ip/monographs/sterile-water-for-injections","@type":"IndexedMonograph","prefLabel":{"en":"Sterile Water for Injections"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sterile Water for Injections\nSterile Water for Injections is Water for Injections in bulk that \nhas been distributed in suitable containers of glass or any \nother material, sealed and sterilised by heat under conditions \nthat ensure that the water complies with the test for bacterial \nendotoxins. It is free from any added substances. Each \ncontainer contains a sufficient quantity of Water for Injections \nto permit the withdrawl of the nominal volume.\nCategory. Pharmaceutical aid.\nDescription. A clear, colourless liquid; odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/streptokinase-bulk-solution","@type":"IndexedMonograph","prefLabel":{"en":"Streptokinase Bulk Solution"},"edition":"ip-2010","category":"monographs","definition":{"en":"Streptokinase Bulk Solution\nStreptokinase Bulk Solution is a fibrinolytic enzyme present\nin certain strains ofhaemolytic Streptococcus group C. It has\nthe property of combining'with human plasminogen to form\nplasminogen activator. Streptokinase is also produced by a\nmethod based on recombinantDNA technology using bacteria\nor suitable genetically engineered host cells.\nStreptokinase Bulle Solution has a potency of not less than\n96,000illper mg ofprotein."}},{"@id":"https://www.openphar.org/data/ip/monographs/streptokinase-injection","@type":"IndexedMonograph","prefLabel":{"en":"Streptokinase Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Streptokinase Injection\nStreptokinase Injection is a sterile material consisting of \nStreptokinase with or without auxiliary agents. It is filled ma \nsealed container. ,\nThe injection is constituted by dissolving the contents ofthe \nsealed containerin the requisite amount of sterile Water fot\nInjections, immediately before use. . h\n3664\nwww.webofpharma.com\n■ £f» 2022; \n..........................■........................... ...............................\n^^stijutedisolution complies with the requirements for\nsolution and Particulate matter stated Under \n^^^¿Pfepdrations (Injections).\n■ -s aee fghe constituted solution should be used immediately \nfter pt®Par^on ^ut’ *n any case’ wi^nn period \n^o^ended by the manufacturer.\nY^gcontcnts of the sealed container comply with the\nujrenlents stated under Parenteral Preparations (Powders \nforfnjictipn) and with the following requirements.\n^¿^¿^ngths.^0,000 Units; 100,000 Units; 750,000 Units; \n1,500^^^\nA Place 0-5 pl of citrated human plasma in a haemolysis tube \nmaintained in a water-bath at 37°. Add 0.1 ml of a solution of \nthe contents of the container containing 10,000 Units per ml in \neitro-phosphate buffer pH 7.2 and 0.1 ml of a solution of \nthrombin containing 20 Units per ml in citro-phosphate buffer \npH 7.2 and shake immediately; a clot forms and lyses within\n30 minutes. Repeat the procedure using citrated bovine plasma; \nlysis does not occur , within 1 hour.\nB. Dissolve 0.6 g of agar in 50.0 ml of mixed barbitone buffer \npH'8'ff, heating until a clear solution is obtained. Place glass\nplates (50 rriiri x 50 mm) that are free from traces of grease on a \nlevel surfaced Apply to each plate 4 ml of the agar solution and \nallow to cool until set. Bore a hole 6 mm in diameter in the \ncentre of the agar and an appropriate number of holes\n(notexceeding six) at distances of 11 mm from the central hole \nremoving the residual agar by means of a cannula connected \nto a vacuum pump. Place a quantity of 80 llI of goat or rabbit \nantistreptokinase serum containing 10,000 Units of \nantistreptokinase activity per ml in the central hole and 80 pl \nof a solution of the contents of the container 'containing\n125,000 Units of streptokinase activity per mhof each of the \nsurrounding holes. Place the plates in a humidified tank for \n24 hours.\nOnly one precipitation arc is produced which is well-defined \nand localised between the application point of the serum and \neach hole containing: the: solution of. the substance, under \nexamination; ' \n• \n... , . .\nTests,‘h>\nNOTE — Tests for Streptolysin and Streptodornase may be\nomitted if the Streptokinase injection is prepared from \nSf^bffiase ¿bmplied as per monograph in current edition\n' '' ? i;\npH (2.4,24). 6.8 to 7.5, determined on a freshly constituted \nflection containing 5000 Units per ml, using carbon dioxide \ndewater. \n■ \n. . \n... ...\nSTREPTOKINASE INJECTION\nStreptodornase. Introduce 0.5 ml of a 0.1 per cent w/v solution \nof sodium deoxyribonucleate in imidazole buffer pH 6.5 into \neach of eight centrifuge tubes. To each of the first two tubes \nadd 0.25 vatotimidazolebufferpH 6.5 and 0.25 ml of solution \nof the contents of the container with the substance under \nexamination in imidazole buffer. pH 6,5 containing\n150,000 Units per ml (solution A) followed immediately by \n3.0 ml of 0.25 Mperchloric acid. Mix the contents of each \ntube, centrifuge for 5 minutes at 3000 rpm and measure the \nabsorbance of each of the supernatant'liquids at about \n260 nm (2.4.7), using as the blank a mixture of 1.0 ini of imidazole \nbuffer pH 6.5 and 3.0 ml of 0.25 Mperchloric acid. Calculate \nthe sum of the two absorbances (A ;). To each of the remaining \nsix tubes add, respectively, 0.25,0.25,0.125,0.125,0 and 0 ml \nof imidazole buffer pH 6.5 followed by 0.25 ml of solution A \nand finally 0,0,0.125,0.125,0.25 and 0.25 ml respectively of a \nsolution of the Standard Preparation containing 20 Units of \nstreptodornase activity per ml in imidazole buffer pH 6.5. \n[The standar"}},{"@id":"https://www.openphar.org/data/ip/monographs/streptokinase","@type":"IndexedMonograph","prefLabel":{"en":"Streptokinase"},"edition":"ip-2022","category":"monographs","definition":{"en":"Streptokinase\nStreptokinase is a preparation of a protein obtained from culture \nfiltrates of certain strains of Streptococcus haemolyticus group \nC. It has the property of combining with human plasminogen \nto form plasminogenactivatorand is purified to contain not \nlessthan 600 Units of Streptokinase activity per pg of nitrogen \nbefore addition of any stabiliser or carrier. It usually contains \na buffer and may be stabilised by the addition of suitable \nsubstances such as Human Albumin.\nCategory, Fibrinolytic enzyme.\nDescription: A white powder or a white, friable solid; \nhygroscopic. ;"}},{"@id":"https://www.openphar.org/data/ip/monographs/streptomycin-injection","@type":"IndexedMonograph","prefLabel":{"en":"Streptomycin Injection"},"edition":"ip-2010","category":"monographs","definition":{"en":"Streptomycin Injection\nStreptomycin Sulphate Injection\nStreptomycin Injection is a sterile material consisting of\nStreptomycin Sulphate with or without auxiliary agents. It is\nfilredin-a-seah:~a-container~----'--\n--- '-'\"--'-\"-'--'\"--'-'._.__._._.,--\nThe injection is constituted by dissolving the contents of the\nsealed container in the requisite amount of sterile Water for\nInjections, immediately before use.\n2162\nIP 2010\nThe constituted solution complies with the requirements for\nClarity of solution and Particulate matter stated under\nParenteral Preparations (Injections).\nStorage. The constituted solution'should be used immediately\nafter preparation but, in any case, within the period\nrecommended by the manufacturer.\nStreptomycin Injection contains not less than 90.0 per cent\nand not more than 115.0 per cent of the stated amount of\nstreptomycin, CZIH39N70Iz.\nThe contents of the sealed container comply with the\nrequirements stated under Parenteral Preparations\n(Powders for Injection) and with thefollowing requirements.\nUsual strengths. The equivalent of 750 mg and 1 g of"}},{"@id":"https://www.openphar.org/data/ip/monographs/streptomycin-sulphate","@type":"IndexedMonograph","prefLabel":{"en":"Streptomycin Sulphate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Streptomycin Sulphate\n(C2iH39N7Ol2)2,3U2SO4 \nMol. Wt. 1457.4\nStreptomycin Sulphate is the sulphate of O-2-deoxy- \n2-methylamino-a-L-glucopyranosyl-( 1 —> 2)-<9-5-deoxy- \n3-C-formyl-a-L-lyxofuranosyl-( 1—> 4)-Ar/,7VJ-diamidino- \nD-streptamine, a substance produced by the growth of certain \nstrains of Streptomyces griseus or obtained by any other \nmeans.\" \n' \n’ ’ \n’ ’\nStreptomycin Sulphate has a potency equivalent to not les \nthan 720 pg of streptomycin per mg, calculated on the on® \nbasis. \n, \n:\nCategory.Antitubercular. .. .\nDescription. A white or almost white powder; hygroscopic-\nwww.webofpharma.com\nSTREPTOMYCIN SULPHATE\n1P2022\nIdeI^catioh^ <\na ¿etennine by thin-layer chromatography (2.4.17). Prepare\n- j jeEy mixing 0.3 g olcarbomer with 240 ml of water,\nh ’ne to stand with moderate stirring for 1 hour, adjusted \n2 H 70 by the gradual addition with constant shaking of 2\n{\\hOdntnt hydroxide and adding 30 g of silica Sel Spread\n‘ uniform layer of the resulting suspension 0.75 mm thick. \nHeat the plate at 110° for 1 hour, allow to cool and use\nimmediately. -\nMobile phase. A,L7 percent w/v solution of potassium \nddtydrogep phosphate.\nTest solutioh. Dissolve 0.1 g of the substance under \nexaminationin 100 ml of water.\nReference sblution (a). A 0.1 per' cent w/v of streptomycin \nsulphate IPRS m water.\nReference solution (b). A solution containing 0.1 per cent\nw/vi of streptomycin sulphate IPRS, 0.1 per cent w/v of in a water-bath for exactly 10 minutes. Cool in ice for exactly \nneomycin sulphate IPRSand 0.1 per cent w/v of kanamycin 5 minutes, add 3 ml of a 1.5 per cent w/v solution of ferric \nmonosulphate IPRS in water.\nApply to the plate TO pTof each solution. Allow the mobile \nphase to rise 12 cm. Dry the plate in warm air, spray with a \nmixture;of equal volumes of a 0.2 per cent w/v solution of \nnaphthalene-1,3-diol in ethanol (95 per cent) and sulphuric \nacid (45per cent) and heat at 150° for 5 to 10 minutes. The \nprincipal spot jn the chromatogram obtained with the test \nsolution corresponds to that in the chromatogram obtained \nwith reference solution (a). The test is not valid unless the\n■■V- '..A'A / \\ \nV\nchtomatograni obtained with reference solution (b) shows \nthree clearly separated spots.\nB. Dissolve 5 to. 10 mg in 4 ml of water and add 1 ml of \n1 Xisodium hydroxide. Heat in a water-bath for 4 minutes. Add\na slight excess of 2 M hydrochloric acid and 0.1 ml of a\n10 per cent w/v solution offerric chloride', a violet colour is \nproduced.\n0. Dissolve 0.1 g in 2 ml of water and add 1 ml of dilute \nTnaphthol solution'and 2 ml of a mixture of equal volumes of \ndilute sodium hypochlorite solution and water, a red colour \nis produced.\nDissolve 10 mg in 5 ml of water and add 1 ml of 7 M hydro­\nchlor icacid.}de.?y in a water-bath for 2 minutes. Add\n~ ml of a 0.5percent w/v solution of 1-naphthol in I M sodium \nhydroxide and heat in a water-bath for 1 minute; a faint yellow \ncolourisproduced.\ngives the reactions of sulphates (2.3.1).\nTests '\n^Ppearance ofsolution. A 25,0 per cent w/v solutionin carbon\ntae-free water is not more intensely coloured than degree\n3 of the appropriate range of reference solutions (2.4.1). The \nsolution, after standing protected from light at a temperature \nof about 20° for 24 hours, is not more opalescent than \nopalescence standard OS2 (2.4.1).\npH (2.4.24). 4.5 to 7.0, determined in a 25.0 per cent w/v solution.\nSulphates. 18.0 to 21.5 per cent, calculated on the dried basis, \nwhen determined by the following method. Dissolve 0.25 g in\n100 ml of water, adjusted to pH 11 with strong ammonia \nsolution and add 10.0 ml of 0.1Mbarium chloride and 0.5 mg \nof metalphthalein. Titrate the excess of barium chloride with \n0.1 M disodium edetate, adding 50 ml of ethanol (95 per \ncent) when the colour of the solution begins to change and \ncontinuing the titration until the violet-blue colour disappears.\n1 ml of 0.1 Mbarium chloride is equivalent to 0.009606 g of \nsulphate, SO4.\nColorimetric test. Dissolve 0.1 g in "}},{"@id":"https://www.openphar.org/data/ip/monographs/succinylcholine-chloride","@type":"IndexedMonograph","prefLabel":{"en":"Succinylcholine Chloride","la":"Identification"},"edition":"ip-2022","category":"monographs","definition":{"en":"Succinylcholine Chloride\nSuxamethonium Chloride\nSuccinylcholine Chloride is 2,2'-succinyldioxy- ; \nbis(ethyltrimethylammonium) dichloride dihydrate. .■.-■\nSuccinylcholine Chloride contains not less than 98.0 per cent \nand not more than 101.0 per cent of C14H30CI2N2O4, calculated \non the anhydrous basis. \n'': \n: .\nCategory. Depolarising skeletal muscle relaxant. - \n1\nDescription. A white or almost white, crystalline powder; \nhygroscopic. \n■\n3669\nwww.webofpharma.com\nSUCCINYLCHOLINE CHLORIDE"}},{"@id":"https://www.openphar.org/data/ip/monographs/succinylcholine-injection","@type":"IndexedMonograph","prefLabel":{"en":"Succinylcholine Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Succinylcholine Injection\nSuxamethonium Chloride Injection\nSuccinylcholine Injection is . a sterile , solution of \nSuccinylcholine Chloride in Water for Injections.;,;\nSuccinylcholine Injection contains not less than90.0 percent \nand not more than 107.5 per cent of the stated amount of \nsuccinylcholine chloride, Ci4H30Cl2N2O4,2H2CX\nUsual strength. 50 mg per ml. \n; \n|"}},{"@id":"https://www.openphar.org/data/ip/monographs/sucralfate","@type":"IndexedMonograph","prefLabel":{"en":"Sucralfate"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sucralfate\nnAl(OH)3, n'H2O .\n< yy iu \ni s ; Ji; ■■ H •• : t ' -■• ■ • j • • ■ • -, ■ J ' \n- • • ■ ' \n..................\nSucralfate is Als(OH)16(Ci2HMO35S8)[Al(OlI)3|n|lLO]rfin which \nn= 8 to 10; and nr-22 to 31. a-D-Glucopyranoside, p-D- \nfrûctdfufàhÔsÿR;6ctakis (hydrogensulphate), aluminium \ncomplex. \n.....\nSüçrâlfàtë is the hydrous basic aluminium salt of sucrose \noctaSuifate; If contains the equivalent of not legs than\n3(Mf percent and not more than 38.0 per cent of sucrose \noctasulfatë, Ci2l-IÎ4O35S8.\nCategory. Antiulcer.\nDescription. A white or almost white, amorphous powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sucrose","@type":"IndexedMonograph","prefLabel":{"en":"Sucrose"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sucrose\nRefinedSugar\nSucrose is p-D-fructofuranosyl a-D-glucopyranoside.\nCategory? Pharmaceutical aid (sweetening agent; tablet \nexcipient).\nDescription. An almost white or colourless crystals, dry \ncrystalline powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sulfasalazine","@type":"IndexedMonograph","prefLabel":{"en":"Sulfasalazine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sulfasalazine\nSulfasalazine is 2-hydroxy-5-[2-[4-(pyridin-2-ylsulfa \nphenyl]diazenyl]benzoic acid.\nSulfasalazine contains not less than 97.0 per-cent and not \nmore than 101.5 per cent of C18H14N4O5S, calculated on \ndried basis.\nCategory. Disease-modifying antirheumatic drug (DMARD)\nDescription. A bright yellow or brownish-yellow, fine powder"}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphadiazine-and-trimethoprim-veterinary-oral-powder","@type":"IndexedMonograph","prefLabel":{"en":"Sulphadiazine and Trimethoprim Veterinary Oral Powder"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sulphadiazine and Trimethoprim Veterinary Oral Powder\nconsists ofSulphadiazine and Trimethoprim in the proportion\nof five parts to one part respectively, mixed with suitable\nwetting, dispersing and suspending agents.\nSulphadiazine and Trimethoprim Veterinary Oral Powder\ncontains not less than 92.5 per cent and not more than\n107.5 per cent of the stated amounts of sulphadiazine,\nCIOHION40 2S, and oftrimethoprim, C14H1SN403.\nUsual strength. 10 per cent w/w of Sulphadiazine and 2 per\ncent w/w ofTrimethoprim."}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphadiazine","@type":"IndexedMonograph","prefLabel":{"en":"Sulphadiazine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sulphadiazine\nCioHio^O^' ' \nMol.Wt.250.3\nSulphadiazine is ,V'-(pyTimidin-2-yl)sulphanilamidc.\nSulphadiazine contains hot less than 99.0¡ per cent and not \nmore than 101.0 per cent of CiqIIhjN./TS, calculated on the \ndried basis. \n\" \n■ 1\nCategory. Antibacterial.\nDescription. White, yellowish white or pinkish white crystals \nor crystalline powder. /"}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphadoxine","@type":"IndexedMonograph","prefLabel":{"en":"Sulphadoxine"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sulphadoxine \n- <\n^ubhormethoxine;Sulphocthomidine \n;\nC«H14N4O4S. m ; ' \nMol. Wt. 310.3"}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphamethizole","@type":"IndexedMonograph","prefLabel":{"en":"Sulphamethizole"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sulphamethizole\nC9H10N4O2S2 \n' ■ \n' \n; ■’ Mol. Wt. 270.3\nSulphamethizole is N--(5-methyl-1,3,4-thiadiazol-2-yl) \nsulphanilamide.\nSulphamethizole contains hot less than 99.0 per cent and hot \nmore than 101.0 per cent of C9HI0N4O2S2, calculated on the \ndried basis. \n'• \n: ‘ \n‘\nCategory.Antibacterial.: \n■ ■\nDescription. White or yellowish white crystals or crystalline \npowder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphamethoxazole","@type":"IndexedMonograph","prefLabel":{"en":"Sulphamethoxazole"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sulphamethoxazole\nCIOHlIN30 3S\nMol. Wt. 253.3\nSulphamethoxazole is Nl-(5-methylisoxazol-\n3-yl)sulphanilarnide.\nwww.webofpharma.com\nIP 2010\nSulphamethoxazole contains not less than 99.0 per cent and\nnot more than 101.0 per cent ofCIOH\"N30 3S, calculated on the\ndried basis.\nCategory. Antibacterial.\nDose. Initial dose, 2 g; subsequent doses, 1 g two or three\ntimes daily.\nDescription. A white or almost white, crystalline powder;\nalmost odourless."}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphaquinoxaline-sodium-solution","@type":"IndexedMonograph","prefLabel":{"en":"Sulphaquinoxaline Sodium Solution"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sulphaquinoxaline Sodium Solution \n|\nSulphaquinoxaline Sodium Solution is an aqueous solution of \nsulphaquinoxalitie sodium prepared ‘by thé interaction of \nSulphaquinoxaline and Sodium Hydroxide: -\nSulphaquinoxaline Soditim Solution’ contains “not ‘less than \n95.0 per cent and not more than 105.0 per cent of the stated \namount of sulpbaquinoxaline, CigH2N,O,S.\n‘Usual strength. The equivalent of 96 mg of ‘Sulphaquinoxaline\n‘in 1 mi. \n7\nDeserip tion. Aclear, yellow to brown solution, . oe\n‘Identification : 8\n   \nA. To: a  vohinis Containing \n1; £ of Sulphaquinoxaline ‘add 10 mi\nof water and 31 ml of 2M. hydrochlorie acid, filter, wash the\nprecipitate with water and dry for 2 hours at tose. The residue \ncoraplies with the following test. \n™\nDetermine by infrared absorption spectrophotometry (3, 4, 6). \nCompare: the” spectrum \nwith: \n‘that’ obtained \nwith \nsulphaquinoxaline IPRS or with the reference spectrum of\nsulphaquinoxaline.\nB. Dissolve 4 mg ofthe tesidue obtained j ‘in test A'in 2 mi of \nwarn 2 M hydrochloric atid: The solution j gives the’ reaction\nof primary aromatic amines (2.3. 1 \nws\n€. Acidify with 6 Macetic acid, filter and évapoiate thé filtrate\nto drynéss. The incinerated residue, when moistened with \n“hydrochloric acid and: introduced on a platinum. wire into:a\nBunsen burner flame, gives a yellow colour.to:the:-flameé. \n-\n4932\nSULPRAQUINOXALINE SODIUM SOLUTION \n   \nIP-2022"}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphaquinoxaline","@type":"IndexedMonograph","prefLabel":{"en":"Sulphaquinoxaline"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sulphaquinoxaline\nCI4H12N40ZS\nMol. Wt. 300.3\nSulphaquinoxaline is 4-amino-N-2-quinoxalinylbenzene-\nsulphonamide.\nSulphaquinoxaline contains not less than 98.0 per cent and\nnot more than 101.0per cent OfCI4HIZN40ZS, calculated on the\ndried basis.\nCategory. Antibacterial.\nDose. Poulny. Prophylactic, upto 125 g per tonne offeed for 8\nweeks or 300 to 500 mg per litre ofdrinking water.\nDescription. Ayellow colourpowder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphated","@type":"IndexedMonograph","prefLabel":{"en":"Sulphated"},"edition":"ip-2018","category":"monographs","definition":{"en":"Sulphated\nSulphated ash (2.3.18). Not more than 0.1 per cent.\nDescription. A white to off white powder.\nSolvent mixture. 50 volumes of buffer solution prepared by \ndissolving 3.4g of potassium dihydrogen phosphate in 1000 \nml of water, add 1.0 ml of triethvlamine, adjusted to pH 3.0\nLoss on drying (2.4.19). Not more than 0.5 per cent, determined \non 1.0 g by drying in an oven at 60° for 3 hour."}},{"@id":"https://www.openphar.org/data/ip/monographs/sulphide-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sulphide Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sulphide Injection\nCategory. Diagnostic\nDescription. Technetium (99nTc) Colloidal Rhenium Sulphide \nInjection is a light bro wn sterile colloidal dispersion of rhenium \nsulphide, the micelles of which are labelled with technetium- \n99m. It contains not less than 90.0 per cent and not more than \n110.0 per cent of the stated technetium-99m radioactivity at \nthe date and time stated on the label. Technetium (99:rTc)- \nColloidal Rhenium Sulphide.Injection should,be used within 8 \nhours from date and time of preparation.\nRadiopharmaceutical Preparation. Technetium (99l1'Tc) \nColloidal Rhenium Sulphide Injection is prepared aseptically \nfollowing instructions provided with the kit. The kit contains \nsodium pertechnetate (\"vTc) injection /(fission or non - \nfission) and other suitable ingredients and stabilizers. The pH\nof the injection may be adjusted by the addition of a suitable \nbuffer such as a citrate buffer solution. /.y"}},{"@id":"https://www.openphar.org/data/ip/monographs/sumatriptan-injection","@type":"IndexedMonograph","prefLabel":{"en":"Sumatriptan Injection"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sumatriptan Injection \nI\nSumatriptan Succinate Injection \nI\nSumatriptan Injection is a sterile isotonic solution of ■ | \nSumatriptan Succinate in Water for Injections; '5 '; \n|\nSumatriptan Injection contains Sumatriptan Succinate | \nequivalent to not less than 95.0 per cent and not more than |\n105.0 per cent of the stated amount of sumatriptan f \nCmH„N,O£. \n: \n’ .1\nDescription. Aclear, colourless to pale yellow solution. I\nUsual strength. 6 mg per 0.5 ml. \n1"}},{"@id":"https://www.openphar.org/data/ip/monographs/sumatriptan","@type":"IndexedMonograph","prefLabel":{"en":"Sumatriptan"},"edition":"ip-2010","category":"monographs","definition":{"en":"Sumatriptan\nCIJ1ZIN30ZS\nMol. Wt. 295.4\nSumatriptan is 3-(2-dimethylaminoethyl)indol-5-yl-N-\nmethylmethanesulphonamide.\nSumatriptan contains not less than 97.5 per cent and not more\nthan 102.0 per cent of CI4HzIN30ZS, calculated on the\nanhydrous basis.\nCategory. Antimigraine.\nDescription. A white to pale yellow powder."}},{"@id":"https://www.openphar.org/data/ip/monographs/sunthi","@type":"IndexedMonograph","prefLabel":{"en":"Sunthi"},"edition":"ip-2022","category":"monographs","definition":{"en":"Sunthi\nSaunth; Ginger; Zingiber officinale\n4304\nIP2022\nSunthi is the whole or cut scraped or unscraped, dried rhizomes \nof Zingiber officinale Roscoe. (Fam. Zingiberaceae). .2\nSunthi contains not less than 0.8 per cent w/w of total \ngingerofc, calculated on the dried basis. ; -.»b \n,\nCategory. Carminative, antiemetic, antiinflammatory, hepato- \nprotective, agnimandya. \n: \\' '?' ■ :; 'U\nDescription. Odour, agreeable and aromatic; taste, agreeable \nand pungent. \n5 < ,'y"}},{"@id":"https://www.openphar.org/data/ip/monographs/surgical-spirit","@type":"IndexedMonograph","prefLabel":{"en":"Surgical Spirit"},"edition":"ip-2018","category":"monographs","definition":{"en":"Surgical Spirit\nSurgical Spirit contains 0.45 per cent to 0.55 per cent v/v of \nmethyl salicylate, C8H803 and 1.8 cent to 2.2 per cent v/v of \ndiethyl phthalate, C12111404.\nFurther dilute 10 ml of the solution prepared in the Assay for \nmethyl salicylate to 50 ml with ethanol and measure the \nabsorbance of the resulting solution at 227 nm (2.4.7). Subtract \nfrom the observed absorbance the absorbance due to the \nmethyl salicylate present, as determined above, taking 432 as \nthe specific absorbance of methyl salicylate. For calculation, \ntake 419 as the specific absorbance of diethyl phthalate at \n227 nm.\nInject reference solution (a). The test is not valid unless the \nresolution between the peaks due to sumatriptan impurity C \nand sumatriptan is not less than 1.5.\nSurgical Spirit contains\nInject reference solution (b) and test solutions (a), (b). In the \nchromatogram obtained with test solution (a) the area of any \npeak corresponding to (3a-hydroxy,1,1-dimethy1-5-Rmethyl-\namino)sulfonylimethyl-1,2,3,3a,8,8a hexahydropyrrolo\nMethyl Salicylate \t\n5 ml\nDiethyl Phthalate \t\n20 ml\nCastor Oil \t\n25 ml\n[2,3-b]indo1-1-ium trifuoroacetate) (sumatriptan impurity A) is \nnot more than 1.5 times the area of the principal peak in the \nchromatogram obtained with test solution (b) (1.5 per cent), \nthe area of any peak corresponding to 2 (1-342- \n(dimethylam ino)ethy1]-3-hydroxy-2-oxo-2,3-di hydro-1H-indo1- \n5-yl-N-methylmethanesulfonamide) (sumatriptan impurity H) \nis not more than the area of the principal peak in the \nchromatogram obtained with test solution (b) (1.0 per cent). \nThe area of any other secondary peak is not more than the \narea of the principal peak in the chromatogram obtained with \ntest solution (b) (1.0 per cent) and sum of areas of the peaks \ndue to sumatriptan impurity A and H is not more than 4 times \nthe area of the principal peak in the chromatogram obtained \nwith test solution (b) (4.0 per cent).\nStorage. Store protected from moisture.\nIndustrial Methylated Spirit Sufficient to produce 1000 ml.\nLabelling. The label states that the preparation is flammable \nand should be kept away from a naked flame.\nCategory. Skin disinfectant.\nOther tests. Comply with the tests stated under Parenteral \nPreparations (Injections).\nBacterial endotoxins (2.2.3). Not more than 350.0 Endotoxin \nUnits per ml of sumatriptan succinate.\nAssay. Determine by liquid chromatography (2.4.14).\nTest solution. Dilute the volume of injection containing 3 mg \nof Sumatriptan succinate in 100 ml of the solvent mixture.\n..X.c-:*-- \n- \t\nic \n \n,. * • \t\n1._.  ,..;..,,\nRefer .ice solution (a). A 0.003 per cent w/v solution of\n_ \nsumatriptan succinate RS in the solvent mixture.\n,__•\"\"N\",.. ..-•N\n_...,„\"e'erl,-_:., , -/•_:.._' \t\n-_,___.•:\\ ,,-,,,, Ny- ,--, ., ,-;-i----\n' -°•-•\"^.\n'-•._ .-----_,---'---'-''(;-•,\n„..., \".-4-,-. , \n . \n._,-../.;,....- -\n4.,......:IN-\n.A...\", t'• \t\n.53:, ' ,;,,...\n.-7\ni'1=-7 11(1 -\nSs7 11 \u0013e\nfisiNAN PHARMACOPOEIA 2018 \t\n