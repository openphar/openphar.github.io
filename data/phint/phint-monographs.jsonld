":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-120","@type":"IndexedMonograph","prefLabel":{"en":"Nelfinavir mesilate"},"monographId":"8.120","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-121","@type":"IndexedMonograph","prefLabel":{"en":"Neostigmine metilsulfate"},"monographId":"8.121","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-122","@type":"IndexedMonograph","prefLabel":{"en":"Nevirapine anhydrous"},"monographId":"8.122","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-123","@type":"IndexedMonograph","prefLabel":{"en":"Nicotinamide"},"monographId":"8.123","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-124","@type":"IndexedMonograph","prefLabel":{"en":"Nifurtimox"},"monographId":"8.124","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-125","@type":"IndexedMonograph","prefLabel":{"en":"Niridazole"},"monographId":"8.125","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-126","@type":"IndexedMonograph","prefLabel":{"en":"Norethisterone"},"monographId":"8.126","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-127","@type":"IndexedMonograph","prefLabel":{"en":"Norethisterone acetate"},"monographId":"8.127","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-128","@type":"IndexedMonograph","prefLabel":{"en":"Norethisterone enantate"},"monographId":"8.128","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-129","@type":"IndexedMonograph","prefLabel":{"en":"Noscapine hydrochloride"},"monographId":"8.129","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-13","@type":"IndexedMonograph","prefLabel":{"en":"Artemisinin"},"monographId":"8.13","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-130","@type":"IndexedMonograph","prefLabel":{"en":"Papaverine hydrochloride"},"monographId":"8.130","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-131","@type":"IndexedMonograph","prefLabel":{"en":"Pentamidine isetionate"},"monographId":"8.131","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-132","@type":"IndexedMonograph","prefLabel":{"en":"Phenobarbital"},"monographId":"8.132","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"}]},{"@id":"https://www.openphar.org/data/phint/monographs/8-133","@type":"IndexedMonograph","prefLabel":{"en":"Phenoxymethylpenicillin"},"monographId":"8.133","edition":"PhInt-13","category":"monographs","definition":{"en":"Instrument: Fourier Transform\r\nPhase: Potassium bromide disc"},"sections":[{"name":"opening","text":"Instrument: Fourier Transform\r\nPhase: Potassium br