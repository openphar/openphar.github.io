)\r\n\r\n\r\nb Emission\r\nprobability\r\n(per 100\r\ndisintegrations)\r\n\r\n\r\nType\r\n\r\n\r\nEnergy (MeV)\r\n\r\n\r\nEmission\r\nprobability\r\n(per 100\r\ndisintegrations)\r\n\r\n\r\n\r\n\r\nTritium (3H)\r\n\r\n\r\n*12.33 (6) years\r\n\r\n\r\n*β-\r\n\r\n\r\n*0.006(I)\r\n(max: 0.019)\r\n\r\n\r\n*100\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nCarbon-11 (11C)\r\n\r\n\r\n20.385 (20) min\r\n\r\n\r\nβ +\r\n\r\n\r\n0.386(I)\r\n(max: 0.960)\r\n\r\n\r\n99.8\r\n\r\n\r\nγ\r\n\r\n\r\n0.511\r\n\r\n\r\n199.5(II)\r\n\r\n\r\n\r\n\r\nNitrogen-13 (13N)\r\n\r\n\r\n9.965 (4) min\r\n\r\n\r\nβ +\r\n\r\n\r\n0.492(I)\r\n(max: 1.198)\r\n\r\n\r\n99.8\r\n\r\n\r\nγ\r\n\r\n\r\n0.511\r\n\r\n\r\n199.6(II)\r\n\r\n\r\n\r\n\r\nOxygen-15 (15O)\r\n\r\n\r\n122.24 (16) s\r\n\r\n\r\nβ +\r\n\r\n\r\n0.735(I)\r\n(max: 1.732)\r\n\r\n\r\n99.9\r\n\r\n\r\nγ\r\n\r\n\r\n0.511\r\n\r\n\r\n199.8(II)\r\n\r\n\r\n\r\n\r\nFluorine-18 (18F)\r\n\r\n\r\n109.77 (5) min\r\n\r\n\r\nβ +\r\n\r\n\r\n0.250(I)\r\n(max: 0.633)\r\n\r\n\r\n96.7\r\n\r\n\r\nγ\r\n\r\n\r\n0.511\r\n\r\n\r\n193.5(II)\r\n\r\n\r\n\r\n\r\nPhosphorus-32 (32P)\r\n\r\n\r\n14.26 (4) days\r\n\r\n\r\nβ -\r\n\r\n\r\n0.695(I)\r\n(max: 1.71)\r\n\r\n\r\n100\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nPhosphorus-33 (33P)\r\n\r\n\r\n25.34 (12) days\r\n\r\n\r\nβ -\r\n\r\n\r\n0.076(I)\r\n(max: 0.249)\r\n\r\n\r\n100\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nSulphur-35 (35S)\r\n\r\n\r\n87.51 (12) days\r\n\r\n\r\nβ -\r\n\r\n\r\n0.049(I)\r\n(max: 0.167)\r\n\r\n\r\n100\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nChromium-51 (51Cr)\r\n\r\n\r\n27.7025 (24) days\r\n\r\n\r\neA\r\n\r\n\r\n0.004\r\n\r\n\r\n67\r\n\r\n\r\nX\r\nγ\r\n\r\n\r\n0.005\r\n0.320\r\n\r\n\r\n22.3\r\n9.9\r\n\r\n\r\n\r\n\r\nCobalt-56 (56Co)\r\n\r\n\r\n77.27 (3) days\r\n\r\n\r\neA\r\nβ +\r\n\r\n\r\n0.006\r\n0.179(I)\r\n0.631(I)\r\n\r\n\r\n47\r\n0.9\r\n18.1\r\n\r\n\r\nX\r\nγ\r\n\r\n\r\n0.006-0.007\r\n0.511\r\n0.847\r\n1.038\r\n1.175\r\n1.238\r\n1.360\r\n1.771\r\n2.015\r\n2.035\r\n2.598\r\n3.202\r\n3.253\r\n\r\n\r\n25\r\n38.0(II)\r\n100.0\r\n14.1\r\n2.2\r\n66