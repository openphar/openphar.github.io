ry":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/atasi.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/atasi.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/atibala","@type":"IndexedMonograph","prefLabel":{"la":"Atibala"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/atibala.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/atibala.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/ativisha","@type":"IndexedMonograph","prefLabel":{"la":"Ativisha"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/ativisha.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/ativisha.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/atmagupta-root","@type":"IndexedMonograph","prefLabel":{"la":"Atmagupta"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/atmagupta_1.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/atmagupta_1.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/atmagupta","@type":"IndexedMonograph","prefLabel":{"la":"Atmagupta"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/atmagupta.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/atmagupta.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/bakuchi","@type":"IndexedMonograph","prefLabel":{"la":"Bakuchi"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/bakuchi.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/bakuchi.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/bast