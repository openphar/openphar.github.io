E","text":"Converted from ontology/data/ingredients/syonaka.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/tagara","@type":"IndexedMonograph","prefLabel":{"la":"Tagara"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/tagara.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/tagara.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/tailaparna","@type":"IndexedMonograph","prefLabel":{"la":"Tailaparna"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/tailaparna.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/tailaparna.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/tala","@type":"IndexedMonograph","prefLabel":{"la":"Tala"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/tala.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/tala.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/talamuli","@type":"IndexedMonograph","prefLabel":{"la":"Talamuli"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/talamuli.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/talamuli.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/tila","@type":"IndexedMonograph","prefLabel":{"la":"Tila"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/tila.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/ingredients/tila.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/tinisha","@type":"IndexedMonograph","prefLabel":{"la":"Tinisha"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/da