ar.org/data/ayp/monographs/it-is-thereafter-bundled-in-a-piece-of-cloth-and-boiled-in-dol","@type":"IndexedMonograph","prefLabel":{"la":"It is thereafter bundled in a piece of cloth and boiled in Dol"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/it-is-thereafter-bundled-in-a-piece-of-cloth-and-boiled-in-dol.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/jala-water","@type":"IndexedMonograph","prefLabel":{"la":"Jala Water"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/jala-water.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/jalafor-decoction-water","@type":"IndexedMonograph","prefLabel":{"la":"Jalafor decoction Water"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/jalafor-decoction-water.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/ka","@type":"IndexedMonograph","prefLabel":{"la":"Ka"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/ka.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/ku","@type":"IndexedMonograph","prefLabel":{"la":"Ku"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/ku.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/madhu-api-honey","@type":"IndexedMonograph","prefLabel":{"la":"Madhu API Honey"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/madhu-api-honey.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/madhu-honey","@type":"IndexedMonograph","prefLabel":{"la":"Madhu Honey"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/madhu-honey.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/malak","@type":"IndexedMonograph","prefLabel":{"la":"Āmalak"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/malak.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/must","@type":"IndexedMonograph","prefLabel":{"la":"Must"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/must.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/punarnav","@type":"IndexedMonograph","prefLabel":{"la":"Punarnav"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/punarnav.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sarpi","@type":"IndexedMonograph","prefLabel":{"la":"Sarpi"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/sarpi.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/take-a-thread","@type":"IndexedMonograph","prefLabel":{"la":"Take a thread"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/take-a-thread.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/take-another-small-portion-of-the-washed-material","@type":"IndexedMonograph","prefLabel":{"la":"Take another small portion of the washed material"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/take-another-small-portion-of-the-washed-material.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/the-period-of-p","@type":"IndexedMonograph","prefLabel":{"la":"The period of P"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/the-period-of-p.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/there-are-a-few-exceptions-for-the-above-general-rule","@type":"IndexedMonograph","prefLabel":{"la":"There are a few exceptions for the above general rule"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/there-are-a-few-exceptions-for-the-above-general-rule.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/there-are-usually-three-essential-components-in-the-manufacture-of-gh","@type":"IndexedMonograph","prefLabel":{"la":"There are usually three essential components in the manufacture of Gh"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/there-are-usually-three-essential-components-in-the-manufacture-of-gh.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/there-are-usually-three-essential-components-in-the-manufacture-of-taila-kalpan","@type":"IndexedMonograph","prefLabel":{"la":"There are usually three essential components in the manufacture of Taila Kalpan"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/there-are-usually-three-essential-components-in-the-manufacture-of-taila-kalpan.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/three-stages-of-p","@type":"IndexedMonograph","prefLabel":{"la":"Three stages of P"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/three-stages-of-p.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/vahni","@type":"IndexedMonograph","prefLabel":{"la":"Vahni"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/vahni.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/vid","@type":"IndexedMonograph","prefLabel":{"la":"Vid"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/vid.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/yava","@type":"IndexedMonograph","prefLabel":{"la":"Yava"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/yava.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/yavak","@type":"IndexedMonograph","prefLabel":{"la":"Yavak"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/yavak.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/katu","@type":"IndexedMonograph","prefLabel":{"la":"Katu"},"edition":"API Part I–VII","category":"ingredients","definition":{"la":"Converted from ontology/data/ingredients/katu.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/apamarga-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Apāmārga Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing oleanolic acid as a reference standard. Test \nsolution: Extract 2 g of substance by refluxing \nwith 50 per cent methanol (50 ml x 3) for a period \nof 30 min each, cool and filter. Combine all the \nfiltrates, concentrate and transfer to a 100-ml \nround bottomed flask. Add 20 ml of 2 M \nmethanolic hydrochloric acid and reflux at 60-700 \non a water bath for 3 hours, cool and transfer the \nsolution to a separating flask, extract with \nchloroform (25 ml x 3). Combine all the organic \nextracts and wash gently with water. Pass the \ncombined chloroform extract through anhydrous \nsodium sulphate and evaporate the chloroform \nunder vacuum. Dissolve the residue obtained in \n10 ml of methanol. Standard solution: Dissolve \n10 mg of oleanolic acid RS in about 10 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase: ethyl acetate : toluene : \nformic acid (45.0 : 0.5 : 0.1). Dry the plate in air. \nSpray the plate with 10 per cent methanolic \nsulphuric acid reagent and heat at 1050 till the \ncolour of the spots/bands appear without charring. \nThe chromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \n \nVisible after derivatisation \n RS T \nFig. 1: Thin-Layer Chromatogram of \nApāmārga hydro-alcoholic extract \nRS: Oleanolic acid, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent \n(Appendix 2.1.4); Total ash: not more than 10.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n4.0-6.5 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-I) \n \n \nAPĀMĀRGA HYDRO-ALCOHOLIC EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/apamarga-water","@type":"IndexedMonograph","prefLabel":{"la":"Apāmārga Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing oleanolic acid as a reference standard. Test \nsolution: Extract 2 g of substance by refluxing \nwith 50 per cent methanol (50 ml x 3) for a period \nof 30 min each, cool and filter. Combine all the \nfiltrates, concentrate and transfer to a 100-ml \nround bottomed flask. Add 20 ml of 2 M \nmethanolic hydrochloric acid and reflux at 60-700 \non a water bath for 3 hours, cool and transfer the \nsolution to a separating flask, extract with \nchloroform (25 ml x 3). Combine all the organic \nextracts and wash gently with water. Pass the \ncombined chloroform extract through anhydrous \nsodium sulphate and evaporate the chloroform \nunder vacuum. Dissolve the residue obtained in \n10 ml of methanol. Standard solution: Dissolve \n10 mg of oleanolic acid RS in about 10 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase : ethyl acetate : toluene : \nformic acid (45.0 : 0.5 : 0.1). Dry the plate in air. \nSpray the plate with 10 per cent methanolic \nsulphuric acid reagent and heat at 1050 till the \ncolour of the spots/bands appear without charring. \nThe chromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \nVisible after derivatisation \n \nRS T \nFig. 1: Thin-Layer Chromatogram of \nApāmārga water extract \nRS: Oleanolic acid, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent \n(Appendix 2.1.4); Total Ash: not more than 25.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n4.5- 6.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-II) \n \n \nAPĀMĀRGA WATER EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/apamarga","@type":"IndexedMonograph","prefLabel":{"la":"Apāmārga"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Mayūraka, \nPratyakpuṣpa, \nKharamaμjarī, Śikharī"}},{"@id":"https://www.openphar.org/data/ayp/monographs/asana-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Asana Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing pterostilbene as a reference standard. Test \nsolution: Extract 1 g of substance by refluxing \nwith 50 ml of methanol for a period of 10-15 min. \nFilter and concentrate the extract to 25 ml. \nStandard solution: Dissolve 10 mg of \npterostilbene RS in about 10 ml of methanol. \nProcedure: Apply 10 l each of the test and \nstandard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase : ethyl acetate : n-hexane \n(5.5 : 4.5). Dry the plate in air and examine under \nUV 254 nm. Spray the plate with anisaldehyde - \nsulphuric acid reagent and heat at 1050 till the \ncolour of the spots/bands appear without charring. \nThe chromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \n \nRS: Pterostilbene, T: Test solution \nFig. 1: Thin-Layer Chromatogram of Asana \nhydro-alcoholic extract \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 9.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not \nmore than 2.0 per cent (Appendix 2.1.7); pH: 4.0-\n7.0 (Appendix 2.1.10); Total soluble solids: not \nless than 85.0 per cent (Appendix 2.1.11) \n(Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4) \n254 nm\nVisible after \nderivatisation\n  \nRS T\nRS  T \n \nASANA HYDRO-ALCOHOLIC EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/asana-water","@type":"IndexedMonograph","prefLabel":{"la":"Asana Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing pterostilbene as a reference standard. Test \nsolution: Extract 1 g of substance by refluxing \nwith 50 ml of methanol for a period of 10-15 min. \nFilter and concentrate the extract to 25 ml. \nStandard solution: Dissolve 10 mg of \npterostilbene RS in about 10 ml of methanol. \nProcedure: Apply 10 l each of the test and \nstandard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase : ethyl acetate : n-hexane \n(5.5 : 4.5). Dry the plate in air and examine under \nUV 254 nm. Spray the plate with anisaldehyde \nsulphuric acid reagent and heat at 1050 till the \ncolour of the spots/bands appear without charring. \nThe chromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \n \n \n \nFig. 1: Thin-Layer Chromatogram of Asana \nwater extract \nRS: Pterostilbene, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 8.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not \nmore than 2.0 per cent (Appendix 2.1.7); pH: 4.0-\n7.0 (Appendix 2.1.10); Total soluble solids: not \nless than 65.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed \nlimits, \n(Appendix \n3.1); \nMicrobial \ncontamination: Complies with the prescribed \nlimits, (Appendix 3.2); Pesticide residues: \nComplies with the prescribed limits, (Appendix \n3.3); Aflatoxins: Complies with the prescribed \nlimits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/asana","@type":"IndexedMonograph","prefLabel":{"la":"Asana"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Bījaka, Pītasāra, Asanaka, Bījasāra"}},{"@id":"https://www.openphar.org/data/ayp/monographs/daruharidra-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Dāruharidrā Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing berberine chloride as a reference standard. \nTest solution: Extract 0.2 g of substance by \nrefluxing with 50 ml of methanol for a period of \n10-15 min. Filter and concentrate the extract to 25 \nml. Standard solution: Dissolve 10 mg of \nberberine chloride RS in about 100 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase: n-butanol : glacial acetic \nacid : Water (6.5 : 1.5 : 2.0). Dry the plate in air \nand examine under UV 366 nm. The \nchromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \n366 nm \n \nRS T \nFig. 1: Thin-Layer Chromatogram of \nDāruharidrā hydro-alcoholic extract \nRS: Berberine chloride T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 2.0 per cent (Appendix 2.1.7); pH: 6.0-8.0 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 90.0 per cent (Appendix 2.1.11) (Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the Prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/daruharidra-water","@type":"IndexedMonograph","prefLabel":{"la":"Dāruharidrā Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing berberine chloride as a reference standard. \nTest solution: Extract 0.2 g of substance by \nrefluxing with 50 ml of methanol for a period of \n10-15 min. Filter and concentrate the extract to 25 \nml. Standard solution: Dissolve 10 mg of \nberberine chloride RS in about 100 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase : n-butanol : glacial acetic \nacid : Water (6.5 : 1.5 : 2.0). Dry the plate in air \nand examine under UV 366 nm. The \nchromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \n \n366 nm \n \nRS T \nFig. 1: Thin-Layer Chromatogram of \nDāruharidrā water extract \nRS: Berberine chloride, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n6.0-8.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix 3.1); Microbial contamination: Complies \nwith the prescribed limits, (Appendix 3.2); Pesticide \nresidues: Complies with the prescribed limits, \n(Appendix 3.3); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/daruharidra","@type":"IndexedMonograph","prefLabel":{"la":"Dāruharidrā"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Kaṭa´kaṭerī, Dārvī"}},{"@id":"https://www.openphar.org/data/ayp/monographs/dhara-vriksamla-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Dhārā Vṛkṣāmla Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nHigh performance liquid chromatography: \nCarry out liquid chromatography (Appendix 3.6) \nusing (-)-hydroxycitric acid lactone and calcium \n(-)-hydroxycitrate as a reference standards. Test \nsolution, Standard solution, Chromatographic \nsystem, Mobile phase, Injection volume, \nDetection and Procedure follow as mentioned \nunder Assay. The chromatogram obtained with \ntest solution shows peaks corresponding to the \nretention time of (-)-hydroxycitric acid lactone \nand (-)-hydroxycitric acid (Fig. 1). \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total Ash: not more than 7.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 2.0 per cent (Appendix 2.1.7); pH: 2.0-3.5 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 90.0 per cent (Appendix 2.1.11) (Method-I) \nOther requirements: \n \nHeavy metals: Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/dhara-vriksamla-water","@type":"IndexedMonograph","prefLabel":{"la":"Dhārā Vṛkṣāmla Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nHigh performance liquid chromatography: \nCarry out liquid chromatography (Appendix 3.6) \nusing (-)-hydroxycitric acid lactone and calcium \n(-)-hydroxycitrate as a reference standards. Test \nsolution, Standard solution, Chromatographic \nsystem, Mobile phase, Injection volume, \nDetection and Procedure follow as mentioned \nunder Assay. The chromatogram obtained with \ntest solution shows peaks corresponding to the \nretention time of (-)-hydroxycitric acid lactone \nand (-)-hydroxycitric acid (Fig. 1). \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 7.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 2.0 per cent (Appendix 2.1.7); pH: 2.0-3.5 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 90.0 per cent (Appendix 2.1.11) (Method-II) \nOther requirements: \n \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/dhara-vriksamla","@type":"IndexedMonograph","prefLabel":{"la":"Dhārā Vṛkṣāmla"},"edition":"API Part I–VII","category":"extracts","definition":{"la":": \nFruits are ovoid, yellow or red when ripe and become \nblack when dried. 6-8 grooves are seen up to the \nmiddle. Dried pieces of drug consists of longitudinal \nfragments of pericarp of various size and shapes \nstrongly inwardly curved, boat or half moon shaped, \ndark brownish black, wrinkled irregularly and \ninternally smooth. Odour characteristic, taste sour, \nastringent and slightly bitter"}},{"@id":"https://www.openphar.org/data/ayp/monographs/katuka-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Kaṭukā Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using picroside-\nI and picroside-II as reference standards. Test solution: \nExtract 1 g of substance by refluxing with 50 ml of \nmethanol for a period of 10-15 min. Filter and \nconcentrate the extract to 25 ml. Standard solution: \nDissolve 5 mg each of picroside-I RS and picroside-II \nRS in 25 ml of methanol. Procedure: Apply 10 l each \nof the test and standard solutions as bands at a height \nof 10 mm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate using the \nmobile phase: ethyl acetate : methanol : water (82.0 : \n10.0 : 8.0). Dry the plate in air and examine under UV \n254 nm. Spray the plate with 10 per cent methanolic \nsulphuric acid reagent and heat at 1050 till the colour \nof the spots/bands appear without charring. The \nchromatographic profile of the test solution shows \nbands corresponding to that of the standard solution \n(Fig. 1). \n254 nm \nVisible after \nderivatisation \n \n RS T \n \nRS T \nFig. 1: Thin-Layer Chromatogram of \nKaṭukā hydro-alcoholic extract \nRS: (1) Picroside-I and (2) Picroside-II, \nT: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 7.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not \nmore than 1.0 per cent (Appendix 2.1.7); pH: 4.0-\n6.0 (Appendix 2.1.10); Total soluble olids: not \nless than 90.0 per cent (Appendix 2.1.11) \n(Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4) \nKAṬUKĀ HYDRO-ALCOHOLIC EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/katuka-water","@type":"IndexedMonograph","prefLabel":{"la":"Kaṭukā Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing picroside-I and picroside-II as reference \nstandards. Test solution: Extract 1 g of substance \nby refluxing with 50 ml of methanol for a period \nof 10-15 min. Filter and concentrate the extract to \n25 ml. Standard solution: Dissolve 5 mg each of \npicroside-I RS and picroside-II RS in 25 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate using \nthe mobile phase: ethyl acetate: methanol : water \n(82.0 : 10.0 : 8.0). Dry the plate in air and examine \nunder UV 254 nm. Spray the plate with 10 per cent \nmethanolic sulphuric acid reagent and heat at 1050 \ntill the colour of the spots/bands appear without \ncharring. The chromatographic profile of the test \nsolution shows bands corresponding to that of the \nstandard solution (Fig. 1). \n254 nm \nVisible after \nderivatisation \n \n RS T \n \nRS T\nFig. 2: Thin-Layer Chromatogram of \nKaṭukā water extract \nRS: (1) Picroside-I and (2) Picroside-II, \nT: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent (Appendix \n2.1.4); Total ash: not more than 5.0 per cent \n(Appendix 2.1.5); Acid-insoluble ash: not more than \n1.0 per cent (Appendix 2.1.7); pH: 4.0-7.0 (Appendix \n2.1.10); Total soluble solids: not less than 90.0 per \ncent (Appendix 2.1.11) (Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/katuka","@type":"IndexedMonograph","prefLabel":{"la":"Kaṭukā"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Tiktā, Tiktarohiṇī, Kaṭurohiṇī, \nKaṭvī, Matsyaśakalā"}},{"@id":"https://www.openphar.org/data/ayp/monographs/manjistha-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Mañjiṣṭhā Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing rubiadin as a reference standard. Test \nsolution: Extract 2 g of substance by refluxing \nwith chloroform (25 ml x 3) for a period of 10-15 \nmin each. Filter and concentrate the combined \nextract to dryness. Dissolve the residue in 2 ml of \nmethanol. Standard solution: Dissolve 1 mg of \nrubiadin RS in about 10 ml of methanol. \nProcedure: Apply 10 l each of the test and \nstandard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and \ndevelop upto 8 cm from the base of the plate using \nthe mobile phase: toluene : ethyl acetate : \nchloroform : glacial acetic acid (10.0 : 5.0 : 1.0 : \n2.5). Dry the plate in air and examine under UV \n254 nm and under UV 366 nm. The \nchromatographic profile of the test solution \nshows a band corresponding to that of standard \nsolution (Fig. 1). \n254 nm \n366 nm \n \n RS T \n \n RS T \nFig. 1: Thin-Layer Chromatogram of \nMaμjiṣṭhā hydro-alcoholic extract \nRS: Rubiadin, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 22.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n4.5-7.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/manjistha-water","@type":"IndexedMonograph","prefLabel":{"la":"Mañjiṣṭhā Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing rubiadin as a reference standard. Test \nsolution: Extract 2 g of substance by refluxing \nwith chloroform (25 ml x 3) for a period of 10-15 \nmin each. Filter and concentrate the combined \nextract to dryness.Dissolve the residue in 2 ml of \nmethanol. Standard solution: Dissolve 1 mg of \nrubiadin RS in about 10 ml of methanol. \nProcedure: Apply 10 l each of the test and \nstandard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and \ndevelop upto 8 cm from the base of the plate using \nthe mobile phase:toluene : ethyl acetate : \nchloroform : glacial acetic acid (10.0 : 5.0 : 1.0 : \n2.5). Dry the plate in air and examine under UV \n254 nm and under UV 366 nm. The \nchromatographic profile of the test solution \nshows a band corresponding to that of standard \nsolution (Fig. 1). \n254 nm \n366 nm \n \n RS T \n \n RS T \nFig. 1: Thin-Layer Chromatogram of \nMaμjiṣṭhā water extract \nRS: Rubiadin, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent, \n(Appendix 2.1.4); Total ash: not more than 18.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n4.0-6.5 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/manjistha","@type":"IndexedMonograph","prefLabel":{"la":"Mañjiṣṭhā"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Yojanavallī, \nTāmravallī, \nVastraraμjinī, Raktā"}},{"@id":"https://www.openphar.org/data/ayp/monographs/mesasringi-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Meṣaśṛṅgī Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using \ngymnemagenin as a reference standard. Test \nsolution: Extract 0.5 g of substance by refluxing \nwith a mixture of 50 per cent methanol and 11 per \ncent potassium hydroxide solution (10 : 2), for a \nperiod of 1 hour. Add 1.8 ml of concentrated \nhydrochloric acid and reflux again for one hour on \nwater bath. Cool and adjust the pH between 7.5 to \n8.5 with 11 per cent potassium hydroxide solution. \nDilute to 50 ml with 50 per cent of methanol and \nfilter. Standard solution: Dissolve 10 mg of \ngymnemagenin RS in 10 ml of methanol. \nProcedure: Apply 10 l each of the test and standard \nsolutions as bands at a height of 10 mm from the \nbase of a 10 x 5 cm TLC plate and develop up to 8 \ncm from the base of the plate using the mobile \nphase: ethyl acetate : methanol : formic acid (82.0 : \n10.0 : 8.0). Dry the plate in air. Spray the plate with \n10 per cent methanolic sulphuric acid reagent and \nheat at 1050 till the colour of the spots/bands appear \nwithout charring. The chromatographic profile of \nthe test solution shows a band corresponding to that \nof the standard solution (Fig. 1). \n \n \nFig. 1: Thin-Layer Chromatogram of \nMeṣaśṛ´gī hydro-alcoholic extract \nRS: Gymnemagenin, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total Ash: not more than 15.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 1.0 per cent (Appendix 2.1.7); pH: 4.5-7.0 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 90.0 per cent (Appendix 2.1.11) (Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix 3.1); Microbial contamination: Complies \nwith the prescribed limits, (Appendix 3.2); Pesticide \nresidues: Complies with the prescribed limits, \n(Appendix 3.3); Residual solvent: Complies with the \nprescribed limits, (Appendix 3.8); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4) \nVisible after derivatisation \n \nRS T \nMEṢAŚÎṄGĪ HYDRO-ALCOHOLIC EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/mesasringi-water","@type":"IndexedMonograph","prefLabel":{"la":"Meṣaśṛṅgī Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using \ngymnemagenin as a reference standard. Test \nsolution: Extract 0.5 g of substance by refluxing with \na mixture of 50 per cent methanol and 11 per cent \npotassium hydroxide solution (10 : 2), for a period of \n1 hour. Add 1.8 ml of concentrated hydrochloric acid \nand reflux again for one hour on water bath. Cool and \nadjust the pH between 7.5 to 8.5 with 11 per cent \npotassium hydroxide solution. Dilute to 50 ml with \n50 per cent of methanol and filter. Standard solution: \nDissolve 10 mg of gymnemagenin RS in 10 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and develop \nup to 8 cm from the base of the plate using the mobile \nphase: ethyl acetate : methanol : formic acid (82.0 : \n10.0 : 8.0). Dry the plate in air. Spray the plate with \n10 per cent methanolic sulphuric acid reagent and \nheat at 1050 till the colour of the spots/bands appear \nwithout charring. The chromatographic profile of the \ntest solution shows a band corresponding to that of \nthe standard solution (Fig. 1). \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \n \nFig. 1: Thin-Layer Chromatogram of \nMeṣaśṛ´gī water extract \nRS: Gymnemagenin, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total Ash: not more than 20.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 1.0 per cent (Appendix 2.1.7); pH: \n4.5-8.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4) \nVisible after derivatisation \n \n RS T \nMEṢAŚÎṄGĪ WATER EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/mesasringi","@type":"IndexedMonograph","prefLabel":{"la":"Meṣaśṛṅgī"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Madhunāśinī"}},{"@id":"https://www.openphar.org/data/ayp/monographs/methi-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Methī Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing 4-hydroxyisoleucine as a reference \nstandard. Test solution: Extract 2 g of substance \nby refluxing with 50 ml of methanol for a period \nof 10-15 min. Filter and concentrate the extract to \n25 ml. Standard solution: Dissolve 2.5 mg of 4-\nhydroxyisoleucine RS in 10 ml of methanol. \nProcedure: Apply 10 l each of the test and \nstandard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase: n-butanol : acetic acid : \nwater (40 : 10 : 10). Dry the plate in air. Spray the \nplate with 1 per cent ninhydrin in methanol \nreagent and heat at 1050 till the colour of the \nspots/bands appear without charring. The \nchromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \nVisible after derivatization \n \nRS T \nFig. 1: Thin-Layer Chromatogram of Methī \nhydro-alcoholic extract \nRS: 4-Hydroxyisoleucine, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 6.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 2.0 per cent (Appendix 2.1.7); pH: 4.0-7.0 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 90.0 per cent (Appendix 2.1.11) (Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4) \n \n \nMETHĪ HYDRO-ALCOHOLIC EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/methi-water","@type":"IndexedMonograph","prefLabel":{"la":"Methī Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing 4-hydroxyisoleucine as a reference \nstandard. Test solution: Extract 2 g of substance \nby refluxing with 50 ml of methanol for a period \nof 10-15 min. Filter and concentrate the extract to \n25 ml. Standard solution: Dissolve 2.5 mg of 4-\nhydroxyisoleucine RS in 10 ml of methanol. \nProcedure: Apply 10 l each of the test and \nstandard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase: n-butanol : acetic acid : \nWater (40 : 10 : 10). Dry the plate in air. Spray \nthe plate with 1 per cent ninhydrin in methanol \nreagent and heat at 1050 till the colour of the \nspots/bands appear without charring. The \nchromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \nVisible after derivatisation \n \n \nRS T \nFig. 1: Thin-Layer Chromatogram of Methī \nwater extract \n RS: 4-Hydroxyisoleucine, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 8.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n4.0‐7.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/methi","@type":"IndexedMonograph","prefLabel":{"la":"Methī"},"edition":"API Part I–VII","category":"extracts","definition":{"la":": \nSeed oblong, rhomboidal with deep furrow \nrunning obliquely from one side, dividing seed \ninto a larger and smaller part, 0.2 to 0.5 cm long, \n0.15 to 0.35 cm broad, smooth, very hard; dull \nyellow; seed becomes mucilaginous when soaked \nin water; odour pleasant; taste bitter."}},{"@id":"https://www.openphar.org/data/ayp/monographs/ningundi-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Niṅguṇḍī Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing negundoside and agnuside as reference \nstandards. Test solution: Extract 2 g of substance \nby refluxing with 50 ml of methanol for a period \nof 10-15 min. Filter and concentrate the extract to \n25 ml. Standard solution: Dissolve 10 mg each of \nnegundoside RS and agnuside RS in 10 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate using \nthe mobile phase: ethyl acetate : glacial acetic acid \n: water (8.0 : 1.0 : 1.0). Dry the plate in air and \nexamine under UV 254 nm. Spray the plate with of \nanisaldehyde-sulphuric acid reagent and heat at \n1050 till the colour of the spots/bands appear \nwithout charring. The chromatographic profile of \nthe test solution shows bands corresponding to that \nof the standard solution (Fig. 1). \n254 nm \nVisible after derivatisation \n \nRS T \n \nRS T \nFig. 1: Thin-Layer Chromatogram of \nNirguṇḍī hydro-alcoholic extract \nRS: (1) Negundoside and (2) Agnuside, \n T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent (Appendix \n2.1.4); Total ash: not more than 15.0 per cent \n(Appendix 2.1.5); Acid-insoluble ash: not more than \n2.0 per cent (Appendix 2.1.7); pH: 4.0-6.0 (Appendix \n2.1.10); Total soluble solids: not less than 90.0 per \ncent (Appendix 2.1.11) (Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \nNIRGUṚḌĪ HYDRO-ALCOHOLIC EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/ningundi-water","@type":"IndexedMonograph","prefLabel":{"la":"Niṅguṇḍī Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using \nnegundoside and agnuside as reference standards. \nTest solution: Extract 2 g of substance by refluxing \nwith 50 ml of methanol for a period of 10-15 min. \nFilter and concentrate the extract to 25 ml. Standard \nsolution: Dissolve 10 mg each of negundoside RS \nand agnuside RS in 10 ml of methanol. Procedure: \nApply 10 l each of the test and standard solutions as \nbands at a height of 10 mm from the base of a 10 x 5 \ncm TLC plate and develop up to 8 cm from the base \nof the plate using the mobile phase: ethyl acetate: \nglacial acetic acid : water (8.0 : 1.0 : 1.0). Dry the \nplate in air and examine under UV 254 nm. Spray the \nplate with of anisaldehyde sulphuric acid reagent and \nheat at 1050 till the colour of the spots/bands appear \nwithout charring. The chromatographic profile of the \ntest solution shows bands corresponding to that of the \nstandard solution (Fig. 1). \n254 nm \nVisible after \nderivatisation \n \nRS T \n \nRS T \nFig. 1: Thin-Layer Chromatogram of \nNirguṇḍī water extract \nRS: (1) Negundoside and (2) Agnuside, \n T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 6.0 per cent \n(Appendix 2.1.4); Total ash: not more than 15.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 3.0 per cent (Appendix 2.1.7); pH: \n4.0-6.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4) \n \n \nNIRGUṚḌĪ WATER EXTRACT"}},{"@id":"https://www.openphar.org/data/ayp/monographs/ningundi","@type":"IndexedMonograph","prefLabel":{"la":"Niṅguṇḍī"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Sinduvāra, Śephālikā, Nīla"}},{"@id":"https://www.openphar.org/data/ayp/monographs/punarnava-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Punarnavā Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing boeravinone B as a reference standard. Test \nsolution: Extract 2 g of substance by refluxing \nwith 50 ml of methanol for a period of 15 min. \nFilter and concentrate the extract to 25 ml. \nStandard solution: Dissolve 2 mg of boeravinone \nB RS in 10 ml of methanol. Procedure: Apply 10 \nl each of the test and standard solutions as bands \nat a height of 10 mm from the base of a 10 x 5 cm \nTLC plate and develop up to 8 cm from the base \nof the plate using the mobile phase: toluene : ethyl \nacetate : formic acid (4.0 : 5.0 : 1.0). Dry the plate \nin air and examine under UV 254 nm. The \nchromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \n254 nm \n \n RS T \nFig. 1: Thin-Layer Chromatogram of \nPunarnavā water extract \nRS: Boeravinone B, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n6.0- 8.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-I) \nOther requirements: \nHeavy metals:  Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the  prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/punarnava-water","@type":"IndexedMonograph","prefLabel":{"la":"Punarnavā Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing boeravinone B as a reference standard. Test \nsolution: Extract 2 g of substance by refluxing \nwith 50 ml of methanol for a period of 15 min. \nFilter and concentrate the extract to 25 ml. \nStandard solution: Dissolve 2 mg of boeravinone \nB RS in 10 ml of methanol. Procedure: Apply 10 \nl each of the test and standard solutions as bands \nat a height of 10 mm from the base of a 10 x 5 cm \nTLC plate and develop up to 8 cm from the base \nof the plate using the mobile phase : toluene : \nethyl acetate : formic acid (4.0 : 5.0 : 1.0). Dry the \nplate in air and examine under UV 254 nm. The \nchromatographic profile of the test solution \nshows a band corresponding to that of the \nstandard solution (Fig. 1). \n \n254 nm \n \n RS T \nFig. 1: Thin-Layer Chromatogram of \nPunarnavā water extract \nRS: Boeravinone B, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 2.0 per cent (Appendix 2.1.7); pH: 6.0-8.0 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 90.0 per cent (Appendix 2.1.11) (Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/punarnava","@type":"IndexedMonograph","prefLabel":{"la":"Punarnavā"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Kaṭhillā, Śophaghnī, Śothaghnī"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sallaki-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Śallakī Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using β-\nboswellic acid as a reference standard. Test \nsolution: Extract 0.2 g of substance by refluxing \nwith 50 ml of methanol for a period of 15 min. Filter \nand concentrate the extract to 25 ml. Standard \nsolution: Dissolve 10 mg of β-boswellic acid RS in \n25 ml of methanol. Procedure: Apply 10 l each of \nthe test and standard solutions as bands at a height \nof 10 mm from the base of a 10 x 5 cm TLC plate \nand develop up to 8 cm from the base of the plate \nusing the mobile phase: Toluene : Ethyl acetate : \nMethanol (8.0 :1.5 : 0.5). Spray the plate with \nanisaldehyde - sulphuric acid reagent and heat at \n1050 till the colour of the spots / bands appear \nwithout charring. The chromatographic profile of \nthe test solution shows a band corresponding to that \nof the standard solution (Fig. 1). \nVisible after derivatisation \n \nRS T \nFig. 1: Thin-Layer Chromatogram of Śallakī \nhydro-alcoholic extract \nRS: β-boswellic acid, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent \n(Appendix 2.1.4); Total Ash: not more than 4.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 1.0 per cent (Appendix 2.1.7); pH: \n3.5-5.5 (Appendix 2.1.10); Total soluble solids: \nnot less than 70.0 per cent (Appendix 2.1.11) \n(Method-I). \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)."}},{"@id":"https://www.openphar.org/data/ayp/monographs/sallaki-water","@type":"IndexedMonograph","prefLabel":{"la":"Śallakī Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing β-boswellic acid as a reference standard. \nTest solution: Extract 0.2 g of substance by \nrefluxing with 50 ml of methanol for a period of \n15 min. Filter and concentrate the extract to 25 \nml. Standard solution: Dissolve 10 mg of β-\nboswellic acid RS in 25 ml of methanol. \nProcedure: Apply 10 l each of the test and \nstandard solutions as bands at a height of 10 mm \nfrom the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobile phase: toluene : ethyl acetate : \nmethanol (8.0 :1.5 : 0.5). Spray the plate with \nanisaldehyde -sulphuric acid reagent and heat at \n1050 till the colour of the spots/ bands appear \nwithout charring. The chromatographic profile of \nthe test solution shows a band corresponding to \nthat of the standard solution (Fig. 1). \n \nVisible after derivatisation \n \n RS T \nFig. 1: Thin-Layer Chromatogram of Śallakī \nwater extract \nRS: β-boswellic acid, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent \n(Appendix 2.1.4); Total ash: not more than 5.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 1.0 per cent (Appendix 2.1.7); pH: 3.5-5.5 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 65.0 per cent (Appendix 2.1.11) (Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sallaki","@type":"IndexedMonograph","prefLabel":{"la":"Śallakī"},"edition":"API Part I–VII","category":"extracts","definition":{"la":": \nDrug occurs in stalactitic, transparent, tears \nforming agglomerates of various shapes and \nsizes, brownish-yellow, upto 5 cm long, 2 cm \nthick, fragrant, fracture brittle; fractured surface \nwaxy and translucent; burns readily and emanates \nan agreeable characteristic, balsamic resinous \nodour; taste, aromatic and agreeable \nIdentification - Trituration with water forms an \nemulsion; when immersed in alcohol (90 per cent) \na tear of' Śallakī is not altered much in form but \nbecomes almost opaque and white; when a drop \nof con. H2SO4 is added to a freshly fractured \nsurface, it becomes cherry red which, when \nwashed with water changes to a white emulsion, \nturning later to a buff colour \nFluorescence Test - Brownish-yellow colour in day \nlight; aqueous extract under UV light (366 nm) light \ngreen and in (254 nm) shows dark blue colour; \nalcoholic extract under UV light (366 nm) is \ncolourless and in (254 nm) shows light green colour"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sirisa-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Śirīṣa Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using catechin as \na reference standard. Test solution: Extract 2 g of \nsubstance by refluxing with 50 ml of water for a period \nof 15 min. Filter and concentrate the extract to 25 ml. \nStandard solution: Dissolve 10 mg of catechin RS in \n10 ml of methanol. Procedure: Apply 10 l each of the \ntest and standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate using the \nmobile phase: toluene : ethyl acetate : formic acid (1.2 \n: 1.8 : 1.0). Dry the plate in air and examine under UV \n254 nm. Spray the plate with fast blue salt B reagent, \nand heat at 1050 till the colour of the spots/bands \nappear without charring. The chromatographic profile \nof the test solution shows a band corresponding to that \nof the standard solution (Fig. 1). \n254 nm \nVisible after \nderivatisation \n \n RS T \n \n RS T \nFig. 1: Thin-Layer Chromatogram of Śirīṣa \nhydro-alcoholic extract \nRS: Catechin, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent, \n(Appendix 2.1.4); Total ash: not more than 10.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 2.0 per cent (Appendix 2.1.7); pH: 4.0-6.5 \n(Appendix 2.1.10); Total soluble solids: not less than \n90.0 per cent (Appendix 2.1.11) (Method-I) \nOther requirements: \nHeavy metals:  Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sirisa-water","@type":"IndexedMonograph","prefLabel":{"la":"Śirīṣa Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using catechin \nas a reference standard. Test solution: Extract 2 g of \nsubstance by refluxing with 50 ml of water for a \nperiod of 15 min. Filter and concentrate the extract to \n25 ml. Standard solution: Dissolve 10 mg of catechin \nRS in 10 ml of methanol. Procedure: Apply 10 l \neach of the test and standard solutions as bands at a \nheight of 10 mm from the base of a 10 x 5 cm TLC \nplate and develop up to 8 cm from the base of the \nplate using the mobile phase: toluene : ethyl acetate : \nformic acid (1.2 : 1.8 : 1.0). Dry the plate in air and \nexamine under UV 254 nm. Spray the plate with fast \nblue salt B reagent, and heat at 1050 till the colour of \nthe spots/bands appear without charring. The \nchromatographic profile of the test solution shows a \nband corresponding to that of the standard solution \n(Fig. 1). \n254 nm \nVisible after \nderivatisation \n \n RS T \n  \n RS T \nFig. 1: Thin-Layer Chromatogram of Śirīṣa \nwater extract \nRS: Catechin, T: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent (Appendix \n2.1.4); Total ash: not more than 12.0 per cent \n(Appendix 2.1.5); Acid-insoluble ash: not more than \n2.0 per cent (Appendix 2.1.7); pH: 4.5-6.0 (Appendix \n2.1.10); Total soluble solids: not less than 90.0 per \ncent (Appendix 2.1.11) (Method-II). \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix 3.1); Microbial contamination: Complies \nwith the prescribed limits, (Appendix 3.2); Pesticide \nresidues: Complies with the prescribed limits, \n(Appendix 3.3); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)."}},{"@id":"https://www.openphar.org/data/ayp/monographs/sirisa","@type":"IndexedMonograph","prefLabel":{"la":"Śirīṣa"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Śukapriya, Mṛdupuṣpa"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sunthi-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Śuṇṭhī Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing 6-gingerol and 6-shogaol as reference \nstandards. Test solution: Extract 1 g of substance \nby refluxing with 50 ml of methanol for a period \nof 15 min. Filter and concentrate the extract to 25 \nml. Standard solution: Dissolve 5 mg each of 6-\ngingerol RS and 6-shogaol RS in about 25 ml of \nmethanol. Procedure: Apply 10 l each of the test \nand standard solutions as bands at a height of 10 \nmm from the base of a 10 x 5 cm TLC plate and \ndevelop up to 8 cm from the base of the plate \nusing the mobilephase: ethyl acetate : toluene : \ndiethyl ether (3.0 : 6.0 :1.0). Dry the plate in air \nand examine under UV 254 nm. Spray the plate \nwith anisaldehyde- sulphuric acid reagent and \nheat at 1050 till the colour of the spots/bands \nappear without charring. The chromatographic \nprofile of the test solution shows bands \ncorresponding to that of the standard solution \n(Fig. 1). \n254 nm \nVisible after \nderivatisation \n \nRS T \n              RS T \nFig. 1: Thin-Layer Chromatogram of Śuṇṭhī \nhydro-alcoholic extract \nRS: (1) 6-Gingerol and (2) 6-Shogaol, \nT: Test solution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n4.0-7.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-I) \nOther requirements: \nHeavy metals:  Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4) \nŚUṚṬHĪ HYDRO-ALCOHOLIC EXTRACT \nRf"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sunthi-water","@type":"IndexedMonograph","prefLabel":{"la":"Śuṇṭhī Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a precoated \nsilica gel 60F254 plate (Appendix 3.5) using 6-\ngingerol and 6-shogaol as reference standards. Test \nsolution: Extract 1 g of substance by refluxing with \n50 ml of methanol for a period of 15 min. Filter and \nconcentrate the extract to 25 ml. Standard solution: \nDissolve 5 mg each of 6-gingerol RS and 6-shogaol \nRS in about 25 ml of methanol. Procedure: Apply 10 \nl each of the test and standard solutions as bands at \na height of 10 mm from the base of a 10 x 5 cm TLC \nplate and develop up to 8 cm from the base of the \nplate using the mobile phase: ethyl acetate : toluene : \ndiethyl ether (3.0 : 6.0 :1.0). Dry the plate in air and \nexamine under UV 254 nm. Spray the plate with \nanisaldehyde- sulphuric acid reagent and heat at 1050 \ntill the colour of the spots/bands appear without \ncharring. The chromatographic profile of the test \nsolution shows bands corresponding to that of the \nstandard solution (Fig. 1). \n254 nm \nVisible after \nderivatisation \n \n \n RS T \n RS T\nFig. 1: Thin-Layer Chromatogram of Śuṇṭhī  \nwater extract \nRS: (1) 6-Gingerol and (2) 6-Shogaol, T: Test \nsolution \nQuantitative parameters: \nLoss on drying: not more than 7.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 2.0 per cent (Appendix 2.1.7); pH: \n4.0-7.0 (Appendix 2.1.10); Total soluble solids: \nnot less than 90.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/sunthi","@type":"IndexedMonograph","prefLabel":{"la":"Śuṇṭhī"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Mahauṣadha, \nNāgara, \nViśvā, \nViśvabheṣaja, Śṛ´agavera"}},{"@id":"https://www.openphar.org/data/ayp/monographs/svarnapatri-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Svarṇapatrī Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing sennoside A and sennoside B as reference \nstandards. Test solution: Extract 0.2 g of \nsubstance by refluxing with 50 ml of methanol for \na period of 10-15 min. Filter and concentrate the \nextract to 25 ml. Standard solution: Dissolve 5 mg \neach of sennoside A RS and sennoside B RS in \nabout 10 ml of methanol. Procedure: Apply 10 l \neach of the test and standard solutions as bands at \na height of 10 mm from the base of a 10 x 5 cm \nTLC plate and develop up to 8 cm from the base \nof the plate using the mobile phase: ethyl acetate \n: methanol : water (7.7 : 1.7 : 1.0). Dry the plate \nin air and examine under UV 366 nm. The \nchromatographic profile of the test solution \nshows bands corresponding to that of the standard \nsolution (Fig. 1). \n366 nm \n \n RS (1) RS (2) T \nFig. 1: Thin-Layer Chromatogram of \nSvarṇapatrī hydro-alcoholic extract \nRS: (1) Sennoside A and (2) Sennoside B \nT: Test solution \nQuantitative parameters: \nLoss on drying: not more than 5.0 per cent \n(Appendix 2.1.4); Total ash: not more than 13.0 per \ncent (Appendix 2.1.5); Acid-insoluble ash: not more \nthan 1.0 per cent (Appendix 2.1.7); pH: 3.5-5.5 \n(Appendix 2.1.10); Total soluble solids: not less \nthan 80.0 per cent (Appendix 2.1.11) (Method-I) \nOther requirements: \nHeavy metals:  Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/svarnapatri-water","@type":"IndexedMonograph","prefLabel":{"la":"Svarṇapatrī Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing sennoside A and sennoside B as reference \nstandards. Test solution: Extract 0.2 g of \nsubstance by refluxing with 50 ml of methanol for \na period of 10-15 min. Filter and concentrate the \nextract to 25 ml. Standard solution: Dissolve 5 mg \neach of sennoside A RS and sennoside B RS in \nabout 10 ml of methanol. Procedure: Apply 10 l \neach of the test and standard solutions as bands at \na height of 10 mm from the base of a 10 x 5 cm \nTLC plate and develop up to 8 cm from the base \nof the plate using the mobile phase: ethyl acetate \n: methanol : water (7.7 : 1.7 : 1.0). Dry the plate \nin air and examine under UV 366 nm. The \nchromatographic profile of the test solution \nshows bands corresponding to that of the standard \nsolution (Fig. 1). \n366 nm \n \n \n RS (1) RS (2) T \nFig. 1: Thin-Layer Chromatogram of \nSvarṇapatrī water extract \nRS: (1) Sennoside A and (2) Sennoside B \nT: Test solution \nQuantative parameters: \nLoss on drying: not more than 5.0 per cent \n(Appendix 2.1.4); Total ash: not more than 10.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 1.0 per cent (Appendix 2.1.7); pH: \n3.5-5.5 (Appendix 2.1.10); Total soluble solids: \nnot less than 80.0 per cent (Appendix 2.1.11) \n(Method-II) \nOther requirements: \nHeavy metals: Complies with the prescribed limits, \n(Appendix \n3.1); \nMicrobial \ncontamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Aflatoxins: \nComplies with the prescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/svarnapatri","@type":"IndexedMonograph","prefLabel":{"la":"Svarṇapatrī"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Mārkaṇḍikā"}},{"@id":"https://www.openphar.org/data/ayp/monographs/tulasi-hydro-alcoholic","@type":"IndexedMonograph","prefLabel":{"la":"Tulasī Hydro-alcoholic Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"and Strength: \nThin-layer chromatography: \nCarry out thin-layer chromatography on a \nprecoated silica gel 60F254 plate (Appendix 3.5) \nusing ursolic acid as a reference standard. Test \nsolution: Extract 1 g of substance by refluxing \nwith 50 ml of methanol for a period of 15 min. \nFilter and concentrate the extract to 25 ml. \nStandard solution: Dissolve 5 mg of ursolic acid \nRS in about 25 ml of methanol. Procedure: Apply \n10 l each of the test and standard solutions as \nbands at a height of 10 mm from the base of a 10 \nx 5 cm TLC plate and develop up to 8 cm from \nthe base of the plate using the mobile phase: \ntoluene : ethyl acetate : acetic acid (8.0 : 2.0 : 0.1). \nDry the plate in air. Spray the plate with \nanisaldehyde - sulphuric acid reagent and heat at \n1050 till the colour of the spots/bands appear \nwithout charring. The chromatographic profile of \nthe test solution shows a band corresponding to \nthat of the standard solution (Fig. 1). \nVisible after derivatisation \n \n RS T \nFig. 1: Thin-Layer Chromatogram of Tulasī \nhydro-alcoholic extract \nRS: Ursolic acid, T: Test solution \nQuantative parameters: \nLoss on drying: not more than 5.0 per cent \n(Appendix 2.1.4); Total ash: not more than 12.0 \nper cent (Appendix 2.1.5); Acid-insoluble ash: \nnot more than 1.5 per cent (Appendix 2.1.7); pH: \n3.5-5.5 (Appendix 2.1.10); Total soluble solids: \nNot less than 90.0 per cent (Appendix 2.1.11) \n(Method-I) \nOther requirements: \nHeavy metals: Complies with the prescribed \nlimits, (Appendix 3.1); Microbial contamination: \nComplies with the prescribed limits, (Appendix \n3.2); Pesticide residues: Complies with the \nprescribed limits, (Appendix 3.3); Residual \nsolvent: Complies with the prescribed limits, \n(Appendix 3.8); Aflatoxins: Complies with the \nprescribed limits, (Appendix 3.4)"}},{"@id":"https://www.openphar.org/data/ayp/monographs/tulasi-water","@type":"IndexedMonograph","prefLabel":{"la":"Tulasī Water Extract"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"For the purposes of the Pharmacopoeia, a pesticide is any substance or mixture of substances intended for preventing, destroying or controlling any pest, unwanted species of plants or animals causing harm during or otherwise interfering with the production, processing, storage, transport or marketing of vegetable drugs. Table 7: Permissible Limits for Pesticide Residue: Substance Limit (mg/kg) Alachlor 0.02 Aldrin and Dieldrin (sum of) 0.05 Azinphos-methyl 1.0 Bromopropylate 3.0 Chlordane (sum of cis-, trans - and Oxythlordane) 0.05 Chlorfenvinphos 0.5 Chlorpyrifos 0.2 Chlorpyrifos-methyl 0.1 Cypermethrin (and isomers) 1.0 DDT (sum of p,p´-DDT, o,p´-DDT, p,p- DDE and p,p´-TDE) 1.0 Deltamethrin 0.5 Diazinon 0.5 Dichlorvos 1.0 Dithiocarbamates (as CS2) 2.0 Endosulfan (sum of isomers and endosulfan sulphate) 3.0 Endrin 0.05 Ethion 2.0 Fenitrothion 0.5 Fenvalerate 1.5 Fonofos 0.05 Heptachlor (sum of heptachlor and heptachlor epoxide) 0.05 Hexachlorobenzene 0.1 Hexachlorocyclohexane isomers (other than γ) 0.3 Lindane (γ-hexachlorocyclohexane) 0.6 Malathion 1.0 Methidathion 0.2 Parathion 0.5 Parathion-methyl 0.2 Permethrin 1.0 Phosalone 0.1 Piperonyl butoxide 3.0 Pirimiphos-methyl 4.0 Pyrethrins (sum of) 3.0 Quintozene (sum of quintozene, pentachloroaniline and methyl pentachlorophenyl sulphide) 1.0 Note: Apart from the above, if any pesticides applied to the herb before or after harvesting should also be tested. The limit should be calculated using the following formula. ADIṄM MDDṄ100 ADI= Acceptable daily intake as published by FAO- WHO, in milligrams per kilogram of body mass, M= body mass in kilograms (60 kg), MDD= daily dose of the drug, in kilograms If the drug is intended for the preparation of extracts, tinctures or other pharmaceutical forms whose preparation method modifies the content of pesticides in the finished product, the limits are calculated using the following expression: API, Part-I, Vol.-IX (Extracts); Appendices 128 ADIṄMṄE MDDṄ100 E= Extraction factor for of the method of preparation, determined experimentally. Higher limits can also be authorised, in exceptional cases, especially when a plant requires a particular cultivation method or has a metabolism or a structure that gives rise to a higher than normal content of pesticides. Reagents: All reagents and solvents are free from any contaminants, especially pesticides, that might interfere with the analysis. It is often necessary to use special quality solvents or, if this is not possible, solvents that have recently been re- distilled in an apparatus made entirely of glass. In any case, suitable blank tests must be carried out. Apparatus: Clean the apparatus and especially glassware to ensure that they are free from pesticides, for example, soak for at least 16 hours in a solution of phosphate-free detergent, rinse with large quantities of distilled water and wash with acetone and hexane or heptane. 3.3.1. Test for Pesticides: The following methods may be used depending on the substance being examined, it may be necessary to modify, sometimes extensively, the procedure described hereafter. In any case, it may be necessary to use, in addition, another column with a different polarity or another detection method (mass spectrometry) or a different method (immunochemical methods) to confirm the results obtained. This procedure is valid only for the analysis of samples of vegetable drugs containing less than 15 per cent of water. Samples with a higher content of water may be dried, provided it has been shown that the drying procedure does not affect significantly the pesticide content. Extraction (Method-I): To 10 g of the substance being examined, add 100 ml of acetone and allow to stand for 20 min. Add 1 ml of a solution containing 1.8 g/ml of carbophenothion in toluene. Homogenise using a high-speed blender for 3 min. Filter and wash the filter cake with two quantities, each of 25 ml of acetone. Combine the filtrate and the washings and heat using a rotary eva"}},{"@id":"https://www.openphar.org/data/ayp/monographs/tulasi","@type":"IndexedMonograph","prefLabel":{"la":"Tulasī"},"edition":"API Part I–VII","category":"extracts","definition":{"la":"Surasā, Surasa"}},{"@id":"https://www.openphar.org/data/ayp/monographs/abhayarishta","@type":"IndexedMonograph","prefLabel":{"la":"Abhayarishta"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/abhayarishta.jsonld"}},{"@id":"https://www.openphar.org/data/ayp/monographs/ajamoda-arka","@type":"IndexedMonograph","prefLabel":{"la":"Ajamodā Arka"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Ajamodā Arka is a liquid preparation obtained by hydro-distillation of fruits of Trachyspermum roxburghianum."}},{"@id":"https://www.openphar.org/data/ayp/monographs/amalakyadi-churna","@type":"IndexedMonograph","prefLabel":{"la":"Amalakyadi churna"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"ĀMALAKYĀDI CŪRṆA is a powder preparation made with the ingredients in the Formulation composition given below."}},{"@id":"https://www.openphar.org/data/ayp/monographs/amrutarishta","@type":"IndexedMonograph","prefLabel":{"la":"Amṛtāriṣṭa"},"edition":"API Part I–VII","category":"formulations"},{"@id":"https://www.openphar.org/data/ayp/monographs/apamarga-kshaara","@type":"IndexedMonograph","prefLabel":{"la":"Apamarga kshaara"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"APĀMĀRGA KṣĀRA is an off-white alkaline preparation made with the ingredients in the Formulation composition given below."}},{"@id":"https://www.openphar.org/data/ayp/monographs/apamarga-kshara-taila","@type":"IndexedMonograph","prefLabel":{"la":"Apāmārga Kṣāra Taila"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Apāmārga Kṣāra Taila is a medicated oil preparation made with the ingredients in the Formulation Composition given below with Tila taila as the basic ingredient."}},{"@id":"https://www.openphar.org/data/ayp/monographs/aravindasava","@type":"IndexedMonograph","prefLabel":{"la":"Aravindāsava"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"ARAVINDËSAVA (AFI, Part-I, 1: 4) Aravind¡sava is a fermented liquid preparation made with the ingredients in the Formulation composition given below. It contains not more than 10 per cent, and not less than 5 per cent of alcohol that is self generated in the preparation over a period of time."}},{"@id":"https://www.openphar.org/data/ayp/monographs/arimededdi-taila","@type":"IndexedMonograph","prefLabel":{"la":"Arimedādi Taila"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Arimedādi Taila is a medicated oil preparation made with the ingredients in the Formulation Composition given below with mūrcchita Tila taila as the basic ingredient."}},{"@id":"https://www.openphar.org/data/ayp/monographs/arka-lavana","@type":"IndexedMonograph","prefLabel":{"la":"Arka lavana"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"ARKA LAVAṆA is a preparation made with the ingredients in the formulation composition given below."}},{"@id":"https://www.openphar.org/data/ayp/monographs/arka-vati","@type":"IndexedMonograph","prefLabel":{"la":"Arka Vaṭī"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Microbial limits: \nComplies with Appendix 2.4 \n \nAflatoxins: \nComplies with Appendix 2.6 \n \nMineral oil: \nAbsent, Appendix 3.15"}},{"@id":"https://www.openphar.org/data/ayp/monographs/asanabilvadi-taila","@type":"IndexedMonograph","prefLabel":{"la":"Asanabilvādi Taila"},"edition":"API Part I–VII","category":"formulations","definition":{"la":" Take all ingredients of pharmacopoeial quality. \n Treat Tila taila to prepare mūrcchita Tila taila (Appendix 6.2.9.4). \n Wash, clean, dry the ingredients numbered 1 to 4 of the Formulation Composition, powder \nseparately and pass through 355 µm I. S. sieve (sieve number 44) (kvātha dravya). \n Add water for decoction to the kvātha dravya and soak for 4 h, heat and reduce the volume to \none-fourth. Filter through muslin cloth to obtain kvātha. \n Wash, dry the ingredients numbered 6 to 8 (kalka dravya) of the Formulation Composition, \npowder separately and pass through 180 µm I. S. sieve (sieve number 85) to obtain fine \npowder. \n Transfer the powdered ingredients to wet grinder and grind with sufficient quantity of water to \nprepare homogeneous blend (kalka). \n Take mūrcchita Tila taila in a stainless steel vessel and heat it. \n Add increments of kalka, stir thoroughly while adding kvātha. \n \n∗ Part actually used in the formulation \n\n65 \n \n Heat for 3 h with constant stirring, maintaining the temperature between 500 and 900 during \nthe first hour of heating. Stop heating and allow to stand overnight. \n Next day, add Godugdha and continue the process of heating. Constantly check the kalka by \nrolling between the fingers. \n Stop the heating when the kalka easily rolls into a varti without sticking (Madhyama pāka \nlakṣaṇa) to the fingers and at the appearance of froth (phenodgama) over the oil. Expose the \nvarti and oil to flame and confirm the absence of crackling sound indicating absence of \nmoisture. \n Filter while hot (about 800) through a muslin cloth and allow to cool. \n Store it in glass containers and pack them air-tight to protect from light and moisture."}},{"@id":"https://www.openphar.org/data/ayp/monographs/ashokarishta","@type":"IndexedMonograph","prefLabel":{"la":"Aśokāriṣṭa"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"AáOKËRIâÙA (AFI, Part-I, 1:5) A¿ok¡riÀ¶a is a fermented liquid preparation, made with the ingredients in Formulation composition given below. It contains not more than 10 per cent, and not less than 5 per cent of alcohol that is self generated in the preparation over a period of time."}},{"@id":"https://www.openphar.org/data/ayp/monographs/ashvagandhadyarishta","@type":"IndexedMonograph","prefLabel":{"la":"Aśvagandhādyariṣṭa"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"AáVAGANDHËDYARIâÙA (AFI, Part-1, 1:6) A¿vagandh¡dyariÀ¶a is a fermented liquid preparation made with the ingredients in the Formulation composition given below. It contains not more than 10 per cent, and not less than 5 per cent of alcohol that is self generated in the preparation over a period of time."}},{"@id":"https://www.openphar.org/data/ayp/monographs/astangavaleha","@type":"IndexedMonograph","prefLabel":{"la":"Astangavaleha"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"AṣṬĀṄGĀVALEHA is a semisolid preparation made with the ingredients in the Formulation composition given below."}},{"@id":"https://www.openphar.org/data/ayp/monographs/asu-taila","@type":"IndexedMonograph","prefLabel":{"la":"Aśu Taila"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Aṇu Taila is a medicated oil preparation made with the ingredients in the Formulation Composition given below with mūrcchita Tila taila as the basic ingredient."}