{"@context":"https://www.openphar.org/ontology/context/pharmacopoeia.jsonld","@graph":[{"@id":"https://www.openphar.org/data/ayp/monographs/bha","@type":"IndexedMonograph","prefLabel":{"la":"Bha"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/bha.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/formulations/bha.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/citra","@type":"IndexedMonograph","prefLabel":{"la":"Citra"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/citra.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/formulations/citra.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/da","@type":"IndexedMonograph","prefLabel":{"la":"Da"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/da.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/formulations/da.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/dh","@type":"IndexedMonograph","prefLabel":{"la":"Dh"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/dh.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/formulations/dh.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/dr","@type":"IndexedMonograph","prefLabel":{"la":"Dr"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/dr.jsonld"},"sections":[{"name":"SOURCE","text":"Converted from ontology/data/formulations/dr.jsonld"}]},{"@id":"https://www.openphar.org/data/ayp/monographs/el","@type":"IndexedMonograph","prefLabel":{"la":"El"},"edition":"API Part I–VII","category":"formulations","definition":{"la":"Converted from ontology/data/formulations/el.jsonld"},"sections":[{"name":"S