      "publisher": "JP",
      "status": "Official",
      "version": "18",
      "prefLabel": {
        "en": "Imperata Rhizome",
        "la": "Imperatae Rhizoma",
        "ja": "ボウコン"
      },
      "definition": {
        "en": "not more than 3"
