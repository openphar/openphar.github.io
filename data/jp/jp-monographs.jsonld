      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/flunitrazepam",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Flunitrazepam",
        "ja": "フルニトラゼパム"
      },
      "monographId": "JP18-flunitrazepam",
      "publisher": "JP",
      "status": "Official",
