      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/mizoribine-tablets",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Mizoribine Tablets",
        "ja": "ミゾリビン錠"
