      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/amoxicillin-capsules",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Amoxicillin Capsules",
