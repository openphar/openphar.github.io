      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/flavoxate-hydrochloride",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Flavoxate Hydrochloride",
