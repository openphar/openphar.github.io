      "version": "18",
      "appearance": {
        "en": "Compound Diastase and Sodium Bicarbonate Powder occurs as a slightly brownish, light yellow powder. It has a characteristic odor and a bitter taste."
      },
      "storageConditions": {
        "en": "Containers—Well-closed contain-ers."
