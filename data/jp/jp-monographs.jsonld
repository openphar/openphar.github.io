      },
      "definition": {
        "en": "not more than 1"
      },
      "botanicalSource": {
        "@type": "BotanicalSource",
        "referencesPlantSpecies": {
          "@id": "https://www.openphar.org/data/jp/biological-sources/gardenia-fruit-gardenia-jasminoides-ellis"
