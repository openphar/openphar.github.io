    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/haloperidol",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Haloperidol",
        "ja": "ハロペリドール"
      },
      "monographId": "JP18-haloperidol",
