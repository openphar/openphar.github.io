      "@id": "https://www.openphar.org/data/jp/chemicals/polyporus",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Polyporus",
        "ja": "チョレイ"
      },
      "monographId": "JP18-polyporus",
