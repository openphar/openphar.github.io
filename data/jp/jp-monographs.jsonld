          "testType": "TestType-Assay",
          "testConditions": {
            "en": "Weigh accurately about 0.8 g of Penbutolol Sulfate, previously dried, dissolve in 50 mL of a mixture of acetic an-hydride and acetic acid (100) (7:3), and titrate <2.50> with 0.1 mol/L perchloric acid VS (potentiometric titration). Per-form a blank determination in the same manner, and make any necessary correction. Each mL of 0.1 mol/L perchloric acid VS ＝ 68.09 mg of (C18H29NO2)2.H2SO4"
          }
        }
      ],
      "storageConditions": {
        "en": "Containers—Well-closed contain-ers."
      }
    },
