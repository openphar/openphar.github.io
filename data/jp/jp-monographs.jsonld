      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/oxycodone-hydrochloride-hydrate",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Oxycodone Hydrochloride Hydrate",
