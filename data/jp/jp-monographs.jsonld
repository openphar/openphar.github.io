      "appearance": {
        "en": "Deferoxamine Mesilate occurs as a white to pale yellow-white crystalline powder. It is freely soluble in water, and practically insoluble in ethanol (99.5), in 2-propanol and in diethyl ether. Melting point: about 1479C (with decomposition)."
      },
      "testSpecification": [
        {
          "@type": "IdentificationSpecification",
