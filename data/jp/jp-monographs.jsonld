      "definition": {
        "en": "Pirenoxine, when dried, contains not less than 98."
      },
      "appearance": {
        "en": "Pirenoxine occurs as a yellow-brown powder. It is odorless, and has a slightly bitter taste. It is very slightly soluble in dimethylsulfoxide, and practi-cally insoluble in water, in acetonitrile, in ethanol (95), in tetrahydrofuran and in diethyl ether. Melting point: about 2509C (with decomposition)."
      },
      "testSpecification": [
        {
          "@type": "IdentificationSpecification",
          "testName": {
            "en": "Identification"
          },
          "testType": "TestType-Identification",
