      "publisher": "JP",
      "status": "Official",
      "version": "18",
      "prefLabel": {
        "en": "Catalpa Fruit",
        "la": "Catalpae Fructus",
        "ja": "キササゲ"
      },
      "definition": {
        "en": "solution as the standard solution"
      },
      "botanicalSource": {
        "@type": "BotanicalSource",
        "referencesPlantSpecies": {
          "@id": "https://www.openphar.org/data/jp/biological-sources/catalpa-fruit-catalpa-ovata-g"
        }
      },
      "testSpecification": [
