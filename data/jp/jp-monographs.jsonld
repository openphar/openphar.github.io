      "appearance": {
        "en": "Sodium Benzoate occurs as white, granules, crystals or crystalline powder. It is odorless, and has a sweet and saline taste. It is freely soluble in water, slightly soluble in ethanol (95), and practically insoluble in diethyl ether."
      },
      "testSpecification": [
        {
          "@type": "IdentificationSpecification",
          "testName": {
            "en": "Identification"
