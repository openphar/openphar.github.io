    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/terbinafine-hydrochloride-solution",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Terbinafine Hydrochloride Solution",
        "ja": "テルビナフィン塩酸塩液"
