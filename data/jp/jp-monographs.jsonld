      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/meropenem-hydrate",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Meropenem Hydrate",
        "ja": "メロペネム水和物"
      },
      "monographId": "JP18-meropenem-hydrate",
      "publisher": "JP",
      "status": "Official",
