        "en": "Pogostemi Herb",
        "la": "Pogostemi Herba",
        "ja": "カッコウ"
      },
      "definition": {
        "en": "terrestrial part of Pogostemon cablin Bentham (Labiatae)"
      },
      "botanicalSource": {
        "@type": "BotanicalSource",
        "referencesPlantSpecies": {
          "@id": "https://www.openphar.org/data/jp/biological-sources/pogostemi-herb-pogostemon-cablin-bentham"
