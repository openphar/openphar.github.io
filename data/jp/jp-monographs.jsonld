      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/nicotinic-acid-injection",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Nicotinic Acid Injection",
