    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/aciclovir-for-syrup",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Aciclovir for Syrup",
        "ja": "シロップ用アシクロビル"
