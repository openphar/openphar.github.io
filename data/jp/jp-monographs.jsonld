    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/crude-drugs/glycyrrhizae-radix-praeparata",
      "@type": "CrudeDrugMonograph",
      "prefLabel": {
        "en": "Glycyrrhizae Radix Praeparata",
        "ja": "シャカンゾウ"
      },
      "monographId": "JP18-glycyrrhizae-radix-praeparata",
      "publisher": "JP",
      "status": "Official",
      "version": "18",
      "testSpecification": [
        {
          "@type": "PuritySpecification",
          "testName": {
            "en": "Purity"
          },
          "testType": "TestType-Purity",
          "testConditions": {
            "en": "(1) Heavy metals <1.07>—Proceed with 3.0 g of pulverized Poria Sclerotium according to Method 3, and per-form the test. Prepare the control solution with 3.0 mL of Standard Lead Solution (not more than 10 ppm). (2) Arsenic <1.11>—Prepare the test solution with 0.40 g of pulverized Poria Sclerotium according to Method 4, and perform the test (not more than 5 ppm). Total ash <5.01> Not more than 1.0z."
          }
        }
      ],
      "storageConditions": {
        "en": "Containers—Well-closed contain-ers."
      }
    },
    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/crude-drugs/glycyrrhizae-radix-pulverata",
      "@type": "CrudeDrugMonograph",
      "prefLabel": {
        "en": "Glycyrrhizae Radix Pulverata",
        "ja": "カンゾウ末"
      },
      "monographId": "JP18-glycyrrhizae-radix-pulverata",
      "publisher": "JP",
      "status": "Official",
      "version": "18",
      "appearance": {
        "en": "Powdered Glycyrrhiza is light yellow-brown or light yellow to grayish yellow (powder of peeled Glycyrrhiza) in color. It has a slight odor and a sweet taste. Under a microscope <5.01>, Powdered Glycyrrhiza reveals mainly yellow sclerenchymatous fiber bundles accompanied with crystal cell rows; vessels, 80 – 200 mm in diameter, with pitted, reticulate and scalariform pits, and with round perfo-rations; parenchyma cells, containing starch grains and soli-tary crystals of calcium oxalate, their fragments, and cork tissues; but powder of peeled Glycyrrhiza shows no cork tissue; if any, a very few. Starch grains are simple grains, 2 – 20 mm in diameter; solitary crystals of calcium oxalate, 10 – 30 mm in a diameter."
      },
      "testSpecification": [
        {
          "@type": "IdentificationSpecification",
          "testName": {
            "en": "Identification"
          },
          "testType": "TestType-Identification",
          "testConditions": {
            "en": "To 2 g of Powdered Glycyrrhiza add 10 mL of a mixture of ethanol (95) and water (7:3), heat by shaking on a water bath for 5 minutes, cool, filter, and use the fil-trate as the sample solution. Separately, dissolve 5 mg of Glycyrrhizic Acid RS or glycyrrhizic acid for thin-layer chro-matography in 1 mL of a mixture of ethanol (95) and water (7:3), and use this solution as the standard solution. Perform the test with these solutions as directed under Thin-layer Chromatography <2.03>. Spot 2 mL each of the sample solu-tion and standard solution on a plate of silica gel with fluo-rescent indicator for thin-layer chromatography. Develop the plate with a mixture of 1-butanol, water and acetic acid (100) (7:2:1) to a distance of about 7 cm, and air-dry the plate. Examine under ultraviolet light (main wavelength: 254 nm): one of the several spots obtained from the sample solu-tion and a spot from the standard solution show the same color tone and the same Rf value. ‌JP XVIII Crude Drugs and Related Drugs / Glycyrrhiza Extract 2015"
          }
        },
        {
          "@type": "PuritySpecification",
          "testName": {
            "en": "Purity"
          },
          "testType": "TestType-Purity",
          "testConditions": {
            "en": "(1) Heavy metals <1.07>—Proceed with 3.0 g of Powdered Glycyrrhiza according to Method 3, and perform the test. Prepare the control solution with 3.0 mL of Stand-ard Lead Solution (not more than 10 ppm). Arsenic <1.11>—Prepare the test solution with 0.40 g of Powdered Glycyrrhiza according to Method 4, and per- Glycyrrhiza Extract"
          }
        }
      ]
    },
    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/crude-drugs/glycyrrhizae-radix",
      "@type": "CrudeDrugMonograph",
      "prefLabel": {
        "en": "Glycyrrhizae Radix",
        "ja": "カンゾウ",
        "la": "Radix Glycyrrhizae"
      },
      "altLabel": [
        {
          "@value": "Licorice Root",
          "@language": "en"
        },
        {
          "@value": "Glycyrrhiza",
          "@language": "en"
        },
        {
          "@value": "甘草",
          "@language": "ja"
        },
        {
          "@value": "kanzou",
          "@language": "ja-Latn"
        }
      ],
      "monographId": "JP18-002",
      "publisher": "JP",
      "status": "Official",
      "effectiveDate": "2021-06-25",
      "version": "18",
      "definition": {
        "en": "Glycyrrhizae Radix consists of the root and stolon of Glycyrrhiza glabra Linne, Glycyrrhiza uralensis Fisher, or related species (Leguminosae), from which the cork layer is removed, dried, and usually processed."
      },
      "referencesPreparation": {
        "@id": "https://www.herbapedia.org/entity/preparation/dried-licorice-root"
      },
      "referencesTCMProfile": {
        "@id": "https://www.herbapedia.org/system/tcm/profile/gan-cao"
      },
      "referencesAyurvedaProfile": {
        "@id": "https://www.herbapedia.org/system/ayurveda/dravya/yashtimadhu"
      },
      "botanicalSource": {
        "@type": "BotanicalSource",
        "referencesPlantSpecies": {
          "@id": "https://www.herbapedia.org/entity/botanical/species/glycyrrhiza-glabra"
        },
        "plantPartUsed": {
          "en": "Root and Stolon"
        },
        "collectionPeriod": {
          "en": "Collected in autumn to spring of 3-4 year old plants"
        }
      },
      "macroscopicDescription": {
        "@type": "MacroscopicDescription",
        "color": {
          "en": "Yellowish brown to brown"
        },
        "shape": {
          "en": "Root: cylindrical, often laterally split, 30-100 cm long, 0.5-3.5 cm in diameter; Stolon: cylindrical, sometimes with branches, 1-3 m long, 0.5-1.5 cm in diameter"
        },
        "texture": {
          "en": "Hard and fibrous"
        },
        "fracture": {
          "en": "Fracture surface is fibrous, outer part reddish brown, inner part yellowish brown"
        },
        "odor": {
          "en": "Characteristic, slight"
        },
        "taste": {
          "en": "Sweet, characteristic"
        }
      },
      "microscopicDescription": {
        "@type": "MicroscopicDescription",
        "transverseSection": {
          "en": "Cork cells usually absent; phloem composed of fiber bundles (surrounded by crystal sheath containing calcium oxalate prisms), sieve tubes and parenchyma; xylem composed of vessels (arranged in radial rows), tracheids, wood fibers and parenchyma; vessels 30-180 μm in diameter with simple perforation plates; prisms of calcium oxalate crystals 15-30 μm in length scattered in the parenchyma cells near the fiber bundles"
        },
        "powderCharacteristics": {
          "en": "Powder shows fragments of fibers surrounded by crystal sheath containing prisms of calcium oxalate; fragments of vessels with simple perforation plates; parenchyma cells containing starch grains (simple or compound, 3-15 μm in diameter) and prisms of calcium oxalate"
        },
        "diagnosticFeatures": {
          "en": "Fiber bundles surrounded by crystal sheath containing prisms of calcium oxalate; vessels with simple perforation plates; starch grains 3-15 μm in diameter; sweet taste"
        }
      },
      "testSpecification": [
        {
          "@type": "IdentificationSpecification",
          "testName": {
            "en": "Identification A - TLC"
          },
          "testType": "TestType-Identification",
          "harmonizedMethod": "TLC",
          "testConditions": {
            "en": "To 1.0 g of pulverized Glycyrrhizae Radix add 20 mL of ammonia TS and 20 mL of chloroform, shake for 15 minutes, filter, and use the chloroform layer as the sample solution. Separately, dissolve 1 mg of glycyrrhizin RS in 10 mL of methanol, and use this solution as the standard solution. Perform the test with these solutions as directed under Thin-layer Chromatography. Spot 10 μL each of the sample solution and standard solution on a plate of silica gel for thin-layer chromatography. Develop the plate with a mixture of 1-propanol, ammonium acetate TS, ammonia solution and ethyl acetate (6:3:1:1) to a distance of about 10 cm, and dry the plate. Spray evenly 4-dimethylaminobenzaldehyde TS on the plate, and heat at 80°C for 10 minutes: a spot from the sample solution and a spot from the standard solution show the same blue-purple color."
          }
        },
        {
          "@type": "IdentificationSpecification",
          "testName": {
            "en": "Identification B - HPLC"
          },
          "testType": "TestType-Identification",
          "harmonizedMethod": "HPLC",
          "testConditions": {
            "en": "Perform the test as directed under Liquid Chromatography with the sample solution prepared in the Assay. The retention time of the peak corresponding to glycyrrhizic acid from the sample solution is the same as that from the standard solution."
          }
        },
        {
          "@type": "PhysicalSpecification",
          "testName": {
            "en": "Foreign Matter"
          },
          "testType": "TestType-ForeignMatter",
          "harmonizedMethod": "ForeignMatter",
          "limit": {
