    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/nilvadipine-tablets",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Nilvadipine Tablets",
