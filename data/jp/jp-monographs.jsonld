          "@type": "AssaySpecification",
          "testName": {
            "en": "Assay"
          },
          "testType": "TestType-Assay",
          "testConditions": {
            "en": "Weigh accurately about 0.5 g of Pilocarpine Hydro-chloride, previously dried, dissolve in 50 mL of a mixture of acetic anhydride and acetic acid (100) (7:3), and titrate <2.50> with 0.1 mol/L perchloric acid VS (potentiometric titration). Perform a blank determination in the same manner, and make any necessary correction. Each mL of 0.1 mol/L perchloric acid VS ＝ 24.47 mg of C11H16N2O2.HCl"
          }
        }
      ],
      "storageConditions": {
        "en": "Containers—Tight containers. Storage—Light-resistant."
      }
    },
    {
