      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/neostigmine-methylsulfate-injection",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Neostigmine Methylsulfate Injection",
        "ja": "ネオスチグミンメチル硫酸塩注射液"
      },
      "monographId": "JP18-neostigmine-methylsulfate-injection",
      "publisher": "JP",
