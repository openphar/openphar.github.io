          "@type": "AssaySpecification",
          "testName": {
            "en": "Assay"
          },
          "testType": "TestType-Assay",
          "testConditions": {
            "en": "Weigh accurately about 0.8 g of Scopolamine Butyl-bromide, previously dried, dissolve in 40 mL of acetic acid (100) and 30 mL of acetic anhydride, and titrate <2.50> with 0.1 mol/L perchloric acid VS (potentiometric titration). Per-form a blank determination in the same manner, and make any necessary correction. Each mL of 0.1 mol/L perchloric acid VS ＝ 44.04 mg of C21H30BrNO4"
          }
        }
      ],
      "storageConditions": {
        "en": "Containers—Tight containers."
      }
    },
    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/scopolia-extract-and-tannic-acid-suppositories",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Scopolia Extract and Tannic Acid Suppositories",
        "ja": "ロートエキス・タンニン坐剤"
      },
      "monographId": "JP18-scopolia-extract-and-tannic-acid-suppositories",
      "publisher": "JP",
      "status": "Official",
