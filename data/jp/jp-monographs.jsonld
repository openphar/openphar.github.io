      "@id": "https://www.openphar.org/data/jp/chemicals/lafutidine",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Lafutidine",
        "ja": "ラフチジン"
      },
      "monographId": "JP18-lafutidine",
