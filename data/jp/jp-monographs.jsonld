    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/methyltestosterone-tablets",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Methyltestosterone Tablets",
