    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/azelnidipine-tablets",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Azelnidipine Tablets",
