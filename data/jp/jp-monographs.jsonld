      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/hydroxocobalamin-acetate",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Hydroxocobalamin Acetate",
        "ja": "ヒドロキソコバラミン酢酸塩"
