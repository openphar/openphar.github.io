      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/polaprezinc-granules",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "‌Polaprezinc Granules",
        "ja": "ポラプレジンク顆粒"
      },
      "monographId": "JP18-polaprezinc-granules",
      "publisher": "JP",
