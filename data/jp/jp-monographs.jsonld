    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/cefaclor-fine-granules",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Cefaclor Fine Granules",
        "ja": "セファクロル細粒"
