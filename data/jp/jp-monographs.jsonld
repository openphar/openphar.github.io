      "casNumber": "53152-21-9",
      "appearance": {
        "en": "Buprenorphine Hydrochloride occurs as white to yellowish white, crystals or a crystalline powder. It is freely soluble in methanol and in acetic acid (100), and sparingly soluble in water and in ethanol (99.5). Melting point: about 2689C (with decomposition)."
      },
      "testSpecification": [
        {
          "@type": "IdentificationSpecification",
