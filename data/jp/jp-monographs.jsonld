      },
      "monographId": "JP18-clemastine-fumarate",
      "publisher": "JP",
      "status": "Official",
      "version": "18",
      "molecularFormula": "C21H26ClNO.C4H4O4",
      "molecularWeight": 459.96,
      "definition": {
