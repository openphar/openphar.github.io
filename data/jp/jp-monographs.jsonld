    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/vitamins/vitamin-b1-hydrochloride",
      "@type": "VitaminMonograph",
      "prefLabel": {
        "en": "Vitamin B1 Hydrochloride",
        "ja": "チアミン塩化物塩酸塩"
      },
      "monographId": "JP18-vitamin-b1-hydrochloride",
