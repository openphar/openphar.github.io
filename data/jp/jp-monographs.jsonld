      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/doxorubicin-hydrochloride",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Doxorubicin Hydrochloride",
        "ja": "ドキソルビシン塩酸塩"
