    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/losartan-potassium-tablets",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Losartan Potassium Tablets",
        "ja": "ロサルタンカリウム錠"
