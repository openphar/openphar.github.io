    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/mupirocin-calcium-ointment",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "‌Mupirocin Calcium Ointment",
        "ja": "ムピロシンカルシウム軟膏"
      },
