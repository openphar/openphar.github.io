    {
      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/minerals/mupirocin-calcium-hydrate",
      "@type": "MineralSubstanceMonograph",
      "prefLabel": {
        "en": "Mupirocin Calcium Hydrate",
