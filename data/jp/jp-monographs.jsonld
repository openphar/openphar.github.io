        {
          "@type": "AssaySpecification",
          "testName": {
            "en": "Assay"
          },
          "testType": "TestType-Assay",
          "testConditions": {
            "en": "Weigh accurately about 0.3 g of Isoxsuprine Hydro-chloride, previously dried, dissolve in 5 mL of formic acid, add 50 mL of a mixture of acetic anhydride and acetic acid (100) (7:3), and titrate <2.50> with 0.1 mol/L perchloric acid VS (potentiometric titration). Perform a blank determina-tion in the same manner, and make any necessary correction. Each mL of 0.1 mol/L perchloric acid VS ＝ 33.78 mg of C18H23NO3.HCl"
          }
        }
      ],
      "storageConditions": {
        "en": "Containers—Well-closed contain-ers."
      }
