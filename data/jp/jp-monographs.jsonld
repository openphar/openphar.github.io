      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/lansoprazole-delayed-release-capsules",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Lansoprazole Delayed-release Capsules",
