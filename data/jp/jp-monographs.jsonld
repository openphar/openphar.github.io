      "version": "18",
      "prefLabel": {
        "en": "Aralia Rhizome",
        "la": "Araliae Cordatae Rhizoma",
        "ja": "ドクカツ"
      },
      "definition": {
        "en": "distinct, pith broad"
      },
      "botanicalSource": {
        "@type": "BotanicalSource",
        "referencesPlantSpecies": {
          "@id": "https://www.openphar.org/data/jp/biological-sources/aralia-rhizome-aralia-cordata-thunberg"
