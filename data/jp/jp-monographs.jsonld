      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/formulations/propafenone-hydrochloride-tablets",
      "@type": "FormulationMonograph",
      "prefLabel": {
        "en": "Propafenone Hydrochloride Tablets",
