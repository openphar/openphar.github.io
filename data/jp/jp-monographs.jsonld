          },
          "testType": "TestType-Assay",
          "testConditions": {
            "en": "Weigh accurately about 0.5 g of Oxaprozin, previ-ously dried, dissolve in 50 mL of ethanol (95), and titrate <2.50> with 0.1 mol/L sodium hydroxide VS (potentiometric titration). Perform a blank determination in the same man-ner, and make any necessary correction. Each mL of 0.1 mol/L sodium hydroxide VS ＝ 29.33 mg of C18H15NO3"
          }
        }
