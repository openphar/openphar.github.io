      "@context": "https://www.openphar.org/ontology/context/pharmacopoeia.jsonld",
      "@id": "https://www.openphar.org/data/jp/chemicals/minocycline-hydrochloride",
      "@type": "ChemicalDrugMonograph",
      "prefLabel": {
        "en": "Minocycline Hydrochloride",
