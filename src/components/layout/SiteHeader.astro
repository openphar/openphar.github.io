---
import BrandMark from '../BrandMark.vue'
const nav = [['/search', 'Search'], ['/compare', 'Compare'], ['/ontology', 'Ontology'], ['/api', 'API']]
---
<header class="border-b border-line bg-paper">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-start gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="group flex items-center gap-3">
        <BrandMark size={34} />
        <span class="flex flex-col leading-none">
          <span class="font-display text-[1.35rem] font-semibold tracking-tight text-ink">Open&nbsp;Pharmacopoeia</span>
          <span class="font-mono text-[0.625rem] tracking-[0.18em] text-brass uppercase">one structure · every pharmacopoeia</span>
        </span>
      </a>
      <nav class="flex flex-wrap items-center gap-1 sm:gap-4" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname.replace(/\/$/, '') === href ? 'page' : undefined}
          class:list={['font-mono text-xs tracking-[0.12em] uppercase text-ink/70 hover:text-pine px-2 py-1.5 rounded-xs transition-colors', { 'text-pine border-b-2 border-brass': Astro.url.pathname.replace(/\/$/, '') === href }]}>{label}</a>)}
      </nav>
    </div>
  </div>
  <div class="h-[3px] bg-linear-to-r from-pine via-moss to-brass"></div>
</header>
